{
	"luci-app-adguardhome": {
		"description": "Grant permissions for the AdGuard Home LuCI app",
		"read": {
			"ubus": {
				"luci.adguardhome": [ "get_status", "get_version", "get_config_info", "get_log" ]
			},
			"uci": [ "AdGuardHome" ]
		},
		"write": {
			"ubus": {
				"luci.adguardhome": [ "get_yaml", "set_yaml", "reset_yaml", "get_password_info", "set_password", "get_yaml_update" ]
			},
			"uci": [ "AdGuardHome" ]
		}
	}
}
