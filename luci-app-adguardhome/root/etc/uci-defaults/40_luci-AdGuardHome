ensure_lower_section() {
	uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}" >/dev/null 2>&1 && return 0
	uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}=adguardhome" || return 1
	LOWER_CHANGED=1
}

set_lower_option() {
	local option="$1"
	local value="$2"

	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.${option}")" = "$value" ] && return 0
	uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.${option}=${value}" || return 1
	LOWER_CHANGED=1
}

delete_lower_option() {
	local option="$1"

	uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.${option}" >/dev/null 2>&1 || return 0
	uci -q delete "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.${option}" || return 1
	LOWER_CHANGED=1
}

yaml_get_section_value() {
	local section="$1"
	local key="$2"
	local file="$3"

	[ -f "$file" ] || return 0
	awk -v section="$section" -v key="$key" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		{ line[++n] = $0 }
		END {
			for (i = 1; i <= n; i++)
				if (line[i] ~ ("^" section ":[[:space:]]*($|#)")) { sections++; if (!first) first = i }
			if (sections != 1) exit
			last = n
			for (i = first + 1; i <= n; i++)
				if (top(line[i])) { last = i - 1; break }
			depth = 0
			for (i = first + 1; i <= last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d = indent(line[i]); if (!depth || d < depth) depth = d
			}
			if (!depth) depth = 2
			for (i = first + 1; i <= last; i++) {
				if (indent(line[i]) != depth) continue
				value = substr(line[i], depth + 1)
				if (value !~ ("^" key ":[[:space:]]*")) continue
				matches++
				sub("^" key ":[[:space:]]*", "", value)
				sub(/[[:space:]]+#.*$/, "", value)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
				    (substr(value, 1, 1) == "\047" && substr(value, length(value), 1) == "\047"))
					value = substr(value, 2, length(value) - 2)
				result = value
			}
			if (matches == 1) print result
		}
	' "$file"
}

next_backup_path() {
	local target="$1"
	local candidate suffix

	candidate="${target}.pre-migration"
	suffix=0
	while [ -e "$candidate" ] || [ -L "$candidate" ]; do
		suffix=$((suffix + 1))
		candidate="${target}.pre-migration.${suffix}"
	done
	printf '%s\n' "$candidate"
}

valid_yaml_source_path() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "${value}/" in */./*|*/../*) return 1 ;; esac
	[ -f "$value" ] && [ ! -L "$value" ] || return 1
	! path_contains_symlink "$value"
}

copy_yaml_bounded() {
	local source="$1" target="$2" capture_rc=0
	valid_yaml_source_path "$source" || return 1
	root_private_file "$target" || return 1
	[ -x /sbin/start-stop-daemon ] || return 1
	if trusted_root_file_source "$source"; then
		capture_root_file_bytes "$source" "$target" 129 || capture_rc=$?
	else
		run_bounded 3 1 \
			/sbin/start-stop-daemon -S -c 853:853 -n AGHMigration \
			-x /bin/dd -- if="$source" bs=4096 count=129 \
			>"$target" 2>/dev/null || capture_rc=$?
	fi
	[ "$capture_rc" = 0 ] || return 1
	chown 0:0 "$target" && chmod 0600 "$target" || return 1
	bounded_regular_file "$target"
}

validate_yaml_candidate() {
	local candidate="$1" requested_work_dir="$2"
	bounded_regular_file "$candidate" || return 1
	if [ ! -x /etc/init.d/AdGuardHome ] || [ -L /etc/init.d/AdGuardHome ]; then
		echo "The packaged AdGuard Home validation helper is unavailable." >&2
		return 1
	fi
	# Cover both bounded TLS snapshots, the writable schema-normalization jail,
	# the read-only official-core recheck, and descriptor-based captures.
	run_bounded 120 5 /etc/init.d/AdGuardHome \
		normalize_config "$candidate" "$requested_work_dir"
}

secure_work_dir_inode() (
	local target="$1" fd_path metadata mode owner group
	[ -d "$target" ] && [ ! -L "$target" ] || exit 1
	exec 9<"$target" || exit 1
	fd_path=/proc/self/fd/9
	[ -d "$fd_path" ] && [ "$fd_path" -ef "$target" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$fd_path" 2>/dev/null)" || exit 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	case "${owner}:${group}:${mode}" in
		# The 1.x APK shipped its fixed workdir as root:root 0775.  Accept
		# that exact legacy state (and its non-writable 0755 variant) only
		# long enough to tighten the held inode below; world-writable and
		# non-root-owned directories remain rejected.
		0:0:drwxrwxr-x|0:0:drwxr-xr-x|0:0:drwx------|0:"$ADGUARD_GID":drwx------|0:"$ADGUARD_GID":drwx--x---|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) exit 1 ;;
	esac
	chown 0:0 "$fd_path" && chmod 0700 "$fd_path" || exit 1
	[ "$fd_path" -ef "$target" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$fd_path" 2>/dev/null)" || exit 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = drwx------ ] && [ "$owner" = 0 ] && [ "$group" = 0 ]
)

secure_target_work_dir() {
	local target="${1%/}" parent
	is_managed_work_dir "$target" || return 1
	parent="${target%/*}"
	case "$parent" in
		/etc) root_owned_directory_allow_writable "$parent" || return 1 ;;
		*) root_owned_safe_directory "$parent" || return 1 ;;
	esac
	if [ -e "$target" ] || [ -L "$target" ]; then
		[ -d "$target" ] && [ ! -L "$target" ] || return 1
	else
		mkdir -m 0700 "$target" || return 1
		CREATED_MANAGED_WORK_DIR="$target"
	fi
	secure_work_dir_inode "$target" || return 1
	root_private_directory "$target"
}

install_yaml_candidate() {
	local candidate="$1" target="$2" preserve_existing="$3"
	local target_dir temporary backup=""
	bounded_regular_file "$candidate" || return 1
	target_dir="${target%/*}"
	[ "$target" = "${target_dir}/AdGuardHome.yaml" ] || return 1
	secure_target_work_dir "$target_dir" || return 1
	if [ -e "$target" ] || [ -L "$target" ]; then
		[ -f "$target" ] && [ ! -L "$target" ] || return 1
		if cmp -s "$candidate" "$target"; then
			chown 0:0 "$target" && chmod 0600 "$target"
			return
		fi
	fi
	temporary="$(mktemp "${target}.install.XXXXXX")" || return 1
	if ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary"; then
		rm -f "$temporary"
		return 1
	fi
	if ! run_bounded 3 1 dd if="$candidate" bs=4096 count=129 \
		of="$temporary" 2>/dev/null ||
	   ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! bounded_regular_file "$temporary" || ! cmp -s "$candidate" "$temporary"; then
		rm -f "$temporary"
		return 1
	fi
	if [ "$preserve_existing" = 1 ] && [ -f "$target" ]; then
		backup="$(next_backup_path "$target")" || {
			rm -f "$temporary"
			return 1
		}
		if ! run_bounded 3 1 dd if="$target" bs=4096 count=129 \
			of="$backup" 2>/dev/null || ! chown 0:0 "$backup" ||
		   ! chmod 0600 "$backup" || ! bounded_regular_file "$backup" ||
		   ! cmp -s "$target" "$backup"; then
			rm -f "$temporary" "$backup"
			return 1
		fi
	fi
	if ! mv -f "$temporary" "$target"; then
		rm -f "$temporary" "$backup"
		return 1
	fi
	root_private_file "$target" && cmp -s "$candidate" "$target" || return 1
	[ -z "$backup" ] || echo "Preserved existing config as '$backup'."
}

migrate_yaml() {
	local source="$1"
	local target="$2"
	local candidate preserve_existing=0

	if [ ! -e "$source" ] && [ ! -L "$source" ]; then
		if [ -f "$target" ] && [ ! -L "$target" ]; then
			source="$target"
		else
			echo "AdGuard Home config source is missing: '$source'." >&2
			return 1
		fi
	fi
	valid_yaml_source_path "$source" || {
		echo "Unsafe AdGuard Home config source: '$source'." >&2
		return 1
	}
	# Secure the old fixed workdir before selecting a capture path only when the
	# source is the root-owned target itself.  Service-owned workdirs must remain
	# traversable until their YAML has been captured as uid 853; they are secured
	# later by install_yaml_candidate().
	if [ "$source" = "$target" ] && root_owned_regular_file "$source"; then
		secure_target_work_dir "${target%/*}" || {
			echo "Unable to secure the managed AdGuard Home workdir '${target%/*}'." >&2
			return 1
		}
	fi
	new_private_temp yaml-migration || return 1
	candidate="$NEW_PRIVATE_TEMP"
	copy_yaml_bounded "$source" "$candidate" || {
		echo "Unable to capture a bounded AdGuard Home config from '$source'." >&2
		return 1
	}
	validate_yaml_candidate "$candidate" "${target%/*}" || {
		echo "AdGuard Home rejected the migration candidate from '$source'." >&2
		return 1
	}
	if [ -e "$target" ] || [ -L "$target" ]; then
		[ -f "$target" ] && [ ! -L "$target" ] || return 1
		if [ "$source" != "$target" ] || ! cmp -s "$candidate" "$target"; then
			preserve_existing=1
		fi
	fi
	install_yaml_candidate "$candidate" "$target" "$preserve_existing" || {
		echo "Unable to install the validated AdGuard Home configuration." >&2
		return 1
	}
	if [ "$source" != "$target" ]; then
		echo "Migrated AdGuard Home config from '$source' to '$target'."
	fi
}

# Keep the official local-filter allowlist usable when a volatile workdir is
# imported into persistent storage.  Replace only the exact generated list
# item, preserve every user-added pattern, and ask the official core to verify
# the rewritten YAML before accepting it.
rewrite_migrated_workdir_pattern() {
	local old_work="${1%/}" new_work="${2%/}" file="$3"
	local old_pattern new_pattern original generated rc

	[ -n "$old_work" ] || return 0
	[ "$old_work" != "$new_work" ] || return 0
	is_allowed_data_source_work_dir "$old_work" || return 1
	is_managed_work_dir "$new_work" || return 1
	valid_yaml_source_path "$file" || return 1

	old_pattern="${old_work}/data/userfilters/*"
	new_pattern="${new_work}/data/userfilters/*"
	new_private_temp yaml-workdir-source || return 1
	original="$NEW_PRIVATE_TEMP"
	copy_yaml_bounded "$file" "$original" || return 1
	new_private_temp yaml-workdir-result || return 1
	generated="$NEW_PRIVATE_TEMP"
	awk -v old="$old_pattern" -v replacement="$new_pattern" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(count, s, i) { s=""; for (i=0; i<count; i++) s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for (i=1; i<=n; i++)
				if (line[i] ~ /^filtering:[[:space:]]*($|#)/) { first=i; break }
			if (!first) { for (i=1; i<=n; i++) print line[i]; exit 3 }
			last=n
			for (i=first+1; i<=n; i++) if (top(line[i])) { last=i-1; break }
			depth=0
			for (i=first+1; i<=last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d=indent(line[i]); if (!depth || d<depth) depth=d
			}
			if (!depth) depth=2
			for (i=first+1; i<=last; i++) {
				if (indent(line[i]) != depth) continue
				candidate=substr(line[i], depth+1)
				if (candidate ~ /^safe_fs_patterns:[[:space:]]*/) { key_line=i; break }
			}
			if (!key_line) { for (i=1; i<=n; i++) print line[i]; exit 3 }
			block_last=last
			for (i=key_line+1; i<=last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/) continue
				if (indent(line[i]) <= depth) { block_last=i-1; break }
			}
			for (i=key_line+1; i<=block_last; i++) {
				if (indent(line[i]) <= depth) continue
				value=substr(line[i], indent(line[i])+1)
				if (value !~ /^-[[:space:]]*/) continue
				sub(/^-[[:space:]]*/, "", value)
				comment=""
				if (match(value, /[[:space:]]+#.*/)) {
					comment=substr(value, RSTART)
					value=substr(value, 1, RSTART-1)
				}
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if ((substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") ||
				    (substr(value,1,1)=="\047" && substr(value,length(value),1)=="\047"))
					value=substr(value,2,length(value)-2)
				if (value == old) {
					line[i]=pad(indent(line[i])) "- " replacement comment
					changed=1
				}
			}
			for (i=1; i<=n; i++) print line[i]
			if (!changed) exit 3
		}' "$original" >"$generated"
	rc=$?
	chown 0:0 "$generated" && chmod 0600 "$generated" || return 1
	case "$rc" in
		3)
			return 0
			;;
		0) ;;
		*) return 1 ;;
	esac
	bounded_regular_file "$generated" || return 1
	validate_yaml_candidate "$generated" "$new_work" || {
		echo "AdGuard Home rejected the migrated workdir path." >&2
		return 1
	}
	install_yaml_candidate "$generated" "$file" 0 || return 1
	echo "Updated AdGuard Home local-filter path for '$new_work'."
}

# Runtime trees are owned by the packaged service uid.  Scan and read them as
# that uid so a concurrent path substitution can never make this root wrapper
# copy host secrets.  Only directories and regular files are accepted.
uid853_tree_is_plain() {
	local tree="$1"
	[ -d "$tree" ] && [ ! -L "$tree" ] || return 1
	# $1 and bad intentionally expand in the lowered child shell.
	# shellcheck disable=SC2016
	run_bounded 30 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataScan -x /bin/sh -- -c '
			set -o pipefail
			bad="$(/usr/bin/find "$1" ! -type d ! -type f -print 2>/dev/null |
				/usr/bin/head -n 1)" || exit 1
			[ -z "$bad" ]
		' sh "$tree" >/dev/null 2>&1
}

uid853_read_small_file() {
	run_bounded 3 1 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataRead -x /bin/dd -- if="$1" bs=4096 count=1 2>/dev/null
}

restore_migration_directory_owner() {
	chown "$1" "$2"
}

restore_migration_directory_mode() {
	chmod "$1" "$2"
}

# Preserve runtime history, filters, and query data when a volatile official or
# legacy workdir must be moved.  The source is retained for rollback; a
# root-owned 0710 target parent grants uid 853 traversal into only its private
# staging child, never rename/write authority over sibling paths.
migrate_runtime_data() (
	# BusyBox ash restores function-local variables before running an EXIT trap.
	# This function already runs in a subshell, so keep trap state at subshell
	# scope to make it available throughout cleanup without leaking to the caller.
	old_work="${1%/}"
	new_work="${2%/}"
	source_data=""
	target_data=""
	marker=""
	temporary=""
	temporary_leaf=""
	target_relaxed=0
	marker_value=""
	source_relaxed=0
	source_fd=""
	source_metadata=""
	source_mode=""
	source_owner=""
	source_group=""
	target_fd=""
	target_metadata=""
	target_mode=""
	target_owner=""
	target_group=""
	data_migration_copied=0
	fd_directory_metadata_matches() {
		local metadata mode owner group
		[ -d "$1" ] || return 1
		metadata="$(LC_ALL=C ls -ldnL "$1" 2>/dev/null)" || return 1
		read -r mode _fd_links owner group _fd_remainder <<-EOF
		$metadata
		EOF
		[ "$mode" = "$2" ] && [ "$owner" = "$3" ] && [ "$group" = "$4" ]
	}
	cleanup_data_migration() {
		data_migration_rc="$1"
		data_migration_cleanup_rc=0
		if [ -n "$temporary" ]; then
			data_migration_temporary_safe=1
			temporary_leaf="${temporary##*/}"
			case "$temporary_leaf" in
				.data-migration.??????) ;;
				*)
					data_migration_temporary_safe=0
					data_migration_cleanup_rc=1
					;;
			esac
			case "$temporary_leaf" in
				*[!A-Za-z0-9._-]*)
					data_migration_temporary_safe=0
					data_migration_cleanup_rc=1
					;;
			esac
			if [ "$data_migration_temporary_safe" = 1 ] &&
			   [ "$temporary" = "${new_work}/${temporary_leaf}" ] &&
			   [ -n "$target_fd" ] && [ -d "$target_fd" ]; then
				rm -rf "${target_fd:?}/${temporary_leaf:?}" || data_migration_cleanup_rc=1
				if [ -e "${target_fd}/${temporary_leaf}" ] ||
				   [ -L "${target_fd}/${temporary_leaf}" ]; then
					data_migration_cleanup_rc=1
				fi
			else
				data_migration_cleanup_rc=1
			fi
		fi
		if [ "$source_relaxed" = 1 ] && [ -n "$source_fd" ] && [ -d "$source_fd" ]; then
			restore_migration_directory_owner \
				"${source_owner}:${source_group}" "$source_fd" >/dev/null 2>&1 ||
				data_migration_cleanup_rc=1
			restore_migration_directory_mode 0700 "$source_fd" >/dev/null 2>&1 ||
				data_migration_cleanup_rc=1
		elif [ "$source_relaxed" = 1 ]; then
			data_migration_cleanup_rc=1
		fi
		if [ -n "$source_fd" ]; then
			[ "$source_fd" -ef "$old_work" ] &&
				fd_directory_metadata_matches "$source_fd" "$source_mode" \
					"$source_owner" "$source_group" || data_migration_cleanup_rc=1
		fi
		if [ "$target_relaxed" = 1 ] && [ -n "$target_fd" ] && [ -d "$target_fd" ]; then
			restore_migration_directory_owner \
				"${target_owner}:${target_group}" "$target_fd" >/dev/null 2>&1 ||
				data_migration_cleanup_rc=1
			restore_migration_directory_mode 0700 "$target_fd" >/dev/null 2>&1 ||
				data_migration_cleanup_rc=1
		elif [ "$target_relaxed" = 1 ]; then
			data_migration_cleanup_rc=1
		fi
		if [ -n "$target_fd" ]; then
			[ "$target_fd" -ef "$new_work" ] &&
				fd_directory_metadata_matches "$target_fd" "$target_mode" \
					"$target_owner" "$target_group" || data_migration_cleanup_rc=1
		fi
		if [ "$data_migration_cleanup_rc" -ne 0 ]; then
			echo "Unable to restore AdGuard Home migration directory metadata." >&2
		fi
		if [ "$data_migration_rc" -ne 0 ]; then
			return "$data_migration_rc"
		fi
		return "$data_migration_cleanup_rc"
	}
	cleanup_data_migration_on_exit() {
		data_migration_exit_rc=$?
		# Disable the EXIT action and ignore terminating signals in one trap
		# operation, so cleanup cannot recurse or be interrupted halfway through
		# restoring a directory inode.
		trap '' 0 HUP INT TERM
		data_migration_exit_final_rc=0
		cleanup_data_migration "$data_migration_exit_rc" ||
			data_migration_exit_final_rc=$?
		exit "$data_migration_exit_final_rc"
	}
	trap cleanup_data_migration_on_exit 0
	trap 'exit 1' HUP INT TERM
	perform_data_migration() {
	[ -n "$old_work" ] || return 0
	[ "$old_work" != "$new_work" ] || return 0
	is_allowed_data_source_work_dir "$old_work" || return 1
	is_managed_work_dir "$new_work" || return 1
	case "${old_work}/" in
		"${new_work}/"*)
			echo "Nested AdGuard Home migration source '$old_work' is unsafe." >&2
			return 1
			;;
	esac
	case "${new_work}/" in
		"${old_work}/"*)
			echo "Nested AdGuard Home migration target '$new_work' is unsafe." >&2
			return 1
			;;
	esac
	source_data="${old_work}/data"
	target_data="${new_work}/data"
	marker="${target_data}/.luci-app-adguardhome-migrated-from"
	[ -d "$source_data" ] || return 0
	if [ -L "$source_data" ] || path_contains_symlink "$old_work"; then
		echo "Unsafe AdGuard Home runtime-data source '$source_data'." >&2
		return 1
	fi
	exec 7<"$old_work" || return 1
	source_fd=/proc/self/fd/7
	[ -d "$source_fd" ] && [ "$source_fd" -ef "$old_work" ] || return 1
	source_metadata="$(LC_ALL=C ls -ldnL "$source_fd" 2>/dev/null)" || return 1
	read -r source_mode _source_links source_owner source_group _source_remainder <<-EOF
	$source_metadata
	EOF
	case "$source_mode" in d?????????) ;; *) return 1 ;; esac
	if ! uid853_tree_is_plain "$source_data"; then
		# A stopped legacy instance may leave its managed workdir root-private.
		# Hold that directory inode while granting uid 853 traverse-only access,
		# and restore the original inode through the descriptor on every exit.
		case "${source_owner}:${source_group}:${source_mode}" in
			0:0:drwx------|0:"$ADGUARD_GID":drwx------) ;;
			*) return 1 ;;
		esac
		source_relaxed=1
		chown "0:${ADGUARD_GID}" "$source_fd" && chmod 0710 "$source_fd" || return 1
		[ "$source_fd" -ef "$old_work" ] &&
			fd_directory_metadata_matches "$source_fd" drwx--x--- 0 "$ADGUARD_GID" &&
			uid853_tree_is_plain "$source_data" || return 1
	else
		[ "$source_fd" -ef "$old_work" ] || return 1
	fi
	secure_target_work_dir "$new_work" || return 1
	exec 8<"$new_work" || return 1
	target_fd=/proc/self/fd/8
	[ -d "$target_fd" ] && [ "$target_fd" -ef "$new_work" ] || return 1
	target_metadata="$(LC_ALL=C ls -ldnL "$target_fd" 2>/dev/null)" || return 1
	read -r target_mode _target_links target_owner target_group _target_remainder <<-EOF
	$target_metadata
	EOF
	[ "$target_mode" = drwx------ ] && [ "$target_owner" = 0 ] &&
		[ "$target_group" = 0 ] || return 1
	target_relaxed=1
	chown "0:${ADGUARD_GID}" "$target_fd" && chmod 0710 "$target_fd" || return 1
	[ "$target_fd" -ef "$new_work" ] &&
		fd_directory_metadata_matches "$target_fd" drwx--x--- 0 "$ADGUARD_GID" ||
		return 1
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		marker_value=""
		if [ -f "$marker" ] && [ ! -L "$marker" ] &&
		   uid853_tree_is_plain "$target_data"; then
			marker_value="$(uid853_read_small_file "$marker")" || marker_value=""
		fi
		if [ "$marker_value" = "$old_work" ]; then
			chmod 0700 "$target_data" || return 1
			return 0
		fi
		echo "Target data directory '$target_data' already exists; refusing to overwrite it." >&2
		return 1
	fi
	temporary="$(mktemp -d "${new_work}/.data-migration.XXXXXX")" || return 1
	chown "${ADGUARD_UID}:${ADGUARD_GID}" "$temporary" &&
		chmod 0700 "$temporary" || return 1
	if ! run_bounded 120 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataCopy -x /bin/cp -- -pR "${source_data}/." "$temporary/" ||
	   ! { [ "$source_relaxed" != 1 ] || [ "$source_fd" -ef "$old_work" ]; } ||
	   ! uid853_tree_is_plain "$source_data" ||
	   ! uid853_tree_is_plain "$temporary"; then
		return 1
	fi
	if ! printf '%s\n' "$old_work" | run_bounded 3 1 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataMark -x /bin/dd -- \
		of="${temporary}/.luci-app-adguardhome-migrated-from" \
		bs=4096 count=1 2>/dev/null; then
		return 1
	fi
	if ! /sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataMode -x /bin/chmod -- 0600 \
		"${temporary}/.luci-app-adguardhome-migrated-from" ||
	   ! uid853_tree_is_plain "$temporary"; then
		return 1
	fi
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		return 1
	fi
	mv "$temporary" "$target_data" || {
		return 1
	}
	temporary=""
	chmod 0700 "$target_data" || return 1
	data_migration_copied=1
	}
	data_migration_rc=0
	perform_data_migration || data_migration_rc=$?
	# Normal completion performs cleanup explicitly so BusyBox ash can propagate
	# its status.  Ignore terminating signals for the whole critical section and
	# disable the EXIT action atomically before restoring either inode.
	trap '' 0 HUP INT TERM
	data_migration_final_rc=0
	cleanup_data_migration "$data_migration_rc" || data_migration_final_rc=$?
	if [ "$data_migration_final_rc" -eq 0 ] && [ "$data_migration_copied" = 1 ]; then
		echo "Copied AdGuard Home runtime data from '$source_data' to '$target_data'; source retained."
	fi
	exit "$data_migration_final_rc"
)

read_official_state() {
	local legacy_value running_rc=0

	legacy_value="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	if [ -n "$legacy_value" ]; then
		OFFICIAL_CONFIG_FILE="$legacy_value"
	else
		OFFICIAL_CONFIG_FILE="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	fi
	[ -n "$OFFICIAL_CONFIG_FILE" ] || OFFICIAL_CONFIG_FILE="$OFFICIAL_DEFAULT_CONFIG"

	legacy_value="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	if [ -n "$legacy_value" ]; then
		OFFICIAL_WORK_DIR="$legacy_value"
	else
		OFFICIAL_WORK_DIR="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	fi
	[ -n "$OFFICIAL_WORK_DIR" ] || OFFICIAL_WORK_DIR="$OFFICIAL_DEFAULT_WORK_DIR"

	OFFICIAL_ENABLED="$(normalize_bool "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled")")"
	OFFICIAL_VERBOSE="$(normalize_bool "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.verbose")")"
	if [ -x /etc/init.d/adguardhome ]; then
		run_bounded 5 1 /etc/init.d/adguardhome running \
			>/dev/null 2>&1 || running_rc=$?
		case "$running_rc" in
			0)
				OFFICIAL_WAS_RUNNING=1
				OFFICIAL_ENABLED=1
				;;
			1) ;;
			*)
				echo "Unable to determine the official adguardhome runtime state." >&2
				return 1
				;;
		esac
	fi
}

official_state_is_meaningful() {
	[ "$OFFICIAL_WAS_RUNNING" = 1 ] && return 0
	[ "$OFFICIAL_ENABLED" = 1 ] && return 0
	[ -f "$OFFICIAL_CONFIG_FILE" ] && return 0
	[ -L "$OFFICIAL_CONFIG_FILE" ] && return 0
	[ "$OFFICIAL_CONFIG_FILE" != "$OFFICIAL_DEFAULT_CONFIG" ] && return 0
	[ "$OFFICIAL_WORK_DIR" != "$OFFICIAL_DEFAULT_WORK_DIR" ] && return 0
	return 1
}

select_migration_source() {
	local legacy_config_path upper_work_dir

	legacy_config_path="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.configpath")"
	upper_work_dir="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.workdir")"
	if [ -n "$upper_work_dir" ]; then
		upper_work_dir="$(normalize_work_dir "$upper_work_dir")" || {
			echo "Unsafe existing AdGuard Home workdir; refusing to abandon its runtime data." >&2
			return 1
		}
	else
		upper_work_dir="$DEFAULT_WORK_DIR"
	fi

	if [ "$IS_UPGRADE" != 1 ] && official_state_is_meaningful; then
		IMPORT_OFFICIAL=1
		DATA_SOURCE_WORK_DIR=""
		# The official package normally separates its YAML under /etc from its
		# runtime data under volatile /var/lib.  The refactored app requires YAML
		# inside a persistent workdir, so move volatile state to the default.
		if [ "${OFFICIAL_WORK_DIR%/}" = "$OFFICIAL_DEFAULT_WORK_DIR" ]; then
			DATA_SOURCE_WORK_DIR="$OFFICIAL_DEFAULT_WORK_DIR"
			TARGET_WORK_DIR="$DEFAULT_WORK_DIR"
			echo "Moving volatile official workdir '$DATA_SOURCE_WORK_DIR' to persistent '$TARGET_WORK_DIR'."
		else
			TARGET_WORK_DIR="$(normalize_work_dir "$OFFICIAL_WORK_DIR")" || {
				echo "Official AdGuard Home workdir '$OFFICIAL_WORK_DIR' is outside the managed namespace; import aborted." >&2
				return 1
			}
		fi
		if [ -e "$OFFICIAL_CONFIG_FILE" ] || [ -L "$OFFICIAL_CONFIG_FILE" ]; then
			valid_yaml_source_path "$OFFICIAL_CONFIG_FILE" || {
				echo "Unsafe official AdGuard Home config source '$OFFICIAL_CONFIG_FILE'; import aborted." >&2
				return 1
			}
			SOURCE_CONFIG_FILE="$OFFICIAL_CONFIG_FILE"
		else
			SOURCE_CONFIG_FILE="$DEFAULT_CONFIG_FILE"
		fi
		return 0
	fi

	TARGET_WORK_DIR="$upper_work_dir"
	if [ -n "$legacy_config_path" ]; then
		case "$legacy_config_path" in
			"$LEGACY_ROOT_CONFIG"|"${upper_work_dir}/AdGuardHome.yaml") ;;
			"${DATA_SOURCE_WORK_DIR}/AdGuardHome.yaml")
				[ -n "$DATA_SOURCE_WORK_DIR" ] || return 1
				;;
			*)
				echo "Untrusted legacy configpath '$legacy_config_path'; migration aborted." >&2
				return 1
				;;
		esac
		if [ -e "$legacy_config_path" ] || [ -L "$legacy_config_path" ]; then
			valid_yaml_source_path "$legacy_config_path" || {
				echo "Unsafe legacy config source '$legacy_config_path'; migration aborted." >&2
				return 1
			}
			SOURCE_CONFIG_FILE="$legacy_config_path"
			return 0
		fi
		if [ -e "$LEGACY_ROOT_CONFIG" ] || [ -L "$LEGACY_ROOT_CONFIG" ]; then
			valid_yaml_source_path "$LEGACY_ROOT_CONFIG" || return 1
			SOURCE_CONFIG_FILE="$LEGACY_ROOT_CONFIG"
			return 0
		fi
	fi

	# On a genuine first install, preserve an orphaned pre-2.0 root YAML.  Once
	# configpath has been removed, subsequent upgrades must prefer the active
	# workdir copy so that the stale legacy file cannot roll back user changes.
	if [ "$IS_UPGRADE" != 1 ] && { [ -e "$LEGACY_ROOT_CONFIG" ] || [ -L "$LEGACY_ROOT_CONFIG" ]; }; then
		valid_yaml_source_path "$LEGACY_ROOT_CONFIG" || return 1
		SOURCE_CONFIG_FILE="$LEGACY_ROOT_CONFIG"
		return 0
	fi
	if [ -n "$DATA_SOURCE_WORK_DIR" ] &&
	   { [ -e "${DATA_SOURCE_WORK_DIR}/AdGuardHome.yaml" ] || [ -L "${DATA_SOURCE_WORK_DIR}/AdGuardHome.yaml" ]; }; then
		valid_yaml_source_path "${DATA_SOURCE_WORK_DIR}/AdGuardHome.yaml" || return 1
		SOURCE_CONFIG_FILE="${DATA_SOURCE_WORK_DIR}/AdGuardHome.yaml"
		return 0
	fi
	if [ -e "${TARGET_WORK_DIR}/AdGuardHome.yaml" ] || [ -L "${TARGET_WORK_DIR}/AdGuardHome.yaml" ]; then
		valid_yaml_source_path "${TARGET_WORK_DIR}/AdGuardHome.yaml" || return 1
		SOURCE_CONFIG_FILE="${TARGET_WORK_DIR}/AdGuardHome.yaml"
		return 0
	fi
	if [ -e "$LEGACY_ROOT_CONFIG" ] || [ -L "$LEGACY_ROOT_CONFIG" ]; then
		valid_yaml_source_path "$LEGACY_ROOT_CONFIG" || return 1
		SOURCE_CONFIG_FILE="$LEGACY_ROOT_CONFIG"
		return 0
	fi

	SOURCE_CONFIG_FILE="$DEFAULT_CONFIG_FILE"
}

resume_paused_official() {
	local running_rc=0
	[ "$OFFICIAL_PAUSED" = 1 ] || return 0
	# The coordinator normally repairs external TLS file access while preparing
	# a start.  Installation resumes the already-running official service
	# directly, so perform that same YAML-driven preparation explicitly first.
	# The managed UCI/YAML transaction is already committed here.  From this
	# point onward, every failure must leave the core stopped instead of letting
	# cleanup_all perform an unchecked lower-service restart.
	OFFICIAL_PAUSED=0
	if ! run_bounded 20 2 /etc/init.d/AdGuardHome tls_prepare \
		>/dev/null 2>&1; then
		echo "Unable to prepare AdGuard Home TLS access; the service remains stopped." >&2
		return 1
	fi
	run_bounded 20 2 /etc/init.d/adguardhome restart \
		>/dev/null 2>&1 || return 1
	run_bounded 5 1 /etc/init.d/adguardhome running \
		>/dev/null 2>&1 || running_rc=$?
	[ "$running_rc" = 0 ] || return 1
	if [ "$IS_UPGRADE" = 1 ] && [ "$UPGRADE_WAS_RUNNING" = 1 ]; then
		run_bounded 150 5 /etc/init.d/AdGuardHome do_redirect 1 \
			>/dev/null 2>&1 || return 1
	fi
}

pause_official_for_normalization() {
	local running_rc=0
	[ "$OFFICIAL_WAS_RUNNING" = 1 ] || return 0
	OFFICIAL_PAUSED=1
	if ! run_bounded 20 2 /etc/init.d/adguardhome stop \
		>/dev/null 2>&1; then
		echo "Unable to stop the running official AdGuard Home service before normalization." >&2
		return 1
	fi
	run_bounded 5 1 /etc/init.d/adguardhome running \
		>/dev/null 2>&1 || running_rc=$?
	case "$running_rc" in
		1) ;;
		0)
			echo "Official AdGuard Home is still running; refusing to copy its live configuration." >&2
			return 1
			;;
		*)
			echo "Unable to verify that official AdGuard Home stopped." >&2
			return 1
			;;
	esac
}

initialize_upper_options() {
	local enabled verbose redirect run_from_memory memory_writeback_interval

	if [ "$IMPORT_OFFICIAL" = 1 ]; then
		enabled="$OFFICIAL_ENABLED"
		verbose="$OFFICIAL_VERBOSE"
	else
		enabled="$(normalize_bool "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.enabled")")"
		verbose="$(normalize_bool "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.verbose")")"
	fi
	run_from_memory="$(normalize_bool "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.run_from_memory")")"
	memory_writeback_interval="$(normalize_memory_writeback_interval \
		"$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.memory_writeback_interval")")"
	set_upper_option enabled "$enabled" || return 1
	set_upper_option verbose "$verbose" || return 1
	set_upper_option run_from_memory "$run_from_memory" || return 1
	set_upper_option memory_writeback_interval "$memory_writeback_interval" || return 1
	set_upper_option workdir "$TARGET_WORK_DIR" || return 1

	if [ "$IMPORT_OFFICIAL" = 1 ]; then
		# Existing official installations may already integrate with dnsmasq or
		# own port 53.  Import them without changing that network policy.
		set_upper_option redirect none || return 1
	else
		redirect="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.redirect")"
		case "$redirect" in
			none|redirect|dnsmasq-upstream|exchange) ;;
			*) set_upper_option redirect dnsmasq-upstream || return 1 ;;
		esac
	fi

}

# Rewrite only the exchange-mode DNS port required to move dnsmasq back to 53.
# The active YAML is otherwise always authoritative for both DNS and Web ports.
rewrite_migrated_dns_port() {
	local chosen_port="$1" file="$2"
	local current original generated rc

	is_valid_dns_port "$chosen_port" || return 1
	valid_yaml_source_path "$file" || return 1
	current="$(yaml_get_section_value dns port "$file")"
	[ "$current" != "$chosen_port" ] || return 0
	new_private_temp yaml-dns-source || return 1
	original="$NEW_PRIVATE_TEMP"
	copy_yaml_bounded "$file" "$original" || return 1
	new_private_temp yaml-dns-result || return 1
	generated="$NEW_PRIVATE_TEMP"
	awk -v replacement="$chosen_port" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(count, s, i) { s=""; for (i=0; i<count; i++) s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for (i=1; i<=n; i++)
				if (line[i] ~ /^dns:[[:space:]]*($|#)/) { sections++; if (!first) first=i }
			if (sections != 1) exit 4
			last=n
			for (i=first+1; i<=n; i++) if (top(line[i])) { last=i-1; break }
			depth=0
			for (i=first+1; i<=last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d=indent(line[i]); if (!depth || d<depth) depth=d
			}
			if (!depth) exit 4
			for (i=first+1; i<=last; i++) {
				if (indent(line[i]) != depth) continue
				candidate=substr(line[i],depth+1)
				if (candidate ~ /^port:[[:space:]]*/) { matches++; key_line=i }
			}
			if (matches != 1) exit 4
			for (i=1; i<=n; i++) {
				if (i == key_line) print pad(depth) "port: " replacement
				else print line[i]
			}
		}' "$original" >"$generated"
	rc=$?
	[ "$rc" = 0 ] || return 1
	chown 0:0 "$generated" && chmod 0600 "$generated" || return 1
	bounded_regular_file "$generated" || return 1
	validate_yaml_candidate "$generated" "$TARGET_WORK_DIR" || {
		echo "AdGuard Home rejected migrated DNS port ${chosen_port}." >&2
		return 1
	}
	install_yaml_candidate "$generated" "$file" 0 || return 1
	echo "Migrated legacy exchange mode to YAML DNS port ${chosen_port}."
}

migrate_legacy_dns_port() {
	local redirect yaml_port legacy_port
	redirect="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.redirect")"
	[ "$redirect" != exchange ] || return 0
	yaml_port="$(yaml_get_section_value dns port "$TARGET_CONFIG_FILE")"
	if is_valid_port "$yaml_port"; then
		if [ "$(canonical_port "$yaml_port")" -eq 53 ] && [ "$redirect" != none ]; then
			echo "YAML DNS port 53 requires integration mode none." >&2
			return 1
		fi
		return 0
	fi
	legacy_port="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.dnsport")"
	if ! is_valid_dns_port "$legacy_port"; then
		echo "AdGuard Home YAML has no valid dns.port and no safe legacy value is available." >&2
		return 1
	fi
	rewrite_migrated_dns_port "$(canonical_port "$legacy_port")" "$TARGET_CONFIG_FILE"
}

migrate_exchange_mode() {
	local redirect chosen_port dnsmasq_port old_port yaml_port legacy_port

	redirect="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.redirect")"
	[ "$redirect" = exchange ] || return 0

	dnsmasq_port="$(uci -q get dhcp.@dnsmasq[0].port)"
	old_port="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.old_port")"
	legacy_port="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.dnsport")"
	yaml_port="$(yaml_get_section_value dns port "$TARGET_CONFIG_FILE")"
	if is_valid_dns_port "$dnsmasq_port"; then
		chosen_port="$dnsmasq_port"
	elif is_valid_dns_port "$old_port"; then
		chosen_port="$old_port"
	elif is_valid_dns_port "$legacy_port"; then
		chosen_port="$legacy_port"
	elif is_valid_dns_port "$yaml_port"; then
		chosen_port="$yaml_port"
	else
		chosen_port=53335
	fi

	chosen_port="$(canonical_port "$chosen_port")"
	rewrite_migrated_dns_port "$chosen_port" "$TARGET_CONFIG_FILE" || return 1
	set_upper_option redirect redirect || return 1

	if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 &&
	   [ "$(uci -q get dhcp.@dnsmasq[0].port)" != 53 ]; then
		uci -q set dhcp.@dnsmasq[0].port='53' || return 1
		DHCP_CHANGED=1
	fi
}

remove_obsolete_options() {
	local option

	for option in \
		configpath binpath logfile waitonboot core_version upxflag update_url hashpass \
		crontab upprotect backupfile backupwdpath lastworkdir lastlogfile \
		gfwupstream gfwlistmd5 ipsetlistmd5 hostsmd5 \
		dnsport httpport old_redirect old_port old_enabled ucitracktest; do
		delete_upper_option "$option" || return 1
	done
}

sync_official_config() {
	local enabled verbose

	enabled="$(normalize_bool "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.enabled")")"
	verbose="$(normalize_bool "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.verbose")")"
	ensure_lower_section || return 1
	set_lower_option enabled "$enabled" || return 1
	set_lower_option config_file "$TARGET_CONFIG_FILE" || return 1
	set_lower_option work_dir "$TARGET_WORK_DIR" || return 1
	set_lower_option verbose "$verbose" || return 1
	delete_lower_option config || return 1
	delete_lower_option workdir || return 1
}

remove_legacy_cron_jobs() {
	[ -f "$CRON_FILE" ] || return 0
	grep -Eq '/usr/share/AdGuardHome/(update_core|gfw2adg|gfwipset2adg|addhost|tailto)\.sh' "$CRON_FILE" || return 0

	sed -i \
		-e '/\/usr\/share\/AdGuardHome\/update_core\.sh/d' \
		-e '/\/usr\/share\/AdGuardHome\/gfw2adg\.sh/d' \
		-e '/\/usr\/share\/AdGuardHome\/gfwipset2adg\.sh/d' \
		-e '/\/usr\/share\/AdGuardHome\/addhost\.sh/d' \
		-e '/\/usr\/share\/AdGuardHome\/tailto\.sh/d' \
		"$CRON_FILE" || return 1
	/etc/init.d/cron reload >/dev/null 2>&1 || true
}

keep_active_config() {
	[ -z "$IPKG_INSTROOT" ] || return 0
	mkdir -p "${KEEP_FILE%/*}" || return 1
	touch "$KEEP_FILE" || return 1
	grep -Fqx "$TARGET_CONFIG_FILE" "$KEEP_FILE" 2>/dev/null || printf '%s\n' "$TARGET_CONFIG_FILE" >>"$KEEP_FILE"
	grep -Fqx "${SNAPSHOT_DIR}/" "$KEEP_FILE" 2>/dev/null || printf '%s/\n' "$SNAPSHOT_DIR" >>"$KEEP_FILE"
}

secure_active_config() {
	local target_data="${TARGET_WORK_DIR}/data"
	# APK preserves modified conffiles during upgrades, including their old
	# mode.  Enforce the official service's private-directory policy on the
	# active file after every clean install, import, and migration.
	chmod 0700 "$TARGET_WORK_DIR" || return 1
	chmod 0600 "$TARGET_CONFIG_FILE" || return 1
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		if [ ! -d "$target_data" ] || [ -L "$target_data" ]; then
			echo "Unsafe AdGuard Home data path '$target_data'; refusing to change it." >&2
			return 1
		fi
		chmod 0700 "$target_data" || return 1
	fi
}

remove_resolved_upgrade_candidate() {
	local candidate="$1"
	[ ! -e "$candidate" ] && [ ! -L "$candidate" ] && return 0
	if [ ! -f "$candidate" ] || [ -L "$candidate" ]; then
		echo "Unsafe resolved upgrade candidate '$candidate'; refusing to remove it." >&2
		return 1
	fi
	rm -f "$candidate"
}

refresh_luci_runtime() {
	[ -z "$IPKG_INSTROOT" ] || return 0

	# These are the two exact LuCI caches used by the 25.12.1 runtime.  Treat a
	# replaced module-cache path as an object instead of following a symlink.
	rm -f /tmp/luci-indexcache.* || return 1
	if [ -L /tmp/luci-modulecache ] || [ -f /tmp/luci-modulecache ]; then
		rm -f /tmp/luci-modulecache || return 1
	elif [ -d /tmp/luci-modulecache ]; then
		rm -rf /tmp/luci-modulecache/ || return 1
	fi
	[ ! -x /etc/init.d/rpcd ] ||
		/etc/init.d/rpcd reload >/dev/null 2>&1 || true
}

if [ "$IS_MAINTENANCE_UPGRADE" = 1 ]; then
	validate_maintenance_upgrade_marker || {
		echo "Unable to validate the AdGuard Home r1 maintenance upgrade." >&2
		exit 1
	}
	refresh_luci_runtime || exit 1
	INSTALL_COMMITTED=1
	trap - 0 HUP INT TERM
	exit 0
fi

ensure_no_official_pending_delta || exit 1
ensure_original_snapshot || exit 1
ensure_upper_section || exit 1
read_official_state || exit 1
load_upgrade_snapshot || {
	echo "Unable to validate the AdGuard Home v2.1 upgrade snapshot." >&2
	exit 1
}
select_migration_source || exit 1
TARGET_CONFIG_FILE="${TARGET_WORK_DIR}/AdGuardHome.yaml"
if [ "$IS_UPGRADE" = 1 ]; then
	if [ "$TARGET_WORK_DIR" != "$UPGRADE_SOURCE_WORK_DIR" ] ||
	   [ "$TARGET_CONFIG_FILE" != "$UPGRADE_SOURCE_CONFIG_FILE" ]; then
		echo "The active workdir changed after the v2.1 upgrade snapshot was captured." >&2
		exit 1
	fi
	restore_upgrade_yaml_snapshot || {
		echo "Unable to restore the active v2.1 YAML before migration." >&2
		exit 1
	}
	SOURCE_CONFIG_FILE="$TARGET_CONFIG_FILE"
	OFFICIAL_WAS_RUNNING="$UPGRADE_WAS_RUNNING"
fi
pause_official_for_normalization || exit 1
migrate_yaml "$SOURCE_CONFIG_FILE" "$TARGET_CONFIG_FILE" || exit 1
migrate_runtime_data "$DATA_SOURCE_WORK_DIR" "$TARGET_WORK_DIR" || exit 1
rewrite_migrated_workdir_pattern "$DATA_SOURCE_WORK_DIR" "$TARGET_WORK_DIR" \
	"$TARGET_CONFIG_FILE" || exit 1
secure_active_config || exit 1

if [ "$IMPORT_OFFICIAL" = 1 ] && [ "$OFFICIAL_WORK_DIR" != "$TARGET_WORK_DIR" ]; then
	echo "Existing official data remains in '$OFFICIAL_WORK_DIR'; managed workdir is now '$TARGET_WORK_DIR'."
fi

initialize_upper_options || exit 1
migrate_legacy_dns_port || exit 1
migrate_exchange_mode || exit 1
remove_obsolete_options || exit 1
sync_official_config || exit 1
remove_legacy_cron_jobs || exit 1
keep_active_config || exit 1

[ "$UPPER_CHANGED" = 0 ] || uci -q commit "$UCI_CONFIG" || exit 1
[ "$LOWER_CHANGED" = 0 ] || uci -q commit "$OFFICIAL_CONFIG" || exit 1
[ "$DHCP_CHANGED" = 0 ] || uci -q commit dhcp || exit 1

if [ -z "$IPKG_INSTROOT" ] && [ "$DHCP_CHANGED" = 1 ]; then
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
fi

restore_upgrade_workdir_metadata || {
	echo "Unable to restore the v2.1 workdir and YAML ownership after migration." >&2
	exit 1
}
resume_paused_official || exit 1

if [ "$IS_UPGRADE" = 1 ]; then
	remove_resolved_upgrade_candidate /etc/config/AdGuardHome.apk-new || exit 1
	remove_resolved_upgrade_candidate "${DEFAULT_CONFIG_FILE}.apk-new" || exit 1
	refresh_luci_runtime || exit 1
fi

create_upgrade_stopped_marker || {
	echo "Unable to preserve the stopped AdGuard Home upgrade state." >&2
	exit 1
}
INSTALL_COMMITTED=1
cleanup_runtime_artifacts || exit 1
trap - 0 HUP INT TERM

exit 0
