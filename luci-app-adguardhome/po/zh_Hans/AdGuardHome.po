"Language: zh_CN\n"

msgid "AdGuard Home"
msgstr "AdGuard Home"

msgid "Grant permissions for the AdGuard Home LuCI app"
msgstr "授予 AdGuard Home LuCI 应用权限"

msgid "The core is provided and updated by the official ImmortalWrt adguardhome package. Default web login: admin / admin."
msgstr "核心由 ImmortalWrt 官方 adguardhome 软件包提供和更新。默认网页登录用户名和密码为 admin / admin。"

msgid "Overview"
msgstr "概览"

msgid "Service status"
msgstr "服务状态"

msgid "Active storage"
msgstr "当前存储模式"

msgid "Memory"
msgstr "内存"

msgid "Persistent storage"
msgstr "持久化存储"

msgid "Persistent storage (memory fallback)"
msgstr "持久化存储（内存模式回退）"

msgid "Persistent storage (memory on next start)"
msgstr "持久化存储（下次启动使用内存）"

msgid "Running"
msgstr "运行中"

msgid "Not running"
msgstr "未运行"

msgid "Core version"
msgstr "核心版本"

msgid "Unknown"
msgstr "未知"

msgid "Unavailable"
msgstr "不可用"

msgid "Management interface"
msgstr "管理界面"

msgid "Open Web Interface"
msgstr "打开 Web 管理界面"

msgid "Enable AdGuard Home and click Save & Apply; the management interface becomes available after the service is running."
msgstr "请启用 AdGuard Home 并点击“保存并应用”；服务运行后方可打开管理界面。"

msgid "The YAML management endpoint is unavailable or invalid."
msgstr "YAML 中的管理端点不可用或无效。"

msgid "HTTP keeps the host used to access LuCI and uses the port from YAML http.address. HTTPS uses YAML tls.server_name and tls.port_https."
msgstr "HTTP 沿用访问 LuCI 时的主机地址并使用 YAML http.address 中的端口；HTTPS 使用 YAML tls.server_name 和 tls.port_https。"

msgid "Settings"
msgstr "设置"

msgid "General Settings"
msgstr "常规设置"

msgid "DNS Integration"
msgstr "DNS 集成"

msgid "Paths"
msgstr "路径"

msgid "Enable"
msgstr "启用"

msgid "DNS listening port (YAML)"
msgstr "DNS 监听端口（YAML）"

msgid "DNS redirect mode"
msgstr "DNS 重定向模式"

msgid "Choose how LAN DNS traffic is routed to the DNS port read dynamically from WORKDIR/AdGuardHome.yaml."
msgstr "选择如何将 LAN 的 DNS 流量转发到从 WORKDIR/AdGuardHome.yaml 动态读取的 DNS 端口。"

msgid "None"
msgstr "无"

msgid "Use AdGuard Home as dnsmasq upstream"
msgstr "将 AdGuard Home 用作 dnsmasq 上游"

msgid "Redirect LAN port 53 to AdGuard Home"
msgstr "将 LAN 的 53 端口重定向到 AdGuard Home"

msgid "Working directory"
msgstr "工作目录"

msgid "Runtime data is stored here. The YAML configuration is fixed at WORKDIR/AdGuardHome.yaml."
msgstr "运行数据存放于此目录；YAML 配置固定为 WORKDIR/AdGuardHome.yaml。"

msgid "Verbose logging"
msgstr "详细日志"

msgid "Run from memory"
msgstr "从内存运行"

msgid "At startup, copies the persistent data directory into RAM and runs the official core there. Normal stop or restart, and enabled periodic write-back, save a consistent checkpoint; an unexpected power loss can lose changes made since the last successful checkpoint."
msgstr "启动时把持久化 data 目录复制到内存，并让官方核心在内存副本中运行。正常停止、重启及已启用的周期回写都会保存一致性检查点；意外断电可能丢失自上次成功检查点之后的改动。"

msgid "Memory write-back interval (minutes)"
msgstr "内存数据回写周期（分钟）"

msgid "At each interval, the plugin briefly stops and restarts the official core and its DNS service to write a consistent data checkpoint to the persistent working directory. Each checkpoint writes to persistent storage; use 60 minutes or longer to reduce flash wear. Set 0 to disable periodic write-back; normal stop or restart still writes back."
msgstr "每到设定周期，插件会短暂停止并重启官方核心及其 DNS 服务，把一致性 data 检查点写回持久化工作目录。每次检查点都会写入持久化存储；建议设置为 60 分钟或更长以减少闪存磨损。设为 0 可停用周期回写，但正常停止或重启时仍会回写。"

msgid "Enter 0 to disable periodic write-back, or a whole number from 1 to 10080."
msgstr "请输入 0 以停用周期回写，或输入 1 到 10080 之间的整数。"

msgid "Management password"
msgstr "管理密码"

msgid "Changes the password for the admin account stored in AdGuardHome.yaml. The password is BCrypt-hashed in this browser and the plaintext is never sent to the router."
msgstr "修改 AdGuardHome.yaml 中 admin 账号的密码。密码会在本浏览器中进行 BCrypt 哈希，明文不会发送到路由器。"

msgid "Change Password"
msgstr "修改密码"

msgid "Change AdGuard Home Password"
msgstr "修改 AdGuard Home 密码"

msgid "Enter a new password for the admin account. Use at least 8 characters and no more than 72 UTF-8 bytes."
msgstr "请输入 admin 账号的新密码，至少 8 个字符，且不超过 72 个 UTF-8 字节。"

msgid "New password"
msgstr "新密码"

msgid "Confirm password"
msgstr "确认密码"

msgid "The YAML admin account is unavailable or ambiguous. Use the YAML editor to review the users section."
msgstr "YAML 中的 admin 账号不可用或存在歧义，请在 YAML 编辑器中检查 users 段。"

msgid "Unable to prepare the password change: %s"
msgstr "无法准备密码修改：%s"

msgid "The two passwords do not match."
msgstr "两次输入的密码不一致。"

msgid "The password must contain at least 8 characters."
msgstr "密码必须至少包含 8 个字符。"

msgid "The password exceeds the 72-byte BCrypt limit."
msgstr "密码超过 BCrypt 的 72 字节限制。"

msgid "Hashing the password securely in this browser…"
msgstr "正在本浏览器中安全地计算密码哈希……"

msgid "The server did not accept the password update job."
msgstr "服务器未接受密码更新任务。"

msgid "The password update was accepted and is being applied in the background."
msgstr "密码更新任务已接受，正在后台应用。"

msgid "The server rejected the password update."
msgstr "服务器拒绝了密码更新。"

msgid "The admin password was changed and AdGuard Home restarted successfully."
msgstr "admin 密码已修改，AdGuard Home 已成功重启。"

msgid "The admin password was changed."
msgstr "admin 密码已修改。"

msgid "Unable to finish the password change: %s"
msgstr "无法完成密码修改：%s"

msgid "Unable to change the password: %s"
msgstr "无法修改密码：%s"

msgid "The password update returned an unknown job state."
msgstr "密码更新任务返回了未知状态。"

msgid "The password update is still running, but its status is temporarily unavailable: %s. Do not submit it again; reload this page later."
msgstr "密码更新仍在运行，但暂时无法获取其状态：%s。请勿重复提交，稍后重新加载此页面。"

msgid "The password update is still running. Do not submit it again; reload this page later."
msgstr "密码更新仍在运行。请勿重复提交，稍后重新加载此页面。"

msgid "This field is required."
msgstr "此字段为必填项。"

msgid "Path must be absolute."
msgstr "必须使用绝对路径。"

msgid "The working directory must not be the filesystem root."
msgstr "工作目录不能是文件系统根目录。"

msgid "Path must not contain repeated slashes."
msgstr "路径不能包含连续的斜杠。"

msgid "Path must not end with a slash."
msgstr "路径不能以斜杠结尾。"

msgid "Path contains characters that are unsafe for the current service script."
msgstr "路径包含当前服务脚本不接受的字符。"

msgid "Path must not contain \".\" or \"..\" components."
msgstr "路径不能包含“.”或“..”路径段。"

msgid "The working directory must contain at least two path components below the filesystem root (for example, /etc/AdGuardHome)."
msgstr "工作目录必须在文件系统根目录下至少包含两级路径（例如 /etc/AdGuardHome）。"

msgid "Working directories under /tmp or /var are volatile on ImmortalWrt and are not allowed."
msgstr "ImmortalWrt 中 /tmp 或 /var 下的目录是易失存储，不能用作工作目录。"

msgid "Use /etc/AdGuardHome, an /etc/AdGuardHome-* directory, or a dedicated AdGuardHome[-*] directory below /mnt."
msgstr "请使用 /etc/AdGuardHome、/etc/AdGuardHome-*，或 /mnt 下以 AdGuardHome[-*] 命名的专用目录。"

msgid "Runtime Log"
msgstr "运行日志"

msgid "View recent service messages from the system log. This page is read-only."
msgstr "查看系统日志中的近期服务消息；此页面为只读。"

msgid "Lines:"
msgstr "行数："

msgid "%d lines"
msgstr "%d 行"

msgid "Refresh"
msgstr "刷新"

msgid "No log output."
msgstr "暂无日志输出。"

msgid "Showing up to %d lines (%d returned)."
msgstr "最多显示 %d 行（实际返回 %d 行）。"

msgid "Unable to read the runtime log: %s"
msgstr "无法读取运行日志：%s"

msgid "Unknown error"
msgstr "未知错误"

msgid "YAML Configuration"
msgstr "YAML 配置"

msgid "Edit the active AdGuard Home configuration file directly."
msgstr "直接编辑当前生效的 AdGuard Home 配置文件。"

msgid "Saving validates and atomically applies the YAML. A running service is restarted; a disabled service remains stopped."
msgstr "保存时会校验并原子应用 YAML；服务原本运行时会重启，原本停用时会保持停用。"

msgid "Path"
msgstr "路径"

msgid "A content hash prevents overwriting changes made after this page was loaded. If a conflict is reported, reload the file and merge your changes before saving. Invalid YAML is rejected without replacing the current file."
msgstr "内容哈希会防止覆盖页面加载后产生的新改动。若报告冲突，请重新载入文件并合并改动后再保存。无效 YAML 会被拒绝，不会替换当前文件。"

msgid "Validate, Save & Apply"
msgstr "校验、保存并应用"

msgid "Reload from disk"
msgstr "从磁盘重新载入"

msgid "Reset to Template"
msgstr "重置为模板"

msgid "Reset YAML to Template"
msgstr "将 YAML 重置为模板"

msgid "This overwrites every YAML-managed setting, including DNS, upstreams, filters, rewrites, DHCP, Web/TLS and certificate paths."
msgstr "此操作会覆盖所有由 YAML 管理的设置，包括 DNS、上游、过滤器、重写、DHCP、Web/TLS 和证书路径。"

msgid "The management login returns to admin / admin, DNS returns to port 53335, and the Web interface returns to HTTP port 3000. The persistent working directory, stored data, enable state, DNS mode and verbose setting are kept."
msgstr "管理登录将恢复为 admin / admin，DNS 恢复为 53335 端口，Web 界面恢复为 HTTP 3000 端口；持久化工作目录、已存数据、启用状态、DNS 模式和详细日志设置会保留。"

msgid "A running service will restart; a disabled service will remain stopped. Continue?"
msgstr "服务原本运行时会重启，原本停用时会保持停用。是否继续？"

msgid "The server did not accept the template reset job."
msgstr "服务器未接受模板重置任务。"

msgid "The template reset was accepted and is being applied in the background."
msgstr "模板重置任务已接受，正在后台应用。"

msgid "The server rejected the packaged YAML template."
msgstr "服务器拒绝了软件包自带的 YAML 模板。"

msgid "The YAML configuration was reset and AdGuard Home restarted successfully."
msgstr "YAML 配置已重置，AdGuard Home 已成功重启。"

msgid "The YAML configuration was reset to the packaged template."
msgstr "YAML 配置已重置为软件包自带模板。"

msgid "Unable to reset the YAML configuration: %s"
msgstr "无法重置 YAML 配置：%s"

msgid "Unable to read the YAML configuration: %s"
msgstr "无法读取 YAML 配置：%s"

msgid "The YAML configuration is unavailable."
msgstr "YAML 配置不可用。"

msgid "The YAML configuration was reloaded from disk."
msgstr "已从磁盘重新载入 YAML 配置。"

msgid "Save YAML Configuration"
msgstr "保存 YAML 配置"

msgid "The configuration will be validated and applied atomically. A running service will restart; a disabled service will remain stopped. Continue?"
msgstr "配置将接受校验并原子应用；服务原本运行时会重启，原本停用时会保持停用。是否继续？"

msgid "Cancel"
msgstr "取消"

msgid "The server rejected the YAML configuration. Check its syntax and protected settings."
msgstr "服务器拒绝了 YAML 配置。请检查语法及受保护的设置。"

msgid "The YAML configuration was saved and AdGuard Home restarted successfully."
msgstr "YAML 配置已保存，AdGuard Home 已成功重启。"

msgid "The YAML configuration was saved."
msgstr "YAML 配置已保存。"

msgid "The YAML configuration was saved, but the editor could not reload it: %s"
msgstr "YAML 配置已保存，但编辑器无法重新载入：%s"

msgid "The YAML configuration was reset, but the editor could not reload it: %s"
msgstr "YAML 配置已重置，但编辑器无法重新载入：%s"

msgid "Unable to save the YAML configuration: %s"
msgstr "无法保存 YAML 配置：%s"

msgid "If the file changed since it was loaded, reload it and merge your changes. Otherwise, check the YAML syntax and protected settings."
msgstr "若文件在加载后已发生变化，请重新载入并合并改动；否则请检查 YAML 语法和受保护的设置。"

msgid "The server did not accept the YAML update job."
msgstr "服务器未接受 YAML 更新任务。"

msgid "The YAML update was accepted and is being applied in the background."
msgstr "YAML 更新任务已接受，正在后台应用。"

msgid "The YAML update returned an unknown job state."
msgstr "YAML 更新任务返回了未知状态。"

msgid "The YAML update is still running, but its status is temporarily unavailable: %s. Do not submit it again; reload this page later."
msgstr "YAML 更新仍在运行，但暂时无法获取其状态：%s。请勿重复提交，稍后重新加载此页面。"

msgid "The YAML update is still running. Do not submit it again; reload this page later."
msgstr "YAML 更新仍在运行。请勿重复提交，稍后重新加载此页面。"

msgid "The YAML update outcome is unknown. Reload the page before editing it again."
msgstr "YAML 更新结果未知。再次编辑前请重新加载页面。"

msgid "The YAML update succeeded, but its result could not be verified. Reload the page before editing it again."
msgstr "YAML 更新已成功，但无法验证其结果。再次编辑前请重新加载页面。"

msgid "The template reset outcome is unknown. Reload the page before editing the YAML again."
msgstr "模板重置结果未知。再次编辑 YAML 前请重新加载页面。"

msgid "The template reset succeeded, but its result could not be verified. Reload the page before editing the YAML again."
msgstr "模板重置已成功，但无法验证其结果。再次编辑 YAML 前请重新加载页面。"
