#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

UCI_CONFIG="adguardhome"
OFFICIAL_SECTION="config"
LUCI_SECTION="luci"
DEFAULT_WORK_DIR="/etc/AdGuardHome"
PACKAGED_CONFIG_TEMPLATE="/usr/share/luci-app-adguardhome/default.yaml"
OFFICIAL_DEFAULT_CONFIG="/etc/adguardhome/adguardhome.yaml"
OFFICIAL_DEFAULT_WORK_DIR="/var/lib/adguardhome"
KEEP_FILE="/lib/upgrade/keep.d/luci-app-adguardhome"
SNAPSHOT_DIR="/root/.luci-app-adguardhome"
MANAGED_CONFIG_SNAPSHOT="$SNAPSHOT_DIR/managed-adguardhome.config"
RUNTIME_DIR="/var/run/luci-app-adguardhome"
MAX_FILE_SIZE=524288
ADGUARD_UID=853
ADGUARD_GID=853

TARGET_WORK_DIR=""
TARGET_CONFIG_FILE=""
SOURCE_WORK_DIR=""
SOURCE_CONFIG_FILE=""
USING_TEMPLATE=0
UCI_CHANGED=0
INSTALL_COMMITTED=0
INSTALL_STARTED=0
INSTALL_BACKUP=""
INSTALL_WAS_RUNNING=0
YAML_STAGE=""
INSTALL_TRANSACTION_DIR=""
TARGET_WORK_DIR_CREATED=0
YAML_ORIGINAL_ABSENT=0
DATA_ORIGINAL_ABSENT=0

# @include run-bounded

# @include private-files

bounded_regular_file() {
	local size
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	size="$(wc -c <"$1" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_FILE_SIZE" ]
}

normalize_bool() {
	case "$1" in
		1|on|true|yes|enabled) printf '1\n' ;;
		0|off|false|no|disabled) printf '0\n' ;;
		*) return 1 ;;
	esac
}

path_contains_symlink() {
	local value="$1" remaining component current=""
	case "$value" in /*) ;; *) return 1 ;; esac
	remaining="$(printf '%s\n' "$value" | sed 's:^/::')"
	while [ -n "$remaining" ]; do
		component="$(printf '%s\n' "$remaining" | cut -d/ -f1)"
		current="$current/$component"
		[ ! -L "$current" ] || return 0
		[ "$remaining" = "$component" ] && break
		remaining="$(printf '%s\n' "$remaining" | sed 's:^[^/]*/::')"
	done
	return 1
}

trim_trailing_slashes() {
	printf '%s\n' "$1" | sed 's:/*$::'
}

valid_managed_work_dir() {
	run_bounded 5 1 /etc/init.d/AdGuardHome check_work_dir "$1" \
		>/dev/null 2>&1
}

resolve_source_file() {
	local value="$1" resolved
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "$value/" in */./*|*/../*) return 1 ;; esac
	[ -f "$value" ] && [ ! -L "$value" ] || return 1
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	[ -f "$resolved" ] && [ ! -L "$resolved" ] || return 1
	case "$value" in
		/var/*|/tmp/*) case "$resolved" in /tmp/*) ;; *) return 1 ;; esac ;;
		*) ! path_contains_symlink "$value" || return 1 ;;
	esac
	printf '%s\n' "$resolved"
}

resolve_source_work_dir() {
	local value resolved
	value="$(trim_trailing_slashes "$1")" || return 1
	case "$value" in
		""|/|//*|*//*|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "$value" in /var/*|/tmp/*) ;; *) return 1 ;; esac
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	case "$resolved" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "$resolved" in /tmp/*) ;; *) return 1 ;; esac
	[ -d "$resolved" ] && [ ! -L "$resolved" ] || return 1
	printf '%s\n' "$resolved"
}

official_delta_is_clean() {
	local changes
	changes="$(uci -q changes adguardhome 2>/dev/null)" || return 1
	[ -z "$changes" ]
}

set_official_option() {
	local option="$1" value="$2" current
	current="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.$option")"
	[ "$current" = "$value" ] && return 0
	uci -q set "$UCI_CONFIG.$OFFICIAL_SECTION.$option=$value" || return 1
	UCI_CHANGED=1
}

ensure_luci_section() {
	local current
	current="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION")"
	[ "$current" = luci ] && return 0
	[ -z "$current" ] || return 1
	uci -q set "$UCI_CONFIG.$LUCI_SECTION=luci" || return 1
	UCI_CHANGED=1
}

set_luci_option() {
	local option="$1" value="$2" current
	current="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.$option")"
	[ "$current" = "$value" ] && return 0
	uci -q set "$UCI_CONFIG.$LUCI_SECTION.$option=$value" || return 1
	UCI_CHANGED=1
}

select_clean_install_source() {
	local configured_work configured_file packaged
	configured_work="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")"
	[ -n "$configured_work" ] || configured_work="$OFFICIAL_DEFAULT_WORK_DIR"
	configured_file="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.config_file")"
	[ -n "$configured_file" ] || configured_file="$OFFICIAL_DEFAULT_CONFIG"

	if valid_managed_work_dir "$configured_work"; then
		SOURCE_WORK_DIR=""
		TARGET_WORK_DIR="$(trim_trailing_slashes "$configured_work")" ||
			return 1
	else
		case "$configured_work" in
		/var/*|/tmp/*)
			if [ -e "$configured_work" ] || [ -L "$configured_work" ]; then
				SOURCE_WORK_DIR="$(resolve_source_work_dir "$configured_work")" ||
					return 1
			else
				SOURCE_WORK_DIR=""
			fi
			TARGET_WORK_DIR="$DEFAULT_WORK_DIR"
			;;
		*) return 1 ;;
		esac
	fi
	TARGET_CONFIG_FILE="$TARGET_WORK_DIR/AdGuardHome.yaml"

	if [ -e "$configured_file" ] || [ -L "$configured_file" ]; then
		SOURCE_CONFIG_FILE="$(resolve_source_file "$configured_file")" || return 1
	elif [ -e "$TARGET_CONFIG_FILE" ] || [ -L "$TARGET_CONFIG_FILE" ]; then
		SOURCE_CONFIG_FILE="$(resolve_source_file "$TARGET_CONFIG_FILE")" ||
			return 1
	else
		SOURCE_CONFIG_FILE="$(resolve_source_file "$PACKAGED_CONFIG_TEMPLATE")" ||
			return 1
	fi
	packaged="$(resolve_source_file "$PACKAGED_CONFIG_TEMPLATE")" || return 1
	if cmp -s "$SOURCE_CONFIG_FILE" "$packaged"; then
		USING_TEMPLATE=1
	else
		USING_TEMPLATE=0
	fi
}

initialize_clean_options() {
	local enabled verbose redirect
	enabled="$(normalize_bool "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.enabled")")" ||
		enabled=0
	verbose="$(normalize_bool "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.verbose")")" ||
		verbose=0
	if [ "$USING_TEMPLATE" = 1 ]; then
		redirect=dnsmasq-upstream
	else
		redirect=none
	fi
	set_official_option enabled "$enabled" &&
		set_official_option verbose "$verbose" &&
		set_official_option config_file "$TARGET_CONFIG_FILE" &&
		set_official_option work_dir "$TARGET_WORK_DIR" &&
		set_luci_option redirect "$redirect" &&
		set_luci_option run_from_memory 0 &&
		set_luci_option memory_writeback_interval 60
}

secure_target_work_dir() {
	valid_managed_work_dir "$TARGET_WORK_DIR" || return 1
	if [ ! -e "$TARGET_WORK_DIR" ] && [ ! -L "$TARGET_WORK_DIR" ]; then
		mkdir -p -m 0700 "$TARGET_WORK_DIR" &&
			chown 0:0 "$TARGET_WORK_DIR" && chmod 0700 "$TARGET_WORK_DIR" || return 1
		TARGET_WORK_DIR_CREATED=1
	fi
	[ -d "$TARGET_WORK_DIR" ] && [ ! -L "$TARGET_WORK_DIR" ]
}

install_transaction_dir_valid() {
	[ -n "$INSTALL_TRANSACTION_DIR" ] || return 1
	case "$INSTALL_TRANSACTION_DIR" in
		"$TARGET_WORK_DIR"/.luci-install.??????) ;;
		*) return 1 ;;
	esac
	root_private_directory "$INSTALL_TRANSACTION_DIR"
}

ensure_install_transaction_dir() {
	[ -z "$INSTALL_TRANSACTION_DIR" ] || {
		install_transaction_dir_valid
		return
	}
	INSTALL_TRANSACTION_DIR="$(mktemp -d "$TARGET_WORK_DIR/.luci-install.XXXXXX")" ||
		return 1
	chown 0:0 "$INSTALL_TRANSACTION_DIR" &&
		chmod 0700 "$INSTALL_TRANSACTION_DIR" &&
		install_transaction_dir_valid
}

install_selected_yaml() {
	local source="$SOURCE_CONFIG_FILE" target_stage old_yaml old_yaml_stage
	bounded_regular_file "$source" || return 1
	if [ -e "$RUNTIME_DIR" ] || [ -L "$RUNTIME_DIR" ]; then
		root_private_directory "$RUNTIME_DIR" || return 1
	else
		mkdir -m 0700 "$RUNTIME_DIR" || return 1
		chown 0:0 "$RUNTIME_DIR" && chmod 0700 "$RUNTIME_DIR" || return 1
	fi
	YAML_STAGE="$(mktemp "$RUNTIME_DIR/yaml-migration.XXXXXX")" || return 1
	chown 0:0 "$YAML_STAGE" && chmod 0600 "$YAML_STAGE" || return 1
	run_bounded 5 1 /bin/dd if="$source" of="$YAML_STAGE" \
		bs=4096 count=129 2>/dev/null || return 1
	bounded_regular_file "$YAML_STAGE" || return 1
	run_bounded 120 5 /etc/init.d/AdGuardHome normalize_config \
		"$YAML_STAGE" "$TARGET_WORK_DIR" >/dev/null 2>&1 || return 1
	chown 0:0 "$YAML_STAGE" && chmod 0600 "$YAML_STAGE" || return 1
	ensure_install_transaction_dir || return 1
	target_stage="$INSTALL_TRANSACTION_DIR/AdGuardHome.yaml.new"
	old_yaml="$INSTALL_TRANSACTION_DIR/AdGuardHome.yaml.old"
	old_yaml_stage="$INSTALL_TRANSACTION_DIR/AdGuardHome.yaml.old.new"
	[ ! -e "$target_stage" ] && [ ! -L "$target_stage" ] || return 1
	(umask 077; : >"$target_stage") || return 1
	run_bounded 5 1 /bin/dd if="$YAML_STAGE" of="$target_stage" \
		bs=4096 count=129 2>/dev/null || return 1
	chown 0:0 "$target_stage" && chmod 0600 "$target_stage" || return 1
	bounded_regular_file "$target_stage" && cmp -s "$YAML_STAGE" "$target_stage" ||
		return 1
	if [ -e "$TARGET_CONFIG_FILE" ] || [ -L "$TARGET_CONFIG_FILE" ]; then
		bounded_regular_file "$TARGET_CONFIG_FILE" || return 1
		[ ! -e "$old_yaml_stage" ] && [ ! -L "$old_yaml_stage" ] || return 1
		if ! run_bounded 5 1 /bin/cp -p "$TARGET_CONFIG_FILE" "$old_yaml_stage" ||
		   ! bounded_regular_file "$old_yaml_stage" ||
		   ! cmp -s "$TARGET_CONFIG_FILE" "$old_yaml_stage" ||
		   ! mv "$old_yaml_stage" "$old_yaml"; then
			rm -f "$old_yaml_stage"
			return 1
		fi
	else
		YAML_ORIGINAL_ABSENT=1
	fi
	mv -f "$target_stage" "$TARGET_CONFIG_FILE" || return 1
	bounded_regular_file "$TARGET_CONFIG_FILE" &&
		cmp -s "$YAML_STAGE" "$TARGET_CONFIG_FILE"
}

plain_data_tree() {
	local unsafe
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	[ -r /proc/self/mountinfo ] || return 1
	awk -v base="${1%/}" '
		$5 == base || index($5, base "/") == 1 { found = 1 }
		END { exit found ? 1 : 0 }
	' /proc/self/mountinfo || return 1
	unsafe="$(find "$1" -xdev \
		\( -type l -o -type b -o -type c -o -type p -o -type s \) \
		-print 2>/dev/null)" || return 1
	[ -z "$unsafe" ]
}

copy_official_data_if_needed() {
	local source_data target_data existing data_stage old_data
	[ -n "$SOURCE_WORK_DIR" ] || return 0
	source_data="$SOURCE_WORK_DIR/data"
	target_data="$TARGET_WORK_DIR/data"
	[ -e "$source_data" ] || return 0
	plain_data_tree "$source_data" || return 1
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		[ -d "$target_data" ] && [ ! -L "$target_data" ] || return 1
		existing="$(find "$target_data" -mindepth 1 -maxdepth 1 -print 2>/dev/null)" ||
			return 1
		[ -z "$existing" ] || {
			echo "Existing managed data was kept; official data was not merged."
			return 0
		}
	fi
	ensure_install_transaction_dir || return 1
	data_stage="$INSTALL_TRANSACTION_DIR/data.new"
	old_data="$INSTALL_TRANSACTION_DIR/data.old"
	[ ! -e "$data_stage" ] && [ ! -L "$data_stage" ] || return 1
	mkdir -m 0700 "$data_stage" || return 1
	cp -a "$source_data/." "$data_stage/" || return 1
	plain_data_tree "$data_stage" || return 1
	chown "$ADGUARD_UID:$ADGUARD_GID" "$data_stage" &&
		chmod 0700 "$data_stage" || return 1
	if [ -e "$target_data" ]; then
		mv "$target_data" "$old_data" || return 1
	else
		DATA_ORIGINAL_ABSENT=1
	fi
	mv "$data_stage" "$target_data" || return 1
	plain_data_tree "$target_data"
}

managed_config_is_valid() {
	local work config enabled verbose redirect memory interval changes
	[ "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION")" = adguardhome ] ||
		return 1
	[ "$(uci -q get "$UCI_CONFIG.$LUCI_SECTION")" = luci ] || return 1
	work="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")" || return 1
	config="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.config_file")" ||
		return 1
	valid_managed_work_dir "$work" || return 1
	[ "$config" = "$work/AdGuardHome.yaml" ] || return 1
	bounded_regular_file "$config" || return 1
	enabled="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.enabled")" || return 1
	verbose="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.verbose")" || return 1
	redirect="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.redirect")" || return 1
	memory="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.run_from_memory")" ||
		return 1
	interval="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.memory_writeback_interval")" ||
		return 1
	case "$enabled:$verbose:$memory" in [01]:[01]:[01]) ;; *) return 1 ;; esac
	case "$redirect" in none|dnsmasq-upstream|redirect) ;; *) return 1 ;; esac
	case "$interval" in ""|*[!0-9]*) return 1 ;; esac
	[ "$interval" -le 10080 ] || return 1
	changes="$(uci -q changes "$UCI_CONFIG" 2>/dev/null)" || return 1
	[ -z "$changes" ]
}

refresh_managed_config_snapshot() {
	local temporary
	if [ ! -e "$SNAPSHOT_DIR" ] && [ ! -L "$SNAPSHOT_DIR" ]; then
		mkdir -m 0700 "$SNAPSHOT_DIR" && chown 0:0 "$SNAPSHOT_DIR" || return 1
	fi
	root_private_directory "$SNAPSHOT_DIR" || return 1
	temporary="$(mktemp "$SNAPSHOT_DIR/.managed-adguardhome.config.XXXXXX")" ||
		return 1
	if ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! run_bounded 5 1 /bin/dd if=/etc/config/adguardhome of="$temporary" \
		bs=4096 count=129 2>/dev/null || ! bounded_private_file "$temporary" ||
	   ! mv -f "$temporary" "$MANAGED_CONFIG_SNAPSHOT"; then
		rm -f "$temporary"
		return 1
	fi
	bounded_private_file "$MANAGED_CONFIG_SNAPSHOT" &&
		cmp -s /etc/config/adguardhome "$MANAGED_CONFIG_SNAPSHOT"
}

# @include keep-active-config

capture_install_config() {
	local running_rc=0
	bounded_regular_file /etc/config/adguardhome && official_delta_is_clean || return 1
	INSTALL_BACKUP="$(mktemp /etc/config/.adguardhome.install.XXXXXX)" || return 1
	chown 0:0 "$INSTALL_BACKUP" && chmod 0600 "$INSTALL_BACKUP" || return 1
	run_bounded 5 1 /bin/dd if=/etc/config/adguardhome of="$INSTALL_BACKUP" \
		bs=4096 count=129 2>/dev/null || return 1
	bounded_private_file "$INSTALL_BACKUP" &&
		cmp -s /etc/config/adguardhome "$INSTALL_BACKUP" || return 1
	run_bounded 5 1 /etc/init.d/adguardhome running >/dev/null 2>&1 || running_rc=$?
	case "$running_rc" in
		0) INSTALL_WAS_RUNNING=1 ;;
		1) INSTALL_WAS_RUNNING=0 ;;
		*) return 1 ;;
	esac
}

restore_install_config() {
	local temporary
	bounded_private_file "$INSTALL_BACKUP" || return 1
	uci -q revert "$UCI_CONFIG" >/dev/null 2>&1 || true
	temporary="$(mktemp /etc/config/.adguardhome.rollback.XXXXXX)" || return 1
	if ! run_bounded 5 1 /bin/dd if="$INSTALL_BACKUP" of="$temporary" \
		bs=4096 count=129 2>/dev/null ||
	   ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! mv -f "$temporary" /etc/config/adguardhome; then
		rm -f "$temporary"
		return 1
	fi
	cmp -s "$INSTALL_BACKUP" /etc/config/adguardhome || return 1
}

restore_install_files() {
	local old_yaml old_data target_data
	[ -n "$INSTALL_TRANSACTION_DIR" ] || return 0
	install_transaction_dir_valid || return 1
	old_yaml="$INSTALL_TRANSACTION_DIR/AdGuardHome.yaml.old"
	old_data="$INSTALL_TRANSACTION_DIR/data.old"
	target_data="$TARGET_WORK_DIR/data"

	if [ -e "$old_yaml" ] || [ -L "$old_yaml" ]; then
		bounded_regular_file "$old_yaml" || return 1
		if [ -e "$TARGET_CONFIG_FILE" ] || [ -L "$TARGET_CONFIG_FILE" ]; then
			bounded_regular_file "$TARGET_CONFIG_FILE" &&
				bounded_regular_file "$YAML_STAGE" &&
				cmp -s "$YAML_STAGE" "$TARGET_CONFIG_FILE" || return 1
		fi
		mv -f "$old_yaml" "$TARGET_CONFIG_FILE" || return 1
	elif [ "$YAML_ORIGINAL_ABSENT" = 1 ] &&
	     { [ -e "$TARGET_CONFIG_FILE" ] || [ -L "$TARGET_CONFIG_FILE" ]; }; then
		bounded_regular_file "$TARGET_CONFIG_FILE" &&
			bounded_regular_file "$YAML_STAGE" &&
			cmp -s "$YAML_STAGE" "$TARGET_CONFIG_FILE" || return 1
		rm -f "$TARGET_CONFIG_FILE" || return 1
	fi

	if [ -e "$old_data" ] || [ -L "$old_data" ]; then
		[ -d "$old_data" ] && [ ! -L "$old_data" ] &&
			plain_data_tree "$old_data" || return 1
		if [ -e "$target_data" ] || [ -L "$target_data" ]; then
			[ -d "$target_data" ] && [ ! -L "$target_data" ] &&
				plain_data_tree "$target_data" || return 1
			rm -rf "$target_data" || return 1
		fi
		mv "$old_data" "$target_data" || return 1
	elif [ "$DATA_ORIGINAL_ABSENT" = 1 ] &&
	     { [ -e "$target_data" ] || [ -L "$target_data" ]; }; then
		[ -d "$target_data" ] && [ ! -L "$target_data" ] &&
			plain_data_tree "$target_data" || return 1
		rm -rf "$target_data" || return 1
	fi
}

discard_install_transaction() {
	[ -n "$INSTALL_TRANSACTION_DIR" ] || return 0
	install_transaction_dir_valid || return 1
	plain_data_tree "$INSTALL_TRANSACTION_DIR" || return 1
	rm -rf "$INSTALL_TRANSACTION_DIR" || return 1
	[ ! -e "$INSTALL_TRANSACTION_DIR" ] && [ ! -L "$INSTALL_TRANSACTION_DIR" ] ||
		return 1
	INSTALL_TRANSACTION_DIR=""
}

cleanup_install() {
	local rc=$? restored=1
	if [ "$INSTALL_STARTED" = 1 ] && [ "$INSTALL_COMMITTED" != 1 ]; then
		restore_install_files || restored=0
		restore_install_config || restored=0
		if [ "$restored" = 1 ] && [ "$INSTALL_WAS_RUNNING" = 1 ]; then
			run_bounded 20 2 /etc/init.d/adguardhome start \
				>/dev/null 2>&1 || restored=0
		fi
		[ "$restored" = 1 ] && discard_install_transaction || restored=0
		if [ "$restored" != 1 ]; then
			echo "Unable to restore installation settings; recovery files were kept." >&2
			exit 1
		fi
	fi
	[ -z "$YAML_STAGE" ] || rm -f "$YAML_STAGE" 2>/dev/null || true
	rmdir "$RUNTIME_DIR" 2>/dev/null || true
	if [ "$INSTALL_STARTED" = 1 ] && [ "$INSTALL_COMMITTED" != 1 ] &&
	   [ "$TARGET_WORK_DIR_CREATED" = 1 ]; then
		rmdir "$TARGET_WORK_DIR" 2>/dev/null || true
	fi
	[ -z "$INSTALL_BACKUP" ] || rm -f "$INSTALL_BACKUP"
	exit "$rc"
}
trap cleanup_install 0
trap 'exit 1' HUP INT TERM

if [ "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION")" != adguardhome ]; then
	echo "The official lowercase adguardhome configuration is unavailable." >&2
	exit 1
fi
official_delta_is_clean || {
	echo "Commit or revert pending official adguardhome changes first." >&2
	exit 1
}
if [ "$(uci -q get "$UCI_CONFIG.$LUCI_SECTION")" = luci ]; then
	managed_config_is_valid || {
		echo "The installed AdGuard Home configuration is invalid." >&2
		exit 1
	}
	TARGET_WORK_DIR="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")"
	TARGET_CONFIG_FILE="$TARGET_WORK_DIR/AdGuardHome.yaml"
	keep_active_config "$TARGET_CONFIG_FILE" "$SNAPSHOT_DIR" &&
		refresh_managed_config_snapshot || {
		echo "Unable to preserve the installed AdGuard Home configuration." >&2
		exit 1
	}
	INSTALL_COMMITTED=1
	trap - 0 HUP INT TERM
	exit 0
fi

select_clean_install_source || {
	echo "The official AdGuard Home source paths are outside the supported layout." >&2
	exit 1
}
capture_install_config || {
	echo "Unable to preserve settings for installation rollback." >&2
	exit 1
}
INSTALL_STARTED=1
run_bounded 20 2 /etc/init.d/adguardhome stop >/dev/null 2>&1 || {
	echo "Unable to stop the official AdGuard Home service for initialization." >&2
	exit 1
}
secure_target_work_dir && install_selected_yaml &&
	copy_official_data_if_needed || {
	echo "Unable to initialize the managed AdGuard Home work directory." >&2
	exit 1
}
ensure_luci_section && initialize_clean_options || exit 1
[ "$UCI_CHANGED" = 0 ] || uci -q commit "$UCI_CONFIG" || exit 1
managed_config_is_valid && keep_active_config "$TARGET_CONFIG_FILE" "$SNAPSHOT_DIR" &&
	refresh_managed_config_snapshot || {
	echo "Unable to validate the initialized AdGuard Home configuration." >&2
	exit 1
}
INSTALL_COMMITTED=1
discard_install_transaction ||
	echo "Unable to remove completed installation recovery files." >&2
exit 0
