// SPDX-License-Identifier: Apache-2.0

'use strict';

import { chmod, chown, lstat, lsdir, mkdir, open, popen, readfile, rename, stat, unlink } from 'fs';
import { sha256 } from 'digest';
import { connect } from 'ubus';
import { cursor } from 'uci';
import * as uloop from 'uloop';

const SERVICE_NAME = 'adguardhome';
const INSTANCE_NAME = 'adguardhome';
const VERSION_COMMAND = '/usr/bin/AdGuardHome --version 2>/dev/null';
const MAX_VERSION_LENGTH = 256;
const MAX_CONFIG_LENGTH = 512 * 1024;
const MAX_LOG_LENGTH = 512 * 1024;
const YAML_UPDATE_COMMAND = '/etc/init.d/AdGuardHome';
const YAML_JOB_DIRECTORY = '/var/run/luci-app-adguardhome-yaml';
const YAML_JOB_LOCK = `${YAML_JOB_DIRECTORY}/update.lock`;
const YAML_MAINTENANCE_MARKER = `${YAML_JOB_DIRECTORY}/removing`;
const YAML_JOB_STATE_LIMIT = 256;
const CONFIG_NAME = 'AdGuardHome';
const CONFIG_SECTION = 'AdGuardHome';
const CONFIG_FILENAME = 'AdGuardHome.yaml';
const TEMPLATE_DIRECTORY = '/usr/share/luci-app-adguardhome';
const TEMPLATE_PATH = `${TEMPLATE_DIRECTORY}/default.yaml`;
const MEMORY_RUNTIME_DIRECTORY = '/tmp/luci-app-adguardhome-memory';
const MEMORY_WORK_DIRECTORY = `${MEMORY_RUNTIME_DIRECTORY}/work`;
const MEMORY_CONFIG_PATH = `${MEMORY_WORK_DIRECTORY}/${CONFIG_FILENAME}`;
const MEMORY_STATE_PATH = `${MEMORY_RUNTIME_DIRECTORY}/state`;
const ADGUARD_UID = 853;
const ADGUARD_GID = 853;

function valid_work_dir(value, official_work_dir, official_config_file) {
	if (type(value) != 'string' ||
	    !match(value, /^\/[A-Za-z0-9_./+@%:,=-]+$/) ||
	    match(value, /\/\//) ||
	    substr(value, length(value) - 1, 1) == '/')
		return null;

	let components = split(substr(value, 1), '/');
	if (length(components) < 2 || value == '/tmp' || match(value, /^\/tmp\//) ||
	    value == '/var' || match(value, /^\/var\//))
		return null;
	if (!match(value, /^\/etc\/AdGuardHome(-[A-Za-z0-9_.+@%:,=-]+)?$/) &&
	    !match(value, /^\/mnt\/([A-Za-z0-9_.+@%:,=-]+\/)+AdGuardHome(-[A-Za-z0-9_.+@%:,=-]+)?$/))
		return null;

	let current = '';
	let final_metadata = null;
	for (let component in components) {
		if (!length(component) || component == '.' || component == '..')
			return null;

		current += `/${component}`;
		let metadata = lstat(current);
		if (metadata?.type == 'link')
			return null;
		// Custom /mnt locations are allowed only below trusted mountpoint
		// ancestors.  The leaf itself is normally owned by uid 853, but every
		// existing ancestor that can redirect or replace it must be a root-owned,
		// non-group/world-writable directory.
		if (match(value, /^\/mnt\//) && current != value && metadata &&
		    (metadata.type != 'directory' || metadata.uid != 0 ||
		     metadata.perm?.group_write || metadata.perm?.other_write))
			return null;
		if (current == value)
			final_metadata = metadata;
	}
	if (final_metadata && final_metadata.type != 'directory')
		return null;
	if (value != '/etc/AdGuardHome' && final_metadata &&
	    (official_work_dir != value ||
	     official_config_file != `${value}/${CONFIG_FILENAME}`))
		return null;

	return value;
}

function encoded_device(metadata) {
	let major = metadata?.dev?.major;
	let minor = metadata?.dev?.minor;
	if (type(major) != 'int' || type(minor) != 'int' || major < 0 || minor < 0)
		return null;

	// Linux gnu_dev_makedev(), expressed arithmetically to avoid 32-bit bitwise
	// truncation in JavaScript-compatible runtimes.
	return (minor % 256) + (major % 4096) * 256 +
		int(minor / 256) * 1048576 + int(major / 4096) * 17592186044416;
}

function same_inode(left, right) {
	return left?.type == 'file' && right?.type == 'file' &&
		left.inode == right.inode &&
		left.dev?.major == right.dev?.major &&
		left.dev?.minor == right.dev?.minor;
}

function memory_config_path(persistent_work_dir) {
	if (!valid_work_dir(
		persistent_work_dir,
		persistent_work_dir,
		`${persistent_work_dir}/${CONFIG_FILENAME}`
	    ))
		return null;

	let runtime = lstat(MEMORY_RUNTIME_DIRECTORY);
	let active = lstat(MEMORY_WORK_DIRECTORY);
	let config = lstat(MEMORY_CONFIG_PATH);
	let data = lstat(`${MEMORY_WORK_DIRECTORY}/data`);
	let backing = lstat(persistent_work_dir);
	if (runtime?.type != 'directory' || runtime.uid != 0 ||
	    runtime.gid != ADGUARD_GID || runtime.mode != 0o710 ||
	    active?.type != 'directory' || active.uid != ADGUARD_UID ||
	    active.gid != ADGUARD_GID || active.mode != 0o700 ||
	    data?.type != 'directory' || data.uid != ADGUARD_UID ||
	    data.gid != ADGUARD_GID || data.mode != 0o700 ||
	    backing?.type != 'directory' || backing.mode != 0o700 ||
	    !((backing.uid == 0 && (backing.gid == 0 || backing.gid == ADGUARD_GID)) ||
	      (backing.uid == ADGUARD_UID && backing.gid == ADGUARD_GID)) ||
	    config?.type != 'file' || config.nlink != 1 || config.size <= 0 ||
	    config.size > MAX_CONFIG_LENGTH ||
	    !((config.uid == ADGUARD_UID && config.gid == ADGUARD_GID &&
	       (config.mode == 0o600 || config.mode == 0o640)) ||
	      (config.uid == 0 && config.gid == ADGUARD_GID && config.mode == 0o640)))
		return null;

	let file = null;
	try {
		let before = lstat(MEMORY_STATE_PATH);
		if (before?.type != 'file' || before.uid != 0 || before.gid != 0 ||
		    before.mode != 0o600 || before.nlink != 1 || before.size <= 0 ||
		    before.size > 1024)
			return null;

		file = open(MEMORY_STATE_PATH, 'r');
		if (!file)
			return null;
		let descriptor = file.fileno();
		let opened = type(descriptor) == 'int'
			? stat(`/proc/self/fd/${descriptor}`)
			: null;
		let content = file.read(1025);
		let after = lstat(MEMORY_STATE_PATH);
		let lines = type(content) == 'string' ? split(content, '\n') : [];
		let backing_device = encoded_device(backing);
		let valid = same_inode(before, opened) && same_inode(before, after) &&
			opened.uid == 0 && opened.gid == 0 && opened.mode == 0o600 &&
			opened.nlink == 1 && after.uid == 0 && after.gid == 0 &&
			after.mode == 0o600 && after.nlink == 1 &&
			before.size == opened.size && before.size == after.size &&
			length(content) == opened.size && length(lines) == 5 &&
			lines[0] == 'version=2' &&
			lines[1] == `persistent_work_dir=${persistent_work_dir}` &&
			type(backing_device) == 'int' &&
			lines[2] == `backing_device=${backing_device}` &&
			lines[3] == `backing_inode=${backing.inode}` &&
			lines[4] == '';
		if (!file.close())
			valid = false;
		file = null;
		return valid ? MEMORY_CONFIG_PATH : null;
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		return null;
	}
}

function config_path() {
	let uci = null;
	let work_dir = null;

	try {
		uci = cursor();
		let official_work_dir = uci.get('adguardhome', 'config', 'work_dir') ||
			uci.get('adguardhome', 'config', 'workdir');
		let official_config_file = uci.get('adguardhome', 'config', 'config_file');
		let configured_work_dir = uci.get(CONFIG_NAME, CONFIG_SECTION, 'workdir');
		let memory_namespace = lstat(MEMORY_RUNTIME_DIRECTORY);
		let active_path = memory_config_path(configured_work_dir);
		if (active_path) {
			// A valid root-private state record is authoritative for this boot.
			// Lower UCI may briefly expose the backing paths while the init wrapper
			// commits TLS or service fields; never open the stale disk YAML then.
			work_dir = MEMORY_WORK_DIRECTORY;
		}
		else if (memory_namespace ||
		         official_work_dir == MEMORY_WORK_DIRECTORY ||
		         official_config_file == MEMORY_CONFIG_PATH) {
			// A present but invalid RAM namespace is a corruption state, not an
			// absent feature.  Never fall back to the stale backing YAML while the
			// init transaction temporarily exposes persistent lower-UCI paths.
			work_dir = null;
		}
		else {
			work_dir = valid_work_dir(
				configured_work_dir,
				official_work_dir,
				official_config_file
			);
		}
	}
	catch (error) {
		work_dir = null;
	}

	if (uci) {
		try {
			uci.unload(CONFIG_NAME);
			uci.unload('adguardhome');
		}
		catch (error) {
			// Failure to unload a read-only cursor does not alter the result.
		}
	}

	return work_dir ? `${work_dir}/${CONFIG_FILENAME}` : null;
}

function service_running() {
	let connection = null;
	let service = null;

	try {
		connection = connect();
		if (connection)
			service = connection.call('service', 'list', { name: SERVICE_NAME });
	}
	catch (error) {
		service = null;
	}

	if (connection) {
		try {
			connection.disconnect();
		}
		catch (error) {
			// A failed disconnect does not change the status result.
		}
	}

	return service?.[SERVICE_NAME]?.instances?.[INSTANCE_NAME]?.running === true;
}

function service_status() {
	let requested = false;
	let active = config_path() == MEMORY_CONFIG_PATH;
	let uci = null;

	try {
		uci = cursor();
		let value = lc(`${uci.get(CONFIG_NAME, CONFIG_SECTION, 'run_from_memory') || ''}`);
		requested = value == '1' || value == 'on' || value == 'true' ||
			value == 'yes' || value == 'enabled';
	}
	catch (error) {
		requested = false;
	}
	if (uci) {
		try { uci.unload(CONFIG_NAME); }
		catch (error) { }
	}

	return {
		running: service_running(),
		memory_requested: requested,
		memory_active: active,
	};
}

function read_yaml() {
	let path = config_path();
	let file = null;
	let content = null;
	let digest = null;
	let descriptor = null;
	let before = null;
	let opened = null;
	let after = null;
	let valid = false;

	try {
		before = path ? lstat(path) : null;
		if (!before || before.type != 'file' || before.size <= 0 ||
		    before.size > MAX_CONFIG_LENGTH)
			return null;

		file = open(path, 'r');
		if (!file)
			return null;

		descriptor = file.fileno();
		opened = type(descriptor) == 'int'
			? stat(`/proc/self/fd/${descriptor}`)
			: null;
		content = file.read(MAX_CONFIG_LENGTH + 1);
		digest = type(content) == 'string' ? sha256(content) : null;
		// Keep the descriptor open until the pathname has been checked again.
		// This proves that the bytes read came from the same inode observed at
		// both pathname checks, even if the uid-853 work directory is renamed.
		after = lstat(path);
		valid = opened?.type == 'file' && after?.type == 'file' &&
			before.inode == opened.inode && before.inode == after.inode &&
			before.dev?.major == opened.dev?.major &&
			before.dev?.minor == opened.dev?.minor &&
			before.dev?.major == after.dev?.major &&
			before.dev?.minor == after.dev?.minor &&
			before.size == opened.size && before.size == after.size &&
			type(content) == 'string' && length(content) > 0 &&
			length(content) <= MAX_CONFIG_LENGTH &&
			length(content) == opened.size && !!digest;
		if (!file.close())
			valid = false;
		file = null;
	}
	catch (error) {
		if (file) {
			try {
				file.close();
			}
			catch (close_error) {
				// Report the YAML as unavailable if cleanup also fails.
			}
		}

		return null;
	}

	if (!valid)
		return null;

	return { content, sha256: digest, path };
}

function safe_template_directory(path, shared_ancestor) {
	let metadata = lstat(path);
	// Some ImmortalWrt images expose the shared /usr ancestors as 0777.  They
	// are not owned by this package, so accept their write bits while still
	// requiring real root-owned directories.  The package-private directory
	// remains non-writable to group/other and the leaf is inode-checked below.
	return metadata?.type == 'directory' && metadata.uid == 0 && metadata.gid == 0 &&
		(shared_ancestor === true ||
		 (!metadata.perm?.group_write && !metadata.perm?.other_write));
}

function read_template() {
	let file = null;
	let content = null;
	let descriptor = null;
	let before = null;
	let opened = null;
	let after = null;
	let valid = false;

	try {
		for (let directory in [ '/usr', '/usr/share' ])
			if (!safe_template_directory(directory, true))
				return null;
		if (!safe_template_directory(TEMPLATE_DIRECTORY, false))
			return null;

		before = lstat(TEMPLATE_PATH);
		if (before?.type != 'file' || before.uid != 0 || before.gid != 0 ||
		    before.mode != 0o644 || before.nlink != 1 || before.size <= 0 ||
		    before.size > MAX_CONFIG_LENGTH)
			return null;

		file = open(TEMPLATE_PATH, 'r');
		if (!file)
			return null;

		descriptor = file.fileno();
		opened = type(descriptor) == 'int'
			? stat(`/proc/self/fd/${descriptor}`)
			: null;
		content = file.read(MAX_CONFIG_LENGTH + 1);
		after = lstat(TEMPLATE_PATH);
		valid = same_inode(before, opened) && same_inode(before, after) &&
			opened.uid == 0 && opened.gid == 0 && opened.mode == 0o644 &&
			opened.nlink == 1 && after.uid == 0 && after.gid == 0 &&
			after.mode == 0o644 && after.nlink == 1 &&
			before.size == opened.size && before.size == after.size &&
			type(content) == 'string' && length(content) == opened.size &&
			length(content) > 0 && length(content) <= MAX_CONFIG_LENGTH &&
			index(content, "\u0000") < 0;
		if (!file.close())
			valid = false;
		file = null;
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		return null;
	}

	return valid ? content : null;
}

function template_for_path(path) {
	if (type(path) != 'string' ||
	    !match(path, /^\/[A-Za-z0-9_./+@%:,=-]+\/AdGuardHome\.yaml$/))
		return null;

	let suffix = `/${CONFIG_FILENAME}`;
	if (substr(path, length(path) - length(suffix), length(suffix)) != suffix)
		return null;

	return read_template();
}

function read_config() {
	let result = read_yaml();
	return result ? replace(result.content, /\r\n?/g, '\n') : null;
}

function requested_log_lines(value) {
	if (type(value) != 'int' || value <= 100)
		return 100;
	if (value <= 300)
		return 300;
	return 500;
}

function read_log(value) {
	let requested = requested_log_lines(value);
	let pipe = null;
	let output = null;
	let status = -1;

	try {
		// ImmortalWrt 25.12.1's ucode popen() accepts a command string only.
		// The sole interpolation has already been reduced to one of three
		// decimal literals; every other byte is a fixed constant.  Filter
		// before tailing because logread applies its own -l limit before -e.
		pipe = popen(
			`set -o pipefail; /sbin/logread -e '[Aa]d[Gg]uard[Hh]ome' | /usr/bin/tail -n ${requested}`,
			'r'
		);
		if (!pipe)
			return { log: '', lines: 0 };

		output = pipe.read(MAX_LOG_LENGTH + 1);
		status = pipe.close();
		pipe = null;
	}
	catch (error) {
		if (pipe) {
			try {
				pipe.close();
			}
			catch (close_error) {
				// Ignore cleanup errors and return an empty bounded result.
			}
		}

		return { log: '', lines: 0 };
	}

	if (status != 0 || type(output) != 'string')
		return { log: '', lines: 0 };

	if (length(output) > MAX_LOG_LENGTH) {
		output = substr(output, length(output) - MAX_LOG_LENGTH);
		let newline = index(output, '\n');
		if (newline >= 0)
			output = substr(output, newline + 1);
	}

	let actual = 0;
	for (let line in split(output, '\n'))
		if (length(line))
			actual++;

	return { log: output, lines: actual };
}

function random_token() {
	let file = null;
	let bytes = null;

	try {
		file = open('/dev/urandom', 'r');
		if (!file)
			return null;

		bytes = file.read(16);
		file.close();
		file = null;
	}
	catch (error) {
		if (file) {
			try {
				file.close();
			}
			catch (close_error) {
				// Ignore cleanup errors and report random generation failure.
			}
		}

		return null;
	}

	return type(bytes) == 'string' && length(bytes) == 16 ? hexenc(bytes) : null;
}

function yaml_job_path(token) {
	return type(token) == 'string' && match(token, /^[0-9a-f]{32}$/)
		? `${YAML_JOB_DIRECTORY}/${token}`
		: null;
}

function root_private_directory(metadata) {
	return metadata?.type == 'directory' && metadata.uid == 0 &&
		metadata.gid == 0 && metadata.mode == 0o700;
}

function root_private_file(metadata) {
	return metadata?.type == 'file' && metadata.uid == 0 && metadata.gid == 0 &&
		metadata.mode == 0o600 && metadata.nlink == 1 &&
		metadata.size > 0 && metadata.size <= YAML_JOB_STATE_LIMIT;
}

function root_private_temporary_file(metadata) {
	return metadata?.type == 'file' && metadata.uid == 0 && metadata.gid == 0 &&
		metadata.mode == 0o600 && metadata.nlink == 1 &&
		metadata.size >= 0 && metadata.size <= YAML_JOB_STATE_LIMIT;
}

function root_private_lock_file(metadata) {
	return metadata?.type == 'file' && metadata.uid == 0 && metadata.gid == 0 &&
		metadata.mode == 0o600 && metadata.nlink == 1 && metadata.size == 0;
}

function ensure_yaml_job_directory() {
	let metadata = lstat(YAML_JOB_DIRECTORY);
	if (metadata)
		return root_private_directory(metadata);

	if (!mkdir(YAML_JOB_DIRECTORY, 0o700))
		return root_private_directory(lstat(YAML_JOB_DIRECTORY));
	if (!chown(YAML_JOB_DIRECTORY, 0, 0) || !chmod(YAML_JOB_DIRECTORY, 0o700))
		return false;

	return root_private_directory(lstat(YAML_JOB_DIRECTORY));
}

function open_yaml_job_lock() {
	let metadata = null;
	let opened = null;
	let file = null;
	let descriptor = null;
	let created = false;

	if (!ensure_yaml_job_directory())
		return { error: 'YAML update state is unavailable' };

	metadata = lstat(YAML_JOB_LOCK);
	if (metadata && !root_private_lock_file(metadata))
		return { error: 'YAML update lock is unsafe' };

	try {
		file = open(YAML_JOB_LOCK, metadata ? 'r+' : 'wx', 0o600);
		created = !!file && !metadata;
		if (!file && !metadata) {
			metadata = lstat(YAML_JOB_LOCK);
			if (root_private_lock_file(metadata))
				file = open(YAML_JOB_LOCK, 'r+', 0o600);
		}
		if (!file)
			return { error: 'YAML update lock is unavailable' };

		if (created &&
		    (!chown(YAML_JOB_LOCK, 0, 0) || !chmod(YAML_JOB_LOCK, 0o600))) {
			file.close();
			return { error: 'Unable to secure YAML update lock' };
		}

		metadata = lstat(YAML_JOB_LOCK);
		descriptor = file.fileno();
		opened = type(descriptor) == 'int'
			? stat(`/proc/self/fd/${descriptor}`)
			: null;
		if (!root_private_lock_file(metadata) || !same_inode(metadata, opened) ||
		    descriptor < 3 || descriptor == 1000) {
			file.close();
			return { error: 'YAML update lock is unsafe' };
		}

		if (!file.lock('xn')) {
			file.close();
			return { busy: true };
		}
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		return { error: 'YAML update lock failed' };
	}

	return { file, descriptor };
}

function parse_yaml_job_state(content) {
	if (type(content) != 'string' || !length(content) ||
	    length(content) > YAML_JOB_STATE_LIMIT)
		return null;

	let fields = match(content,
		/^pending:([0-9a-f]{64}):([0-9a-f]{64})\n$/);
	if (fields)
		return {
			state: 'pending',
			expected_hash: fields[1],
			candidate_hash: fields[2],
		};

	fields = match(content,
		/^running:([1-9][0-9]*):([0-9a-f]{64}):([0-9a-f]{64})\n$/);
	if (fields)
		return {
			state: 'running',
			pid: fields[1],
			expected_hash: fields[2],
			candidate_hash: fields[3],
		};

	fields = match(content,
		/^success:([0-9a-f]{64}):([01]):([0-9a-f]{64}):([0-9a-f]{64})\n$/);
	if (fields)
		return {
			state: 'success',
			sha256: fields[1],
			restarted: fields[2] == '1',
			expected_hash: fields[3],
			candidate_hash: fields[4],
		};

	fields = match(content,
		/^failure:([0-9a-f]{64}):([0-9a-f]{64})\n$/);
	if (fields)
		return {
			state: 'failure',
			expected_hash: fields[1],
			candidate_hash: fields[2],
		};

	fields = match(content,
		/^indeterminate:([0-9a-f]{64}):([0-9a-f]{64})\n$/);
	if (fields)
		return {
			state: 'indeterminate',
			expected_hash: fields[1],
			candidate_hash: fields[2],
		};

	return null;
}

function read_yaml_job(token) {
	let path = yaml_job_path(token);
	if (!path || !root_private_directory(lstat(YAML_JOB_DIRECTORY)))
		return null;

	let metadata = lstat(path);
	if (!root_private_file(metadata))
		return null;

	return parse_yaml_job_state(readfile(path, YAML_JOB_STATE_LIMIT + 1));
}

function yaml_job_active() {
	let metadata = lstat(YAML_JOB_DIRECTORY);
	if (!metadata)
		return false;
	if (!root_private_directory(metadata))
		return true;

	let entries = lsdir(YAML_JOB_DIRECTORY);
	if (type(entries) != 'array')
		return true;
	for (let name in entries) {
		if (name == 'update.lock')
			continue;
		if (name == 'removing')
			return true;
		if (!match(name, /^[0-9a-f]{32}$/))
			return true;
		let record = read_yaml_job(name);
		if (!record || record.state == 'pending' || record.state == 'running')
			return true;
	}

	return false;
}

function write_new_yaml_job(token, expected_hash, candidate_hash) {
	let path = yaml_job_path(token);
	let suffix = random_token();
	let temporary = path && suffix ?
		`${YAML_JOB_DIRECTORY}/.${token}.rpcd-${suffix}` : null;
	let content = `pending:${expected_hash}:${candidate_hash}\n`;
	let file = null;
	let created = false;

	if (!temporary || !ensure_yaml_job_directory())
		return false;

	try {
		file = open(temporary, 'wx', 0o600);
		created = !!file;
		if (!file || file.write(content) != length(content) || !file.flush()) {
			if (file)
				file.close();
			if (created)
				unlink(temporary);
			return false;
		}
		if (!file.close()) {
			file = null;
			unlink(temporary);
			return false;
		}
		file = null;
		if (!root_private_file(lstat(temporary)) ||
		    !parse_yaml_job_state(readfile(temporary, YAML_JOB_STATE_LIMIT + 1)) ||
		    lstat(path) || !rename(temporary, path)) {
			unlink(temporary);
			return false;
		}
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		if (created)
			unlink(temporary);
		return false;
	}

	let valid = root_private_file(lstat(path)) &&
		!!parse_yaml_job_state(readfile(path, YAML_JOB_STATE_LIMIT + 1));
	if (!valid && root_private_file(lstat(path)))
		unlink(path);

	return valid;
}

function replace_yaml_job(token, content) {
	let path = yaml_job_path(token);
	let suffix = random_token();
	let temporary = path && suffix ?
		`${YAML_JOB_DIRECTORY}/.${token}.rpcd-${suffix}` : null;
	let file = null;
	let created = false;

	if (!temporary || !root_private_directory(lstat(YAML_JOB_DIRECTORY)) ||
	    type(content) != 'string' || !parse_yaml_job_state(content))
		return false;

	try {
		file = open(temporary, 'wx', 0o600);
		created = !!file;
		if (!file || file.write(content) != length(content) || !file.flush()) {
			if (file)
				file.close();
			if (created)
				unlink(temporary);
			return false;
		}
		if (!file.close()) {
			file = null;
			unlink(temporary);
			return false;
		}
		file = null;
		if (!root_private_file(lstat(temporary)) || !rename(temporary, path)) {
			unlink(temporary);
			return false;
		}
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		if (created)
			unlink(temporary);
		return false;
	}

	return root_private_file(lstat(path)) &&
		!!parse_yaml_job_state(readfile(path, YAML_JOB_STATE_LIMIT + 1));
}

function discard_yaml_job(token) {
	let path = yaml_job_path(token);
	if (!path || !root_private_directory(lstat(YAML_JOB_DIRECTORY)))
		return false;

	let metadata = lstat(path);
	return !metadata || (root_private_file(metadata) && !!unlink(path));
}

function yaml_stage_path(token) {
	let path = config_path();
	let stage = path && yaml_job_path(token) ? `${path}.luci-${token}` : null;

	return stage &&
		match(stage, /^\/[A-Za-z0-9_./+@%:,=-]+\/AdGuardHome\.yaml\.luci-[0-9a-f]{32}$/)
		? stage
		: null;
}

function remove_yaml_stage(token, original, explicit_stage) {
	let stage = explicit_stage || yaml_stage_path(token);
	let suffix = `/AdGuardHome.yaml.luci-${token}`;
	let metadata = stage ? lstat(stage) : null;

	if (!stage ||
	    !match(stage, /^\/[A-Za-z0-9_./+@%:,=-]+\/AdGuardHome\.yaml\.luci-[0-9a-f]{32}$/) ||
	    substr(stage, length(stage) - length(suffix)) != suffix)
		return false;
	if (!metadata)
		return true;
	if (metadata.type != 'file' || metadata.uid != 0 || metadata.gid != 0 ||
	    metadata.mode != 0o600 || metadata.nlink != 1 ||
	    metadata.size < 0 || metadata.size > MAX_CONFIG_LENGTH ||
	    (original && !same_inode(metadata, original)))
		return false;

	return !!unlink(stage);
}

function scan_yaml_jobs(clean_temporary) {
	let entries = lsdir(YAML_JOB_DIRECTORY);
	let result = { active: [], terminal: [] };

	if (type(entries) != 'array')
		return { error: 'YAML update state is unavailable' };

	for (let name in entries) {
		if (name == 'update.lock')
			continue;
		if (name == 'removing') {
			if (!root_private_lock_file(lstat(YAML_MAINTENANCE_MARKER)))
				return { error: 'YAML update maintenance marker is unsafe' };
			result.maintenance = true;
			continue;
		}
		if (match(name, /^\.[0-9a-f]{32}(\.rpcd-[0-9a-f]{32}|\.[A-Za-z0-9]{6})$/)) {
			if (clean_temporary) {
				let temporary = `${YAML_JOB_DIRECTORY}/${name}`;
				if (!root_private_temporary_file(lstat(temporary)) || !unlink(temporary))
					return { error: 'YAML update state is unsafe' };
			}
			continue;
		}
		if (!match(name, /^[0-9a-f]{32}$/))
			return { error: 'YAML update state is unsafe' };

		let record = read_yaml_job(name);
		if (!record)
			return { error: 'YAML update state is unsafe' };

		let item = { token: name, record };
		if (record.state == 'pending' || record.state == 'running')
			push(result.active, item);
		else
			push(result.terminal, item);
	}

	return result;
}

function close_yaml_job_lock(lock) {
	if (!lock?.file)
		return true;

	try {
		return !!lock.file.close();
	}
	catch (error) {
		return false;
	}
}

function mark_yaml_job_indeterminate(item) {
	if (!item || !item.token || !item.record)
		return false;

	return remove_yaml_stage(item.token, null) &&
		replace_yaml_job(item.token,
			`indeterminate:${item.record.expected_hash}:${item.record.candidate_hash}\n`);
}

function prepare_yaml_job(token, expected_hash, candidate_hash) {
	let lock = open_yaml_job_lock();
	let jobs = scan_yaml_jobs(!!lock.file);
	if (jobs.error) {
		close_yaml_job_lock(lock);
		return jobs;
	}
	if (jobs.maintenance) {
		close_yaml_job_lock(lock);
		return { error: 'YAML updates are temporarily unavailable during package maintenance' };
	}

	let exact_active = null;
	for (let item in jobs.active)
		if (item.record.expected_hash == expected_hash &&
		    item.record.candidate_hash == candidate_hash)
			exact_active = item;

	if (!lock.file) {
		if (lock.error)
			return { error: lock.error };
		if (!lock.busy)
			return { error: 'YAML update lock is unavailable' };
		if (exact_active && length(jobs.active) == 1)
			return { token: exact_active.token, reused: true };
		if (length(jobs.active))
			return { error: 'Another YAML update is already in progress' };
		return { error: lock.error || 'Another YAML update is still finishing' };
	}

	if (length(jobs.active)) {
		let marked = true;
		for (let item in jobs.active)
			marked = mark_yaml_job_indeterminate(item) && marked;
		close_yaml_job_lock(lock);
		if (!marked)
			return { error: 'Unable to recover interrupted YAML update state' };
		if (exact_active && length(jobs.active) == 1)
			return { token: exact_active.token, reused: true };
		return { error: 'A previous YAML update was interrupted; reload the YAML before editing it again' };
	}

	// Normally the editor consumes terminal records.  Bound abandoned results
	// without making a recent result disappear merely because another editor
	// begins a later, revision-checked transaction.
	if (length(jobs.terminal) >= 16)
		for (let item in jobs.terminal)
			if (!discard_yaml_job(item.token)) {
				close_yaml_job_lock(lock);
				return { error: 'Unable to clean completed YAML update state' };
			}

	if (!write_new_yaml_job(token, expected_hash, candidate_hash)) {
		close_yaml_job_lock(lock);
		return { error: 'Unable to create YAML update state' };
	}

	return {
		token,
		reused: false,
		lock: lock.file,
		lock_descriptor: lock.descriptor,
	};
}

function finish_yaml_process(token, expected_hash, candidate_hash, stage, original) {
	let lock = open_yaml_job_lock();
	if (!lock.file)
		return;

	let record = read_yaml_job(token);
	if (record && (record.state == 'pending' || record.state == 'running'))
		replace_yaml_job(token,
			`indeterminate:${expected_hash}:${candidate_hash}\n`);

	remove_yaml_stage(token, original, stage);
	close_yaml_job_lock(lock);
}

function update_yaml(content, expected_hash) {
	if (type(content) != 'string' || !length(content) ||
	    length(content) > MAX_CONFIG_LENGTH || index(content, "\u0000") >= 0)
		return { error: 'Invalid YAML content' };
	if (type(expected_hash) != 'string' ||
	    !match(expected_hash, /^[0-9a-f]{64}$/))
		return { error: 'Invalid or missing YAML revision' };

	let path = config_path();
	let token = random_token();
	let candidate_hash = sha256(content);
	if (!path || !token || !candidate_hash)
		return { error: 'YAML configuration is unavailable' };
	let job = prepare_yaml_job(token, expected_hash, candidate_hash);
	if (job.error)
		return job;
	if (job.reused)
		return { accepted: true, token: job.token, reused: true };

	let stage = `${path}.luci-${token}`;
	if (!match(stage, /^\/[A-Za-z0-9_./+@%:,=-]+\/AdGuardHome\.yaml\.luci-[0-9a-f]{32}$/)) {
		discard_yaml_job(token);
		close_yaml_job_lock({ file: job.lock });
		return { error: 'Unsafe YAML staging path' };
	}
	let file = null;
	let descriptor = null;
	let metadata = null;
	let stage_created = false;
	let launched = false;

	try {
		// Exclusive creation prevents a symlink or another request from
		// claiming the staging pathname.  The init script revalidates it under
		// its integration lock before using it.
		file = open(stage, 'wx', 0o600);
		stage_created = !!file;
		if (!file || file.write(content) != length(content)) {
			if (file)
				file.close();
			if (stage_created)
				unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unable to stage YAML configuration' };
		}
		if (!file.flush()) {
			file.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unable to flush staged YAML configuration' };
		}

		metadata = lstat(stage);
		descriptor = file.fileno();
		let opened = type(descriptor) == 'int'
			? stat(`/proc/self/fd/${descriptor}`)
			: null;
		if (!metadata || metadata.type != 'file' || opened?.type != 'file' ||
		    metadata.size != length(content) || metadata.inode != opened.inode ||
		    metadata.dev?.major != opened.dev?.major ||
		    metadata.dev?.minor != opened.dev?.minor) {
			file.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unsafe YAML staging file' };
		}
		// Reopen the already-held inode read-only through procfs, then close the
		// writable handle.  Every helper spawned by the transaction inherits only
		// a read descriptor, regardless of the pathname's later state.
		let reader = open(`/proc/self/fd/${descriptor}`, 'r');
		let reader_descriptor = reader ? reader.fileno() : null;
		let reader_opened = type(reader_descriptor) == 'int'
			? stat(`/proc/self/fd/${reader_descriptor}`)
			: null;
		if (!reader || reader_opened?.type != 'file' ||
		    reader_opened.inode != opened.inode ||
		    reader_opened.dev?.major != opened.dev?.major ||
		    reader_opened.dev?.minor != opened.dev?.minor) {
			if (reader)
				reader.close();
			file.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unable to hold staged YAML configuration' };
		}
		if (!file.close()) {
			reader.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unable to close writable YAML staging handle' };
		}
		file = reader;
		descriptor = reader_descriptor;

		let lock_metadata = lstat(YAML_JOB_LOCK);
		let lock_opened = type(job.lock_descriptor) == 'int'
			? stat(`/proc/self/fd/${job.lock_descriptor}`)
			: null;
		if (!root_private_lock_file(lock_metadata) ||
		    !same_inode(lock_metadata, lock_opened) ||
		    descriptor == job.lock_descriptor || descriptor == 1000) {
			file.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unsafe YAML update descriptors' };
		}

		// The core validation/restart transaction may legitimately take longer
		// than LuCI's request timeout.  Fork it without a shell while this read-only
		// descriptor is held; the worker inherits the immutable staged inode and
		// publishes an atomic root-private result for short polling calls.
		let child = uloop.process(YAML_UPDATE_COMMAND, [
			'yaml_update_job', expected_hash, candidate_hash, stage,
			`${descriptor}`, `${job.lock_descriptor}`, token,
		], { PATH: '/usr/sbin:/usr/bin:/sbin:/bin' }, function(status) {
			finish_yaml_process(token, expected_hash, candidate_hash, stage, metadata);
		});
		if (!child) {
			file.close();
			file = null;
			unlink(stage);
			discard_yaml_job(token);
			close_yaml_job_lock({ file: job.lock });
			return { error: 'Unable to start YAML update transaction' };
		}
		launched = true;

		let stage_closed = file.close();
		file = null;
		let lock_closed = close_yaml_job_lock({ file: job.lock });
		job.lock = null;
		// A failed parent-side close cannot revoke the descriptor already inherited
		// by the worker.  Let the persistent job result remain authoritative.
		if (!stage_closed || !lock_closed)
			return { accepted: true, token, reused: false };
	}
	catch (error) {
		if (file) {
			try { file.close(); }
			catch (close_error) { }
		}
		if (launched)
		{
			close_yaml_job_lock({ file: job.lock });
			return { accepted: true, token, reused: false };
		}
		if (stage_created)
			unlink(stage);
		discard_yaml_job(token);
		close_yaml_job_lock({ file: job.lock });
		return { error: 'YAML update transaction failed' };
	}

	return { accepted: true, token, reused: false };
}

function yaml_job_status(token, consume) {
	let record = read_yaml_job(token);
	if (!record)
		return { error: 'YAML update job is unavailable' };

	// Serialize terminal observation and consumption with both the worker and
	// set_yaml() directory scans.  A worker publishes its terminal bytes just
	// before releasing this lock, so hide that short handoff as "running" until
	// the complete transaction is quiescent.
	let lock = open_yaml_job_lock();
	if (!lock.file) {
		if (lock.error)
			return { error: lock.error };
		return { state: record.state == 'pending' ? 'pending' : 'running' };
	}

	record = read_yaml_job(token);
	if (!record) {
		close_yaml_job_lock(lock);
		return { error: 'YAML update job is unavailable' };
	}
	if (record.state == 'pending' || record.state == 'running') {
		let item = { token, record };
		if (!mark_yaml_job_indeterminate(item)) {
			close_yaml_job_lock(lock);
			return { error: 'Unable to recover interrupted YAML update state' };
		}
		record = read_yaml_job(token);
		if (!record) {
			close_yaml_job_lock(lock);
			return { error: 'YAML update job is unavailable' };
		}
	}

	let result = record.state == 'success'
		? {
			state: 'done',
			ok: true,
			sha256: record.sha256,
			restarted: record.restarted,
		}
		: record.state == 'indeterminate'
		? {
			state: 'done',
			ok: false,
			indeterminate: true,
			error: 'The YAML update was interrupted; reload the current YAML before editing it again',
		}
		: {
			state: 'done',
			ok: false,
			error: 'YAML was rejected or changed concurrently',
		};

	if (consume === true && !discard_yaml_job(token)) {
		close_yaml_job_lock(lock);
		return { error: 'Unable to consume YAML update result' };
	}
	if (!close_yaml_job_lock(lock))
		return { error: 'Unable to release YAML update lock' };

	return result;
}

function yaml_scalar(value) {
	value = trim(replace(value, /[ \t]+#.*$/, ''));
	if (length(value) >= 2) {
		let first = substr(value, 0, 1);
		let last = substr(value, length(value) - 1, 1);
		if ((first == '"' && last == '"') || (first == "'" && last == "'"))
			value = substr(value, 1, length(value) - 2);
	}

	return trim(value);
}

function yaml_simple_scalar(value) {
	value = trim(replace(value, /[ \t]+#.*$/, ''));
	if (!length(value))
		return null;

	let first = substr(value, 0, 1);
	if (first == '"' || first == "'") {
		if (length(value) < 2 || substr(value, length(value) - 1, 1) != first)
			return null;
		return substr(value, 1, length(value) - 2);
	}
	if (match(value, /[ \t]/) || first == '|' || first == '>' ||
	    first == '&' || first == '*' || first == '!' || first == '[' ||
	    first == '{')
		return null;

	return value;
}

function supported_password_scalar(value) {
	let scalar = yaml_simple_scalar(value);
	return type(scalar) == 'string' &&
		match(scalar, /^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$/);
}

function supported_username_scalar(value) {
	let scalar = yaml_simple_scalar(value);
	return type(scalar) == 'string' &&
		match(scalar, /^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}$/)
		? scalar
		: null;
}

function credential_record(content) {
	if (type(content) != 'string')
		return null;

	let lines = split(content, '\n');
	let first = -1;
	let last = length(lines);
	let sections = 0;

	for (let i = 0; i < length(lines); i++) {
		if (match(lines[i], /^[^ \t#]/) &&
		    trim(replace(lines[i], /[ \t]+#.*$/, '')) == 'users:') {
			if (first < 0)
				first = i;
			sections++;
		}
	}
	if (sections != 1)
		return null;

	for (let i = first + 1; i < length(lines); i++) {
		if (match(lines[i], /^[^ \t#][^:]*:/)) {
			last = i;
			break;
		}
	}

	let list_indent = 0;
	let have_entry = false;
	let current_name = null;
	let current_name_count = 0;
	let current_password_count = 0;
	let current_password_line = -1;
	let current_password_prefix = '';
	let current_name_line = -1;
	let current_name_prefix = '';
	let records = [];

	for (let i = first + 1; i < last; i++) {
		if (match(lines[i], /^[ \t]*($|#)/))
			continue;

		let sequence = match(lines[i], /^( +)-[ \t]*(.*)$/);
		if (sequence) {
			let indent = length(sequence[1]);
			if (!list_indent)
				list_indent = indent;
			if (indent == list_indent) {
				if (have_entry) {
					if (current_name_count != 1 || current_name == null ||
					    current_name_line < 0 || current_password_count != 1 ||
					    current_password_line < 0)
						return null;
					push(records, {
						username: current_name,
						name_line: current_name_line,
						name_prefix: current_name_prefix,
						password_line: current_password_line,
						password_prefix: current_password_prefix,
					});
				}

				have_entry = true;
				current_name = null;
				current_name_count = 0;
				current_name_line = -1;
				current_name_prefix = '';
				current_password_count = 0;
				current_password_line = -1;
				current_password_prefix = '';

				if (length(trim(sequence[2]))) {
					let inline_field = match(sequence[2], /^([^:]+):[ \t]*(.*)$/);
					if (!inline_field)
						return null;
					let key = trim(inline_field[1]);
					if (key == 'name') {
						current_name_count++;
						current_name = supported_username_scalar(inline_field[2]);
						if (current_name == null)
							return null;
						current_name_line = i;
						current_name_prefix = `${sequence[1]}- name: `;
					}
					else if (key == 'password') {
						if (!supported_password_scalar(inline_field[2]))
							return null;
						current_password_count++;
						current_password_line = i;
						current_password_prefix = `${sequence[1]}- password: `;
					}
				}
				continue;
			}
		}

		if (!have_entry || !list_indent)
			return null;
		let field = match(lines[i], /^( +)([^:]+):[ \t]*(.*)$/);
		if (!field || length(field[1]) != list_indent + 2)
			continue;

		let key = trim(field[2]);
		if (key == 'name') {
			current_name_count++;
			current_name = supported_username_scalar(field[3]);
			if (current_name == null)
				return null;
			current_name_line = i;
			current_name_prefix = `${field[1]}name: `;
		}
		else if (key == 'password') {
			if (!supported_password_scalar(field[3]))
				return null;
			current_password_count++;
			current_password_line = i;
			current_password_prefix = `${field[1]}password: `;
		}
	}

	if (have_entry) {
		if (current_name_count != 1 || current_name == null || current_name_line < 0 ||
		    current_password_count != 1 || current_password_line < 0)
			return null;
		push(records, {
			username: current_name,
			name_line: current_name_line,
			name_prefix: current_name_prefix,
			password_line: current_password_line,
			password_prefix: current_password_prefix,
		});
	}

	if (!length(records))
		return null;

	let target = null;
	if (length(records) == 1)
		target = records[0];
	else {
		for (let record in records) {
			if (record.username != 'admin')
				continue;
			if (target)
				return null;
			target = record;
		}
	}
	if (!target)
		return null;

	let usernames = [];
	for (let record in records)
		push(usernames, record.username);
	target.lines = lines;
	target.usernames = usernames;
	target.record_count = length(records);
	return target;
}

function credentials_info() {
	let yaml = read_yaml();
	if (!yaml)
		return { available: false, error: 'YAML configuration is unavailable' };

	let record = credential_record(yaml.content);
	return record
		? { available: true, username: record.username, sha256: yaml.sha256 }
		: { available: false, error: 'The YAML user account is unavailable or ambiguous' };
}

function update_credentials(username, password_hash, expected_hash) {
	if (type(username) != 'string' || type(password_hash) != 'string')
		return { error: 'Invalid username or BCrypt password hash' };

	let change_username = length(username) > 0;
	let change_password = length(password_hash) > 0;
	if (!change_username && !change_password)
		return { error: 'No username or password change was requested' };
	if (change_username &&
	    !match(username, /^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}$/))
		return { error: 'Invalid username' };
	if (change_password && (length(password_hash) != 60 ||
	    !match(password_hash, /^\$2[aby]\$10\$[./A-Za-z0-9]{53}$/)))
		return { error: 'Invalid BCrypt password hash' };
	if (type(expected_hash) != 'string' ||
	    !match(expected_hash, /^[0-9a-f]{64}$/))
		return { error: 'Invalid or missing YAML revision' };

	let yaml = read_yaml();
	if (!yaml)
		return { error: 'YAML configuration is unavailable' };
	if (yaml.sha256 != expected_hash)
		return { error: 'YAML changed since the credential dialog was opened' };

	let record = credential_record(yaml.content);
	if (!record)
		return { error: 'The YAML user account is unavailable or ambiguous' };
	if (change_username && username == record.username)
		change_username = false;
	if (!change_username && !change_password)
		return { error: 'No username or password change was requested' };

	if (change_username) {
		for (let existing in record.usernames)
			if (existing == username && existing != record.username)
				return { error: 'The requested username already exists' };
		if (record.record_count > 1)
			return {
				error: 'Cannot change the username while multiple YAML user accounts are configured; change only the password or use the YAML editor',
			};
		// Always emit a quoted YAML string.  Plain values such as true, null or
		// an all-numeric username would otherwise be parsed as another YAML type.
		// USERNAME_RE excludes apostrophes, so single-quoting needs no escaping.
		record.lines[record.name_line] = `${record.name_prefix}'${username}'`;
	}
	if (change_password)
		record.lines[record.password_line] =
			`${record.password_prefix}${password_hash}`;

	let content = join('\n', record.lines);
	if (sha256(content) == yaml.sha256)
		return { error: 'No username or password change was requested' };
	return update_yaml(content, expected_hash);
}

function reset_yaml(expected_hash) {
	if (type(expected_hash) != 'string' ||
	    !match(expected_hash, /^[0-9a-f]{64}$/))
		return { error: 'Invalid or missing YAML revision' };

	let yaml = read_yaml();
	if (!yaml)
		return { error: 'YAML configuration is unavailable' };
	if (yaml.sha256 != expected_hash)
		return { error: 'YAML changed since the page was loaded' };

	let content = template_for_path(yaml.path);
	if (!content)
		return { error: 'The packaged YAML template is unavailable or unsafe' };

	// Restoring the template is an editor-only operation.  Return the audited
	// packaged bytes without queueing an update or touching the active YAML;
	// set_yaml remains the sole validate/save/apply boundary.
	return { content, sha256: sha256(content) };
}

function yaml_section_value(content, section, key) {
	let lines = split(content, '\n');
	let first = -1;
	let last = length(lines);
	let depth = 0;
	let sections = 0;

	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (match(line, /^[^ \t#]/) &&
		    trim(replace(line, /[ \t]+#.*$/, '')) == `${section}:`) {
			if (first < 0)
				first = i;
			sections++;
		}
	}

	if (sections != 1)
		return null;

	for (let i = first + 1; i < length(lines); i++) {
		if (match(lines[i], /^[^ \t#][^:]*:/)) {
			last = i;
			break;
		}
	}

	for (let i = first + 1; i < last; i++) {
		let indent = match(lines[i], /^( +)\S/);
		if (indent && (!depth || length(indent[1]) < depth))
			depth = length(indent[1]);
	}

	if (!depth)
		return null;

	let found = null;
	let count = 0;
	for (let i = first + 1; i < last; i++) {
		let item = match(lines[i], /^( +)([^:]+):[ \t]*(.*)$/);
		if (!item || length(item[1]) != depth || trim(item[2]) != key)
			continue;

		found = yaml_scalar(item[3]);
		count++;
	}

	return count == 1 && length(found) ? found : null;
}

function valid_port(value, allow_dns_port_53) {
	if (allow_dns_port_53 == null)
		allow_dns_port_53 = true;

	if (type(value) != 'string' || !match(value, /^[0-9]+$/))
		return null;

	let port = int(value);
	if (type(port) != 'int' || port < 1 || port > 65535 ||
	    (!allow_dns_port_53 && port == 53))
		return null;

	return port;
}

function yaml_bool(value) {
	if (type(value) != 'string')
		return null;

	switch (lc(value)) {
		case '1':
		case 'on':
		case 'true':
		case 'yes':
			return true;
		case '0':
		case 'false':
		case 'no':
		case 'off':
			return false;
		default:
			return null;
	}
}

function valid_dns_name(value) {
	if (type(value) != 'string' || !length(value) || length(value) > 253 ||
	    !match(value, /^[A-Za-z0-9.-]+$/))
		return null;

	let name = value;
	if (substr(name, length(name) - 1, 1) == '.')
		name = substr(name, 0, length(name) - 1);

	if (!length(name))
		return null;

	let labels = split(name, '.');
	for (let label in labels) {
		if (!length(label) || length(label) > 63 ||
		    !match(label, /^[A-Za-z0-9]/) || !match(label, /[A-Za-z0-9]$/))
			return null;
	}

	// WHATWG URLs reinterpret names ending in an IPv4-number component
	// (including abbreviated, octal, and hexadecimal forms) as an IP address.
	// tls.server_name is a DNS name here, so reject those ambiguous spellings.
	let final_label = labels[length(labels) - 1];
	if (match(final_label, /^[0-9]+$/) ||
	    match(final_label, /^0[xX][0-9A-Fa-f]+$/))
		return null;

	return value;
}

function http_port(content) {
	let address = yaml_section_value(content, 'http', 'address');
	let matched = address ? match(address, /:([0-9]+)$/) : null;
	if (address && (match(address, /^127(\.[0-9]+){3}:/) ||
	                match(address, /^\[::1\]:/)))
		return null;
	return matched ? valid_port(matched[1]) : null;
}

function yaml_material_value(content, key) {
	let value = yaml_section_value(content, 'tls', key);
	if (!value || value == '~' || lc(value) == 'null')
		return null;
	return value;
}

function tls_material_complete(content) {
	let certificate_path = yaml_material_value(content, 'certificate_path');
	let private_key_path = yaml_material_value(content, 'private_key_path');

	// Explicit file paths take precedence.  Do not silently fall back to stale
	// inline material when a user has configured only one half of a path pair.
	if (certificate_path || private_key_path)
		return !!certificate_path && !!private_key_path;

	// AdGuard Home also supports embedded PEM values.  A YAML block scalar is
	// represented by its non-empty "|"/">" marker here, which is sufficient
	// for this completeness gate; the core remains the authoritative parser.
	return !!yaml_material_value(content, 'certificate_chain') &&
	       !!yaml_material_value(content, 'private_key');
}

function web_port_listening(port) {
	if (type(port) != 'int')
		return false;

	// Serialize the entire status probe with YAML updates.  Checking the state
	// before entering the init script leaves a race where a new worker can acquire
	// rc.common's service lock first and block rpcd for the whole transaction.
	let lock = open_yaml_job_lock();
	if (!lock.file)
		return false;

	let listening = false;
	try {
		if (!yaml_job_active() && service_running())
			listening = system([
				YAML_UPDATE_COMMAND, 'web_listening', `${port}`,
			]) == 0;
	}
	catch (error) {
		listening = false;
	}

	let closed = close_yaml_job_lock(lock);
	return closed && listening;
}

function config_info() {
	let content = read_config();
	let result = { dns_port: null, web: null };
	if (!content)
		return result;

	result.dns_port = valid_port(
		yaml_section_value(content, 'dns', 'port'),
		true
	);

	let tls_value = yaml_section_value(content, 'tls', 'enabled');
	let tls_enabled = tls_value == null ? false : yaml_bool(tls_value);
	if (tls_enabled == null)
		return result;

	if (tls_enabled) {
		let host = valid_dns_name(yaml_section_value(content, 'tls', 'server_name'));
		let port = valid_port(yaml_section_value(content, 'tls', 'port_https'));
		if (host && port && tls_material_complete(content) && web_port_listening(port))
			result.web = { scheme: 'https', host, port };
		if (result.web ||
		    yaml_bool(yaml_section_value(content, 'tls', 'force_https')) === true)
			return result;
	}

	// When HTTPS is incomplete or not listening, AdGuard Home may still expose
	// its HTTP endpoint unless force_https is explicitly enabled.  The frontend
	// intentionally reuses the LuCI page host for this result.
	let port = http_port(content);
	if (port && web_port_listening(port))
		result.web = { scheme: 'http', host: null, port };

	return result;
}

function core_version() {
	let pipe = null;
	let output = null;
	let status = -1;

	try {
		pipe = popen(VERSION_COMMAND, 'r');
		if (!pipe)
			return null;

		output = pipe.read(MAX_VERSION_LENGTH + 1);
		status = pipe.close();
		pipe = null;
	}
	catch (error) {
		if (pipe) {
			try {
				pipe.close();
			}
			catch (close_error) {
				// Ignore cleanup errors and report an unavailable version.
			}
		}

		return null;
	}

	if (status != 0 || type(output) != 'string' || length(output) > MAX_VERSION_LENGTH)
		return null;

	let version = trim(split(output, '\n')[0] || '');
	if (!length(version))
		return null;

	return substr(version, 0, MAX_VERSION_LENGTH);
}

const methods = {
	get_status: {
		call: function() {
			return service_status();
		},
	},
	get_version: {
		call: function() {
			return { version: core_version() };
		},
	},
	get_config_info: {
		call: function() {
			return config_info();
		},
	},
	get_log: {
		args: { lines: 100 },
		call: function(request) {
			return read_log(request.args.lines);
		},
	},
	get_yaml: {
		call: function() {
			return read_yaml() || { error: 'YAML configuration is unavailable' };
		},
	},
	set_yaml: {
		args: { content: '', sha256: '' },
		call: function(request) {
			return update_yaml(request.args.content, request.args.sha256);
		},
	},
	reset_yaml: {
		args: { sha256: '' },
		call: function(request) {
			return reset_yaml(request.args.sha256);
		},
	},
	get_password_info: {
		call: function() {
			return credentials_info();
		},
	},
	set_password: {
		args: { password_hash: '', sha256: '' },
		call: function(request) {
			return update_credentials(
				'',
				request.args.password_hash,
				request.args.sha256
			);
		},
	},
	get_credentials: {
		call: function() {
			return credentials_info();
		},
	},
	set_credentials: {
		args: { username: '', password_hash: '', sha256: '' },
		call: function(request) {
			return update_credentials(
				request.args.username,
				request.args.password_hash,
				request.args.sha256
			);
		},
	},
	get_yaml_update: {
		args: { token: '', consume: false },
		call: function(request) {
			return yaml_job_status(request.args.token, request.args.consume);
		},
	},
};

return { 'luci.adguardhome': methods };
