# Keep installer and upgrade operations bounded without an external timeout
# package.  Descriptor 187 preserves pipeline input for the async child.
run_bounded() (
	local limit="$1" grace="$2" marker="" child="" watchdog="" rc=0 expired=0
	shift 2
	case "$limit" in ""|*[!0-9]*) exit 125 ;; esac
	case "$grace" in ""|*[!0-9]*) exit 125 ;; esac
	[ "$#" -gt 0 ] || exit 125
	[ -x /usr/bin/setsid ] || exit 125
	marker="$(mktemp /tmp/luci-app-adguardhome-bounded.XXXXXX)" || exit 125
	chmod 0600 "$marker" || {
		rm -f "$marker"
		exit 125
	}
	printf '0\n' >"$marker" || {
		rm -f "$marker"
		exit 125
	}
	bounded_signal_session() {
		/bin/kill "-$1" -- "-$child" 2>/dev/null ||
			/bin/kill "-$1" "$child" 2>/dev/null || true
	}
	bounded_abort() {
		trap - HUP INT QUIT TERM
		[ -z "$watchdog" ] || /bin/kill -TERM "$watchdog" 2>/dev/null || true
		[ -z "$watchdog" ] || wait "$watchdog" 2>/dev/null || true
		if [ -n "$child" ]; then
			bounded_signal_session TERM
			sleep "$grace" 2>/dev/null || true
			bounded_signal_session KILL
			wait "$child" 2>/dev/null || true
		fi
		rm -f "$marker"
		exit 125
	}
	trap bounded_abort HUP INT QUIT TERM
	[ ! -e /proc/self/fd/187 ] || bounded_abort
	exec 187<&0 || bounded_abort
	/usr/bin/setsid "$@" <&187 187<&- &
	child=$!
	exec 187<&-
	(
		bounded_sleeper=""
		bounded_watchdog_abort() {
			trap - HUP INT QUIT TERM
			[ -z "$bounded_sleeper" ] || /bin/kill -TERM "$bounded_sleeper" 2>/dev/null || true
			[ -z "$bounded_sleeper" ] || wait "$bounded_sleeper" 2>/dev/null || true
			exit 1
		}
		bounded_watchdog_sleep() {
			sleep "$1" &
			bounded_sleeper=$!
			wait "$bounded_sleeper"
			bounded_sleep_rc=$?
			bounded_sleeper=""
			return "$bounded_sleep_rc"
		}
		trap bounded_watchdog_abort HUP INT QUIT TERM
		bounded_watchdog_sleep "$limit" || exit 1
		/bin/kill -0 -- "-$child" 2>/dev/null || /bin/kill -0 "$child" 2>/dev/null || exit 1
		printf '1\n' >"$marker" || exit 1
		bounded_signal_session TERM
		bounded_watchdog_sleep "$grace" || exit 0
		bounded_signal_session KILL
	) &
	watchdog=$!
	wait "$child" 2>/dev/null || rc=$?
	read -r expired <"$marker" 2>/dev/null || expired=0
	if [ "$expired" = 1 ]; then
		wait "$watchdog" 2>/dev/null || true
	else
		/bin/kill -TERM "$watchdog" 2>/dev/null || true
		wait "$watchdog" 2>/dev/null || true
	fi
	trap - HUP INT QUIT TERM
	rm -f "$marker"
	[ "$expired" = 1 ] && exit 124
	exit "$rc"
)

entry_metadata() {
	LC_ALL=C ls -ldn "$1" 2>/dev/null
}

root_owned_safe_directory() {
	local metadata mode owner group
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$owner" = 0 ] && [ "$group" = 0 ] || return 1
	case "$mode" in ?????w*|????????w*) return 1 ;; esac
}

root_owned_directory_allow_writable() {
	local metadata
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r _mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$owner" = 0 ] && [ "$group" = 0 ]
}

root_private_directory() {
	local metadata
	root_owned_safe_directory "$1" || return 1
	metadata="$(entry_metadata "$1")" || return 1
	[ "${metadata%% *}" = "drwx------" ]
}

root_private_file() {
	local metadata
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$owner" = 0 ] && [ "$group" = 0 ]
}

root_private_single_file() {
	local metadata mode links owner group
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ]
}

root_owned_regular_file() {
	local metadata
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	case "$mode" in -?????????) ;; *) return 1 ;; esac
	[ "$owner" = 0 ] && [ "$group" = 0 ]
}

# The target rootfs exposes /etc and /etc/config as root-owned mode 0777.
# Permit only those two fixed system ancestors to be writable; every other
# ancestor must be root-owned and non-writable.  A held descriptor below then
# proves that the pathname still names the exact regular root-owned inode both
# before and after its bytes are captured.
trusted_root_file_source() {
	local value="$1" parent remaining component current="" metadata mode owner
	case "$value" in /*) ;; *) return 1 ;; esac
	root_owned_regular_file "$value" || return 1
	root_owned_safe_directory / || return 1
	parent="${value%/*}"
	remaining="${parent#/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		[ -d "$current" ] && [ ! -L "$current" ] || return 1
		metadata="$(entry_metadata "$current")" || return 1
		read -r mode _links owner _group _remainder <<-EOF
		$metadata
		EOF
		[ "$owner" = 0 ] || return 1
		case "$mode" in
			?????w*|????????w*)
				case "$current" in /etc|/etc/config) ;; *) return 1 ;; esac
				;;
		esac
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
}

capture_root_file_bytes() {
	local source="$1" target="$2" blocks="$3"
	trusted_root_file_source "$source" || return 1
	(
		exec 8<"$source" || exit 1
		fd_path=/proc/self/fd/8
		[ -f "$fd_path" ] || exit 1
		fd_metadata="$(LC_ALL=C ls -ldnL "$fd_path" 2>/dev/null)" || exit 1
		read -r fd_mode _fd_links fd_owner fd_group _fd_remainder <<-EOF
		$fd_metadata
		EOF
		case "$fd_mode" in -?????????) ;; *) exit 1 ;; esac
		[ "$fd_owner" = 0 ] && [ "$fd_group" = 0 ] || exit 1
		[ ! -L "$source" ] && [ "$fd_path" -ef "$source" ] || exit 1
		run_bounded 5 1 /bin/dd if="$fd_path" \
			bs=4096 count="$blocks" of="$target" 2>/dev/null || exit 1
		[ ! -L "$source" ] && [ "$fd_path" -ef "$source" ] || exit 1
		trusted_root_file_source "$source"
	)
}

bounded_regular_file() {
	local size
	root_private_file "$1" || return 1
	size="$(wc -c <"$1" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ]
}

validate_original_snapshot() {
	root_private_directory "$SNAPSHOT_DIR" || return 1
	root_private_file "$SNAPSHOT_VERSION" || return 1
	root_private_file "$SNAPSHOT_STATE" || return 1
	bounded_regular_file "$SNAPSHOT_UCI" || return 1
	bounded_regular_file "$SNAPSHOT_CONFIG" || return 1
	[ "$(wc -c <"$SNAPSHOT_VERSION" 2>/dev/null)" = 2 ] &&
		grep -qx '1' "$SNAPSHOT_VERSION" || return 1
	grep -Eq '^was_running=[01]$' "$SNAPSHOT_STATE" || return 1
	[ "$(wc -l <"$SNAPSHOT_STATE" 2>/dev/null)" = 1 ] || return 1
	grep -Eq '^package[[:space:]]+adguardhome$' "$SNAPSHOT_UCI"
}

ensure_no_official_pending_delta() {
	local delta_dir=/tmp/.uci delta_file=/tmp/.uci/adguardhome
	if [ ! -e "$delta_dir" ] && [ ! -L "$delta_dir" ]; then
		return 0
	fi
	root_private_directory "$delta_dir" || {
		echo "Unsafe UCI delta directory; refusing to read pending official state." >&2
		return 1
	}
	if [ -e "$delta_file" ] || [ -L "$delta_file" ]; then
		# A successful UCI commit can leave a root-private, zero-byte saved
		# delta behind.  Accept that committed-state marker while retaining
		# the refusal for non-empty or unsafe entries.
		if root_private_single_file "$delta_file" &&
		   [ "$(wc -c <"$delta_file" 2>/dev/null)" = 0 ]; then
			return 0
		fi
		echo "Pending official adguardhome UCI changes must be committed or reverted before installing this plugin." >&2
		return 1
	fi
	[ ! -e "$delta_file" ] && [ ! -L "$delta_file" ]
}

cleanup_snapshot_stage() {
	local stage="$1"
	[ -n "$stage" ] || return 0
	rm -f "${stage}/official-adguardhome.uci" \
		"${stage}/official-adguardhome.config" \
		"${stage}/official-adguardhome.state" \
		"${stage}/snapshot-version" "${stage}/.semantic-export" \
		"${stage}"/luci_agh_snapshot_?????? 2>/dev/null || true
	rmdir "$stage" 2>/dev/null || true
	[ "$SNAPSHOT_STAGE" != "$stage" ] || SNAPSHOT_STAGE=""
}

ensure_original_snapshot() {
	local stage snapshot_suffix snapshot_package raw_export
	local was_running=0 running_rc=0
	if [ -e "$SNAPSHOT_DIR" ] || [ -L "$SNAPSHOT_DIR" ]; then
		validate_original_snapshot || {
			echo "Unsafe or incomplete original adguardhome snapshot; installation aborted." >&2
			return 1
		}
		return 0
	fi
	root_owned_safe_directory /root || return 1
	stage="$(mktemp -d /root/.luci-app-adguardhome.XXXXXX)" || return 1
	SNAPSHOT_STAGE="$stage"
	if ! chown 0:0 "$stage" || ! chmod 0700 "$stage"; then
		cleanup_snapshot_stage "$stage"
		return 1
	fi
	snapshot_suffix="${stage##*.}"
	case "$snapshot_suffix" in
		??????) ;;
		*) cleanup_snapshot_stage "$stage"; return 1 ;;
	esac
	case "$snapshot_suffix" in *[!A-Za-z0-9]*) cleanup_snapshot_stage "$stage"; return 1 ;; esac
	snapshot_package="luci_agh_snapshot_${snapshot_suffix}"
	raw_export="${stage}/.semantic-export"
	if ! capture_root_file_bytes /etc/config/adguardhome \
		"${stage}/${snapshot_package}" 129 ||
	   ! chown 0:0 "${stage}/${snapshot_package}" ||
	   ! chmod 0600 "${stage}/${snapshot_package}" ||
	   ! bounded_regular_file "${stage}/${snapshot_package}"; then
		cleanup_snapshot_stage "$stage"
		echo "Unable to capture the original official adguardhome config file." >&2
		return 1
	fi
	if ! run_bounded 5 1 uci -q -c "$stage" \
		export "$snapshot_package" >"$raw_export" ||
	   ! chown 0:0 "$raw_export" || ! chmod 0600 "$raw_export" ||
	   ! bounded_regular_file "$raw_export" ||
	   [ "$(sed -n '1p' "$raw_export")" != "package ${snapshot_package}" ]; then
		cleanup_snapshot_stage "$stage"
		echo "Unable to validate the captured official adguardhome UCI configuration." >&2
		return 1
	fi
	{
		printf 'package adguardhome\n'
		sed '1d' "$raw_export"
	} >"${stage}/official-adguardhome.uci" || {
		cleanup_snapshot_stage "$stage"
		return 1
	}
	rm -f "$raw_export" || return 1
	mv "${stage}/${snapshot_package}" "${stage}/official-adguardhome.config" || {
		cleanup_snapshot_stage "$stage"
		return 1
	}
	if [ -x /etc/init.d/adguardhome ]; then
		run_bounded 5 1 /etc/init.d/adguardhome running \
			>/dev/null 2>&1 || running_rc=$?
		case "$running_rc" in
			0) was_running=1 ;;
			1) ;;
			*)
				cleanup_snapshot_stage "$stage"
				echo "Unable to determine the original official adguardhome runtime state." >&2
				return 1
				;;
		esac
	fi
	printf 'was_running=%s\n' "$was_running" \
		>"${stage}/official-adguardhome.state" || {
		cleanup_snapshot_stage "$stage"
		return 1
	}
	printf '1\n' >"${stage}/snapshot-version" || {
		cleanup_snapshot_stage "$stage"
		return 1
	}
	if ! chown 0:0 "${stage}/official-adguardhome.uci" \
		"${stage}/official-adguardhome.config" \
		"${stage}/official-adguardhome.state" "${stage}/snapshot-version" ||
	   ! chmod 0600 "${stage}/official-adguardhome.uci" \
			"${stage}/official-adguardhome.config" \
			"${stage}/official-adguardhome.state" "${stage}/snapshot-version"; then
		cleanup_snapshot_stage "$stage"
		return 1
	fi
	if ! bounded_regular_file "${stage}/official-adguardhome.uci" ||
	   ! bounded_regular_file "${stage}/official-adguardhome.config" ||
	   ! grep -Eq '^package[[:space:]]+adguardhome$' \
		"${stage}/official-adguardhome.uci" ||
	   ! grep -Eq '^was_running=[01]$' \
		"${stage}/official-adguardhome.state"; then
		cleanup_snapshot_stage "$stage"
		return 1
	fi
	if [ -e "$SNAPSHOT_DIR" ] || [ -L "$SNAPSHOT_DIR" ]; then
		cleanup_snapshot_stage "$stage"
		validate_original_snapshot
		return
	fi
	mv "$stage" "$SNAPSHOT_DIR" || {
		cleanup_snapshot_stage "$stage"
		return 1
	}
	SNAPSHOT_STAGE=""
	validate_original_snapshot || return 1
	echo "Saved the original official adguardhome UCI and runtime state."
}

validate_runtime_parent() {
	[ -L /var ] && [ "$(readlink /var 2>/dev/null)" != tmp ] &&
		[ "$(readlink /var 2>/dev/null)" != /tmp ] && return 1
	root_owned_safe_directory /var/run
}

validate_runtime_dir() {
	validate_runtime_parent || return 1
	root_private_directory "$RUNTIME_DIR"
}

ensure_runtime_dir() {
	validate_runtime_parent || return 1
	if [ -e "$RUNTIME_DIR" ] || [ -L "$RUNTIME_DIR" ]; then
		validate_runtime_dir || {
			echo "Unsafe AdGuard Home lifecycle runtime directory." >&2
			return 1
		}
		return 0
	fi
	mkdir -m 0700 "$RUNTIME_DIR" || return 1
	chown 0:0 "$RUNTIME_DIR" && chmod 0700 "$RUNTIME_DIR" || return 1
	validate_runtime_dir
}

validate_runtime_marker() {
	validate_runtime_dir || return 1
	root_private_single_file "$1" || return 1
	[ "$(wc -c <"$1" 2>/dev/null)" = 2 ] && grep -qx '1' "$1"
}

validate_maintenance_upgrade_marker() {
	local line1 line2 line3 line4 line5 line6 line7 line8 extra
	local config_hash config_size delta_hash delta_size digest
	validate_runtime_dir || return 1
	root_private_single_file "$MAINTENANCE_UPGRADE_MARKER" &&
		bounded_regular_file "$MAINTENANCE_UPGRADE_MARKER" || return 1
	[ "$(wc -c <"$MAINTENANCE_UPGRADE_MARKER")" -le 4096 ] 2>/dev/null || return 1
	{
		IFS= read -r line1 && IFS= read -r line2 &&
		IFS= read -r line3 && IFS= read -r line4 &&
		IFS= read -r line5 && IFS= read -r line6 &&
		IFS= read -r line7 && IFS= read -r line8 &&
		! IFS= read -r extra
	} <"$MAINTENANCE_UPGRADE_MARKER" || return 1
	[ "$line1" = format=1 ] && [ "$line2" = source_version=2.2.0-r1 ] || return 1
	case "$line3" in wrapper_running=0|wrapper_running=1)
		MAINTENANCE_WRAPPER_RUNNING="${line3#*=}" ;; *) return 1 ;; esac
	case "$line4" in delta_present=0|delta_present=1)
		MAINTENANCE_DELTA_PRESENT="${line4#*=}" ;; *) return 1 ;; esac
	case "$line5" in config_sha256=*) config_hash="${line5#*=}" ;; *) return 1 ;; esac
	case "$line6" in config_size=*) config_size="${line6#*=}" ;; *) return 1 ;; esac
	case "$line7" in delta_sha256=*) delta_hash="${line7#*=}" ;; *) return 1 ;; esac
	case "$line8" in delta_size=*) delta_size="${line8#*=}" ;; *) return 1 ;; esac
	case "$config_hash:$config_size" in *[!0-9a-f:]*|:*) return 1 ;; esac
	[ "${#config_hash}" = 64 ] || return 1
	root_private_single_file "$MAINTENANCE_CONFIG_SNAPSHOT" &&
		bounded_regular_file "$MAINTENANCE_CONFIG_SNAPSHOT" || return 1
	[ "$(wc -c <"$MAINTENANCE_CONFIG_SNAPSHOT")" = "$config_size" ] || return 1
	digest="$(sha256sum "$MAINTENANCE_CONFIG_SNAPSHOT" 2>/dev/null)" || return 1
	[ "${digest%% *}" = "$config_hash" ] || return 1
	case "$MAINTENANCE_DELTA_PRESENT" in
		0)
			[ "$delta_hash" = none ] && [ "$delta_size" = 0 ] &&
				[ ! -e "$MAINTENANCE_DELTA_SNAPSHOT" ] &&
				[ ! -L "$MAINTENANCE_DELTA_SNAPSHOT" ] || return 1
			;;
		1)
			case "$delta_hash:$delta_size" in *[!0-9a-f:]*|:*) return 1 ;; esac
			[ "${#delta_hash}" = 64 ] || return 1
			root_private_single_file "$MAINTENANCE_DELTA_SNAPSHOT" || return 1
			[ "$(wc -c <"$MAINTENANCE_DELTA_SNAPSHOT")" = "$delta_size" ] &&
				[ "$delta_size" -le "$MAX_YAML_SIZE" ] 2>/dev/null || return 1
			digest="$(sha256sum "$MAINTENANCE_DELTA_SNAPSHOT" 2>/dev/null)" || return 1
			[ "${digest%% *}" = "$delta_hash" ] || return 1
			;;
	esac
}

validate_initial_runtime_contents() {
	local entry
	validate_runtime_dir || return 1
	for entry in \
		"$RUNTIME_DIR"/* \
		"$RUNTIME_DIR"/.[!.]* \
		"$RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		case "$entry" in
			"$UPGRADE_MARKER"|"$INIT_ENABLED_MARKER"|"$UPGRADE_STOPPED_MARKER")
				validate_runtime_marker "$entry" || return 1
				;;
			"$MAINTENANCE_UPGRADE_MARKER")
				validate_maintenance_upgrade_marker || return 1
				;;
			"$MAINTENANCE_CONFIG_SNAPSHOT")
				root_private_single_file "$entry" && bounded_regular_file "$entry" || return 1
				;;
			"$MAINTENANCE_DELTA_SNAPSHOT")
				root_private_single_file "$entry" || return 1
				[ "$(wc -c <"$entry")" -le "$MAX_YAML_SIZE" ] 2>/dev/null || return 1
				;;
			"$UPGRADE_YAML_SNAPSHOT")
				root_private_single_file "$entry" && bounded_regular_file "$entry" || return 1
				;;
			"$UPGRADE_WORKDIR_METADATA")
				root_private_single_file "$entry" || return 1
				[ "$(wc -c <"$entry" 2>/dev/null)" -ge 1 ] 2>/dev/null &&
					[ "$(wc -c <"$entry" 2>/dev/null)" -le 4096 ] 2>/dev/null || return 1
				;;
			*) return 1 ;;
		esac
	done
}

register_temp_file() {
	if [ -n "$TEMP_FILES" ]; then
		TEMP_FILES="${TEMP_FILES}
$1"
	else
		TEMP_FILES="$1"
	fi
}

new_private_temp() {
	local prefix="$1" temporary
	ensure_runtime_dir || return 1
	temporary="$(mktemp "${RUNTIME_DIR}/${prefix}.XXXXXX")" || return 1
	if ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary"; then
		rm -f "$temporary"
		return 1
	fi
	register_temp_file "$temporary"
	NEW_PRIVATE_TEMP="$temporary"
}

create_upgrade_stopped_marker() {
	local stage
	[ "$IS_UPGRADE" = 1 ] && [ "$UPGRADE_WAS_RUNNING" = 0 ] || return 0
	[ ! -e "$UPGRADE_STOPPED_MARKER" ] && [ ! -L "$UPGRADE_STOPPED_MARKER" ] || return 1
	new_private_temp upgrade-was-stopped || return 1
	stage="$NEW_PRIVATE_TEMP"
	printf '1\n' >"$stage" || return 1
	chown 0:0 "$stage" && chmod 0600 "$stage" || return 1
	root_private_single_file "$stage" || return 1
	[ "$(wc -c <"$stage" 2>/dev/null)" = 2 ] && grep -qx '1' "$stage" || return 1
	mv "$stage" "$UPGRADE_STOPPED_MARKER" || return 1
	validate_runtime_marker "$UPGRADE_STOPPED_MARKER"
}

cleanup_runtime_artifacts() {
	local temporary legacy_marker entry cleanup_rc=0 preserve_stopped=0
	if validate_runtime_dir; then
		while IFS= read -r temporary; do
			[ -n "$temporary" ] || continue
			case "$temporary" in
				"${RUNTIME_DIR}/"*) rm -f "$temporary" || cleanup_rc=1 ;;
			esac
		done <<-EOF
		$TEMP_FILES
		EOF
		if [ "$IS_UPGRADE" != 1 ] || [ "$INSTALL_COMMITTED" = 1 ]; then
			rm -f "$UPGRADE_YAML_SNAPSHOT" "$UPGRADE_WORKDIR_METADATA" \
				"$UPGRADE_MARKER" "$INIT_ENABLED_MARKER" || cleanup_rc=1
			if [ "$IS_UPGRADE" = 1 ] && [ "$INSTALL_COMMITTED" = 1 ] &&
			   [ "$UPGRADE_WAS_RUNNING" = 0 ]; then
				validate_runtime_marker "$UPGRADE_STOPPED_MARKER" || cleanup_rc=1
				preserve_stopped=1
			else
				rm -f "$UPGRADE_STOPPED_MARKER" || cleanup_rc=1
			fi
			if [ "$preserve_stopped" = 1 ]; then
				for entry in \
					"$RUNTIME_DIR"/* \
					"$RUNTIME_DIR"/.[!.]* \
					"$RUNTIME_DIR"/..?*; do
					[ -e "$entry" ] || [ -L "$entry" ] || continue
					[ "$entry" = "$UPGRADE_STOPPED_MARKER" ] || cleanup_rc=1
				done
			else
				rmdir "$RUNTIME_DIR" 2>/dev/null || cleanup_rc=1
			fi
		else
			rm -f "$UPGRADE_STOPPED_MARKER" || cleanup_rc=1
		fi
	fi
	# Never use the historical world-writable markers as input.  Remove only
	# those two exact legacy path objects after every attempted install.
	for legacy_marker in \
		/tmp/luci-app-adguardhome.upgrade \
		/tmp/luci-app-adguardhome.init-enabled; do
		if [ -f "$legacy_marker" ] || [ -L "$legacy_marker" ]; then
			rm -f "$legacy_marker" || cleanup_rc=1
		fi
	done
	return "$cleanup_rc"
}

cleanup_all() {
	if [ "$OFFICIAL_PAUSED" = 1 ]; then
		OFFICIAL_PAUSED=0
		echo "AdGuard Home installation failed after attempting to pause the official service; no automatic restart was attempted." >&2
	fi
	cleanup_snapshot_stage "$SNAPSHOT_STAGE"
	cleanup_runtime_artifacts
}

[ "$PKG_UPGRADE" = 1 ] && IS_UPGRADE=1
if [ -e "$RUNTIME_DIR" ] || [ -L "$RUNTIME_DIR" ]; then
	validate_runtime_dir || {
		echo "Unsafe AdGuard Home lifecycle runtime directory; installation aborted." >&2
		exit 1
	}
	validate_initial_runtime_contents || {
		echo "Unexpected AdGuard Home lifecycle runtime entry; installation aborted." >&2
		exit 1
	}
	if [ -e "$UPGRADE_MARKER" ] || [ -L "$UPGRADE_MARKER" ]; then
		validate_runtime_marker "$UPGRADE_MARKER" || {
			echo "Unsafe AdGuard Home upgrade marker; installation aborted." >&2
			exit 1
		}
		IS_UPGRADE=1
		UPGRADE_MARKER_FOUND=1
	fi
	if [ -e "$INIT_ENABLED_MARKER" ] || [ -L "$INIT_ENABLED_MARKER" ]; then
		validate_runtime_marker "$INIT_ENABLED_MARKER" || {
			echo "Unsafe AdGuard Home init marker; installation aborted." >&2
			exit 1
		}
		UPPER_WAS_ENABLED=1
	fi
	if [ -e "$MAINTENANCE_UPGRADE_MARKER" ] ||
	   [ -L "$MAINTENANCE_UPGRADE_MARKER" ]; then
		validate_maintenance_upgrade_marker || {
			echo "Unsafe AdGuard Home maintenance-upgrade marker; installation aborted." >&2
			exit 1
		}
		IS_MAINTENANCE_UPGRADE=1
		IS_UPGRADE=1
	fi
	# This marker is consumed by default_postinst's one automatic wrapper start.
	# If a previous package-manager process died after committing migration but
	# before that start, validate and discard the stale marker before proceeding.
	if [ -e "$UPGRADE_STOPPED_MARKER" ] || [ -L "$UPGRADE_STOPPED_MARKER" ]; then
		validate_runtime_marker "$UPGRADE_STOPPED_MARKER" || {
			echo "Unsafe stopped-upgrade marker; installation aborted." >&2
			exit 1
		}
		rm -f "$UPGRADE_STOPPED_MARKER" || exit 1
	fi
fi
if [ "$IS_MAINTENANCE_UPGRADE" = 1 ]; then
	if [ -e "$UPGRADE_MARKER" ] || [ -L "$UPGRADE_MARKER" ] ||
	   [ -e "$INIT_ENABLED_MARKER" ] || [ -L "$INIT_ENABLED_MARKER" ] ||
	   [ -e "$UPGRADE_YAML_SNAPSHOT" ] || [ -L "$UPGRADE_YAML_SNAPSHOT" ] ||
	   [ -e "$UPGRADE_WORKDIR_METADATA" ] || [ -L "$UPGRADE_WORKDIR_METADATA" ]; then
		echo "Conflicting AdGuard Home upgrade state; maintenance upgrade aborted." >&2
		exit 1
	fi
elif [ "$IS_UPGRADE" = 1 ]; then
	if [ "$UPGRADE_MARKER_FOUND" != 1 ] ||
	   [ ! -e "$UPGRADE_YAML_SNAPSHOT" ] || [ -L "$UPGRADE_YAML_SNAPSHOT" ] ||
	   [ ! -e "$UPGRADE_WORKDIR_METADATA" ] || [ -L "$UPGRADE_WORKDIR_METADATA" ]; then
		echo "Incomplete AdGuard Home v2.1 upgrade snapshot; installation aborted." >&2
		exit 1
	fi
elif [ -e "$UPGRADE_YAML_SNAPSHOT" ] || [ -L "$UPGRADE_YAML_SNAPSHOT" ] ||
     [ -e "$UPGRADE_WORKDIR_METADATA" ] || [ -L "$UPGRADE_WORKDIR_METADATA" ]; then
	echo "Unexpected AdGuard Home upgrade snapshot on a clean installation; installation aborted." >&2
	exit 1
fi
ensure_runtime_dir || exit 1
trap cleanup_all 0
trap 'exit 1' HUP INT TERM

# APK protects locally changed files below /etc by unpacking their replacement
# as .apk-new.  The 1.x package shipped this init script as a protected,
# non-executable CRLF file, so an upgrade can otherwise restart the obsolete
# root-owned supervisor after its helper files have already been removed.
# Resolve only the exact package-owned init candidate; the active UCI and YAML
# conffiles are migrated below instead of being overwritten by defaults.
if [ "$IS_UPGRADE" = 1 ] && [ "$IS_MAINTENANCE_UPGRADE" != 1 ] &&
   { [ -e /etc/init.d/AdGuardHome.apk-new ] || [ -L /etc/init.d/AdGuardHome.apk-new ]; }; then
	if [ ! -f /etc/init.d/AdGuardHome.apk-new ] ||
	   [ -L /etc/init.d/AdGuardHome.apk-new ]; then
		echo "Unsafe AdGuard Home init upgrade candidate; upgrade aborted." >&2
		exit 1
	fi
	chmod 0755 /etc/init.d/AdGuardHome.apk-new || exit 1
	mv -f /etc/init.d/AdGuardHome.apk-new /etc/init.d/AdGuardHome || exit 1
	echo "Activated the packaged AdGuard Home compatibility init script."
fi

# Rebuild stale legacy S95/K01 links whether APK installed the new init script
# directly or protected it as .apk-new.  A wrapper with no pre-upgrade S??/K??
# links stays disabled.
if [ "$IS_UPGRADE" = 1 ] && [ "$IS_MAINTENANCE_UPGRADE" != 1 ] &&
   [ "$UPPER_WAS_ENABLED" = 1 ]; then
	if [ ! -f /etc/init.d/AdGuardHome ] ||
	   [ -L /etc/init.d/AdGuardHome ] ||
	   [ ! -x /etc/init.d/AdGuardHome ]; then
		echo "Packaged AdGuard Home compatibility init script is unavailable." >&2
		exit 1
	fi
	/etc/init.d/AdGuardHome disable || exit 1
	/etc/init.d/AdGuardHome enable || exit 1
	echo "Restored the enabled AdGuard Home init state with current priorities."
fi

is_valid_port() {
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

canonical_port() {
	awk -v value="$1" 'BEGIN { printf "%d\n", value + 0 }'
}

is_valid_dns_port() {
	is_valid_port "$1" || return 1
	[ "$(canonical_port "$1")" -ne 53 ]
}

normalize_bool() {
	case "$1" in
		1|on|true|yes|enabled) printf '1\n' ;;
		*) printf '0\n' ;;
	esac
}

normalize_memory_writeback_interval() {
	local value="$1"
	case "$value" in
		""|*[!0-9]*)
			printf '60\n'
			return 0
			;;
	esac

	# Canonicalize leading zeroes without relying on a non-base utility or on
	# shell arithmetic accepting an implementation-specific octal spelling.
	while [ "${value#0}" != "$value" ]; do
		value="${value#0}"
	done
	[ -n "$value" ] || value=0

	if [ "${#value}" -gt 5 ] || [ "$value" -gt 10080 ] 2>/dev/null; then
		value=60
	fi
	printf '%s\n' "$value"
}

path_contains_symlink() {
	local remaining="${1#/}" component current=""
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -L "$current" ]; then
			# The exact 25.12.1 base-files layout provides /var -> /tmp and the
			# official package defaults to /var/lib/adguardhome.  Permit only this
			# verified system link while rejecting all other symlink components.
			if [ "$current" = /var ]; then
				case "$(readlink "$current" 2>/dev/null)" in
					tmp|/tmp)
						[ "$remaining" = "$component" ] && break
						remaining="${remaining#*/}"
						continue
						;;
				esac
			fi
			return 0
		fi
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
	return 1
}

is_safe_source_work_dir() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "$value" in
		/*/*) ;;
		*) return 1 ;;
	esac
	case "$value" in
		*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "${value}/" in
		*/./*|*/../*) return 1 ;;
	esac
	! path_contains_symlink "$value"
}

managed_work_dir_namespace() {
	local value="${1%/}" parent leaf
	parent="${value%/*}"
	leaf="${value##*/}"
	case "$leaf" in
		AdGuardHome) ;;
		AdGuardHome-?*) ;;
		*) return 1 ;;
	esac
	case "$parent" in
		/etc) ;;
		/mnt/*) ;;
		*) return 1 ;;
	esac
}

trusted_mnt_ancestors() {
	local value="${1%/}" parent remaining component current
	case "$value" in /mnt/*/*) ;; *) return 1 ;; esac
	parent="${value%/*}"
	[ "$parent" != /mnt ] || return 1
	current=/mnt
	root_owned_safe_directory "$current" || return 1
	remaining="${parent#/mnt/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		root_owned_safe_directory "$current" || return 1
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
}

official_work_dir_anchor_matches() {
	local value="${1%/}" official_work official_config
	official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	official_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	[ "${official_work%/}" = "$value" ] &&
		[ "$official_config" = "${value}/AdGuardHome.yaml" ]
}

is_managed_work_dir() {
	local value="${1%/}"
	is_safe_source_work_dir "$value" || return 1
	managed_work_dir_namespace "$value" || return 1
	case "$value" in
		/mnt/*) trusted_mnt_ancestors "$value" || return 1 ;;
	esac
	[ "$value" = "$DEFAULT_WORK_DIR" ] && return 0
	[ ! -e "$value" ] && [ ! -L "$value" ] && return 0
	[ -d "$value" ] && [ ! -L "$value" ] || return 1
	if [ "$CREATED_MANAGED_WORK_DIR" = "$value" ]; then
		root_private_directory "$value"
		return
	fi
	official_work_dir_anchor_matches "$value"
}

normalize_work_dir() {
	local value="${1%/}"
	is_managed_work_dir "$value" || return 1
	printf '%s\n' "$value"
}

snapshot_sha256() {
	local digest
	command -v sha256sum >/dev/null 2>&1 || return 1
	digest="$(sha256sum "$1" 2>/dev/null)" || return 1
	digest="${digest%% *}"
	[ "${#digest}" -eq 64 ] || return 1
	case "$digest" in *[!0-9a-f]*) return 1 ;; esac
	printf '%s\n' "$digest"
}

held_root_private_file() {
	local descriptor="$1" path="$2" minimum="$3" maximum="$4"
	local metadata mode links owner group size
	[ -f "$descriptor" ] && [ "$descriptor" -ef "$path" ] || return 1
	metadata="$(LC_ALL=C ls -ldnL "$descriptor" 2>/dev/null)" || return 1
	read -r mode links owner group size _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ] || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -ge "$minimum" ] 2>/dev/null &&
		[ "$size" -le "$maximum" ] 2>/dev/null
}

# A v2.2 in-place upgrade consumes only the cold, root-private snapshot made
# by the v2.1 pre-upgrade hook.  Fixed line order plus exact field validation
# rejects duplicated, missing, unknown, or injected metadata before the APK's
# replacement conffile can be considered as a source.
load_upgrade_snapshot() {
	local line1 line2 line3 line4 line5 line6 line7 line8 line9 line10 extra
	local work_dir uid gid config_file yaml_hash yaml_size was_running
	local work_metadata work_mode work_owner work_group held_hash held_size valid=0
	local upper_work_dir

	[ "$IS_UPGRADE" = 1 ] || return 0
	validate_runtime_marker "$UPGRADE_MARKER" || return 1
	root_private_single_file "$UPGRADE_YAML_SNAPSHOT" &&
		root_private_single_file "$UPGRADE_WORKDIR_METADATA" || return 1
	[ "$(wc -l <"$UPGRADE_WORKDIR_METADATA" 2>/dev/null)" = 10 ] || return 1

	exec 7<"$UPGRADE_WORKDIR_METADATA" || return 1
	exec 8<"$UPGRADE_YAML_SNAPSHOT" || {
		exec 7<&-
		return 1
	}
	if held_root_private_file /proc/self/fd/7 "$UPGRADE_WORKDIR_METADATA" 1 4096 &&
	   held_root_private_file /proc/self/fd/8 "$UPGRADE_YAML_SNAPSHOT" 1 "$MAX_YAML_SIZE" &&
	   {
		IFS= read -r line1 && IFS= read -r line2 &&
		IFS= read -r line3 && IFS= read -r line4 &&
		IFS= read -r line5 && IFS= read -r line6 &&
		IFS= read -r line7 && IFS= read -r line8 &&
		IFS= read -r line9 && IFS= read -r line10 &&
		! IFS= read -r extra
	   } </proc/self/fd/7 &&
	   [ "$line1" = "format=1" ] &&
	   [ "$line2" = "source_version=2.1.0-r1" ]; then
		case "$line3" in workdir=*) work_dir="${line3#workdir=}" ;; *) work_dir="" ;; esac
		case "$line4" in uid=*) uid="${line4#uid=}" ;; *) uid="" ;; esac
		case "$line5" in gid=*) gid="${line5#gid=}" ;; *) gid="" ;; esac
		case "$line7" in config_file=*) config_file="${line7#config_file=}" ;; *) config_file="" ;; esac
		case "$line8" in yaml_sha256=*) yaml_hash="${line8#yaml_sha256=}" ;; *) yaml_hash="" ;; esac
		case "$line9" in yaml_size=*) yaml_size="${line9#yaml_size=}" ;; *) yaml_size="" ;; esac
		case "$line10" in was_running=*) was_running="${line10#was_running=}" ;; *) was_running="" ;; esac
		upper_work_dir="$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.workdir")"
		held_size="$(wc -c </proc/self/fd/8 2>/dev/null)"
		held_hash="$(snapshot_sha256 /proc/self/fd/8)"
		work_metadata="$(entry_metadata "$work_dir")"
		read -r work_mode _work_links work_owner work_group _work_remainder <<-EOF
		$work_metadata
		EOF
		if [ -n "$work_dir" ] &&
		   [ "$(normalize_work_dir "$work_dir")" = "$work_dir" ] &&
		   [ "$upper_work_dir" = "$work_dir" ] &&
		   [ "${OFFICIAL_WORK_DIR%/}" = "$work_dir" ] &&
		   [ "$OFFICIAL_CONFIG_FILE" = "${work_dir}/AdGuardHome.yaml" ] &&
		   [ "$config_file" = "${work_dir}/AdGuardHome.yaml" ] &&
		   [ "$line6" = "mode=0700" ] && [ "$work_mode" = "drwx------" ] &&
		   { [ "$work_owner:$work_group" = "0:0" ] ||
		     [ "$work_owner:$work_group" = "0:853" ] ||
		     [ "$work_owner:$work_group" = "853:853" ]; } &&
		   { [ "$uid:$gid" = "0:0" ] || [ "$uid:$gid" = "0:853" ] ||
		     [ "$uid:$gid" = "853:853" ]; } &&
		   [ "${#yaml_hash}" -eq 64 ] &&
		   [ -n "$held_hash" ] && [ "$held_hash" = "$yaml_hash" ] &&
		   [ "$yaml_size" = "$held_size" ] &&
		   [ "$yaml_size" -ge 1 ] 2>/dev/null &&
		   [ "$yaml_size" -le "$MAX_YAML_SIZE" ] 2>/dev/null &&
		   { [ "$was_running" = 0 ] || [ "$was_running" = 1 ]; } &&
		   held_root_private_file /proc/self/fd/7 "$UPGRADE_WORKDIR_METADATA" 1 4096 &&
		   held_root_private_file /proc/self/fd/8 "$UPGRADE_YAML_SNAPSHOT" 1 "$MAX_YAML_SIZE"; then
			valid=1
		fi
	fi
	exec 8<&-
	exec 7<&-
	[ "$valid" = 1 ] || return 1

	UPGRADE_SOURCE_WORK_DIR="$work_dir"
	UPGRADE_SOURCE_CONFIG_FILE="$config_file"
	UPGRADE_SOURCE_UID="$uid"
	UPGRADE_SOURCE_GID="$gid"
	UPGRADE_SOURCE_YAML_HASH="$yaml_hash"
	UPGRADE_SOURCE_YAML_SIZE="$yaml_size"
	UPGRADE_WAS_RUNNING="$was_running"
}

restore_upgrade_yaml_snapshot() {
	local candidate candidate_hash candidate_size copied=0
	[ "$IS_UPGRADE" = 1 ] || return 0
	[ "$TARGET_WORK_DIR" = "$UPGRADE_SOURCE_WORK_DIR" ] &&
		[ "$TARGET_CONFIG_FILE" = "$UPGRADE_SOURCE_CONFIG_FILE" ] || return 1
	new_private_temp yaml-migration || return 1
	candidate="$NEW_PRIVATE_TEMP"

	# Keep the cold snapshot inode open while copying it into the only candidate
	# namespace accepted by the packaged normalizer.  The snapshot is deliberately
	# root-only, so this copy must not fall back to the uid-853 migration reader.
	exec 7<"$UPGRADE_YAML_SNAPSHOT" || return 1
	if held_root_private_file /proc/self/fd/7 "$UPGRADE_YAML_SNAPSHOT" 1 "$MAX_YAML_SIZE" &&
	   [ "$(snapshot_sha256 /proc/self/fd/7)" = "$UPGRADE_SOURCE_YAML_HASH" ] &&
	   [ "$(wc -c </proc/self/fd/7 2>/dev/null)" = "$UPGRADE_SOURCE_YAML_SIZE" ] &&
	   run_bounded 5 1 /bin/dd if=/proc/self/fd/7 \
		bs=4096 count=129 of="$candidate" 2>/dev/null &&
	   chown 0:0 "$candidate" && chmod 0600 "$candidate" &&
	   bounded_regular_file "$candidate"; then
		candidate_hash="$(snapshot_sha256 "$candidate")"
		candidate_size="$(wc -c <"$candidate" 2>/dev/null)"
		if [ "$candidate_hash" = "$UPGRADE_SOURCE_YAML_HASH" ] &&
		   [ "$candidate_size" = "$UPGRADE_SOURCE_YAML_SIZE" ] &&
		   held_root_private_file /proc/self/fd/7 "$UPGRADE_YAML_SNAPSHOT" 1 "$MAX_YAML_SIZE" &&
		   [ "$(snapshot_sha256 /proc/self/fd/7)" = "$UPGRADE_SOURCE_YAML_HASH" ]; then
			copied=1
		fi
	fi
	exec 7<&-
	[ "$copied" = 1 ] || return 1

	# normalize_config() validates and atomically replaces this candidate with
	# the official core's normalized YAML.  Compare the installed file with that
	# normalized result, not with the raw v2.1 bytes.
	validate_yaml_candidate "$candidate" "$TARGET_WORK_DIR" || return 1
	install_yaml_candidate "$candidate" "$TARGET_CONFIG_FILE" 0 || return 1
	bounded_regular_file "$candidate" &&
		root_private_file "$TARGET_CONFIG_FILE" &&
		cmp -s "$candidate" "$TARGET_CONFIG_FILE"
}

restore_upgrade_workdir_metadata() (
	local descriptor=/proc/self/fd/9 config_descriptor=/proc/self/fd/8
	local metadata mode links owner group size config_owner config_group config_mode
	[ "$IS_UPGRADE" = 1 ] || exit 0
	[ "$TARGET_WORK_DIR" = "$UPGRADE_SOURCE_WORK_DIR" ] || exit 1
	exec 9<"$TARGET_WORK_DIR" || exit 1
	[ -d "$descriptor" ] && [ "$descriptor" -ef "$TARGET_WORK_DIR" ] || exit 1
	exec 8<>"$TARGET_CONFIG_FILE" || exit 1
	[ -f "$config_descriptor" ] && [ "$config_descriptor" -ef "$TARGET_CONFIG_FILE" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$config_descriptor" 2>/dev/null)" || exit 1
	read -r mode links owner group size _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -ge 1 ] 2>/dev/null && [ "$size" -le "$MAX_YAML_SIZE" ] 2>/dev/null || exit 1
	case "${UPGRADE_SOURCE_UID}:${UPGRADE_SOURCE_GID}" in
		0:0)
			config_owner=0
			config_group=0
			config_mode=0600
			;;
		0:"$ADGUARD_GID")
			config_owner=0
			config_group="$ADGUARD_GID"
			config_mode=0640
			;;
		"$ADGUARD_UID":"$ADGUARD_GID")
			config_owner="$ADGUARD_UID"
			config_group="$ADGUARD_GID"
			config_mode=0600
			;;
		*) exit 1 ;;
	esac
	chown "${config_owner}:${config_group}" "$config_descriptor" &&
		chmod "$config_mode" "$config_descriptor" || exit 1
	chown "${UPGRADE_SOURCE_UID}:${UPGRADE_SOURCE_GID}" "$descriptor" &&
		chmod 0700 "$descriptor" || exit 1
	[ "$descriptor" -ef "$TARGET_WORK_DIR" ] &&
		[ "$config_descriptor" -ef "$TARGET_CONFIG_FILE" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$descriptor" 2>/dev/null)" || exit 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = drwx------ ] && [ "$owner" = "$UPGRADE_SOURCE_UID" ] &&
		[ "$group" = "$UPGRADE_SOURCE_GID" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$config_descriptor" 2>/dev/null)" || exit 1
	read -r mode links owner group size _remainder <<-EOF
	$metadata
	EOF
	[ "$links" = 1 ] && [ "$owner" = "$config_owner" ] &&
		[ "$group" = "$config_group" ] || exit 1
	case "$config_mode:$mode" in
		0600:-rw-------|0640:-rw-r-----) ;;
		*) exit 1 ;;
	esac
	[ "$size" -ge 1 ] 2>/dev/null && [ "$size" -le "$MAX_YAML_SIZE" ] 2>/dev/null
)

is_allowed_data_source_work_dir() {
	[ "${1%/}" = "$OFFICIAL_DEFAULT_WORK_DIR" ] &&
		is_safe_source_work_dir "$1" && return 0
	is_managed_work_dir "$1"
}

ensure_upper_section() {
	uci -q get "${UCI_CONFIG}.${UCI_SECTION}" >/dev/null 2>&1 && return 0
	uci -q set "${UCI_CONFIG}.${UCI_SECTION}=AdGuardHome" || return 1
	UPPER_CHANGED=1
}

set_upper_option() {
	local option="$1"
	local value="$2"

	[ "$(uci -q get "${UCI_CONFIG}.${UCI_SECTION}.${option}")" = "$value" ] && return 0
	uci -q set "${UCI_CONFIG}.${UCI_SECTION}.${option}=${value}" || return 1
	UPPER_CHANGED=1
}

delete_upper_option() {
	local option="$1"

	uci -q get "${UCI_CONFIG}.${UCI_SECTION}.${option}" >/dev/null 2>&1 || return 0
	uci -q delete "${UCI_CONFIG}.${UCI_SECTION}.${option}" || return 1
	UPPER_CHANGED=1
