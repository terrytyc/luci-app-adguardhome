{
	"luci-app-adguardhome": {
		"description": "Grant permissions for the AdGuard Home LuCI app",
		"read": {
			"ubus": {
				"luci.adguardhome": [ "get_status", "get_version", "get_config_info", "get_settings", "get_log", "get_yaml" ]
			}
		},
		"write": {
			"ubus": {
				"luci.adguardhome": [ "set_yaml", "reset_yaml", "get_password_info", "set_password", "get_credentials", "set_credentials", "get_yaml_update", "set_settings", "get_settings_update" ]
			}
		}
	}
}
