#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

UCI_CONFIG="adguardhome"
OFFICIAL_SECTION="config"
LUCI_SECTION="luci"
DEFAULT_WORK_DIR="/etc/AdGuardHome"
DEFAULT_CONFIG_FILE="$DEFAULT_WORK_DIR/AdGuardHome.yaml"
PACKAGED_CONFIG_TEMPLATE="/usr/share/luci-app-adguardhome/default.yaml"
OFFICIAL_DEFAULT_CONFIG="/etc/adguardhome/adguardhome.yaml"
OFFICIAL_DEFAULT_WORK_DIR="/var/lib/adguardhome"
KEEP_FILE="/lib/upgrade/keep.d/luci-app-adguardhome"
SNAPSHOT_DIR="/root/.luci-app-adguardhome"
SNAPSHOT_UCI="$SNAPSHOT_DIR/official-adguardhome.uci"
SNAPSHOT_CONFIG="$SNAPSHOT_DIR/official-adguardhome.config"
SNAPSHOT_STATE="$SNAPSHOT_DIR/official-adguardhome.state"
SNAPSHOT_VERSION="$SNAPSHOT_DIR/snapshot-version"
MANAGED_CONFIG_SNAPSHOT="$SNAPSHOT_DIR/managed-adguardhome.config"
RUNTIME_DIR="/var/run/luci-app-adguardhome"
UPGRADE_STATE="$RUNTIME_DIR/upgrade-state"
MAX_FILE_SIZE=524288
ADGUARD_UID=853
ADGUARD_GID=853

TARGET_WORK_DIR=""
TARGET_CONFIG_FILE=""
SOURCE_WORK_DIR=""
SOURCE_CONFIG_FILE=""
USING_TEMPLATE=0
OFFICIAL_ENABLED=1
OFFICIAL_VERBOSE=0
UCI_CHANGED=0
INSTALL_COMMITTED=0
SNAPSHOT_STAGE=""
YAML_STAGE=""

run_bounded() (
	local limit="$1" grace="$2" marker="" child="" watchdog="" rc=0 expired=0
	shift 2
	case "$limit" in ""|*[!0-9]*) exit 125 ;; esac
	case "$grace" in ""|*[!0-9]*) exit 125 ;; esac
	[ "$#" -gt 0 ] || exit 125
	[ -x /usr/bin/setsid ] || exit 125
	marker="$(mktemp /tmp/luci-app-adguardhome-bounded.XXXXXX)" || exit 125
	chmod 0600 "$marker" || {
		rm -f "$marker"
		exit 125
	}
	printf '0\n' >"$marker" || {
		rm -f "$marker"
		exit 125
	}
	bounded_signal_session() {
		/bin/kill "-$1" -- "-$child" 2>/dev/null ||
			/bin/kill "-$1" "$child" 2>/dev/null || true
	}
	bounded_abort() {
		trap - HUP INT QUIT TERM
		[ -z "$watchdog" ] || /bin/kill -TERM "$watchdog" 2>/dev/null || true
		[ -z "$watchdog" ] || wait "$watchdog" 2>/dev/null || true
		if [ -n "$child" ]; then
			bounded_signal_session TERM
			sleep "$grace" 2>/dev/null || true
			bounded_signal_session KILL
			wait "$child" 2>/dev/null || true
		fi
		rm -f "$marker"
		exit 125
	}
	trap bounded_abort HUP INT QUIT TERM
	[ ! -e /proc/self/fd/187 ] || bounded_abort
	exec 187<&0 || bounded_abort
	/usr/bin/setsid "$@" <&187 187<&- &
	child=$!
	exec 187<&-
	(
		bounded_sleeper=""
		bounded_watchdog_abort() {
			trap - HUP INT QUIT TERM
			[ -z "$bounded_sleeper" ] || /bin/kill -TERM "$bounded_sleeper" 2>/dev/null || true
			[ -z "$bounded_sleeper" ] || wait "$bounded_sleeper" 2>/dev/null || true
			exit 1
		}
		bounded_watchdog_sleep() {
			sleep "$1" &
			bounded_sleeper=$!
			wait "$bounded_sleeper"
			bounded_sleep_rc=$?
			bounded_sleeper=""
			return "$bounded_sleep_rc"
		}
		trap bounded_watchdog_abort HUP INT QUIT TERM
		bounded_watchdog_sleep "$limit" || exit 1
		/bin/kill -0 -- "-$child" 2>/dev/null || /bin/kill -0 "$child" 2>/dev/null || exit 1
		printf '1\n' >"$marker" || exit 1
		bounded_signal_session TERM
		bounded_watchdog_sleep "$grace" || exit 0
		bounded_signal_session KILL
	) &
	watchdog=$!
	wait "$child" 2>/dev/null || rc=$?
	read -r expired <"$marker" 2>/dev/null || expired=0
	if [ "$expired" = 1 ]; then
		wait "$watchdog" 2>/dev/null || true
	else
		/bin/kill -TERM "$watchdog" 2>/dev/null || true
		wait "$watchdog" 2>/dev/null || true
	fi
	trap - HUP INT QUIT TERM
	rm -f "$marker"
	[ "$expired" = 1 ] && exit 124
	exit "$rc"
)

entry_metadata() {
	LC_ALL=C ls -ldn "$1" 2>/dev/null
}

root_private_directory() {
	local metadata mode owner group
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode _links owner group _rest <<-EOF
	$metadata
	EOF
	[ "$mode" = drwx------ ] && [ "$owner" = 0 ] && [ "$group" = 0 ]
}

root_private_file() {
	local metadata mode links owner group
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	metadata="$(entry_metadata "$1")" || return 1
	read -r mode links owner group _rest <<-EOF
	$metadata
	EOF
	[ "$mode" = -rw------- ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ]
}

bounded_private_file() {
	local size
	root_private_file "$1" || return 1
	size="$(wc -c <"$1" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_FILE_SIZE" ]
}

bounded_regular_file() {
	local size
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	size="$(wc -c <"$1" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_FILE_SIZE" ]
}

normalize_bool() {
	case "$1" in
		1|on|true|yes|enabled) printf '1\n' ;;
		0|off|false|no|disabled) printf '0\n' ;;
		*) return 1 ;;
	esac
}

path_contains_symlink() {
	local value="$1" remaining component current=""
	case "$value" in /*) ;; *) return 1 ;; esac
	remaining="$(printf '%s\n' "$value" | sed 's:^/::')"
	while [ -n "$remaining" ]; do
		component="$(printf '%s\n' "$remaining" | cut -d/ -f1)"
		current="$current/$component"
		[ ! -L "$current" ] || return 0
		[ "$remaining" = "$component" ] && break
		remaining="$(printf '%s\n' "$remaining" | sed 's:^[^/]*/::')"
	done
	return 1
}

trim_trailing_slashes() {
	printf '%s\n' "$1" | sed 's:/*$::'
}

valid_managed_work_dir() {
	local value parent
	value="$(trim_trailing_slashes "$1")" || return 1
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "$value/" in */./*|*/../*) return 1 ;; esac
	case "$value" in
		/etc/AdGuardHome|/etc/AdGuardHome-[A-Za-z0-9_.+@%:,=-]*) ;;
		/mnt/*/AdGuardHome|/mnt/*/AdGuardHome-[A-Za-z0-9_.+@%:,=-]*) ;;
		*) return 1 ;;
	esac
	! path_contains_symlink "$value" || return 1
	parent="$(dirname "$value")" || return 1
	[ -d "$parent" ] && [ ! -L "$parent" ]
}

resolve_source_file() {
	local value="$1" resolved
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
	esac
	case "$value/" in */./*|*/../*) return 1 ;; esac
	[ -f "$value" ] && [ ! -L "$value" ] || return 1
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	[ -f "$resolved" ] && [ ! -L "$resolved" ] || return 1
	case "$value" in
		/var/*|/tmp/*) case "$resolved" in /tmp/*) ;; *) return 1 ;; esac ;;
		*) ! path_contains_symlink "$value" || return 1 ;;
	esac
	printf '%s\n' "$resolved"
}

resolve_source_work_dir() {
	local value resolved
	value="$(trim_trailing_slashes "$1")" || return 1
	case "$value" in /var/*|/tmp/*) ;; *) return 1 ;; esac
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	case "$resolved" in /tmp/*) ;; *) return 1 ;; esac
	[ -d "$resolved" ] && [ ! -L "$resolved" ] || return 1
	printf '%s\n' "$resolved"
}

official_delta_is_clean() {
	local changes
	changes="$(uci -q changes "$UCI_CONFIG" 2>/dev/null)" || return 1
	[ -z "$changes" ]
}

validate_original_snapshot() {
	root_private_directory "$SNAPSHOT_DIR" &&
		bounded_private_file "$SNAPSHOT_UCI" &&
		bounded_private_file "$SNAPSHOT_CONFIG" &&
		root_private_file "$SNAPSHOT_STATE" &&
		root_private_file "$SNAPSHOT_VERSION" &&
		grep -qx 'package adguardhome' "$SNAPSHOT_UCI" &&
		grep -Eq '^was_running=[01]$' "$SNAPSHOT_STATE" &&
		[ "$(wc -l <"$SNAPSHOT_STATE" 2>/dev/null)" = 1 ] &&
		grep -qx '1' "$SNAPSHOT_VERSION"
}

cleanup_snapshot_stage() {
	[ -n "$SNAPSHOT_STAGE" ] || return 0
	rm -f "$SNAPSHOT_STAGE/official-adguardhome.uci" \
		"$SNAPSHOT_STAGE/official-adguardhome.config" \
		"$SNAPSHOT_STAGE/official-adguardhome.state" \
		"$SNAPSHOT_STAGE/snapshot-version" 2>/dev/null || true
	rmdir "$SNAPSHOT_STAGE" 2>/dev/null || true
	SNAPSHOT_STAGE=""
}

create_original_snapshot() {
	local running_rc=0 was_running=0
	[ ! -e "$SNAPSHOT_DIR" ] && [ ! -L "$SNAPSHOT_DIR" ] || return 1
	[ -f /etc/config/adguardhome ] && [ ! -L /etc/config/adguardhome ] || return 1
	official_delta_is_clean || return 1
	SNAPSHOT_STAGE="$(mktemp -d /root/.luci-app-adguardhome.XXXXXX)" || return 1
	chown 0:0 "$SNAPSHOT_STAGE" && chmod 0700 "$SNAPSHOT_STAGE" || return 1
	run_bounded 5 1 /bin/dd if=/etc/config/adguardhome \
		of="$SNAPSHOT_STAGE/official-adguardhome.config" bs=4096 count=129 \
		2>/dev/null || return 1
	run_bounded 5 1 uci -q export adguardhome \
		>"$SNAPSHOT_STAGE/official-adguardhome.uci" || return 1
	if [ -x /etc/init.d/adguardhome ]; then
		run_bounded 5 1 /etc/init.d/adguardhome running \
			>/dev/null 2>&1 || running_rc=$?
		case "$running_rc" in
			0) was_running=1 ;;
			1) was_running=0 ;;
			*) return 1 ;;
		esac
	fi
	printf 'was_running=%s\n' "$was_running" \
		>"$SNAPSHOT_STAGE/official-adguardhome.state" || return 1
	printf '1\n' >"$SNAPSHOT_STAGE/snapshot-version" || return 1
	chown 0:0 "$SNAPSHOT_STAGE"/* && chmod 0600 "$SNAPSHOT_STAGE"/* || return 1
	mv "$SNAPSHOT_STAGE" "$SNAPSHOT_DIR" || return 1
	SNAPSHOT_STAGE=""
	validate_original_snapshot
}

ensure_original_snapshot() {
	if [ -e "$SNAPSHOT_DIR" ] || [ -L "$SNAPSHOT_DIR" ]; then
		validate_original_snapshot
	else
		create_original_snapshot
	fi
}

upgrade_state_is_valid() {
	root_private_directory "$RUNTIME_DIR" &&
		root_private_file "$UPGRADE_STATE" &&
		[ "$(wc -l <"$UPGRADE_STATE" 2>/dev/null)" = 2 ] &&
		grep -qx 'source_version=2.4.0-r1' "$UPGRADE_STATE" &&
		grep -Eq '^was_running=[01]$' "$UPGRADE_STATE"
}

set_official_option() {
	local option="$1" value="$2" current
	current="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.$option")"
	[ "$current" = "$value" ] && return 0
	uci -q set "$UCI_CONFIG.$OFFICIAL_SECTION.$option=$value" || return 1
	UCI_CHANGED=1
}

ensure_luci_section() {
	local current
	current="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION")"
	[ "$current" = luci ] && return 0
	[ -z "$current" ] || return 1
	uci -q set "$UCI_CONFIG.$LUCI_SECTION=luci" || return 1
	UCI_CHANGED=1
}

set_luci_option() {
	local option="$1" value="$2" current
	current="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.$option")"
	[ "$current" = "$value" ] && return 0
	uci -q set "$UCI_CONFIG.$LUCI_SECTION.$option=$value" || return 1
	UCI_CHANGED=1
}

select_clean_install_source() {
	local configured_work configured_file packaged
	configured_work="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")"
	[ -n "$configured_work" ] || configured_work="$OFFICIAL_DEFAULT_WORK_DIR"
	configured_file="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.config_file")"
	[ -n "$configured_file" ] || configured_file="$OFFICIAL_DEFAULT_CONFIG"

	case "$configured_work" in
		/var/*|/tmp/*)
			if [ -e "$configured_work" ] || [ -L "$configured_work" ]; then
				SOURCE_WORK_DIR="$(resolve_source_work_dir "$configured_work")" ||
					return 1
			else
				SOURCE_WORK_DIR=""
			fi
			TARGET_WORK_DIR="$DEFAULT_WORK_DIR"
			;;
		*)
			valid_managed_work_dir "$configured_work" || return 1
			SOURCE_WORK_DIR=""
			TARGET_WORK_DIR="$(trim_trailing_slashes "$configured_work")" ||
				return 1
			;;
	esac
	TARGET_CONFIG_FILE="$TARGET_WORK_DIR/AdGuardHome.yaml"

	if [ -e "$configured_file" ] || [ -L "$configured_file" ]; then
		SOURCE_CONFIG_FILE="$(resolve_source_file "$configured_file")" || return 1
	elif [ -e "$TARGET_CONFIG_FILE" ] || [ -L "$TARGET_CONFIG_FILE" ]; then
		SOURCE_CONFIG_FILE="$(resolve_source_file "$TARGET_CONFIG_FILE")" ||
			return 1
	else
		SOURCE_CONFIG_FILE="$(resolve_source_file "$PACKAGED_CONFIG_TEMPLATE")" ||
			return 1
	fi
	packaged="$(resolve_source_file "$PACKAGED_CONFIG_TEMPLATE")" || return 1
	if cmp -s "$SOURCE_CONFIG_FILE" "$packaged"; then
		USING_TEMPLATE=1
	else
		USING_TEMPLATE=0
	fi
}

initialize_clean_options() {
	local enabled verbose redirect
	enabled="$(normalize_bool "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.enabled")")" ||
		enabled=1
	verbose="$(normalize_bool "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.verbose")")" ||
		verbose=0
	if [ "$USING_TEMPLATE" = 1 ]; then
		enabled=1
		redirect=dnsmasq-upstream
	else
		redirect=none
	fi
	OFFICIAL_ENABLED="$enabled"
	OFFICIAL_VERBOSE="$verbose"
	set_official_option enabled "$enabled" &&
		set_official_option verbose "$verbose" &&
		set_official_option config_file "$TARGET_CONFIG_FILE" &&
		set_official_option work_dir "$TARGET_WORK_DIR" &&
		set_luci_option redirect "$redirect" &&
		set_luci_option run_from_memory 0 &&
		set_luci_option memory_writeback_interval 60
}

secure_target_work_dir() {
	valid_managed_work_dir "$TARGET_WORK_DIR" || return 1
	if [ ! -e "$TARGET_WORK_DIR" ] && [ ! -L "$TARGET_WORK_DIR" ]; then
		mkdir -m 0700 "$TARGET_WORK_DIR" || return 1
	fi
	[ -d "$TARGET_WORK_DIR" ] && [ ! -L "$TARGET_WORK_DIR" ] || return 1
	chown 0:0 "$TARGET_WORK_DIR" && chmod 0700 "$TARGET_WORK_DIR"
}

install_selected_yaml() {
	local source="$SOURCE_CONFIG_FILE"
	bounded_regular_file "$source" || return 1
	if [ -e "$RUNTIME_DIR" ] || [ -L "$RUNTIME_DIR" ]; then
		root_private_directory "$RUNTIME_DIR" || return 1
	else
		mkdir -m 0700 "$RUNTIME_DIR" || return 1
		chown 0:0 "$RUNTIME_DIR" && chmod 0700 "$RUNTIME_DIR" || return 1
	fi
	YAML_STAGE="$(mktemp "$RUNTIME_DIR/yaml-migration.XXXXXX")" || return 1
	chown 0:0 "$YAML_STAGE" && chmod 0600 "$YAML_STAGE" || return 1
	run_bounded 5 1 /bin/dd if="$source" of="$YAML_STAGE" \
		bs=4096 count=129 2>/dev/null || return 1
	bounded_regular_file "$YAML_STAGE" || return 1
	run_bounded 120 5 /etc/init.d/AdGuardHome normalize_config \
		"$YAML_STAGE" "$TARGET_WORK_DIR" >/dev/null 2>&1 || return 1
	chown 0:0 "$YAML_STAGE" && chmod 0600 "$YAML_STAGE" || return 1
	mv -f "$YAML_STAGE" "$TARGET_CONFIG_FILE" || return 1
	YAML_STAGE=""
	rmdir "$RUNTIME_DIR" 2>/dev/null || true
	bounded_regular_file "$TARGET_CONFIG_FILE"
}

plain_data_tree() {
	local unsafe
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	unsafe="$(find "$1" -xdev \
		\( -type l -o -type b -o -type c -o -type p -o -type s \) \
		-print 2>/dev/null)" || return 1
	[ -z "$unsafe" ]
}

copy_official_data_if_needed() {
	local source_data target_data existing
	[ -n "$SOURCE_WORK_DIR" ] || return 0
	source_data="$SOURCE_WORK_DIR/data"
	target_data="$TARGET_WORK_DIR/data"
	[ -e "$source_data" ] || return 0
	plain_data_tree "$source_data" || return 1
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		[ -d "$target_data" ] && [ ! -L "$target_data" ] || return 1
		existing="$(find "$target_data" -mindepth 1 -maxdepth 1 -print 2>/dev/null)" ||
			return 1
		[ -z "$existing" ] || {
			echo "Existing managed data was kept; official data was not merged."
			return 0
		}
	else
		mkdir -m 0700 "$target_data" || return 1
	fi
	cp -a "$source_data/." "$target_data/" || return 1
	chown "$ADGUARD_UID:$ADGUARD_GID" "$target_data" &&
		chmod 0700 "$target_data"
}

baseline_config_is_valid() {
	local work config enabled verbose redirect memory interval changes
	[ "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION")" = adguardhome ] ||
		return 1
	[ "$(uci -q get "$UCI_CONFIG.$LUCI_SECTION")" = luci ] || return 1
	work="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")" || return 1
	config="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.config_file")" ||
		return 1
	valid_managed_work_dir "$work" || return 1
	[ "$config" = "$work/AdGuardHome.yaml" ] || return 1
	bounded_regular_file "$config" || return 1
	enabled="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.enabled")" || return 1
	verbose="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.verbose")" || return 1
	redirect="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.redirect")" || return 1
	memory="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.run_from_memory")" ||
		return 1
	interval="$(uci -q get "$UCI_CONFIG.$LUCI_SECTION.memory_writeback_interval")" ||
		return 1
	case "$enabled:$verbose:$memory" in [01]:[01]:[01]) ;; *) return 1 ;; esac
	case "$redirect" in none|dnsmasq-upstream|redirect) ;; *) return 1 ;; esac
	case "$interval" in ""|*[!0-9]*) return 1 ;; esac
	[ "$interval" -le 10080 ] || return 1
	changes="$(uci -q changes "$UCI_CONFIG" 2>/dev/null)" || return 1
	[ -z "$changes" ]
}

refresh_managed_config_snapshot() {
	local temporary
	root_private_directory "$SNAPSHOT_DIR" || return 1
	temporary="$(mktemp "$SNAPSHOT_DIR/.managed-adguardhome.config.XXXXXX")" ||
		return 1
	chown 0:0 "$temporary" && chmod 0600 "$temporary" || return 1
	run_bounded 5 1 /bin/dd if=/etc/config/adguardhome of="$temporary" \
		bs=4096 count=129 2>/dev/null || return 1
	bounded_private_file "$temporary" || return 1
	mv -f "$temporary" "$MANAGED_CONFIG_SNAPSHOT" || return 1
	bounded_private_file "$MANAGED_CONFIG_SNAPSHOT" &&
		cmp -s /etc/config/adguardhome "$MANAGED_CONFIG_SNAPSHOT"
}

keep_active_config() {
	local keep_dir
	keep_dir="$(dirname "$KEEP_FILE")" || return 1
	mkdir -p "$keep_dir" || return 1
	touch "$KEEP_FILE" || return 1
	grep -Fqx "$TARGET_CONFIG_FILE" "$KEEP_FILE" 2>/dev/null ||
		printf '%s\n' "$TARGET_CONFIG_FILE" >>"$KEEP_FILE"
	grep -Fqx "$SNAPSHOT_DIR/" "$KEEP_FILE" 2>/dev/null ||
		printf '%s/\n' "$SNAPSHOT_DIR" >>"$KEEP_FILE"
}

restore_original_config() {
	local temporary was_running
	validate_original_snapshot || return 1
	uci -q revert "$UCI_CONFIG" >/dev/null 2>&1 || true
	temporary="$(mktemp /etc/config/.adguardhome.rollback.XXXXXX)" || return 1
	run_bounded 5 1 /bin/dd if="$SNAPSHOT_CONFIG" of="$temporary" \
		bs=4096 count=129 2>/dev/null || return 1
	chown 0:0 "$temporary" && chmod 0600 "$temporary" || return 1
	mv -f "$temporary" /etc/config/adguardhome || return 1
	cmp -s "$SNAPSHOT_CONFIG" /etc/config/adguardhome || return 1
	was_running="$(sed -n 's/^was_running=//p' "$SNAPSHOT_STATE")"
	if [ "$was_running" = 1 ] && [ -x /etc/init.d/adguardhome ]; then
		/etc/init.d/adguardhome start >/dev/null 2>&1 || return 1
	fi
}

cleanup_install() {
	local rc=$?
	cleanup_snapshot_stage
	[ -z "$YAML_STAGE" ] || rm -f "$YAML_STAGE" 2>/dev/null || true
	if [ "$INSTALL_COMMITTED" != 1 ]; then
		restore_original_config >/dev/null 2>&1 || true
	fi
	exit "$rc"
}
trap cleanup_install 0
trap 'exit 1' HUP INT TERM

if [ "$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION")" != adguardhome ]; then
	echo "The official lowercase adguardhome configuration is unavailable." >&2
	exit 1
fi
official_delta_is_clean || {
	echo "Commit or revert pending official adguardhome changes first." >&2
	exit 1
}
ensure_original_snapshot || {
	echo "Unable to preserve the original official adguardhome state." >&2
	exit 1
}

if [ -e "$UPGRADE_STATE" ] || [ -L "$UPGRADE_STATE" ]; then
	upgrade_state_is_valid && baseline_config_is_valid || {
		echo "The 2.4 baseline upgrade state or configuration is invalid." >&2
		exit 1
	}
	TARGET_WORK_DIR="$(uci -q get "$UCI_CONFIG.$OFFICIAL_SECTION.work_dir")"
	TARGET_CONFIG_FILE="$TARGET_WORK_DIR/AdGuardHome.yaml"
	keep_active_config && refresh_managed_config_snapshot || exit 1
	INSTALL_COMMITTED=1
	trap - 0 HUP INT TERM
	exit 0
fi

select_clean_install_source || {
	echo "The official AdGuard Home source paths are outside the supported layout." >&2
	exit 1
}
run_bounded 20 2 /etc/init.d/adguardhome stop >/dev/null 2>&1 || {
	echo "Unable to stop the official AdGuard Home service for initialization." >&2
	exit 1
}
secure_target_work_dir && install_selected_yaml &&
	copy_official_data_if_needed || {
	echo "Unable to initialize the managed AdGuard Home work directory." >&2
	exit 1
}
ensure_luci_section && initialize_clean_options || exit 1
[ "$UCI_CHANGED" = 0 ] || uci -q commit "$UCI_CONFIG" || exit 1
baseline_config_is_valid && keep_active_config &&
	refresh_managed_config_snapshot || {
	echo "Unable to validate the initialized AdGuard Home configuration." >&2
	exit 1
}

INSTALL_COMMITTED=1
