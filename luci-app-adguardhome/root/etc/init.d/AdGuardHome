MANAGED_TLS_FINGERPRINT="managed_tls_fingerprint"
UCI_CONFIG_DIRECTORY="/etc/config"
UCI_DELTA_DIRECTORY="/tmp/.uci"

# The configured workdir is always the persistent backing store.  Memory mode
# mirrors only its data tree into this fixed plugin namespace.  The YAML stays
# at WORKDIR/AdGuardHome.yaml and the packaged binary and official lowercase
# service remain unchanged.
MEMORY_RUNTIME_DIR="/tmp/luci-app-adguardhome-memory"
MEMORY_WORK_DIR="${MEMORY_RUNTIME_DIR}/work"
MEMORY_DATA_DIR="${MEMORY_WORK_DIR}/data"
# Recognized only to repair a stale r1 lower-UCI pair after /tmp disappeared.
# r2 never creates or reads this path.
LEGACY_MEMORY_CONFIG_FILE="${MEMORY_WORK_DIR}/AdGuardHome.yaml"
MEMORY_STATE_FILE="${MEMORY_RUNTIME_DIR}/state"
MEMORY_JOURNAL_DIR="/root/.luci-app-adguardhome-memory"
MEMORY_JOURNAL_FILE="${MEMORY_JOURNAL_DIR}/checkpoint"
MEMORY_MIN_TMP_RESERVE_KIB=16384
MEMORY_MIN_SYSTEM_RESERVE_KIB=32768
MEMORY_WRITEBACK_DEFAULT_MINUTES=60
MEMORY_WRITEBACK_MAX_MINUTES=10080
MEMORY_LIVE_RUNTIME_DIR="/var/run/luci-app-adguardhome-memory-writeback"
MEMORY_LIVE_MARKER="${MEMORY_LIVE_RUNTIME_DIR}/active"

INTEGRATION_LOCK="/var/lock/AdGuardHome-integration.lock"
NORMALIZER_RUNTIME_DIR="/var/run/luci-app-adguardhome"
NORMALIZER_LOCK="${NORMALIZER_RUNTIME_DIR}/normalizer.lock"
MAINTENANCE_UPGRADE_MARKER="${NORMALIZER_RUNTIME_DIR}/maintenance-upgrade"
MAINTENANCE_CONFIG_SNAPSHOT="${NORMALIZER_RUNTIME_DIR}/maintenance-adguardhome.config"
MAINTENANCE_DELTA_SNAPSHOT="${NORMALIZER_RUNTIME_DIR}/maintenance-adguardhome.delta"
UPGRADE_STOPPED_MARKER="${NORMALIZER_RUNTIME_DIR}/upgrade-was-stopped"
YAML_JOB_RUNTIME_DIR="/var/run/luci-app-adguardhome-yaml"
YAML_MAINTENANCE_MARKER="${YAML_JOB_RUNTIME_DIR}/removing"
MONITOR_INTERVAL=2
# First boot can download and compile the packaged default filters before the
# DNS sockets appear, especially on slower routers.  Keep takeover disabled
# while allowing the official core enough time to become genuinely ready.
READY_TIMEOUT=120
READY_STABLE_COUNT=3

SNAPSHOT_MARKER="dnsmasq_snapshot"
SNAPSHOT_DNSMASQ_SECTION="dnsmasq_snapshot_section"
SNAPSHOT_ACTIVE_FINGERPRINT="dnsmasq_active_fingerprint"
