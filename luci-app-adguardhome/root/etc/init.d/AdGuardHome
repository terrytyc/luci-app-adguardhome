\tmemory_prepare\t\tPrepare the requested RAM workdir while stopped
\tmemory_status\t\tReport requested/active/backing RAM state"

log_error() {
	logger -t AdGuardHome "$*"
}

# Run one command in its own session with a self-contained wall-clock guard.
# Descriptor 187 preserves pipeline input before ash starts the async child.
run_bounded() (
	local limit="$1" grace="$2" marker="" child="" watchdog="" rc=0 expired=0
	shift 2
	case "$limit" in ""|*[!0-9]*) exit 125 ;; esac
	case "$grace" in ""|*[!0-9]*) exit 125 ;; esac
	[ "$#" -gt 0 ] || exit 125
	[ -x /usr/bin/setsid ] || exit 125
	marker="$(mktemp /tmp/luci-app-adguardhome-bounded.XXXXXX)" || exit 125
	chmod 0600 "$marker" || {
		rm -f "$marker"
		exit 125
	}
	printf '0\n' >"$marker" || {
		rm -f "$marker"
		exit 125
	}
	bounded_signal_session() {
		/bin/kill "-$1" -- "-$child" 2>/dev/null ||
			/bin/kill "-$1" "$child" 2>/dev/null || true
	}
	bounded_abort() {
		trap - HUP INT QUIT TERM
		[ -z "$watchdog" ] || /bin/kill -TERM "$watchdog" 2>/dev/null || true
		[ -z "$watchdog" ] || wait "$watchdog" 2>/dev/null || true
		if [ -n "$child" ]; then
			bounded_signal_session TERM
			sleep "$grace" 2>/dev/null || true
			bounded_signal_session KILL
			wait "$child" 2>/dev/null || true
		fi
		rm -f "$marker"
		exit 125
	}
	trap bounded_abort HUP INT QUIT TERM
	[ ! -e /proc/self/fd/187 ] || bounded_abort
	exec 187<&0 || bounded_abort
	/usr/bin/setsid "$@" <&187 187<&- &
	child=$!
	exec 187<&-
	(
		bounded_sleeper=""
		bounded_watchdog_abort() {
			trap - HUP INT QUIT TERM
			[ -z "$bounded_sleeper" ] || /bin/kill -TERM "$bounded_sleeper" 2>/dev/null || true
			[ -z "$bounded_sleeper" ] || wait "$bounded_sleeper" 2>/dev/null || true
			exit 1
		}
		bounded_watchdog_sleep() {
			sleep "$1" &
			bounded_sleeper=$!
			wait "$bounded_sleeper"
			bounded_sleep_rc=$?
			bounded_sleeper=""
			return "$bounded_sleep_rc"
		}
		trap bounded_watchdog_abort HUP INT QUIT TERM
		bounded_watchdog_sleep "$limit" || exit 1
		/bin/kill -0 -- "-$child" 2>/dev/null || /bin/kill -0 "$child" 2>/dev/null || exit 1
		printf '1\n' >"$marker" || exit 1
		bounded_signal_session TERM
		bounded_watchdog_sleep "$grace" || exit 0
		bounded_signal_session KILL
	) &
	watchdog=$!
	wait "$child" 2>/dev/null || rc=$?
	read -r expired <"$marker" 2>/dev/null || expired=0
	if [ "$expired" = 1 ]; then
		wait "$watchdog" 2>/dev/null || true
	else
		/bin/kill -TERM "$watchdog" 2>/dev/null || true
		wait "$watchdog" 2>/dev/null || true
	fi
	trap - HUP INT QUIT TERM
	rm -f "$marker"
	[ "$expired" = 1 ] && exit 124
	exit "$rc"
)

open_integration_lock_descriptor() {
	case "$1" in
		199) exec 199>>"$INTEGRATION_LOCK" ;;
		198) exec 198>>"$INTEGRATION_LOCK" ;;
		197) exec 197>>"$INTEGRATION_LOCK" ;;
		196) exec 196>>"$INTEGRATION_LOCK" ;;
		195) exec 195>>"$INTEGRATION_LOCK" ;;
		194) exec 194>>"$INTEGRATION_LOCK" ;;
		193) exec 193>>"$INTEGRATION_LOCK" ;;
		192) exec 192>>"$INTEGRATION_LOCK" ;;
		*) return 1 ;;
	esac
}

run_locked() (
	local lock_fd="" candidate
	mkdir -p "${INTEGRATION_LOCK%/*}" || exit 1
	# Pick an unused descriptor instead of clobbering a read-only staged YAML or
	# the update lock inherited by an asynchronous worker.  The descriptor is
	# owned by this subshell, so SIGKILL/OOM releases the kernel flock directly.
	for candidate in 199 198 197 196 195 194 193 192; do
		[ ! -e "/proc/self/fd/${candidate}" ] || continue
		open_integration_lock_descriptor "$candidate" || exit 1
		lock_fd="$candidate"
		break
	done
	[ -n "$lock_fd" ] || exit 1
	/usr/bin/flock -x "$lock_fd" || exit 1
	"$@"
)

close_integration_lock_descriptor() {
	case "$1" in
		199) exec 199>&- ;;
		198) exec 198>&- ;;
		197) exec 197>&- ;;
		196) exec 196>&- ;;
		195) exec 195>&- ;;
		194) exec 194>&- ;;
		193) exec 193>&- ;;
		192) exec 192>&- ;;
		*) return 1 ;;
	esac
}

# YAML updates install signal traps only after validating their held staging
# descriptor.  Run those transactions in rc.common's action process so TERM or
# an RPC worker cancellation reaches the rollback trap instead of killing an
# untrapped parent while an orphaned locking subshell continues the commit.
run_yaml_locked() {
	local lock_fd="" candidate command_rc
	mkdir -p "${INTEGRATION_LOCK%/*}" || return 1
	for candidate in 199 198 197 196 195 194 193 192; do
		[ ! -e "/proc/self/fd/${candidate}" ] || continue
		open_integration_lock_descriptor "$candidate" || return 1
		lock_fd="$candidate"
		break
	done
	[ -n "$lock_fd" ] || return 1
	if ! /usr/bin/flock -x "$lock_fd"; then
		close_integration_lock_descriptor "$lock_fd" >/dev/null 2>&1 || true
		return 1
	fi

	YAML_STAGE_CLEANUP=""
	YAML_BACKUP_CLEANUP=""
	YAML_INSTALLED=0
	YAML_WAS_RUNNING=0
	YAML_RUNTIME_PAUSED=0
	"$@"
	command_rc=$?
	finalize_yaml_update_process
	if ! close_integration_lock_descriptor "$lock_fd"; then
		[ "$command_rc" -ne 0 ] || command_rc=1
	fi
	return "$command_rc"
}

is_valid_port() {
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

normalize_memory_writeback_interval() {
	local value="$1"
	case "$value" in ""|*[!0-9]*) value="$MEMORY_WRITEBACK_DEFAULT_MINUTES" ;; esac
	while [ "${value#0}" != "$value" ]; do
		value="${value#0}"
	done
	[ -n "$value" ] || value=0
	if [ "${#value}" -gt 5 ] ||
	   [ "$value" -gt "$MEMORY_WRITEBACK_MAX_MINUTES" ] 2>/dev/null; then
		value="$MEMORY_WRITEBACK_DEFAULT_MINUTES"
	fi
	printf '%s\n' "$value"
}

monotonic_seconds() {
	local seconds fraction extra
	read -r seconds fraction extra </proc/uptime || return 1
	seconds="${seconds%%.*}"
	case "$seconds:$extra" in
		*[!0-9:]*|:*) return 1 ;;
	esac
	printf '%s\n' "$seconds"
}

validate_work_dir() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/)
			log_error "Invalid work directory: '${value}'"
			return 1
			;;
		/*) ;;
		*)
			log_error "Work directory must be absolute: '${value}'"
			return 1
			;;
	esac
	value="${value%/}"
	case "$value" in
		/*/*) ;;
		*)
			log_error "Work directory must not be a top-level directory: '${value}'"
			return 1
			;;
	esac
	case "$value" in
		*[!A-Za-z0-9_./+@%:,=-]*)
			log_error "Work directory contains unsafe characters: '${value}'"
			return 1
			;;
	esac
	case "${value}/" in
		*/./*|*/../*)
			log_error "Work directory contains a '.' or '..' component: '${value}'"
			return 1
			;;
	esac
	[ -n "$value" ] && [ "$value" != / ] && ! path_contains_symlink "$value"
}

validate_mnt_ancestors() {
	local value="${1%/}" parent remaining component current="" metadata mode owner
	local links group remainder
	case "$value" in /mnt/*) ;; *) return 0 ;; esac
	parent="${value%/*}"
	remaining="${parent#/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -e "$current" ] || [ -L "$current" ]; then
			if [ ! -d "$current" ] || [ -L "$current" ]; then
				log_error "Untrusted work-directory ancestor: '$current'"
				return 1
			fi
			metadata="$(LC_ALL=C ls -ldn "$current" 2>/dev/null)" || return 1
			read -r mode links owner group remainder <<-EOF
			$metadata
			EOF
			if [ "$owner" != 0 ]; then
				log_error "Work-directory ancestor is not root-owned: '$current'"
				return 1
			fi
			case "$mode" in
				?????w*|????????w*)
					log_error "Work-directory ancestor is group/world-writable: '$current'"
					return 1
					;;
			esac
		fi
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
}

validate_managed_work_dir_namespace() {
	local value="${1%/}"
	validate_work_dir "$1" || return 1
	case "$value" in
		/etc/AdGuardHome|/etc/AdGuardHome-?*|/mnt/*/AdGuardHome|/mnt/*/AdGuardHome-?*)
			;;
		*)
			log_error "Work directory is outside the dedicated AdGuard Home namespace: '$value'"
			return 1
			;;
	esac
	validate_mnt_ancestors "$value"
}

validate_managed_work_dir() {
	local value="${1%/}" official_work official_config
	validate_managed_work_dir_namespace "$1" || return 1
	[ "$value" = "$DEFAULT_WORK_DIR" ] && return 0
	[ -e "$value" ] || [ -L "$value" ] || return 0
	# While the official service runs from the fixed RAM mirror its effective
	# lower UCI deliberately points at MEMORY_WORK_DIR.  A root-private state
	# record is then the anchor for the still-persistent custom backing path.
	if memory_state_binds_persistent "$value"; then
		return 0
	fi
	official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	[ -n "$official_work" ] ||
		official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	official_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	if [ "${official_work%/}" = "$value" ] &&
	   [ "$official_config" = "${value}/AdGuardHome.yaml" ]; then
		return 0
	fi
	log_error "Refusing an existing custom work directory not anchored by official adguardhome UCI: '$value'"
	return 1
}

path_contains_symlink() {
	local remaining="${1#/}" component current=""
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -L "$current" ]; then
			# ImmortalWrt's standard rootfs intentionally provides /var -> /tmp;
			# the official adguardhome package uses /var/lib/adguardhome by
			# default.  Permit only that verified system link, never an arbitrary
			# user-controlled symlink.
			if [ "$current" = /var ]; then
				case "$(readlink "$current" 2>/dev/null)" in
					tmp|/tmp)
						[ "$remaining" = "$component" ] && break
						remaining="${remaining#*/}"
						continue
						;;
				esac
			fi
			log_error "Symlink path components are not allowed: '${current}'"
			return 0
		fi
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
	return 1
}

memory_runtime_dir_valid() {
	local metadata mode links owner group remainder
	[ -d "$MEMORY_RUNTIME_DIR" ] && [ ! -L "$MEMORY_RUNTIME_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_RUNTIME_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "drwx--x---" ] && [ "$links" -ge 2 ] 2>/dev/null &&
		[ "$owner" = 0 ] && [ "$group" = "$ADGUARD_GID" ]
}

# A prepare WAL is durable before this namespace is created.  Recovery may
# therefore observe either side of the root:root -> root:853 ownership handoff;
# accept those exact non-writable transitional modes only in journal recovery.
memory_prepare_runtime_dir_valid() {
	local metadata mode links owner group remainder
	[ -d "$MEMORY_RUNTIME_DIR" ] && [ ! -L "$MEMORY_RUNTIME_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_RUNTIME_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$links" -ge 2 ] 2>/dev/null || return 1
	case "$owner:$group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|0:"$ADGUARD_GID":drwx--x---) ;;
		*) return 1 ;;
	esac
}

memory_private_state_file() {
	local target="$1" metadata mode links owner group size remainder
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ] || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le 1024 ]
}

memory_active_tree_valid() {
	local metadata mode links owner group remainder entry found=0
	memory_runtime_dir_valid || return 1
	[ -d "$MEMORY_WORK_DIR" ] && [ ! -L "$MEMORY_WORK_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_WORK_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = \
		"$ADGUARD_UID:$ADGUARD_GID:drwx------" ] || return 1
	[ -d "$MEMORY_DATA_DIR" ] && [ ! -L "$MEMORY_DATA_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_DATA_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = \
		"$ADGUARD_UID:$ADGUARD_GID:drwx------" ] || return 1
	# The r2 RAM workdir has exactly one top-level entry: data/.  In particular,
	# never accept an r1 AdGuardHome.yaml copy as part of the active generation.
	for entry in \
		"$MEMORY_WORK_DIR"/* \
		"$MEMORY_WORK_DIR"/.[!.]* \
		"$MEMORY_WORK_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		[ "$entry" = "$MEMORY_DATA_DIR" ] && [ "$found" = 0 ] || return 1
		found=1
	done
	[ "$found" = 1 ] || return 1
	# The top-level shape alone cannot expose a same-device bind mount or a
	# special file nested below data/.  Reuse the bounded uid-853 tree scan and
	# its mountinfo checks before treating this RAM generation as active.
	uid853_tree_is_plain "$MEMORY_WORK_DIR"
}

# Return 0 for a complete state, 1 when no memory state exists, and 2 for an
# unsafe/incomplete namespace.  Callers must never delete a status-2 object.
memory_state_load() {
	local version backing device inode line_count
	MEMORY_STATE_VALIDATED=0
	MEMORY_STATE_PERSISTENT_WORK_DIR=""
	MEMORY_STATE_BACKING_DEVICE=""
	MEMORY_STATE_BACKING_INODE=""
	if [ ! -e "$MEMORY_RUNTIME_DIR" ] && [ ! -L "$MEMORY_RUNTIME_DIR" ]; then
		return 1
	fi
	memory_runtime_dir_valid || return 2
	memory_private_state_file "$MEMORY_STATE_FILE" || return 2
	line_count="$(wc -l <"$MEMORY_STATE_FILE" 2>/dev/null)" || return 2
	[ "$line_count" = 4 ] || return 2
	version="$(sed -n 's/^version=//p' "$MEMORY_STATE_FILE")"
	backing="$(sed -n 's/^persistent_work_dir=//p' "$MEMORY_STATE_FILE")"
	device="$(sed -n 's/^backing_device=//p' "$MEMORY_STATE_FILE")"
	inode="$(sed -n 's/^backing_inode=//p' "$MEMORY_STATE_FILE")"
	[ "$version" = 3 ] || return 2
	[ "$(grep -c '^version=' "$MEMORY_STATE_FILE" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^persistent_work_dir=' "$MEMORY_STATE_FILE" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^backing_device=' "$MEMORY_STATE_FILE" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^backing_inode=' "$MEMORY_STATE_FILE" 2>/dev/null)" = 1 ] || return 2
	case "$device:$inode" in
		*[!0-9:]*|:*|*::*) return 2 ;;
		[0-9]*:[0-9]*) ;;
		*) return 2 ;;
	esac
	validate_managed_work_dir_namespace "$backing" || return 2
	memory_backing_identity "$backing" || return 2
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = "$device:$inode" ] || return 2
	memory_active_tree_valid || return 2
	MEMORY_STATE_PERSISTENT_WORK_DIR="${backing%/}"
	MEMORY_STATE_BACKING_DEVICE="$device"
	MEMORY_STATE_BACKING_INODE="$inode"
	MEMORY_STATE_VALIDATED=1
	return 0
}

memory_state_binds_persistent() {
	local requested="${1%/}" state_rc=0
	if [ "${MEMORY_STATE_VALIDATED:-0}" = 1 ] &&
	   [ "$MEMORY_STATE_PERSISTENT_WORK_DIR" = "$requested" ]; then
		return 0
	fi
	memory_state_load || state_rc=$?
	[ "$state_rc" = 0 ] &&
		[ "$MEMORY_STATE_PERSISTENT_WORK_DIR" = "$requested" ]
}

memory_live_runtime_dir_valid() {
	local metadata mode links owner group remainder
	[ -d "$MEMORY_LIVE_RUNTIME_DIR" ] &&
		[ ! -L "$MEMORY_LIVE_RUNTIME_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_LIVE_RUNTIME_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$mode:$owner:$group" = "drwx------:0:0" ] &&
		[ "$links" -ge 2 ] 2>/dev/null
}

# A killed writer before the final marker rename has not yet changed DNS or
# stopped the core.  Discard only that exact root-private unpublished object;
# any other content is treated as unsafe and left untouched.
memory_discard_unpublished_live_marker() {
	local entry orphan="" found=0 metadata mode links owner group size remainder
	memory_live_runtime_dir_valid || return 1
	[ ! -e "$MEMORY_LIVE_MARKER" ] && [ ! -L "$MEMORY_LIVE_MARKER" ] || return 1
	for entry in \
		"$MEMORY_LIVE_RUNTIME_DIR"/* \
		"$MEMORY_LIVE_RUNTIME_DIR"/.[!.]* \
		"$MEMORY_LIVE_RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		[ "$found" = 0 ] || return 1
		case "$entry" in "$MEMORY_LIVE_RUNTIME_DIR"/.active.??????) ;;
			*) return 1 ;;
		esac
		case "${entry##*.}" in *[!A-Za-z0-9]*) return 1 ;; esac
		metadata="$(LC_ALL=C ls -ldn "$entry" 2>/dev/null)" || return 1
		read -r mode links owner group size remainder <<-EOF
		$metadata
		EOF
		[ "$mode:$links:$owner:$group" = "-rw-------:1:0:0" ] || return 1
		case "$size" in ""|*[!0-9]*) return 1 ;; esac
		[ "$size" -le 1024 ] 2>/dev/null || return 1
		found=1
		orphan="$entry"
	done
	[ "$found" = 0 ] || rm -f "$orphan" || return 1
	rmdir "$MEMORY_LIVE_RUNTIME_DIR"
}

# Return 0 for a published operation, 1 when none exists, and 2 for an unsafe
# marker.  The marker is volatile, but binds the same persistent inode as the
# RAM state so a stale or substituted pathname can never trigger a restart.
memory_live_marker_load() {
	local version backing device inode line_count entry found=0
	MEMORY_LIVE_BACKING=""
	MEMORY_LIVE_DEVICE=""
	MEMORY_LIVE_INODE=""
	if [ ! -e "$MEMORY_LIVE_RUNTIME_DIR" ] &&
	   [ ! -L "$MEMORY_LIVE_RUNTIME_DIR" ]; then
		return 1
	fi
	memory_live_runtime_dir_valid || return 2
	if [ ! -e "$MEMORY_LIVE_MARKER" ] && [ ! -L "$MEMORY_LIVE_MARKER" ]; then
		memory_discard_unpublished_live_marker || return 2
		return 1
	fi
	memory_private_state_file "$MEMORY_LIVE_MARKER" || return 2
	for entry in \
		"$MEMORY_LIVE_RUNTIME_DIR"/* \
		"$MEMORY_LIVE_RUNTIME_DIR"/.[!.]* \
		"$MEMORY_LIVE_RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		[ "$entry" = "$MEMORY_LIVE_MARKER" ] && [ "$found" = 0 ] || return 2
		found=1
	done
	[ "$found" = 1 ] || return 2
	line_count="$(wc -l <"$MEMORY_LIVE_MARKER" 2>/dev/null)" || return 2
	[ "$line_count" = 4 ] || return 2
	version="$(sed -n 's/^version=//p' "$MEMORY_LIVE_MARKER")"
	backing="$(sed -n 's/^persistent_work_dir=//p' "$MEMORY_LIVE_MARKER")"
	device="$(sed -n 's/^backing_device=//p' "$MEMORY_LIVE_MARKER")"
	inode="$(sed -n 's/^backing_inode=//p' "$MEMORY_LIVE_MARKER")"
	[ "$version" = 1 ] || return 2
	[ "$(grep -c '^version=' "$MEMORY_LIVE_MARKER" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^persistent_work_dir=' "$MEMORY_LIVE_MARKER" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^backing_device=' "$MEMORY_LIVE_MARKER" 2>/dev/null)" = 1 ] || return 2
	[ "$(grep -c '^backing_inode=' "$MEMORY_LIVE_MARKER" 2>/dev/null)" = 1 ] || return 2
	case "$device:$inode" in
		*[!0-9:]*|:*|*::*) return 2 ;;
		[0-9]*:[0-9]*) ;;
		*) return 2 ;;
	esac
	validate_managed_work_dir_namespace "$backing" || return 2
	memory_backing_identity "$backing" || return 2
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = "$device:$inode" ] || return 2
	MEMORY_LIVE_BACKING="${backing%/}"
	MEMORY_LIVE_DEVICE="$device"
	MEMORY_LIVE_INODE="$inode"
	return 0
}

memory_clear_live_checkpoint() {
	memory_live_marker_load || return 1
	rm -f "$MEMORY_LIVE_MARKER" || return 1
	[ ! -e "$MEMORY_LIVE_MARKER" ] && [ ! -L "$MEMORY_LIVE_MARKER" ] || return 1
	rmdir "$MEMORY_LIVE_RUNTIME_DIR"
}

load_legacy_settings() {
	local configured_work_dir official_work official_config legacy_work legacy_config state_rc=0
	config_load "$LEGACY_CONFIG"
	config_get_bool legacy_enabled "$LEGACY_SECTION" enabled 0
	config_get configured_work_dir "$LEGACY_SECTION" workdir "$DEFAULT_WORK_DIR"
	config_get redirect_mode "$LEGACY_SECTION" redirect "dnsmasq-upstream"
	config_get_bool verbose "$LEGACY_SECTION" verbose 0
	config_get_bool memory_requested "$LEGACY_SECTION" run_from_memory 0
	config_get memory_writeback_interval "$LEGACY_SECTION" memory_writeback_interval \
		"$MEMORY_WRITEBACK_DEFAULT_MINUTES"
	memory_writeback_interval="$(normalize_memory_writeback_interval \
		"$memory_writeback_interval")" || return 1
	official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	official_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	legacy_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	legacy_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	previous_work_dir="$official_work"
	[ -n "$previous_work_dir" ] || previous_work_dir="$legacy_work"
	# Recover a durable RAM copy/checkpoint transaction before validating the
	# backing metadata.  A crash may intentionally leave that inode frozen at
	# root:853/0710, which is accepted only while the root-private journal binds
	# its path and device/inode identity.
	# The durable journal binds its own backing path and device/inode.  Recover it
	# before interpreting a possibly newer upper-UCI workdir request; otherwise a
	# path change made just before a crash could permanently block safe recovery.
	memory_recover_journal_locked "" || return 1

	MEMORY_ACTIVE=0
	MEMORY_BACKING_WORK_DIR=""
	memory_state_load || state_rc=$?
	case "$state_rc" in
		0)
			;;
		1)
			# A generic `uci commit` can persist the otherwise volatile RAM
			# delta.  After reboot /tmp is empty, so repair only the exact fixed
			# pair from the trusted upper workdir before validating its anchor.
			if [ "${official_work%/}" = "$MEMORY_WORK_DIR" ] ||
			   [ "$official_config" = "$LEGACY_MEMORY_CONFIG_FILE" ] ||
			   [ "${legacy_work%/}" = "$MEMORY_WORK_DIR" ] ||
			   [ "$legacy_config" = "$LEGACY_MEMORY_CONFIG_FILE" ]; then
				if [ "${official_work%/}" != "$MEMORY_WORK_DIR" ] ||
				   { [ "$official_config" != "${configured_work_dir%/}/AdGuardHome.yaml" ] &&
				     [ "$official_config" != "$LEGACY_MEMORY_CONFIG_FILE" ]; }; then
					log_error "Incomplete committed AdGuard Home memory paths"
					return 1
				fi
				memory_commit_official_persistent_paths "$configured_work_dir" || return 1
				official_work="${configured_work_dir%/}"
				official_config="${official_work}/AdGuardHome.yaml"
				legacy_work=""
				legacy_config=""
				previous_work_dir="$official_work"
				log_error "Repaired committed AdGuard Home memory paths after reboot"
			fi
			;;
		2)
			# An invalid RAM namespace matters only when it was requested or the
			# official service is effectively pointed at it.  Disk mode otherwise
			# remains available without touching the foreign object.
			if [ "$memory_requested" = 1 ] ||
			   [ "${official_work%/}" = "$MEMORY_WORK_DIR" ] ||
			   [ "$official_config" = "$LEGACY_MEMORY_CONFIG_FILE" ] ||
			   [ "${legacy_work%/}" = "$MEMORY_WORK_DIR" ] ||
			   [ "$legacy_config" = "$LEGACY_MEMORY_CONFIG_FILE" ]; then
				log_error "Unsafe or incomplete AdGuard Home memory namespace"
				return 1
			fi
			;;
		*) return 1 ;;
	esac

	validate_managed_work_dir "$configured_work_dir" || return 1
	persistent_work_dir="${configured_work_dir%/}"
	persistent_config_file="${persistent_work_dir}/AdGuardHome.yaml"
	work_dir="$persistent_work_dir"
	config_file="$persistent_config_file"
	if [ "$state_rc" = 0 ]; then
		MEMORY_ACTIVE=1
		MEMORY_BACKING_WORK_DIR="$MEMORY_STATE_PERSISTENT_WORK_DIR"
		previous_work_dir="$MEMORY_BACKING_WORK_DIR"
		work_dir="$MEMORY_WORK_DIR"
		# A new upper-UCI workdir request is reconciled only after the current
		# generation has stopped and checkpointed.  Until then its YAML remains
		# the persistent file bound by the v3 state record, never the newly
		# requested directory and never a RAM copy.
		config_file="${MEMORY_BACKING_WORK_DIR}/AdGuardHome.yaml"
		# Recover the volatile lower-UCI work-dir override after a killed commit
		# guard or an accidental global UCI commit in the same boot.  The v3 state
		# record has already bound both the RAM data tree and persistent inode;
		# config_file always remains the persistent YAML.
		memory_apply_official_path_delta || return 1
	fi

	case "$redirect_mode" in
		none|redirect|dnsmasq-upstream) ;;
		exchange) redirect_mode="redirect" ;;
		*)
			log_error "Invalid redirect mode '${redirect_mode}', using none"
			redirect_mode="none"
			;;
	esac
}

# The official YAML is the sole runtime authority for the DNS listener.  The
# packaged value 53335 is only present in the clean-install template; an
# existing missing or invalid value must fail closed instead of being replaced.
load_runtime_dns_port() {
	local value address web_port directory snapshot
	if [ ! -f "$config_file" ] || [ -L "$config_file" ]; then
		log_error "Config file is unavailable while reading the DNS port: ${config_file}"
		return 1
	fi
	directory="$(mktemp -d /tmp/AdGuardHome-runtime.XXXXXX)" || return 1
	snapshot="${directory}/AdGuardHome.yaml"
	if ! snapshot_config_file "$config_file" "$snapshot" "" ""; then
		rm -rf "$directory"
		log_error "Unable to take a safe YAML snapshot: ${config_file}"
		return 1
	fi
	value="$(yaml_get_section_value dns port "$snapshot")"
	address="$(yaml_get_section_value http address "$snapshot")"
	rm -rf "$directory" || return 1
	is_valid_port "$value" || {
		log_error "Invalid or ambiguous dns.port in ${config_file}"
		return 1
	}
	dns_port="$(awk -v value="$value" 'BEGIN { printf "%d\n", value + 0 }')" || return 1
	if [ "$dns_port" -eq 53 ] 2>/dev/null && [ "$redirect_mode" != none ]; then
		log_error "DNS port 53 is only supported when DNS integration mode is none"
		return 1
	fi

	if [ -n "$address" ]; then
		case "$address" in
			*:*) web_port="${address##*:}" ;;
		esac
	fi
	if is_valid_port "$web_port" && [ "$dns_port" -eq "$web_port" ] 2>/dev/null; then
		log_error "The YAML DNS and HTTP ports must be different: ${dns_port}"
		return 1
	fi
}

# Locate a key at the section's actual shallowest indentation.  This accepts
# both two- and four-space YAML and does not mistake nested keys for children.
yaml_get_section_value() {
	local section="$1" key="$2" file="$3"
	awk -v section="$section" -v key="$key" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		{ line[++n] = $0 }
		END {
			for (i = 1; i <= n; i++)
				if (line[i] ~ ("^" section ":[[:space:]]*($|#)")) { sections++; if (!first) first = i }
			if (sections != 1) exit
			last = n
			for (i = first + 1; i <= n; i++)
				if (top(line[i])) { last = i - 1; break }
			depth = 0
			for (i = first + 1; i <= last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d = indent(line[i]); if (!depth || d < depth) depth = d
			}
			if (!depth) depth = 2
			for (i = first + 1; i <= last; i++) {
				if (indent(line[i]) != depth) continue
				value = substr(line[i], depth + 1)
				if (value !~ ("^" key ":[[:space:]]*")) continue
				matches++
				sub("^" key ":[[:space:]]*", "", value)
				sub(/[[:space:]]+#.*$/, "", value)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if ((substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") ||
				    (substr(value,1,1)=="\047" && substr(value,length(value),1)=="\047"))
					value = substr(value, 2, length(value) - 2)
				result = value
			}
			if (matches == 1) print result
		}' "$file"
}

install_yaml_temp() {
	local generated="$1" file="$2" replacement
	replacement="$(mktemp "${file}.install.XXXXXX")" || return 1
	# The generated file is already root-private.  Do not root-copy the
	# replaceable source pathname merely to preserve metadata; apply the narrow
	# managed permissions directly to the new inode before the atomic rename.
	if ! cat "$generated" >"$replacement"; then
		rm -f "$replacement"
		return 1
	fi
	chmod 0600 "$replacement" || {
		rm -f "$replacement"
		return 1
	}
	rm -f "$generated" || {
		rm -f "$replacement"
		return 1
	}
	mv "$replacement" "$file" || {
		rm -f "$replacement"
		return 1
	}
}

# Replace an existing list item without disturbing user-added entries.  This is
# used to keep AdGuard Home's default local-filter allowlist aligned when the
# managed work directory moves.
yaml_replace_section_list_item() {
	local section="$1" key="$2" old_value="$3" new_value="$4" file="$5" tmp rc
	[ -n "$old_value" ] || return 3
	tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
	awk -v section="$section" -v key="$key" -v old="$old_value" -v replacement="$new_value" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(count, s, i) { s=""; for(i=0;i<count;i++)s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for(i=1;i<=n;i++)
				if(line[i] ~ ("^" section ":[[:space:]]*($|#)")){first=i;break}
			if(!first){for(i=1;i<=n;i++)print line[i]; exit 3}
			last=n
			for(i=first+1;i<=n;i++)if(top(line[i])){last=i-1;break}
			depth=0
			for(i=first+1;i<=last;i++){
				if(line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/)continue
				d=indent(line[i]); if(!depth || d<depth)depth=d
			}
			if(!depth)depth=2
			for(i=first+1;i<=last;i++){
				if(indent(line[i])!=depth)continue
				candidate=substr(line[i],depth+1)
				if(candidate ~ ("^" key ":[[:space:]]*")){key_line=i;break}
			}
			if(!key_line){for(i=1;i<=n;i++)print line[i]; exit 3}
			block_last=last
			for(i=key_line+1;i<=last;i++){
				if(line[i] ~ /^[[:space:]]*($|#)/)continue
				if(indent(line[i])<=depth){block_last=i-1;break}
			}
			for(i=key_line+1;i<=block_last;i++){
				if(indent(line[i])<=depth)continue
				value=substr(line[i],indent(line[i])+1)
				if(value !~ /^-[[:space:]]*/)continue
				sub(/^-[[:space:]]*/, "", value)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if((substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") ||
				   (substr(value,1,1)=="\047" && substr(value,length(value),1)=="\047"))
					value=substr(value,2,length(value)-2)
				if(value==old){
					line[i]=pad(indent(line[i])) "- " replacement
					changed=1
				}
			}
			for(i=1;i<=n;i++)print line[i]
			if(!changed)exit 3
		}' "$file" >"$tmp"
	rc=$?
	case "$rc" in
		0)
			if ! install_yaml_temp "$tmp" "$file"; then
				rm -f "$tmp"
				return 1
			fi
			;;
		3)
			rm -f "$tmp"
			return 3
			;;
		*)
			rm -f "$tmp"
			return 1
			;;
	esac
}

secure_active_paths() {
	local data_dir="${work_dir}/data" metadata mode links owner group remainder
	[ -d "$work_dir" ] || return 1
	[ ! -L "$work_dir" ] || return 1
	[ -f "$config_file" ] || return 1
	[ ! -L "$config_file" ] || return 1
	path_contains_symlink "$work_dir" && return 1
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) return 1 ;;
	esac
	if [ -e "$data_dir" ] || [ -L "$data_dir" ]; then
		if [ ! -d "$data_dir" ] || [ -L "$data_dir" ]; then
			log_error "Unsafe AdGuard Home data path: ${data_dir}"
			return 1
		fi
	fi
}

secure_active_config() (
	local directory snapshot metadata mode links owner group size remainder
	local workdir_fd old_fd stage_fd stage="" capture verify old_hash snapshot_fd=""
	secure_active_paths || exit 1
	umask 077
	directory="$(mktemp -d /tmp/AdGuardHome-secure.XXXXXX)" || exit 1
	trap '[ -z "$stage" ] || rm -f "$stage"; rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"

	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || exit 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------)
			metadata="$(LC_ALL=C ls -ldn "$config_file" 2>/dev/null)" || exit 1
			read -r mode links owner group size remainder <<-EOF
			$metadata
			EOF
			case "$owner" in
				0) ;;
				"$ADGUARD_UID")
					# The package installer can leave a service-owned YAML inside a
					# root-private directory before the official service first starts.
					# Do not relax the directory or chown that inode: an old writer FD
					# would retain access.  With the namespace frozen at 0700, copy the
					# exact bounded inode into a new private inode and atomically replace
					# it.  The official service will chown it back on its next start.
					[ "$group:$mode:$links" = "$ADGUARD_GID:-rw-------:1" ] ||
						[ "$group:$mode:$links" = "$ADGUARD_GID:-rw-r-----:1" ] || exit 1
					case "$size" in ""|*[!0-9]*) exit 1 ;; esac
					[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
					official_running && exit 1
					exec 7<"$work_dir" || exit 1
					workdir_fd=/proc/self/fd/7
					[ -d "$workdir_fd" ] && [ "$workdir_fd" -ef "$work_dir" ] || exit 1
					exec 8<"$config_file" || exit 1
					old_fd=/proc/self/fd/8
					[ -f "$old_fd" ] && [ "$old_fd" -ef "$config_file" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$old_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group size remainder <<-EOF
					$metadata
					EOF
					case "$owner:$group:$mode:$links" in
						"$ADGUARD_UID":"$ADGUARD_GID":-rw-------:1|"$ADGUARD_UID":"$ADGUARD_GID":-rw-r-----:1) ;;
						*) exit 1 ;;
					esac
					case "$size" in ""|*[!0-9]*) exit 1 ;; esac
					[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
					# Two bounded captures must agree before the active pathname can be
					# replaced.  Hash only those private captures, never the mutable old
					# inode directly, so an old writer cannot create an unbounded read.
					capture="${directory}/service-owned.yaml"
					verify="${directory}/service-owned-verify.yaml"
					snapshot_config_file "$config_file" "$capture" "" 8 || exit 1
					old_hash="$SNAPSHOT_CONFIG_HASH"
					snapshot_config_file "$config_file" "$verify" "$old_hash" 8 || exit 1
					stage="$(mktemp "${work_dir}/.AdGuardHome-secure.XXXXXX")" || exit 1
					exec 9<>"$stage" || exit 1
					stage_fd=/proc/self/fd/9
					[ -f "$stage_fd" ] && [ "$stage_fd" -ef "$stage" ] || exit 1
					run_bounded 3 1 /bin/dd if="$capture" bs=4096 count=129 \
						of="$stage_fd" 2>/dev/null || exit 1
					secure_config_inode "$stage_fd" || exit 1
					# This is the final size/hash gate before rename.  A truncate or
					# growth beyond MAX_YAML_SIZE therefore leaves the old path intact.
					snapshot_config_file "$stage" "$snapshot" "$old_hash" 9 || exit 1
					[ -f "$old_fd" ] && [ ! -L "$config_file" ] &&
						[ "$old_fd" -ef "$config_file" ] || exit 1
					[ -d "$workdir_fd" ] && [ "$workdir_fd" -ef "$work_dir" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$workdir_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group remainder <<-EOF
					$metadata
					EOF
					case "$owner:$group:$mode" in
						0:0:drwx------|0:"$ADGUARD_GID":drwx------) ;;
						*) exit 1 ;;
					esac
					official_running && exit 1
					mv "$stage" "$config_file" || exit 1
					stage=""
					[ "$stage_fd" -ef "$config_file" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$stage_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group size remainder <<-EOF
					$metadata
					EOF
					[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
					snapshot_fd=9
					;;
				*) exit 1 ;;
			esac
			;;
		"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) exit 1 ;;
	esac

	snapshot_config_file "$config_file" "$snapshot" "$old_hash" "$snapshot_fd" || exit 1
)

secure_config_inode() {
	local inode_path="$1" metadata mode owner links group remainder
	case "$inode_path" in /proc/self/fd/[0-9]*|/proc/[0-9]*/fd/[0-9]*) ;; *) return 1 ;; esac
	[ -f "$inode_path" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner" in
		0)
			chown 0:0 "$inode_path" && chmod 0600 "$inode_path"
			;;
		"$ADGUARD_UID")
			# A previously-running official service owns the workdir.  Keep an
			# edited, root-owned YAML group-readable so disabled -> edit -> enable
			# can still be opened by the official uid without making it writable.
			chown "0:${ADGUARD_GID}" "$inode_path" && chmod 0640 "$inode_path"
			;;
		*)
			log_error "Unexpected AdGuard Home work-directory owner: ${owner}"
			return 1
			;;
	esac
}

ensure_config_file() {
	local source directory candidate candidate_hash
	if [ -L "$config_file" ]; then
		log_error "The AdGuard Home configuration file must not be a symlink: ${config_file}"
		return 1
	fi
	if [ -f "$config_file" ]; then
		secure_active_config
		return
	fi
	mkdir -m 0700 -p "$work_dir" || return 1
	path_contains_symlink "$work_dir" && return 1
	source="$PACKAGED_CONFIG_TEMPLATE"
	if [ ! -f "$source" ] || [ -L "$source" ]; then
		log_error "Packaged AdGuard Home configuration template is missing: ${source}"
		return 1
	fi
	directory="$(mktemp -d /tmp/AdGuardHome-seed.XXXXXX)" || return 1
	candidate="${directory}/AdGuardHome.yaml"
	if ! snapshot_config_file "$source" "$candidate" "" ""; then
		rm -rf "$directory"
		return 1
	fi
	candidate_hash="$(yaml_file_hash "$candidate")" || {
		rm -rf "$directory"
		return 1
	}
	if [ -e "$config_file" ] || [ -L "$config_file" ]; then
		rm -rf "$directory"
		log_error "Configuration path appeared while initializing: ${config_file}"
		return 1
	fi
	install_config_candidate "$candidate" absent "$candidate_hash" "" || {
		rm -rf "$directory"
		return 1
	}
	rm -rf "$directory" || return 1
	secure_active_config
}

uid853_tree_is_plain() {
	local tree="$1"
	[ -d "$tree" ] && [ ! -L "$tree" ] || return 1
	tree_is_mount_free "$tree" || return 1
	# $1 and found intentionally expand only in the lowered child shell.
	# shellcheck disable=SC2016
	run_bounded 30 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataScan -x /bin/sh -- -c '
			set -o pipefail
			found="$(/usr/bin/find "$1" -xdev ! -type f ! -type d -print 2>/dev/null |
				/usr/bin/head -n 1)" || exit 1
			[ -z "$found" ]
		' sh "$tree" >/dev/null 2>&1 || return 1
	tree_is_mount_free "$tree"
}

uid853_tree_is_writable() {
	local tree="$1"
	uid853_tree_is_plain "$tree" || return 1
	# A structurally plain tree may still contain foreign-owned or read-only
	# entries.  cp -p must own each destination inode in order to preserve mode
	# and timestamps, so require uid/gid 853 in addition to probing access as that
	# user.  An unusable tree is treated as damaged and rebuilt by the caller.
	# $1..$3 and found intentionally expand only in the lowered child shell.
	# shellcheck disable=SC2016
	run_bounded 30 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataWriteScan -x /bin/sh -- -c '
			set -o pipefail
			found="$(/usr/bin/find "$1" -xdev \( -user "$2" -group "$3" \( -type d -exec /bin/sh -c '\''[ -w "$1" ] && [ -x "$1" ]'\'' sh {} \; -o -type f -exec /bin/sh -c '\''[ -w "$1" ]'\'' sh {} \; \) -o -print \) 2>/dev/null | /usr/bin/head -n 1)" || exit 1
			[ -z "$found" ]
		' sh "$tree" "$ADGUARD_UID" "$ADGUARD_GID" >/dev/null 2>&1 || return 1
	tree_is_mount_free "$tree"
}

# `find -xdev` rejects entries on another filesystem but cannot identify a
# same-device bind mount.  Consult mountinfo as well before any recursive copy
# or removal so a nested mount can never turn a private data-tree operation
# into an operation on the mounted target.  Managed paths exclude whitespace
# and backslashes, so its literal prefix can be compared directly with the
# escaped mountpoint field (escapes may occur only after that safe prefix).
tree_is_mount_free() {
	local tree="${1%/}"
	case "$tree" in /*) ;; *) return 1 ;; esac
	[ -r /proc/self/mountinfo ] || return 1
	awk -v base="$tree" '
		{
			path = $5
			if (path == base || index(path, base "/") == 1)
				found = 1
		}
		END { exit found ? 1 : 0 }
	' /proc/self/mountinfo
}

restore_workdir_access() {
	chown "$2:$3" "$1" && chmod 0700 "$1"
}

sync_yaml_workdir_pattern() {
	local target_file="${1:-$config_file}" old_pattern desired_pattern replace_rc=0
	[ -n "$previous_work_dir" ] || return 0
	old_pattern="${previous_work_dir%/}/data/userfilters/*"
	desired_pattern="${work_dir}/data/userfilters/*"
	[ "$old_pattern" != "$desired_pattern" ] || return 0
	yaml_replace_section_list_item filtering safe_fs_patterns \
		"$old_pattern" "$desired_pattern" "$target_file" || replace_rc=$?
	case "$replace_rc" in
		0|3) ;;
		*) return 1 ;;
	esac
}

sync_yaml_stale_memory_pattern() {
	local target_file="${1:-$config_file}"
	# A power loss removes the volatile generation and its state record but can
	# leave the exact RAM user-filter allowlist in the persistent YAML.  Before
	# any disk-backed launch, normalize that one managed value back to the
	# current persistent workdir.  Active RAM mode deliberately keeps it.
	[ "${work_dir%/}" != "$MEMORY_WORK_DIR" ] || return 0
	memory_rewrite_workdir_pattern "$MEMORY_WORK_DIR" "$work_dir" "$target_file"
}

sync_yaml_managed_fields() {
	sync_yaml_stale_memory_pattern "$1" || return 1
	sync_yaml_workdir_pattern "$1"
}

memory_rewrite_workdir_pattern() {
	local old_value="$1" new_value="$2" target="$3" rewrite_rc=0
	yaml_replace_section_list_item filtering safe_fs_patterns \
		"${old_value%/}/data/userfilters/*" \
		"${new_value%/}/data/userfilters/*" "$target" || rewrite_rc=$?
	case "$rewrite_rc" in
		0|3) return 0 ;;
		*) return 1 ;;
	esac
}

root_held_tree_is_plain() {
	local descriptor="$1" original="$2"
	case "$descriptor" in /proc/self/fd/[0-9]*|/proc/[0-9]*/fd/[0-9]*) ;; *) return 1 ;; esac
	[ -d "$descriptor" ] && [ "$descriptor" -ef "$original" ] || return 1
	tree_is_mount_free "$original" || return 1
	# find does not follow symlinks by default.  Traverse the held directory
	# inode, not its mutable pathname, and reject every non-file/non-directory
	# entry without opening file contents as root.
	# shellcheck disable=SC2016
	run_bounded 30 2 /bin/sh -c '
		set -o pipefail
		mounts_before="$(/usr/bin/sha256sum /proc/self/mountinfo 2>/dev/null)" || exit 1
		mounts_before="${mounts_before%% *}"
		case "$mounts_before" in *[!0-9a-f]*) exit 1 ;; esac
		[ "${#mounts_before}" = 64 ] || exit 1
		found="$(/usr/bin/find "$1/." -xdev ! -type f ! -type d -print 2>/dev/null |
			/usr/bin/head -n 1)" || exit 1
		[ -z "$found" ] || exit 1
		mounts_after="$(/usr/bin/sha256sum /proc/self/mountinfo 2>/dev/null)" || exit 1
		mounts_after="${mounts_after%% *}"
		case "$mounts_after" in *[!0-9a-f]*) exit 1 ;; esac
		[ "${#mounts_after}" = 64 ] || exit 1
		[ "$mounts_before" = "$mounts_after" ]
	' sh "$descriptor" >/dev/null 2>&1 || return 1
	[ -d "$descriptor" ] && [ "$descriptor" -ef "$original" ] &&
		tree_is_mount_free "$original"
}

memory_source_size_kib() (
	local data_dir="${persistent_work_dir}/data" data_size=0 data_fd
	if [ -e "$data_dir" ] || [ -L "$data_dir" ]; then
		[ -d "$data_dir" ] && [ ! -L "$data_dir" ] || return 1
		exec 8<"$data_dir" || return 1
		data_fd=/proc/self/fd/8
		root_held_tree_is_plain "$data_fd" "$data_dir" || return 1
		data_size="$(
			run_bounded 30 2 \
				/usr/bin/du -sk "${data_fd}/." 2>/dev/null |
				awk 'NR == 1 && $1 ~ /^[0-9]+$/ { print $1; exit }'
		)" || return 1
		case "$data_size" in ""|*[!0-9]*) return 1 ;; esac
		root_held_tree_is_plain "$data_fd" "$data_dir" || return 1
	fi
	printf '%s\n' "$data_size"
)

memory_start_prepare_journal() {
	local stage="$1" suffix metadata mode links original_owner original_group remainder
	local backing_device backing_inode
	case "$stage" in "${MEMORY_RUNTIME_DIR}/.work."??????) ;;
		*) return 1 ;;
	esac
	[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
	memory_journal_dir_valid || return 1
	[ ! -e "$MEMORY_JOURNAL_FILE" ] && [ ! -L "$MEMORY_JOURNAL_FILE" ] || return 1
	suffix="${stage##*.}"
	case "$suffix" in ??????) case "$suffix" in *[!A-Za-z0-9]*) return 1 ;; esac ;;
		*) return 1 ;;
	esac
	metadata="$(LC_ALL=C ls -ldn "$persistent_work_dir" 2>/dev/null)" || return 1
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	case "$original_owner:$original_group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) return 1 ;;
	esac
	memory_backing_identity "$persistent_work_dir" || return 1
	backing_device="$MEMORY_IDENTITY_DEVICE"
	backing_inode="$MEMORY_IDENTITY_INODE"
	memory_write_journal prepare copying "$persistent_work_dir" \
		"$backing_device" "$backing_inode" "$original_owner" "$original_group" \
		"$suffix" 0 - -
}

memory_advance_journal() {
	local operation="$1" phase="$2"
	memory_load_journal || return 1
	[ "$MEMORY_JOURNAL_OPERATION" = "$operation" ] || return 1
	memory_write_journal "$operation" "$phase" "$MEMORY_JOURNAL_BACKING" \
		"$MEMORY_JOURNAL_DEVICE" "$MEMORY_JOURNAL_INODE" \
		"$MEMORY_JOURNAL_ORIGINAL_UID" "$MEMORY_JOURNAL_ORIGINAL_GID" \
		"$MEMORY_JOURNAL_SUFFIX" "$MEMORY_JOURNAL_HAD_OLD" \
		"$MEMORY_JOURNAL_YAML_OLD" "$MEMORY_JOURNAL_YAML_NEW"
}

memory_copy_data_to_runtime() (
	local source="$1" target="$2" stage original_owner original_group
	[ -e "$source" ] || [ -L "$source" ] || exit 0
	stage="${target%/*}"
	memory_load_journal || exit 1
	[ "$MEMORY_JOURNAL_OPERATION:$MEMORY_JOURNAL_PHASE" = prepare:copying ] || exit 1
	[ "$MEMORY_JOURNAL_BACKING" = "$persistent_work_dir" ] || exit 1
	[ "$stage" = "${MEMORY_RUNTIME_DIR}/.work.${MEMORY_JOURNAL_SUFFIX}" ] || exit 1
	original_owner="$MEMORY_JOURNAL_ORIGINAL_UID"
	original_group="$MEMORY_JOURNAL_ORIGINAL_GID"
	trap 'restore_workdir_access "$persistent_work_dir" "$original_owner" "$original_group" >/dev/null 2>&1 || true' EXIT
	chown "0:${ADGUARD_GID}" "$persistent_work_dir" &&
		chmod 0710 "$persistent_work_dir" || exit 1
	[ -d "$source" ] && [ ! -L "$source" ] &&
		uid853_tree_is_plain "$source" || exit 1
	mkdir -m 0700 "$target" || exit 1
	chown "${ADGUARD_UID}:${ADGUARD_GID}" "$target" || exit 1
	run_bounded 120 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHMemoryCopy -x /bin/cp -- -pR "${source}/." "$target/" || exit 1
	chown "${ADGUARD_UID}:${ADGUARD_GID}" "$target" && chmod 0700 "$target" || exit 1
	uid853_tree_is_plain "$target" || exit 1
	memory_advance_journal prepare prepared || exit 1
	restore_workdir_access "$persistent_work_dir" \
		"$original_owner" "$original_group" || exit 1
	memory_durability_barrier || exit 1
	trap - EXIT
)

memory_capacity_available() {
	local source_size reserve required tmp_available memory_available
	awk '$2 == "/tmp" && $3 == "tmpfs" { found = 1 } END { exit !found }' \
		/proc/mounts 2>/dev/null || {
		log_error "Memory mode requires /tmp to be a tmpfs"
		return 1
	}
	source_size="$(memory_source_size_kib)" || return 1
	reserve=$((source_size / 2))
	[ "$reserve" -ge "$MEMORY_MIN_TMP_RESERVE_KIB" ] ||
		reserve="$MEMORY_MIN_TMP_RESERVE_KIB"
	required=$((source_size + reserve))
	tmp_available="$(df -Pk /tmp 2>/dev/null |
		awk 'NR == 2 && $4 ~ /^[0-9]+$/ { print $4; exit }')" || return 1
	memory_available="$(awk '$1 == "MemAvailable:" && $2 ~ /^[0-9]+$/ { print $2; exit }' \
		/proc/meminfo 2>/dev/null)" || return 1
	case "$tmp_available" in ""|*[!0-9]*) return 1 ;; esac
	case "$memory_available" in ""|*[!0-9]*) return 1 ;; esac
	if [ "$tmp_available" -lt "$required" ] 2>/dev/null ||
	   [ "$memory_available" -lt $((source_size + MEMORY_MIN_SYSTEM_RESERVE_KIB)) ] 2>/dev/null; then
		log_error "Insufficient RAM for AdGuard Home memory mode (need ${required} KiB tmpfs for ${source_size} KiB source)"
		return 1
	fi
}

memory_create_runtime_parent() {
	if [ -e "$MEMORY_RUNTIME_DIR" ] || [ -L "$MEMORY_RUNTIME_DIR" ]; then
		return 1
	fi
	# Start root-private.  The prepare WAL can safely recover if the process is
	# killed before the subsequent group handoff and final traverse-only mode.
	mkdir -m 0700 "$MEMORY_RUNTIME_DIR" || return 1
	if ! chown "0:${ADGUARD_GID}" "$MEMORY_RUNTIME_DIR" ||
	   ! chmod 0710 "$MEMORY_RUNTIME_DIR" ||
	   ! memory_runtime_dir_valid; then
		rmdir "$MEMORY_RUNTIME_DIR" 2>/dev/null || true
		return 1
	fi
}

memory_write_state() {
	local backing="${1%/}" temporary device inode
	memory_runtime_dir_valid || return 1
	[ ! -e "$MEMORY_STATE_FILE" ] && [ ! -L "$MEMORY_STATE_FILE" ] || return 1
	memory_backing_identity "$backing" || return 1
	device="$MEMORY_IDENTITY_DEVICE"
	inode="$MEMORY_IDENTITY_INODE"
	temporary="$(mktemp "${MEMORY_RUNTIME_DIR}/.state.XXXXXX")" || return 1
	if ! printf 'version=3\npersistent_work_dir=%s\nbacking_device=%s\nbacking_inode=%s\n' \
		"$backing" "$device" "$inode" >"$temporary" ||
	   ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! memory_private_state_file "$temporary" ||
	   ! mv "$temporary" "$MEMORY_STATE_FILE"; then
		rm -f "$temporary"
		return 1
	fi
	memory_private_state_file "$MEMORY_STATE_FILE" || return 1
	MEMORY_STATE_PERSISTENT_WORK_DIR="$backing"
	MEMORY_STATE_BACKING_DEVICE="$device"
	MEMORY_STATE_BACKING_INODE="$inode"
	MEMORY_STATE_VALIDATED=1
}

memory_remove_active_tree() {
	memory_active_tree_valid || return 1
	# MEMORY_RUNTIME_DIR is root-owned and non-writable by uid 853, so the work
	# leaf cannot be replaced while this exact fixed-path removal runs.
	tree_is_mount_free "$MEMORY_WORK_DIR" || return 1
	rm -rf "$MEMORY_WORK_DIR" || return 1
	[ ! -e "$MEMORY_WORK_DIR" ] && [ ! -L "$MEMORY_WORK_DIR" ] || return 1
	MEMORY_STATE_VALIDATED=0
}

memory_prepare_runtime_locked() {
	local stage="" suffix data_source data_target
	[ "$MEMORY_ACTIVE" != 1 ] || return 0
	[ "$memory_requested" = 1 ] || return 0
	official_running && return 1
	adguard_uid_process_exists && return 1
	memory_capacity_available || return 1
	suffix="$(memory_allocate_journal_suffix)" || {
		return 1
	}
	stage="${MEMORY_RUNTIME_DIR}/.work.${suffix}"
	if ! memory_start_prepare_journal "$stage"; then
		memory_clear_orphan_journal_dir >/dev/null 2>&1 || true
		return 1
	fi
	if ! memory_create_runtime_parent; then
		memory_recover_journal_locked "$persistent_work_dir" >/dev/null 2>&1 || true
		return 1
	fi
	if ! mkdir -m 0710 "$stage" ||
	   ! chown "0:${ADGUARD_GID}" "$stage" || ! chmod 0710 "$stage"; then
		memory_recover_journal_locked "$persistent_work_dir" >/dev/null 2>&1 || true
		return 1
	fi
	data_source="${persistent_work_dir}/data"
	data_target="${stage}/data"
	if [ -e "$data_source" ] || [ -L "$data_source" ]; then
		if ! memory_copy_data_to_runtime "$data_source" "$data_target"; then
			memory_recover_journal_locked "$persistent_work_dir" >/dev/null 2>&1 || true
			return 1
		fi
	else
		if ! mkdir -m 0700 "$data_target" ||
		   ! chown "${ADGUARD_UID}:${ADGUARD_GID}" "$data_target" ||
		   ! uid853_tree_is_plain "$data_target" ||
		   ! memory_advance_journal prepare prepared; then
			memory_recover_journal_locked "$persistent_work_dir" >/dev/null 2>&1 || true
			return 1
		fi
	fi
	if [ -e "$MEMORY_WORK_DIR" ] || [ -L "$MEMORY_WORK_DIR" ] ||
	   ! mv "$stage" "$MEMORY_WORK_DIR" ||
	   ! chown "${ADGUARD_UID}:${ADGUARD_GID}" "$MEMORY_WORK_DIR" ||
	   ! chmod 0700 "$MEMORY_WORK_DIR" ||
	   ! memory_active_tree_valid ||
	   ! memory_advance_journal prepare new_installed ||
	   ! memory_write_state "$persistent_work_dir" ||
	   ! memory_advance_journal prepare committed ||
	   ! memory_clear_journal; then
		memory_recover_journal_locked "$persistent_work_dir" >/dev/null 2>&1 || true
		return 1
	fi
	MEMORY_ACTIVE=1
	MEMORY_BACKING_WORK_DIR="$persistent_work_dir"
	previous_work_dir="$persistent_work_dir"
	work_dir="$MEMORY_WORK_DIR"
	config_file="$persistent_config_file"
	# Only safe_fs_patterns needs to follow the effective work directory.  The
	# file being edited remains the persistent YAML and is never copied to RAM.
	if ! sync_yaml_managed_fields_checked; then
		log_error "Unable to activate the persistent YAML for the RAM data workdir"
		# No core has used this freshly copied generation yet.  If the ordinary
		# deactivation path can restore the persistent managed field and remove
		# the v3 state, let the caller fall back to disk for this start.  Preserve
		# the generation only when cleanup itself cannot be proven complete.
		if memory_deactivate_locked 0; then
			log_error "Discarded the unused RAM generation after YAML activation failed"
			return 1
		fi
		return 2
	fi
	log_error "AdGuard Home data workdir prepared in memory from ${persistent_work_dir}"
}

memory_journal_dir_valid() {
	local metadata mode links owner group remainder
	[ -d "$MEMORY_JOURNAL_DIR" ] && [ ! -L "$MEMORY_JOURNAL_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_JOURNAL_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "drwx------" ] && [ "$owner" = 0 ] && [ "$group" = 0 ]
}

memory_ensure_journal_dir() {
	if [ -e "$MEMORY_JOURNAL_DIR" ] || [ -L "$MEMORY_JOURNAL_DIR" ]; then
		memory_journal_dir_valid
		return
	fi
	mkdir -m 0700 "$MEMORY_JOURNAL_DIR" || return 1
	chown 0:0 "$MEMORY_JOURNAL_DIR" && chmod 0700 "$MEMORY_JOURNAL_DIR" &&
		memory_journal_dir_valid
}

memory_durability_barrier() {
	[ -x /bin/sync ] || return 1
	run_bounded 30 2 /bin/sync >/dev/null 2>&1
}

memory_backing_identity() {
	local value extra target="$1"
	case "$target" in
		/proc/self/fd/[0-9]*|/proc/[0-9]*/fd/[0-9]*)
			[ -d "$target" ] || return 1
			;;
		*)
			[ -d "$target" ] && [ ! -L "$target" ] || return 1
			;;
	esac
	# ImmortalWrt's base BusyBox intentionally has no stat applet.  Bind an
	# otherwise unused descriptor, read its mount-id/inode from procfs, then map
	# the mount's major:minor pair through the kernel's documented device-number
	# encoding.  This keeps the existing state/WAL identity compatible with the
	# ucode fs metadata without adding a runtime package dependency.
	value="$(
		local fd_identity mount_id inode mount_device major minor device fd_extra
		[ ! -e /proc/self/fd/189 ] || exit 1
		exec 189<"$target" || exit 1
		[ -d /proc/self/fd/189 ] && [ /proc/self/fd/189 -ef "$target" ] || exit 1
		fd_identity="$(awk '
			$1 == "mnt_id:" { mounts++; mount_id=$2 }
			$1 == "ino:" { inodes++; inode=$2 }
			END {
				if (mounts == 1 && inodes == 1 &&
				    mount_id ~ /^[0-9]+$/ && inode ~ /^[0-9]+$/)
					print mount_id, inode
				else
					exit 1
			}
		' /proc/self/fdinfo/189)" || exit 1
		read -r mount_id inode fd_extra <<-EOF
		$fd_identity
		EOF
		[ -z "$fd_extra" ] || exit 1
		mount_device="$(awk -v wanted="$mount_id" '
			$1 == wanted { matches++; device=$3 }
			END { if (matches == 1) print device; else exit 1 }
		' /proc/self/mountinfo)" || exit 1
		case "$mount_device" in
			[0-9]*:[0-9]*) ;;
			*) exit 1 ;;
		esac
		major="${mount_device%%:*}"
		minor="${mount_device#*:}"
		case "$major:$minor" in *[!0-9:]*|:*|*::*) exit 1 ;; esac
		device=$((minor % 256 + major % 4096 * 256 +
			(minor - minor % 256) * 4096 +
			(major - major % 4096) * 4294967296))
		printf '%s %s\n' "$device" "$inode"
	)" || return 1
	read -r MEMORY_IDENTITY_DEVICE MEMORY_IDENTITY_INODE extra <<-EOF
	$value
	EOF
	case "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE:$extra" in
		*[!0-9:]*|:*|*::*) return 1 ;;
		[0-9]*:[0-9]*:) ;;
		*) return 1 ;;
	esac
}

memory_write_journal() {
	local operation="$1" phase="$2" backing="${3%/}" device="$4" inode="$5"
	local original_uid="$6" original_gid="$7" suffix="$8" had_old="$9"
	local yaml_old="${10}" yaml_new="${11}" temporary
	case "$operation:$phase" in
		prepare:copying|prepare:prepared|prepare:new_installed|prepare:committed|\
		checkpoint:copying|checkpoint:prepared|checkpoint:old_moved|\
		checkpoint:new_installed|checkpoint:committed) ;;
		*) return 1 ;;
	esac
	case "$suffix" in ??????) case "$suffix" in *[!A-Za-z0-9]*) return 1 ;; esac ;;
		*) return 1 ;;
	esac
	case "$had_old" in 0|1) ;; *) return 1 ;; esac
	case "$operation" in
		prepare)
			[ "$yaml_old:$yaml_new" = -:- ] || return 1
			;;
		checkpoint)
			case "$yaml_old" in *[!0-9a-f]*) return 1 ;; esac
			case "$yaml_new" in *[!0-9a-f]*) return 1 ;; esac
			[ "${#yaml_old}" = 64 ] && [ "${#yaml_new}" = 64 ] || return 1
			;;
	esac
	case "$device:$inode" in
		*[!0-9:]*|:*|*::*) return 1 ;;
		[0-9]*:[0-9]*) ;;
		*) return 1 ;;
	esac
	case "$original_uid:$original_gid" in
		0:0|0:"$ADGUARD_GID"|"$ADGUARD_UID":"$ADGUARD_GID") ;;
		*) return 1 ;;
	esac
	validate_managed_work_dir_namespace "$backing" || return 1
	memory_backing_identity "$backing" || return 1
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = "$device:$inode" ] || return 1
	memory_ensure_journal_dir || return 1
	temporary="$(mktemp "${MEMORY_JOURNAL_DIR}/.checkpoint.XXXXXX")" || return 1
	if ! printf 'version=3\noperation=%s\nphase=%s\npersistent_work_dir=%s\nbacking_device=%s\nbacking_inode=%s\noriginal_uid=%s\noriginal_gid=%s\noriginal_mode=0700\nsuffix=%s\nhad_old=%s\nyaml_old_sha256=%s\nyaml_new_sha256=%s\n' \
		"$operation" "$phase" "$backing" "$device" "$inode" \
		"$original_uid" "$original_gid" "$suffix" "$had_old" \
		"$yaml_old" "$yaml_new" >"$temporary" ||
	   ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! memory_private_state_file "$temporary" ||
	   ! mv -f "$temporary" "$MEMORY_JOURNAL_FILE" ||
	   ! memory_durability_barrier; then
		rm -f "$temporary"
		return 1
	fi
	memory_private_state_file "$MEMORY_JOURNAL_FILE"
}

memory_allocate_journal_suffix() (
	local token suffix metadata mode links owner group size remainder
	umask 077
	memory_ensure_journal_dir || exit 1
	token="$(mktemp "${MEMORY_JOURNAL_DIR}/.checkpoint.XXXXXX")" || exit 1
	case "$token" in "${MEMORY_JOURNAL_DIR}/.checkpoint."??????) ;;
		*) rm -f "$token"; exit 1 ;;
	esac
	suffix="${token##*.}"
	case "$suffix" in ??????) case "$suffix" in *[!A-Za-z0-9]*) rm -f "$token"; exit 1 ;; esac ;;
		*) rm -f "$token"; exit 1 ;;
	esac
	# A mktemp token is deliberately empty, whereas durable state files are not.
	# Validate its exact root-private inode before releasing the random suffix.
	metadata="$(LC_ALL=C ls -ldn "$token" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$mode:$links:$owner:$group:$size" = "-rw-------:1:0:0:0" ] || exit 1
	rm -f "$token" || exit 1
	printf '%s\n' "$suffix"
)

memory_load_journal() {
	local line1 line2 line3 line4 line5 line6 line7 line8 line9 line10 line11
	local line12 line13 extra
	local metadata mode owner group
	MEMORY_JOURNAL_OPERATION=""
	MEMORY_JOURNAL_PHASE=""
	MEMORY_JOURNAL_BACKING=""
	MEMORY_JOURNAL_DEVICE=""
	MEMORY_JOURNAL_INODE=""
	MEMORY_JOURNAL_ORIGINAL_UID=""
	MEMORY_JOURNAL_ORIGINAL_GID=""
	MEMORY_JOURNAL_SUFFIX=""
	MEMORY_JOURNAL_HAD_OLD=""
	MEMORY_JOURNAL_YAML_OLD=""
	MEMORY_JOURNAL_YAML_NEW=""
	if [ ! -e "$MEMORY_JOURNAL_DIR" ] && [ ! -L "$MEMORY_JOURNAL_DIR" ]; then
		return 1
	fi
	memory_journal_dir_valid || return 2
	memory_private_state_file "$MEMORY_JOURNAL_FILE" || return 2
	{
		IFS= read -r line1 && IFS= read -r line2 && IFS= read -r line3 &&
		IFS= read -r line4 && IFS= read -r line5 && IFS= read -r line6 &&
		IFS= read -r line7 && IFS= read -r line8 && IFS= read -r line9 &&
		IFS= read -r line10 && IFS= read -r line11 && IFS= read -r line12 &&
		IFS= read -r line13 && ! IFS= read -r extra
	} <"$MEMORY_JOURNAL_FILE" || return 2
	[ "$line1" = version=3 ] || return 2
	case "$line2" in operation=*) MEMORY_JOURNAL_OPERATION="${line2#operation=}" ;; *) return 2 ;; esac
	case "$line3" in phase=*) MEMORY_JOURNAL_PHASE="${line3#phase=}" ;; *) return 2 ;; esac
	case "$line4" in persistent_work_dir=*) MEMORY_JOURNAL_BACKING="${line4#persistent_work_dir=}" ;; *) return 2 ;; esac
	case "$line5" in backing_device=*) MEMORY_JOURNAL_DEVICE="${line5#backing_device=}" ;; *) return 2 ;; esac
	case "$line6" in backing_inode=*) MEMORY_JOURNAL_INODE="${line6#backing_inode=}" ;; *) return 2 ;; esac
	case "$line7" in original_uid=*) MEMORY_JOURNAL_ORIGINAL_UID="${line7#original_uid=}" ;; *) return 2 ;; esac
	case "$line8" in original_gid=*) MEMORY_JOURNAL_ORIGINAL_GID="${line8#original_gid=}" ;; *) return 2 ;; esac
	[ "$line9" = original_mode=0700 ] || return 2
	case "$line10" in suffix=*) MEMORY_JOURNAL_SUFFIX="${line10#suffix=}" ;; *) return 2 ;; esac
	case "$line11" in had_old=*) MEMORY_JOURNAL_HAD_OLD="${line11#had_old=}" ;; *) return 2 ;; esac
	case "$line12" in yaml_old_sha256=*) MEMORY_JOURNAL_YAML_OLD="${line12#yaml_old_sha256=}" ;; *) return 2 ;; esac
	case "$line13" in yaml_new_sha256=*) MEMORY_JOURNAL_YAML_NEW="${line13#yaml_new_sha256=}" ;; *) return 2 ;; esac
	case "$MEMORY_JOURNAL_OPERATION:$MEMORY_JOURNAL_PHASE" in
		prepare:copying|prepare:prepared|prepare:new_installed|prepare:committed|\
		checkpoint:copying|checkpoint:prepared|checkpoint:old_moved|\
		checkpoint:new_installed|checkpoint:committed) ;;
		*) return 2 ;;
	esac
	validate_managed_work_dir_namespace "$MEMORY_JOURNAL_BACKING" || return 2
	case "$MEMORY_JOURNAL_DEVICE:$MEMORY_JOURNAL_INODE" in
		*[!0-9:]*|:*|*::*) return 2 ;;
		[0-9]*:[0-9]*) ;;
		*) return 2 ;;
	esac
	case "$MEMORY_JOURNAL_ORIGINAL_UID:$MEMORY_JOURNAL_ORIGINAL_GID" in
		0:0|0:"$ADGUARD_GID"|"$ADGUARD_UID":"$ADGUARD_GID") ;;
		*) return 2 ;;
	esac
	case "$MEMORY_JOURNAL_SUFFIX" in
		??????) case "$MEMORY_JOURNAL_SUFFIX" in *[!A-Za-z0-9]*) return 2 ;; esac ;;
		*) return 2 ;;
	esac
	case "$MEMORY_JOURNAL_HAD_OLD" in 0|1) ;; *) return 2 ;; esac
	case "$MEMORY_JOURNAL_OPERATION" in
		prepare)
			[ "$MEMORY_JOURNAL_YAML_OLD:$MEMORY_JOURNAL_YAML_NEW" = -:- ] || return 2
			;;
		checkpoint)
			case "$MEMORY_JOURNAL_YAML_OLD" in *[!0-9a-f]*) return 2 ;; esac
			case "$MEMORY_JOURNAL_YAML_NEW" in *[!0-9a-f]*) return 2 ;; esac
			[ "${#MEMORY_JOURNAL_YAML_OLD}" = 64 ] &&
				[ "${#MEMORY_JOURNAL_YAML_NEW}" = 64 ] || return 2
			;;
	esac
	memory_backing_identity "$MEMORY_JOURNAL_BACKING" || return 2
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = \
		"$MEMORY_JOURNAL_DEVICE:$MEMORY_JOURNAL_INODE" ] || return 2
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_JOURNAL_BACKING" 2>/dev/null)" || return 2
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		"$MEMORY_JOURNAL_ORIGINAL_UID":"$MEMORY_JOURNAL_ORIGINAL_GID":drwx------|\
		0:"$ADGUARD_GID":drwx------|0:"$ADGUARD_GID":drwx--x---) ;;
		*) return 2 ;;
	esac
	return 0
}

memory_remove_service_tree() (
	local target="${1%/}" parent name metadata mode links
	local original_owner original_group original_permissions remainder
	parent="${target%/*}"
	name="${target##*/}"
	validate_managed_work_dir_namespace "$parent" || exit 1
	case "$name" in
		data) ;;
		.data-memory-next.??????|.data-memory-old.??????)
			case "${name##*.}" in *[!A-Za-z0-9]*) exit 1 ;; esac
			;;
		*) exit 1 ;;
	esac
	metadata="$(LC_ALL=C ls -ldn "$parent" 2>/dev/null)" || exit 1
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	case "$original_owner:$original_group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------)
			original_permissions=0700
			;;
		0:"$ADGUARD_GID":drwx--x---)
			original_permissions=0710
			;;
		*) exit 1 ;;
	esac
	trap 'chown "$original_owner:$original_group" "$parent" >/dev/null 2>&1 && chmod "$original_permissions" "$parent" >/dev/null 2>&1 || true' EXIT
	chown "0:${ADGUARD_GID}" "$parent" && chmod 0710 "$parent" || exit 1
	[ -d "$target" ] && [ ! -L "$target" ] || exit 1
	uid853_tree_is_plain "$target" || exit 1
	# The frozen parent is intentionally non-writable by uid 853, so the exact
	# child cannot be exchanged after validation.  Root performs only this fixed
	# unlink; rm never follows a symlink encountered inside the plain tree.
	run_bounded 30 2 /bin/rm -rf "$target" >/dev/null 2>&1 || exit 1
	[ ! -e "$target" ] && [ ! -L "$target" ] || exit 1
	chown "$original_owner:$original_group" "$parent" &&
		chmod "$original_permissions" "$parent" || exit 1
	trap - EXIT
)

memory_clear_orphan_journal_dir() {
	local orphan found=0 metadata mode links owner group size remainder
	memory_journal_dir_valid || return 1
	[ ! -e "$MEMORY_JOURNAL_FILE" ] && [ ! -L "$MEMORY_JOURNAL_FILE" ] || return 1
	for orphan in "${MEMORY_JOURNAL_DIR}"/.checkpoint.??????; do
		[ -e "$orphan" ] || [ -L "$orphan" ] || continue
		found=1
		case "${orphan##*.}" in *[!A-Za-z0-9]*) return 1 ;; esac
		[ -f "$orphan" ] && [ ! -L "$orphan" ] || return 1
		metadata="$(LC_ALL=C ls -ldn "$orphan" 2>/dev/null)" || return 1
		read -r mode links owner group size remainder <<-EOF
		$metadata
		EOF
		[ "$mode:$links:$owner:$group" = "-rw-------:1:0:0" ] || return 1
		case "$size" in ""|*[!0-9]*) return 1 ;; esac
		[ "$size" -le 1024 ] || return 1
		rm -f "$orphan" || return 1
	done
	# rmdir is the final allowlist check: any unexpected or hidden entry keeps
	# this root-private recovery namespace intact and fails closed.
	rmdir "$MEMORY_JOURNAL_DIR" 2>/dev/null || return 1
	[ "$found" = 0 ] || log_error "Removed an incomplete AdGuard Home checkpoint journal write"
}

memory_clear_journal() {
	memory_journal_dir_valid || return 1
	memory_private_state_file "$MEMORY_JOURNAL_FILE" || return 1
	rm -f "$MEMORY_JOURNAL_FILE" || return 1
	memory_durability_barrier || return 1
	rmdir "$MEMORY_JOURNAL_DIR" 2>/dev/null || return 1
}

memory_discard_incomplete_prepare_runtime() {
	local entry stage="${MEMORY_RUNTIME_DIR}/.work.${MEMORY_JOURNAL_SUFFIX}"
	local metadata mode links owner group size remainder
	if [ ! -e "$MEMORY_RUNTIME_DIR" ] && [ ! -L "$MEMORY_RUNTIME_DIR" ]; then
		return 0
	fi
	memory_prepare_runtime_dir_valid || return 1
	for entry in \
		"$MEMORY_RUNTIME_DIR"/* \
		"$MEMORY_RUNTIME_DIR"/.[!.]* \
		"$MEMORY_RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		case "$entry" in
			"$stage"|"$MEMORY_WORK_DIR")
				[ -d "$entry" ] && [ ! -L "$entry" ] || return 1
				;;
			"$MEMORY_STATE_FILE"|"$MEMORY_RUNTIME_DIR"/.state.??????)
				[ -f "$entry" ] && [ ! -L "$entry" ] || return 1
				metadata="$(LC_ALL=C ls -ldn "$entry" 2>/dev/null)" || return 1
				read -r mode links owner group size remainder <<-EOF
				$metadata
				EOF
				[ "$mode:$links:$owner:$group" = "-rw-------:1:0:0" ] || return 1
				case "$size" in ""|*[!0-9]*) return 1 ;; esac
				[ "$size" -le 1024 ] || return 1
				;;
			*) return 1 ;;
		esac
	done
	case "$MEMORY_JOURNAL_PHASE" in
		committed)
			memory_state_load || return 1
			[ "$MEMORY_STATE_PERSISTENT_WORK_DIR" = "$MEMORY_JOURNAL_BACKING" ] || return 1
			return 0
			;;
	esac
	if [ -e "$stage" ] || [ -L "$stage" ]; then
		[ -d "$stage" ] && [ ! -L "$stage" ] || return 1
		memory_journal_tree_plain "$stage" || return 1
		rm -rf "$stage" || return 1
	fi
	if [ -e "$MEMORY_WORK_DIR" ] || [ -L "$MEMORY_WORK_DIR" ]; then
		[ -d "$MEMORY_WORK_DIR" ] && [ ! -L "$MEMORY_WORK_DIR" ] || return 1
		memory_journal_tree_plain "$MEMORY_WORK_DIR" || return 1
		rm -rf "$MEMORY_WORK_DIR" || return 1
	fi
	for entry in "$MEMORY_STATE_FILE" "$MEMORY_RUNTIME_DIR"/.state.??????; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		rm -f "$entry" || return 1
	done
	rmdir "$MEMORY_RUNTIME_DIR"
}

memory_restore_journal_backing_metadata() {
	local metadata mode owner group
	# Keep the only interrupted intermediate at root:853/0700, which remains
	# non-writable by uid 853 and is explicitly journal-gated by the loader.
	chmod 0700 "$MEMORY_JOURNAL_BACKING" &&
		chown "${MEMORY_JOURNAL_ORIGINAL_UID}:${MEMORY_JOURNAL_ORIGINAL_GID}" \
		"$MEMORY_JOURNAL_BACKING" || return 1
	memory_backing_identity "$MEMORY_JOURNAL_BACKING" || return 1
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = \
		"$MEMORY_JOURNAL_DEVICE:$MEMORY_JOURNAL_INODE" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$MEMORY_JOURNAL_BACKING" 2>/dev/null)" || return 1
	read -r mode _links owner group _remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = \
		"$MEMORY_JOURNAL_ORIGINAL_UID:$MEMORY_JOURNAL_ORIGINAL_GID:drwx------" ]
}

memory_freeze_journal_backing() {
	memory_backing_identity "$MEMORY_JOURNAL_BACKING" || return 1
	[ "$MEMORY_IDENTITY_DEVICE:$MEMORY_IDENTITY_INODE" = \
		"$MEMORY_JOURNAL_DEVICE:$MEMORY_JOURNAL_INODE" ] || return 1
	chown "0:${ADGUARD_GID}" "$MEMORY_JOURNAL_BACKING" &&
		chmod 0710 "$MEMORY_JOURNAL_BACKING"
}

memory_journal_tree_plain() (
	local target="$1" descriptor=/proc/self/fd/8
	[ -d "$target" ] && [ ! -L "$target" ] || exit 1
	exec 8<"$target" || exit 1
	root_held_tree_is_plain "$descriptor" "$target"
)

memory_remove_journal_tree() {
	local target="$1"
	case "$target" in
		"${MEMORY_JOURNAL_BACKING}/data"|\
		"${MEMORY_JOURNAL_BACKING}/.data-memory-next.${MEMORY_JOURNAL_SUFFIX}"|\
		"${MEMORY_JOURNAL_BACKING}/.data-memory-old.${MEMORY_JOURNAL_SUFFIX}") ;;
		*) return 1 ;;
	esac
	[ -d "$target" ] && [ ! -L "$target" ] || return 1
	memory_journal_tree_plain "$target" || return 1
	# The journal-bound parent is frozen at 0710, so this exact child cannot be
	# exchanged.  rm does not follow symlinks found below the child.
	rm -rf "$target" || return 1
	[ ! -e "$target" ] && [ ! -L "$target" ]
}

memory_journal_yaml_hash() {
	local target="${MEMORY_JOURNAL_BACKING}/AdGuardHome.yaml" size
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || return 1
	yaml_file_hash "$target"
}

memory_recover_journal_locked() (
	local expected_backing="${1%/}" journal_rc=0 backing next old data
	local current_yaml roll_forward=0
	if { [ -e "$MEMORY_JOURNAL_DIR" ] || [ -L "$MEMORY_JOURNAL_DIR" ]; } &&
	   [ ! -e "$MEMORY_JOURNAL_FILE" ] && [ ! -L "$MEMORY_JOURNAL_FILE" ]; then
		memory_clear_orphan_journal_dir || {
			log_error "Unsafe incomplete AdGuard Home memory checkpoint journal"
			exit 1
		}
		exit 0
	fi
	memory_load_journal || journal_rc=$?
	case "$journal_rc" in
		1) exit 0 ;;
		0) ;;
		*) log_error "Unsafe AdGuard Home memory checkpoint journal"; exit 1 ;;
	esac
	backing="${MEMORY_JOURNAL_BACKING%/}"
	[ -z "$expected_backing" ] || [ "$expected_backing" = "$backing" ] || exit 1
	official_running && exit 1
	adguard_uid_process_exists && exit 1
	if [ "$MEMORY_JOURNAL_OPERATION" = prepare ]; then
		memory_discard_incomplete_prepare_runtime || exit 1
		memory_restore_journal_backing_metadata || exit 1
		memory_durability_barrier || exit 1
		memory_clear_journal || exit 1
		exit 0
	fi
	next="${backing}/.data-memory-next.${MEMORY_JOURNAL_SUFFIX}"
	old="${backing}/.data-memory-old.${MEMORY_JOURNAL_SUFFIX}"
	data="${backing}/data"
	memory_freeze_journal_backing || exit 1
	current_yaml="$(memory_journal_yaml_hash)" || exit 1
	case "$MEMORY_JOURNAL_PHASE" in
		copying|prepared)
			[ "$current_yaml" = "$MEMORY_JOURNAL_YAML_OLD" ] || exit 1
			if [ "$MEMORY_JOURNAL_HAD_OLD" = 1 ]; then
				if [ -e "$old" ] || [ -L "$old" ]; then
					[ ! -e "$data" ] && [ ! -L "$data" ] || exit 1
					memory_journal_tree_plain "$old" || exit 1
					mv "$old" "$data" || exit 1
				else
					memory_journal_tree_plain "$data" || exit 1
				fi
			elif [ -e "$old" ] || [ -L "$old" ] ||
			     [ -e "$data" ] || [ -L "$data" ]; then
				exit 1
			fi
			if [ -e "$next" ] || [ -L "$next" ]; then
				memory_remove_journal_tree "$next" || exit 1
			fi
			;;
		old_moved)
			[ "$current_yaml" = "$MEMORY_JOURNAL_YAML_OLD" ] || exit 1
			if [ "$MEMORY_JOURNAL_HAD_OLD" = 1 ]; then
				if [ -e "$old" ] || [ -L "$old" ]; then
					memory_journal_tree_plain "$old" || exit 1
					if [ -e "$data" ] || [ -L "$data" ]; then
						memory_journal_tree_plain "$data" || exit 1
						memory_remove_journal_tree "$data" || exit 1
					fi
					mv "$old" "$data" || exit 1
				else
					# A prior recovery may already have restored old -> data before
					# losing power.  Accept that terminal rollback layout.
					memory_journal_tree_plain "$data" || exit 1
				fi
			else
				[ ! -e "$old" ] && [ ! -L "$old" ] || exit 1
				if [ -e "$data" ] || [ -L "$data" ]; then
					memory_journal_tree_plain "$data" || exit 1
					memory_remove_journal_tree "$data" || exit 1
				fi
			fi
			if [ -e "$next" ] || [ -L "$next" ]; then
				memory_remove_journal_tree "$next" || exit 1
			fi
			;;
		new_installed)
			if [ "$current_yaml" = "$MEMORY_JOURNAL_YAML_NEW" ]; then
				roll_forward=1
				memory_journal_tree_plain "$data" || exit 1
				[ ! -e "$next" ] && [ ! -L "$next" ] || exit 1
				if [ -e "$old" ] || [ -L "$old" ]; then
					memory_journal_tree_plain "$old" || exit 1
					memory_remove_journal_tree "$old" || exit 1
				fi
			elif [ "$current_yaml" = "$MEMORY_JOURNAL_YAML_OLD" ]; then
				if [ "$MEMORY_JOURNAL_HAD_OLD" = 1 ]; then
					if [ -e "$old" ] || [ -L "$old" ]; then
						memory_journal_tree_plain "$old" || exit 1
						if [ -e "$data" ] || [ -L "$data" ]; then
							memory_journal_tree_plain "$data" || exit 1
							memory_remove_journal_tree "$data" || exit 1
						fi
						mv "$old" "$data" || exit 1
					else
						memory_journal_tree_plain "$data" || exit 1
					fi
				else
					[ ! -e "$old" ] && [ ! -L "$old" ] || exit 1
					if [ -e "$data" ] || [ -L "$data" ]; then
						memory_journal_tree_plain "$data" || exit 1
						memory_remove_journal_tree "$data" || exit 1
					fi
				fi
				if [ -e "$next" ] || [ -L "$next" ]; then
					memory_remove_journal_tree "$next" || exit 1
				fi
			else
				exit 1
			fi
			;;
		committed)
			[ "$current_yaml" = "$MEMORY_JOURNAL_YAML_NEW" ] || exit 1
			roll_forward=1
			memory_journal_tree_plain "$data" || exit 1
			[ ! -e "$next" ] && [ ! -L "$next" ] || exit 1
			if [ -e "$old" ] || [ -L "$old" ]; then
				memory_remove_journal_tree "$old" || exit 1
			fi
			;;
	esac
	if [ "$roll_forward" != 1 ]; then
		if [ "$MEMORY_JOURNAL_HAD_OLD" = 1 ]; then
			memory_journal_tree_plain "$data" || exit 1
		else
			[ ! -e "$data" ] && [ ! -L "$data" ] || exit 1
		fi
		[ ! -e "$old" ] && [ ! -L "$old" ] &&
			[ ! -e "$next" ] && [ ! -L "$next" ] || exit 1
	fi
	memory_durability_barrier || exit 1
	memory_restore_journal_backing_metadata || exit 1
	memory_durability_barrier || exit 1
	memory_clear_journal || exit 1
)

memory_checkpoint_data_locked() (
	local source="${MEMORY_WORK_DIR}/data" target="${MEMORY_BACKING_WORK_DIR}/data"
	local yaml_old="$1" yaml_new="$2"
	local stage suffix old metadata mode links original_owner original_group remainder had_old=0
	local backing_fd=/proc/self/fd/9 backing_device backing_inode
	[ "$MEMORY_ACTIVE" = 1 ] || exit 0
	official_running && exit 1
	adguard_uid_process_exists && exit 1
	[ -d "$source" ] && [ ! -L "$source" ] &&
		uid853_tree_is_plain "$source" || exit 1
	memory_state_load || exit 1
	[ "$MEMORY_STATE_PERSISTENT_WORK_DIR" = "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	memory_recover_journal_locked "$MEMORY_BACKING_WORK_DIR" || exit 1
	[ -d "$MEMORY_BACKING_WORK_DIR" ] && [ ! -L "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	exec 9<"$MEMORY_BACKING_WORK_DIR" || exit 1
	[ -d "$backing_fd" ] && [ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$backing_fd" 2>/dev/null)" || exit 1
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	case "$original_owner:$original_group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) exit 1 ;;
	esac
	memory_backing_identity "$backing_fd" || exit 1
	backing_device="$MEMORY_IDENTITY_DEVICE"
	backing_inode="$MEMORY_IDENTITY_INODE"
	[ "$backing_device:$backing_inode" = \
		"$MEMORY_STATE_BACKING_DEVICE:$MEMORY_STATE_BACKING_INODE" ] || exit 1
	if [ -e "$target" ] || [ -L "$target" ]; then
		[ -d "$target" ] && [ ! -L "$target" ] &&
			memory_journal_tree_plain "$target" || exit 1
		had_old=1
	fi
	suffix="$(memory_allocate_journal_suffix)" || exit 1
	stage="${MEMORY_BACKING_WORK_DIR}/.data-memory-next.${suffix}"
	old="${MEMORY_BACKING_WORK_DIR}/.data-memory-old.${suffix}"
	[ ! -e "$stage" ] && [ ! -L "$stage" ] || exit 1
	if [ -e "$old" ] || [ -L "$old" ]; then
		exit 1
	fi
	if ! memory_write_journal checkpoint copying "$MEMORY_BACKING_WORK_DIR" \
		"$backing_device" "$backing_inode" "$original_owner" "$original_group" \
		"$suffix" "$had_old" "$yaml_old" "$yaml_new"; then
		exit 1
	fi
	mkdir -m 0700 "$stage" || exit 1
	trap 'chmod 0700 "$backing_fd" >/dev/null 2>&1 && chown "$original_owner:$original_group" "$backing_fd" >/dev/null 2>&1 || true' EXIT
	chown "0:${ADGUARD_GID}" "$backing_fd" || exit 1
	[ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	chmod 0710 "$backing_fd" || exit 1
	[ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	if ! chown "${ADGUARD_UID}:${ADGUARD_GID}" "$stage" || ! chmod 0700 "$stage"; then
		exit 1
	fi
	if ! run_bounded 120 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHMemorySave -x /bin/cp -- -pR "${source}/." "$stage/" ||
	   ! chown "${ADGUARD_UID}:${ADGUARD_GID}" "$stage" ||
	   ! chmod 0700 "$stage" ||
	   ! uid853_tree_is_plain "$stage"; then
		exit 1
	fi
	uid853_tree_is_plain "$stage" || exit 1
	memory_advance_journal checkpoint prepared || exit 1
	if [ "$had_old" = 1 ]; then
		mv "$target" "$old" || exit 1
	fi
	memory_advance_journal checkpoint old_moved || exit 1
	mv "$stage" "$target" || exit 1
	memory_advance_journal checkpoint new_installed || exit 1
	chmod 0700 "$backing_fd" && chown "$original_owner:$original_group" "$backing_fd" || exit 1
	[ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	memory_durability_barrier || exit 1
	trap - EXIT
)

memory_finish_data_checkpoint_locked() {
	local journal_rc=0
	memory_load_journal || journal_rc=$?
	[ "$journal_rc" = 0 ] || return 1
	[ "$MEMORY_JOURNAL_OPERATION" = checkpoint ] || return 1
	case "$MEMORY_JOURNAL_PHASE" in
		new_installed) memory_advance_journal checkpoint committed || return 1 ;;
		committed) ;;
		*) return 1 ;;
	esac
	memory_recover_journal_locked "$MEMORY_JOURNAL_BACKING"
}

memory_checkpoint_full_locked() (
	local persistent_hash
	[ "$MEMORY_ACTIVE" = 1 ] || return 0
	official_running && {
		log_error "Refusing to checkpoint a live AdGuard Home memory workdir"
		return 1
	}
	memory_active_tree_valid || return 1
	# The YAML is already persistent.  Use its unchanged hash only as the
	# stopped-data journal anchor; no YAML bytes are copied or installed here.
	persistent_hash="$(active_config_hash)" || return 1
	if ! memory_checkpoint_data_locked "$persistent_hash" "$persistent_hash"; then
		memory_recover_journal_locked "$MEMORY_BACKING_WORK_DIR" >/dev/null 2>&1 || true
		return 1
	fi
	if ! memory_finish_data_checkpoint_locked; then
		memory_recover_journal_locked "$MEMORY_BACKING_WORK_DIR" >/dev/null 2>&1 || true
		return 1
	fi
	log_error "Persisted AdGuard Home RAM data to ${MEMORY_BACKING_WORK_DIR}/data"
)

# A scheduled or manual live write-back deliberately trades checkpoint
# consistency for availability.  The official core keeps using its RAM tree;
# copy the currently visible files directly over the persistent data directory.
# Existing files that have no matching RAM file are intentionally retained.  A
# power loss or a concurrent database write can therefore leave an incomplete
# persistent copy, which is acceptable for this mode.
memory_copy_live_data_locked() (
	local source="${MEMORY_WORK_DIR}/data" target="${MEMORY_BACKING_WORK_DIR}/data"
	local backing_fd=/proc/self/fd/9 metadata mode links original_owner original_group remainder
	local backing_device backing_inode core_pid target_ready=0
	[ "$MEMORY_ACTIVE" = 1 ] || exit 2
	[ -n "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	memory_active_tree_valid || exit 1
	[ -d "$source" ] && [ ! -L "$source" ] || exit 1
	uid853_tree_is_plain "$source" || exit 1
	memory_state_load || exit 1
	[ "$MEMORY_STATE_PERSISTENT_WORK_DIR" = "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	[ -d "$MEMORY_BACKING_WORK_DIR" ] &&
		[ ! -L "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	exec 9<"$MEMORY_BACKING_WORK_DIR" || exit 1
	[ -d "$backing_fd" ] && [ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$backing_fd" 2>/dev/null)" || exit 1
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	# In r2 this directory also contains the live persistent YAML.  While the
	# core runs, never freeze or chown that parent: doing so would make the Web
	# UI's atomic YAML save fail.  The official service must already own its
	# config directory before a live write-back is eligible.
	[ "$original_owner:$original_group:$mode" = \
		"$ADGUARD_UID:$ADGUARD_GID:drwx------" ] || exit 1
	memory_backing_identity "$backing_fd" || exit 1
	backing_device="$MEMORY_IDENTITY_DEVICE"
	backing_inode="$MEMORY_IDENTITY_INODE"
	[ "$backing_device:$backing_inode" = \
		"$MEMORY_STATE_BACKING_DEVICE:$MEMORY_STATE_BACKING_INODE" ] || exit 1
	core_pid="$(official_pid)" || exit 2
	case "$core_pid" in ""|*[!0-9]*) exit 2 ;; esac

	if [ -e "$target" ] || [ -L "$target" ]; then
		tree_is_mount_free "$target" || exit 1
		if [ -d "$target" ] && [ ! -L "$target" ] &&
		   memory_journal_tree_plain "$target" &&
		   uid853_tree_is_writable "$target" &&
		   run_bounded 5 1 \
			/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
			-n AGHDataMode -x /bin/chmod -- 0700 "$target"; then
			target_ready=1
		fi
		# Only an unusable data node/tree is cleared.  A valid directory is kept
		# intact so cp directly overwrites matching files without deleting extras.
		if [ "$target_ready" != 1 ]; then
			run_bounded 30 2 \
				/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
				-n AGHDataClear -x /bin/rm -- -rf "$target" \
				>/dev/null 2>&1 || exit 1
			[ ! -e "$target" ] && [ ! -L "$target" ] || exit 1
		fi
	fi
	if [ "$target_ready" != 1 ]; then
		run_bounded 5 1 \
			/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
			-n AGHDataMake -x /bin/mkdir -- -m 0700 "$target" || exit 1
	fi
	run_bounded 120 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHMemorySave -x /bin/cp -- -pR "${source}/." "$target/" || exit 1
	run_bounded 5 1 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataMode -x /bin/chmod -- 0700 "$target" || exit 1
	uid853_tree_is_plain "$target" || exit 1
	[ "$backing_fd" -ef "$MEMORY_BACKING_WORK_DIR" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$backing_fd" 2>/dev/null)" || exit 1
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	[ "$original_owner:$original_group:$mode" = \
		"$ADGUARD_UID:$ADGUARD_GID:drwx------" ] || exit 1
	[ "$(official_pid)" = "$core_pid" ] || exit 1
	log_error "Copied live AdGuard Home RAM data directly to ${target}"
)

root_private_config_source() {
	local candidate="$1" parent mode
	parent="${candidate%/*}"
	[ -n "$parent" ] || parent=/
	[ -O "$candidate" ] && [ -O "$parent" ] || return 1
	path_contains_symlink "$parent" && return 1
	mode="$(LC_ALL=C ls -ldn "$parent" 2>/dev/null)" || return 1
	mode="${mode%% *}"
	# Reject group- or world-writable parents.  A root-owned file under such a
	# directory could still be renamed between the identity check and open.
	case "$mode" in ?????w*|????????w*) return 1 ;; esac
}

snapshot_config_file() {
	local candidate="$1" target="$2" expected_hash="$3" inherited_fd="$4"
	local allow_detached="$5" fd_path size hash capture_rc=0
	if [ -n "$inherited_fd" ]; then
		case "$inherited_fd" in ""|*[!0-9]*) return 1 ;; esac
		[ "$inherited_fd" -ge 3 ] 2>/dev/null || return 1
		fd_path="/proc/self/fd/${inherited_fd}"
		[ -f "$fd_path" ] || return 1
		if [ "$allow_detached" != 1 ]; then
			[ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
			[ "$fd_path" -ef "$candidate" ] || return 1
		fi
		run_bounded 3 1 /bin/dd if="$fd_path" bs=4096 count=129 \
			of="$target" 2>/dev/null || capture_rc=$?
		[ "$capture_rc" = 0 ] || return 1
		# The pathname is needed later for a same-filesystem rename.  Reject an
		# unlink or replacement that occurred while the held inode was copied.
		if [ "$allow_detached" != 1 ]; then
			[ -f "$candidate" ] && [ ! -L "$candidate" ] &&
				[ "$fd_path" -ef "$candidate" ] || return 1
		fi
	else
		[ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
		# A root-owned private workdir cannot be renamed by uid 853 (clean,
		# disabled installation).  Otherwise capture as uid 853 so a concurrent
		# symlink swap can never grant the snapshotter root read access.
		if root_private_config_source "$candidate"; then
			capture_root_file_bytes "$candidate" "$target" 129 || capture_rc=$?
		else
			run_bounded 3 1 \
				/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
				-n AGHSnapshot -x /bin/dd -- if="$candidate" bs=4096 count=129 \
				>"$target" 2>/dev/null || capture_rc=$?
		fi
		[ "$capture_rc" = 0 ] || return 1
	fi
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || return 1
	hash="$(yaml_file_hash "$target")" || return 1
	if [ -n "$expected_hash" ]; then
		[ "$hash" = "$expected_hash" ] || return 1
	fi
	SNAPSHOT_CONFIG_HASH="$hash"
}

check_core_config_file() {
	local candidate="$1" expected_hash="$2" inherited_fd="$3" repair_tls="$4"
	local validation_dir validation_work validation rc
	[ -x "$CORE_BINARY" ] || {
		log_error "AdGuard Home binary is missing: ${CORE_BINARY}"
		return 1
	}
	[ -x /sbin/start-stop-daemon ] || {
		log_error "The required start-stop-daemon helper is missing"
		return 1
	}
	validation_dir="$(mktemp -d /tmp/AdGuardHome-check.XXXXXX)" || return 1
	validation="${validation_dir}/AdGuardHome.yaml"
	validation_work="${validation_dir}/work"
	mkdir "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	if ! snapshot_config_file "$candidate" "$validation" \
		"$expected_hash" "$inherited_fd"; then
		rm -rf "$validation_dir"
		return 1
	fi
	# When activating an installed YAML, repair only an allowlisted external
	# private key and then prove uid-853 readability.  A staged candidate remains
	# strictly read-only; prepare_tls_validation_files() gives the lowered core
	# bounded private copies so a first root:root 0600 ACME key can be validated
	# without changing the live key before commit.
	if [ "$repair_tls" = 1 ] && ! load_tls_access "$validation"; then
		rm -rf "$validation_dir"
		return 1
	fi
	if ! prepare_tls_validation_files "$validation" "$validation_dir"; then
		rm -rf "$validation_dir"
		return 1
	fi
	# Root retains ownership of both path components.  Group 853 may only
	# traverse the directory and read the disposable YAML, so it cannot replace
	# the validation pathname before the lowered checker opens it.
	chown "0:${ADGUARD_GID}" "$validation_dir" "$validation" || {
		rm -rf "$validation_dir"
		return 1
	}
	chown "${ADGUARD_UID}:${ADGUARD_GID}" "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0710 "$validation_dir" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0640 "$validation" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0700 "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	# AdGuard Home may migrate an old schema during --check-config.  Validate a
	# disposable copy so this helper is genuinely read-only for the active YAML,
	# including while the official service is running.  A hard timeout bounds
	# FIFOs or slow filesystem references in fields not interpreted above, and
	# uid/gid 853 prevents the checker from reading root-only host files.
	run_bounded 15 2 \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHConfigCheck -x "$CORE_BINARY" -- \
		--check-config --config "$validation" --work-dir "$validation_work" \
		>/dev/null 2>&1
	rc=$?
	rm -rf "$validation_dir" || return 1
	return "$rc"
}

check_core_config() {
	# Only the root-owned snapshot is parsed while repairing access for an
	# external ACME/certs key.  Staged RPC candidates never take that mutating
	# path.
	check_core_config_file "$config_file" "" "" 1
}

valid_config_candidate_path() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "${value}/" in */./*|*/../*) return 1 ;; esac
	[ -f "$value" ] && [ ! -L "$value" ] || return 1
	! path_contains_symlink "$value"
}

normalizer_lock_directory_is_private() {
	local directory="${NORMALIZER_LOCK%/*}" metadata mode links owner group remainder
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	path_contains_symlink "$directory" && return 1
	metadata="$(LC_ALL=C ls -ldn "$directory" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ]
}

maintenance_upgrade_private_file() {
	local target="$1" minimum="$2" metadata mode links owner group size remainder
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ] || return 1
	case "$size" in ''|*[!0-9]*) return 1 ;; esac
	[ "$size" -ge "$minimum" ] 2>/dev/null && [ "$size" -le 524288 ] 2>/dev/null
}

maintenance_upgrade_marker_is_valid() {
	local line1 line2 line3 line4 line5 line6 line7 line8 extra entry
	local config_hash config_size delta_hash delta_size digest
	[ -e "$MAINTENANCE_UPGRADE_MARKER" ] ||
		[ -L "$MAINTENANCE_UPGRADE_MARKER" ] || return 1
	normalizer_lock_directory_is_private || return 1
	maintenance_upgrade_private_file "$MAINTENANCE_UPGRADE_MARKER" 1 || return 1
	[ "$(wc -c <"$MAINTENANCE_UPGRADE_MARKER")" -le 4096 ] 2>/dev/null || return 1
	exec 8<"$MAINTENANCE_UPGRADE_MARKER" || return 1
	[ -f /proc/self/fd/8 ] &&
		[ /proc/self/fd/8 -ef "$MAINTENANCE_UPGRADE_MARKER" ] || return 1
	{
		IFS= read -r line1 && IFS= read -r line2 &&
		IFS= read -r line3 && IFS= read -r line4 &&
		IFS= read -r line5 && IFS= read -r line6 &&
		IFS= read -r line7 && IFS= read -r line8 &&
		! IFS= read -r extra
	} </proc/self/fd/8 || return 1
	[ "$line1" = format=1 ] || return 1
	case "$line2" in
		source_version=2.2.0-r1|source_version=2.2.0-r2) ;;
		*) return 1 ;;
	esac
	case "$line3" in wrapper_running=0|wrapper_running=1)
		MAINTENANCE_WRAPPER_RUNNING="${line3#*=}" ;; *) return 1 ;; esac
	case "$line4" in delta_present=0|delta_present=1)
		MAINTENANCE_DELTA_PRESENT="${line4#*=}" ;; *) return 1 ;; esac
	case "$line5" in config_sha256=*) config_hash="${line5#*=}" ;; *) return 1 ;; esac
	case "$line6" in config_size=*) config_size="${line6#*=}" ;; *) return 1 ;; esac
	case "$line7" in delta_sha256=*) delta_hash="${line7#*=}" ;; *) return 1 ;; esac
	case "$line8" in delta_size=*) delta_size="${line8#*=}" ;; *) return 1 ;; esac
	case "$config_hash:$config_size" in *[!0-9a-f:]*|:*) return 1 ;; esac
	[ "${#config_hash}" = 64 ] || return 1
	maintenance_upgrade_private_file "$MAINTENANCE_CONFIG_SNAPSHOT" 1 || return 1
	[ "$(wc -c <"$MAINTENANCE_CONFIG_SNAPSHOT")" = "$config_size" ] || return 1
	digest="$(sha256sum "$MAINTENANCE_CONFIG_SNAPSHOT" 2>/dev/null)" || return 1
	[ "${digest%% *}" = "$config_hash" ] || return 1
	case "$MAINTENANCE_DELTA_PRESENT" in
		0)
			[ "$delta_hash" = none ] && [ "$delta_size" = 0 ] &&
				[ ! -e "$MAINTENANCE_DELTA_SNAPSHOT" ] &&
				[ ! -L "$MAINTENANCE_DELTA_SNAPSHOT" ] || return 1
			;;
		1)
			case "$delta_hash:$delta_size" in *[!0-9a-f:]*|:*) return 1 ;; esac
			[ "${#delta_hash}" = 64 ] || return 1
			maintenance_upgrade_private_file "$MAINTENANCE_DELTA_SNAPSHOT" 0 || return 1
			[ "$(wc -c <"$MAINTENANCE_DELTA_SNAPSHOT")" = "$delta_size" ] || return 1
			digest="$(sha256sum "$MAINTENANCE_DELTA_SNAPSHOT" 2>/dev/null)" || return 1
			[ "${digest%% *}" = "$delta_hash" ] || return 1
			;;
	esac
	for entry in \
		"$NORMALIZER_RUNTIME_DIR"/* \
		"$NORMALIZER_RUNTIME_DIR"/.[!.]* \
		"$NORMALIZER_RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		case "$entry" in
			"$MAINTENANCE_UPGRADE_MARKER"|"$MAINTENANCE_CONFIG_SNAPSHOT") ;;
			"$MAINTENANCE_DELTA_SNAPSHOT")
				[ "$MAINTENANCE_DELTA_PRESENT" = 1 ] || return 1 ;;
			*) return 1 ;;
		esac
	done
}

# ImmortalWrt's default package post-install helper invokes every packaged init
# script once even during an upgrade.  Consume the root-private marker left by
# a successful stopped v2.1 migration so that one automatic invocation is a
# no-op; a later manual start or boot follows the normal enabled-state path.
consume_upgrade_stopped_marker() (
	local entry metadata mode links owner group size remainder
	[ -e "$UPGRADE_STOPPED_MARKER" ] || [ -L "$UPGRADE_STOPPED_MARKER" ] || exit 1
	normalizer_lock_directory_is_private || exit 2
	for entry in \
		"$NORMALIZER_RUNTIME_DIR"/* \
		"$NORMALIZER_RUNTIME_DIR"/.[!.]* \
		"$NORMALIZER_RUNTIME_DIR"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		[ "$entry" = "$UPGRADE_STOPPED_MARKER" ] || exit 2
	done
	exec 9<"$UPGRADE_STOPPED_MARKER" || exit 2
	[ -f /proc/self/fd/9 ] && [ /proc/self/fd/9 -ef "$UPGRADE_STOPPED_MARKER" ] || exit 2
	metadata="$(LC_ALL=C ls -ldnL /proc/self/fd/9 2>/dev/null)" || exit 2
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$mode" = "-rw-------" ] && [ "$links" = 1 ] &&
		[ "$owner" = 0 ] && [ "$group" = 0 ] && [ "$size" = 2 ] || exit 2
	grep -qx '1' /proc/self/fd/9 || exit 2
	rm -f "$UPGRADE_STOPPED_MARKER" || exit 2
	[ ! -e "$UPGRADE_STOPPED_MARKER" ] && [ ! -L "$UPGRADE_STOPPED_MARKER" ] || exit 2
	rmdir "$NORMALIZER_RUNTIME_DIR" || exit 2
)

normalizer_lock_is_private() {
	local metadata mode links owner group remainder
	[ -d "$NORMALIZER_LOCK" ] && [ ! -L "$NORMALIZER_LOCK" ] || return 1
	path_contains_symlink "$NORMALIZER_LOCK" && return 1
	metadata="$(LC_ALL=C ls -ldn "$NORMALIZER_LOCK" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ]
}

# The writable normalizer child may start only while uid 853 is otherwise
# completely quiescent.  Read each thread status once and fail closed if a
# non-vanished record is malformed.
adguard_uid_process_exists() {
	local status uids
	for status in /proc/[0-9]*/task/[0-9]*/status; do
		if [ ! -r "$status" ]; then
			[ ! -e "$status" ] && continue
			return 0
		fi
		uids="$(awk '$1 == "Uid:" {
			if (NF != 5) exit 2
			for (i=2; i<=5; i++) if ($i !~ /^[0-9]+$/) exit 2
			print $2, $3, $4, $5; found=1; exit }
			END { if (!found) exit 1 }' \
			"$status" 2>/dev/null)" || {
			[ ! -e "$status" ] && continue
			return 0
		}
		case " $uids " in *" ${ADGUARD_UID} "*) return 0 ;; esac
	done
	return 1
}

# Installer migrations are the only place where an old schema must be written
# by the official core before it becomes active.  Keep the disposable tree
# behind a root-only parent and expose only its root-group-writable config/work
# children inside a dedicated ujail mount namespace.  The lowered child has
# uid 853 and primary gid 0 solely so it can write the root-group staging
# children.  No other uid-853 process may coexist, so none can reach the
# root-only outer directory through the child's procfs views.  Runtime and RPC
# validation continue to use the read-only sandbox above.
normalize_installer_config() (
	local candidate="$1" source_fd original_hash
	local validation_dir validation_config_dir validation_work validation
	local normalized normalized_verify source_verify config_dir_fd output_fd
	local original_certificate_path original_private_key_path tls_paths_rewritten=0
	local normalized_hash replacement="" replacement_fd metadata mode links
	local owner group size remainder rc=0 pattern_rc=0 lock_held=0
	local account_groups

	cleanup_installer_normalizer() {
		case "$replacement" in
			"${candidate}.normalized."??????) rm -f "$replacement" ;;
		esac
		case "$validation_dir" in
			/tmp/AdGuardHome-normalize.??????) rm -rf "$validation_dir" ;;
		esac
		if [ "$lock_held" = 1 ]; then
			rmdir "$NORMALIZER_LOCK" >/dev/null 2>&1 || true
		fi
	}

	root_private_config_source "$candidate" || exit 1
	[ -x /sbin/ujail ] || exit 1
	[ "$(id -u "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_UID" ] || exit 1
	[ "$(id -g "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_GID" ] || exit 1
	[ "$(id -gn "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_GROUP" ] || exit 1
	[ "$(id -g "$NORMALIZER_GROUP" 2>/dev/null)" = 0 ] || exit 1
	[ "$(id -gn "$NORMALIZER_GROUP" 2>/dev/null)" = "$NORMALIZER_GROUP" ] || exit 1
	account_groups="$(id -G "$ADGUARD_USER" 2>/dev/null)" || exit 1
	case " $account_groups " in *" 0 "*) exit 1 ;; esac
	normalizer_lock_directory_is_private || exit 1
	trap cleanup_installer_normalizer EXIT
	# mkdir is the lock acquisition: it is atomic, nonblocking, and only the
	# successful creator removes this exact directory on exit.  Unlike unlinking
	# a flock file, this cannot split contenders across two locked inodes.
	mkdir -m 0700 "$NORMALIZER_LOCK" || exit 1
	lock_held=1
	chown 0:0 "$NORMALIZER_LOCK" && chmod 0700 "$NORMALIZER_LOCK" || exit 1
	normalizer_lock_is_private || exit 1
	if adguard_uid_process_exists; then
		log_error "Refusing installer normalization while uid ${ADGUARD_UID} is not quiescent"
		exit 1
	fi
	exec 8<"$candidate" || exit 1
	source_fd=/proc/self/fd/8
	[ -f "$source_fd" ] && [ "$source_fd" -ef "$candidate" ] || exit 1

	validation_dir="$(mktemp -d /tmp/AdGuardHome-normalize.XXXXXX)" || exit 1
	validation_config_dir="${validation_dir}/config"
	validation_work="${validation_dir}/work"
	validation="${validation_config_dir}/AdGuardHome.yaml"
	normalized="${validation_dir}/normalized.yaml"
	normalized_verify="${validation_dir}/normalized-verify.yaml"
	source_verify="${validation_dir}/source-verify.yaml"
	mkdir "$validation_config_dir" "$validation_work" || exit 1
	snapshot_config_file "$candidate" "$validation" "" 8 || exit 1
	original_hash="$SNAPSHOT_CONFIG_HASH"
	original_certificate_path="$(yaml_get_section_value tls certificate_path "$validation")"
	original_private_key_path="$(yaml_get_section_value tls private_key_path "$validation")"
	prepare_tls_validation_files "$validation" "$validation_dir" || exit 1
	[ -z "$TLS_CERT_REAL" ] || tls_paths_rewritten=1
	if [ "$tls_paths_rewritten" = 1 ]; then
		chown 0:0 "${validation_dir}/tls-certificate" \
			"${validation_dir}/tls-private-key" || exit 1
		chmod 0640 "${validation_dir}/tls-certificate" \
			"${validation_dir}/tls-private-key" || exit 1
	fi

	# Hold the exact config directory before it becomes writable.  Its root-only
	# parent remains mode 0700 on the host; ujail bind-mounts the child at the
	# same pathname inside a private mount namespace for the lowered core.
	exec 7<"$validation_config_dir" || exit 1
	config_dir_fd=/proc/self/fd/7
	[ -d "$config_dir_fd" ] && [ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1
	chown 0:0 "$config_dir_fd" "$validation_work" || exit 1
	chown "${ADGUARD_UID}:0" "$validation" || exit 1
	chmod 0770 "$config_dir_fd" "$validation_work" || exit 1
	chmod 0600 "$validation" || exit 1
	[ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1

	# Let ujail reap a TERM-resistant child before the outer timeout may kill its
	# supervisor.  The four-second outer grace exceeds ujail's one-second grace.
	set -- /sbin/ujail -n AGHNormalize -t 1 -E -c -o \
		-U "$ADGUARD_USER" -G "$NORMALIZER_GROUP" \
		-w "$validation_config_dir" -w "$validation_work"
	if [ "$tls_paths_rewritten" = 1 ]; then
		set -- "$@" -r "${validation_dir}/tls-certificate" \
			-r "${validation_dir}/tls-private-key"
	fi
	set -- "$@" -- "$CORE_BINARY" --check-config \
		--config "$validation" --work-dir "$validation_work"
	run_bounded 20 4 "$@" >/dev/null 2>&1 || rc=$?
	[ "$rc" = 0 ] || exit 1

	# Revoke the bind source through its held descriptor before opening output.
	# Then prove that the core produced one bounded regular inode and capture it
	# twice through a held FD.  Hash only the root-owned bounded snapshots.
	[ -d "$config_dir_fd" ] && [ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1
	chown 0:0 "$config_dir_fd" && chmod 0700 "$config_dir_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$config_dir_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ] || exit 1
	[ -f "$validation" ] && [ ! -L "$validation" ] || exit 1
	exec 9<"$validation" || exit 1
	output_fd=/proc/self/fd/9
	[ -f "$output_fd" ] && [ "$output_fd" -ef "$validation" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$output_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = \
		"${ADGUARD_UID}:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	chown 0:0 "$output_fd" && chmod 0600 "$output_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$output_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	snapshot_config_file "$validation" "$normalized" "" 9 || exit 1
	normalized_hash="$SNAPSHOT_CONFIG_HASH"
	snapshot_config_file "$validation" "$normalized_verify" \
		"$normalized_hash" 9 || exit 1
	chown 0:0 "$normalized" && chmod 0600 "$normalized" || exit 1
	if [ "$tls_paths_rewritten" = 1 ]; then
		yaml_replace_tls_scalar tls certificate_path \
			"$original_certificate_path" "$normalized" || exit 1
		yaml_replace_tls_scalar tls private_key_path \
			"$original_private_key_path" "$normalized" || exit 1
	fi
	yaml_replace_section_list_item filtering safe_fs_patterns \
		"${validation_work}/data/userfilters/*" \
		"${work_dir}/data/userfilters/*" "$normalized" || pattern_rc=$?
	case "$pattern_rc" in 0|3) ;; *) exit 1 ;; esac
	# No jail-private path may escape into the installed YAML.  This also catches
	# any future official migrator field that embeds its disposable workdir.
	rc=0
	grep -F "$validation_dir" "$normalized" >/dev/null 2>&1 || rc=$?
	case "$rc" in 0) exit 1 ;; 1) ;; *) exit 1 ;; esac
	normalized_hash="$(yaml_file_hash "$normalized")" || exit 1
	check_core_config_file "$normalized" "$normalized_hash" "" "" || exit 1

	snapshot_config_file "$candidate" "$source_verify" "$original_hash" 8 || exit 1
	[ -f "$candidate" ] && [ ! -L "$candidate" ] && \
		[ "$source_fd" -ef "$candidate" ] || exit 1
	root_private_config_source "$candidate" || exit 1
	replacement="$(mktemp "${candidate}.normalized.XXXXXX")" || exit 1
	exec 6<>"$replacement" || exit 1
	replacement_fd=/proc/self/fd/6
	[ -f "$replacement_fd" ] && [ "$replacement_fd" -ef "$replacement" ] || exit 1
	run_bounded 3 1 /bin/dd if="$normalized" \
		bs=4096 count=129 of="$replacement_fd" 2>/dev/null || exit 1
	chown 0:0 "$replacement_fd" && chmod 0600 "$replacement_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$replacement_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	[ "$(open_fd_hash "$replacement_fd")" = "$normalized_hash" ] || exit 1
	snapshot_config_file "$candidate" "$source_verify" "$original_hash" 8 || exit 1
	[ -f "$candidate" ] && [ ! -L "$candidate" ] && \
		[ "$source_fd" -ef "$candidate" ] || exit 1
	mv "$replacement" "$candidate" || exit 1
	replacement=""
	[ "$replacement_fd" -ef "$candidate" ] || exit 1
	[ "$(open_fd_hash "$replacement_fd")" = "$normalized_hash" ] || exit 1
	exec 6>&-
	exec 9>&-
	exec 7>&-
	exec 8>&-
)

# Restricted validator for the clean-install/migration script.  It accepts no
# UCI state and performs no writes outside a root-owned disposable directory.
# snapshot_config_file() either uses a root-private source or reads as uid 853,
# so a pathname race cannot turn this command into a privileged file reader.
check_config() {
	local candidate="$1" requested_work_dir="$2"
	valid_config_candidate_path "$candidate" || return 1
	# This root-only migration validator may run immediately before the official
	# lower UCI is anchored to a newly-created custom directory.  Enforce the
	# namespace and trusted ancestors here; runtime entry points additionally
	# require the exact existing-directory UCI anchor.
	validate_managed_work_dir_namespace "$requested_work_dir" || return 1
	work_dir="${requested_work_dir%/}"
	check_core_config_file "$candidate"
}

normalize_config() {
	local candidate="$1" requested_work_dir="$2"
	valid_config_candidate_path "$candidate" || return 1
	case "$candidate" in
		"${NORMALIZER_RUNTIME_DIR}/yaml-migration."??????|\
		"${NORMALIZER_RUNTIME_DIR}/yaml-workdir-result."??????|\
		"${NORMALIZER_RUNTIME_DIR}/yaml-dns-result."??????) ;;
		*) return 1 ;;
	esac
	# Package migrations may normalize only root-private candidates after the
	# requested destination has passed the same namespace checks as runtime.
	validate_managed_work_dir_namespace "$requested_work_dir" || return 1
	work_dir="${requested_work_dir%/}"
	normalize_installer_config "$candidate"
}

restore_yaml_backup() {
	local backup="$1"
	install_config_candidate "$backup" "" ""
}

open_fd_hash() {
	local fd_path="$1" digest
	[ -f "$fd_path" ] || return 1
	digest="$(/usr/bin/sha256sum "$fd_path" 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		????????????????????????????????????????????????????????????????)
			case "$digest" in *[!0-9a-f]*) return 1 ;; esac
			printf '%s\n' "$digest"
			;;
		*) return 1 ;;
	esac
}

install_config_candidate_attempt() (
	local source="$1" source_hash="$2" expected_active="$3" stage="$4"
	local replacement_marker="$5" fd_path size installed_hash current_hash cleanup_stage=""
	trap '[ -z "$cleanup_stage" ] || rm -f "$cleanup_stage"' EXIT
	# noclobber makes the redirection an exclusive create.  Keep descriptor 9
	# open through the pathname identity checks and atomic rename, so root never
	# writes a stage pathname that uid 853 replaced with a symlink.
	set -C
	exec 9>"$stage" || exit 1
	set +C
	cleanup_stage="$stage"
	fd_path=/proc/self/fd/9
	/bin/cat "$source" >&9 || exit 1
	[ -f "$fd_path" ] || exit 1
	size="$(wc -c <"$fd_path" 2>/dev/null)" || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	installed_hash="$(open_fd_hash "$fd_path")" || exit 1
	[ "$installed_hash" = "$source_hash" ] || exit 1
	[ -f "$stage" ] && [ ! -L "$stage" ] && [ "$fd_path" -ef "$stage" ] || exit 1
	if [ "$expected_active" = absent ]; then
		[ ! -e "$config_file" ] && [ ! -L "$config_file" ] || exit 1
	elif [ -n "$expected_active" ]; then
		current_hash="$(active_config_hash)" || exit 1
		[ "$current_hash" = "$expected_active" ] || exit 1
	fi
	secure_config_inode "$fd_path" || exit 1
	[ -f "$stage" ] && [ ! -L "$stage" ] && [ "$fd_path" -ef "$stage" ] || exit 1
	[ -z "$replacement_marker" ] || : >"$replacement_marker" || exit 1
	mv "$stage" "$config_file" || exit 1
	cleanup_stage=""
	[ "$fd_path" -ef "$config_file" ] || exit 1
	current_hash="$(active_config_hash)" || exit 1
	[ "$current_hash" = "$source_hash" ] || exit 1
	exec 9>&-
)

install_config_candidate() {
	local source="$1" expected_active="$2" desired_hash="$3"
	local replacement_marker="$4" source_hash attempt=0 stage
	[ -f "$source" ] && [ ! -L "$source" ] || return 1
	root_private_config_source "$source" || return 1
	source_hash="$(yaml_file_hash "$source")" || return 1
	[ -z "$desired_hash" ] || [ "$source_hash" = "$desired_hash" ] || return 1
	if [ -n "$replacement_marker" ]; then
		case "$replacement_marker" in
			/tmp/AdGuardHome-managed.??????/install-replaced) ;;
			*) return 1 ;;
		esac
		rm -f "$replacement_marker" || return 1
	fi
	while [ "$attempt" -lt 10 ]; do
		stage="${config_file}.install.$$.$attempt"
		if install_config_candidate_attempt "$source" "$source_hash" \
			"$expected_active" "$stage" "$replacement_marker"; then
			return 0
		fi
		attempt=$((attempt + 1))
	done
	return 1
}

# Rewrite only a root-private bounded snapshot.  The official core validates
# that candidate as uid 853, then the active revision is compared again at the
# final atomic-install boundary.
sync_yaml_managed_fields_checked() {
	local directory backup candidate replacement_marker
	local expected_hash candidate_hash current_hash
	directory="$(mktemp -d /tmp/AdGuardHome-managed.XXXXXX)" || return 1
	backup="${directory}/original.yaml"
	candidate="${directory}/AdGuardHome.yaml"
	replacement_marker="${directory}/install-replaced"
	expected_hash="$(active_config_hash)" || {
		rm -rf "$directory"
		return 1
	}
	if ! snapshot_config_file "$config_file" "$backup" "$expected_hash" "" ||
	   ! /bin/cp "$backup" "$candidate" ||
	   ! chmod 0600 "$candidate" ||
	   ! sync_yaml_managed_fields "$candidate"; then
		rm -rf "$directory"
		log_error "Unable to update the managed YAML fields"
		return 1
	fi
	candidate_hash="$(yaml_file_hash "$candidate")" || {
		rm -rf "$directory"
		return 1
	}
	if [ "$candidate_hash" = "$expected_hash" ]; then
		rm -rf "$directory"
		return 0
	fi
	if ! check_core_config_file "$candidate" "$candidate_hash" "" 1; then
		rm -rf "$directory"
		log_error "AdGuard Home rejected the managed YAML candidate"
		return 1
	fi
	current_hash="$(active_config_hash)" || {
		rm -rf "$directory"
		return 1
	}
	if [ "$current_hash" != "$expected_hash" ]; then
		rm -rf "$directory"
		log_error "The active YAML changed during its managed-field update"
		return 1
	fi
	if ! install_config_candidate "$candidate" "$expected_hash" \
		"$candidate_hash" "$replacement_marker"; then
		if [ -f "$replacement_marker" ] && [ ! -L "$replacement_marker" ]; then
			if install_config_candidate "$backup" "" "$expected_hash" ""; then
				rm -rf "$directory"
				log_error "Restored the active YAML after a failed managed-field install"
				return 1
			fi
			chmod 0700 "$directory" >/dev/null 2>&1 || true
			chmod 0600 "$backup" >/dev/null 2>&1 || true
			log_error "Preserved the original YAML after restore failure: ${backup}"
			return 1
		fi
		rm -rf "$directory"
		log_error "The managed YAML candidate was not installed"
		return 1
	fi
	rm -rf "$directory"
}

uci_set_if_changed() {
	local config="$1" section="$2" option="$3" value="$4" current
	current="$(uci -q get "${config}.${section}.${option}")"
	[ "$current" = "$value" ] && return 0
	uci -q set "${config}.${section}.${option}=${value}" || return 1
	UCI_CHANGED=1
}

uci_delete_if_present() {
	local config="$1" section="$2" option="$3"
	uci -q get "${config}.${section}.${option}" >/dev/null 2>&1 || return 0
	uci -q delete "${config}.${section}.${option}" || return 1
	UCI_CHANGED=1
}

line_list_contains() {
	local needle="$1" list="$2" item
	[ -n "$list" ] || return 1
	while IFS= read -r item; do
		[ "$item" = "$needle" ] && return 0
	done <<-EOF
	$list
	EOF
	return 1
}

append_tls_desired_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_DESIRED_MOUNTS" && return 0
	if [ -n "$TLS_DESIRED_MOUNTS" ]; then
		TLS_DESIRED_MOUNTS="${TLS_DESIRED_MOUNTS}
${value}"
	else
		TLS_DESIRED_MOUNTS="$value"
	fi
}

append_tls_old_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_OLD_MOUNTS" && return 0
	if [ -n "$TLS_OLD_MOUNTS" ]; then
		TLS_OLD_MOUNTS="${TLS_OLD_MOUNTS}
${value}"
	else
		TLS_OLD_MOUNTS="$value"
	fi
}

append_tls_new_managed_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_NEW_MANAGED_MOUNTS" && return 0
	if [ -n "$TLS_NEW_MANAGED_MOUNTS" ]; then
		TLS_NEW_MANAGED_MOUNTS="${TLS_NEW_MANAGED_MOUNTS}
${value}"
	else
		TLS_NEW_MANAGED_MOUNTS="$value"
	fi
}

append_tls_original_mount() {
	local value="$1"
	if [ -n "$TLS_ORIGINAL_MOUNTS" ]; then
		TLS_ORIGINAL_MOUNTS="${TLS_ORIGINAL_MOUNTS}
${value}"
	else
		TLS_ORIGINAL_MOUNTS="$value"
	fi
	if line_list_contains "$value" "$TLS_OLD_MOUNTS" ||
	   line_list_contains "$value" "$TLS_PRESERVED_MOUNTS"; then
		return 0
	fi
	if [ -n "$TLS_PRESERVED_MOUNTS" ]; then
		TLS_PRESERVED_MOUNTS="${TLS_PRESERVED_MOUNTS}
${value}"
	else
		TLS_PRESERVED_MOUNTS="$value"
	fi
}

collect_tls_old_mount() {
	append_tls_old_mount "$1"
}

collect_tls_official_mount() {
	append_tls_original_mount "$1"
}

derive_tls_new_managed_mounts() {
	local value
	TLS_NEW_MANAGED_MOUNTS=""
	[ -n "$TLS_DESIRED_MOUNTS" ] || return 0
	while IFS= read -r value; do
		[ -n "$value" ] || continue
		# Continue owning mounts recorded by this package.  A desired mount
		# already present without such a record is user-owned and is preserved,
		# not silently adopted.  Only a missing desired path becomes new
		# package-managed state.
		if line_list_contains "$value" "$TLS_OLD_MOUNTS" ||
		   ! line_list_contains "$value" "$TLS_ORIGINAL_MOUNTS"; then
			append_tls_new_managed_mount "$value"
		fi
	done <<-EOF
	$TLS_DESIRED_MOUNTS
	EOF
}

valid_tls_path_syntax() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "${value}/" in
		*/./*|*/../*) return 1 ;;
	esac
}

# Require every ancestor of a root-read file to be root-owned.  Writable
# ancestors are rejected except for the target's top-level /etc (exposed as
# mode 0777 by this rootfs) and the root-owned sticky /tmp used by mktemp.
# ImmortalWrt's fixed /var -> /tmp link is treated exactly like /tmp only when
# its target and dereferenced permissions match that system layout.  Every
# deeper ancestor must be non-writable, and the held-FD identity checks below
# reject replacement before bytes are accepted.
trusted_root_file_source() {
	local value="$1" parent remaining component current="" metadata mode owner
	local links group remainder protected_ancestor=0
	[ -f "$value" ] && [ ! -L "$value" ] && [ -O "$value" ] || return 1
	parent="${value%/*}"
	remaining="${parent#/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -L "$current" ]; then
			[ "$current" = /var ] || return 1
			case "$(readlink "$current" 2>/dev/null)" in
				tmp|/tmp) ;;
				*) return 1 ;;
			esac
			metadata="$(LC_ALL=C ls -ldnL "$current" 2>/dev/null)" || return 1
		else
			[ -d "$current" ] || return 1
			metadata="$(LC_ALL=C ls -ldn "$current" 2>/dev/null)" || return 1
		fi
		read -r mode links owner group remainder <<-EOF
		$metadata
		EOF
		[ "$owner" = 0 ] || return 1
		case "$mode" in
			?????w*|????????w*)
				case "$current:$mode" in
					/etc:*) ;;
					/tmp:drwxrwxrwt) ;;
					/var:drwxrwxrwt) ;;
					*) return 1 ;;
				esac
				;;
		esac
		case "$current" in /etc|/tmp|/var) ;; *) protected_ancestor=1 ;; esac
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
	[ "$protected_ancestor" = 1 ]
}

capture_root_file_bytes() {
	local source="$1" target="$2" blocks="$3"
	trusted_root_file_source "$source" || return 1
	(
		exec 8<"$source" || exit 1
		[ -f /proc/self/fd/8 ] || exit 1
		fd_metadata="$(LC_ALL=C ls -ldnL /proc/self/fd/8 2>/dev/null)" || exit 1
		read -r fd_mode fd_links fd_owner fd_group fd_remainder <<-EOF
		$fd_metadata
		EOF
		case "$fd_mode" in -*) ;; *) exit 1 ;; esac
		[ "$fd_owner" = 0 ] || exit 1
		[ ! -L "$source" ] && [ /proc/self/fd/8 -ef "$source" ] || exit 1
		run_bounded 5 1 /bin/dd if=/proc/self/fd/8 \
			bs=4096 count="$blocks" of="$target" 2>/dev/null || exit 1
		[ ! -L "$source" ] && [ /proc/self/fd/8 -ef "$source" ] || exit 1
		trusted_root_file_source "$source"
	)
}

# Copy one TLS file into a root-private regular file with a strict byte and time
# bound.  Workdir material is opened only as uid 853; external root-controlled
# material may be captured as root after the ancestor ownership proof above.
snapshot_tls_file() {
	local source="$1" target="$2" access="$3" size capture_rc=0
	[ ! -e "$target" ] && [ ! -L "$target" ] || return 1
	(umask 077; : >"$target") || return 1
	case "$access" in
		root)
			capture_root_file_bytes "$source" "$target" 257 || capture_rc=$?
			;;
		service)
			run_bounded 5 1 \
				/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
				-n AGHTLSRead -x /bin/dd -- if="$source" bs=4096 count=257 \
				>"$target" 2>/dev/null || capture_rc=$?
			;;
		*) capture_rc=1 ;;
	esac
	[ "$capture_rc" = 0 ] || {
		rm -f "$target"
		return 1
	}
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_TLS_FILE_SIZE" ] || return 1
}

# Resolve one YAML TLS pathname without widening the official service jail.
# /etc/ssl/acme is intentionally file-by-file: a symlink is accepted only when
# its canonical target remains under the acme package's /etc/acme tree.
resolve_tls_path() {
	local value="$1" remainder resolved
	valid_tls_path_syntax "$value" || return 1
	[ -f "$value" ] || return 1
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	[ -f "$resolved" ] || return 1
	case "$value" in
		"${work_dir}"/*)
			case "$resolved" in "${work_dir}"/*) ;; *) return 1 ;; esac
			;;
		/etc/ssl/certs/*)
			case "$resolved" in /etc/ssl/certs/*) ;; *) return 1 ;; esac
			;;
		/etc/ssl/acme/*)
			remainder="${value#/etc/ssl/acme/}"
			case "$remainder" in ""|*/*) return 1 ;; esac
			path_contains_symlink /etc/ssl/acme && return 1
			if [ -L "$value" ]; then
				case "$resolved" in /etc/acme/*) ;; *) return 1 ;; esac
			else
				[ "$resolved" = "$value" ] || return 1
			fi
			append_tls_desired_mount "$value"
			[ "$resolved" = "$value" ] || append_tls_desired_mount "$resolved"
			TLS_USES_ACME=1
			;;
		*) return 1 ;;
	esac
	# Certificate expiry is owned by ACME/the official core and is deliberately
	# not interpreted here.  snapshot_tls_file() separately enforces ordinary
	# file, readability, byte and hard-time bounds before the core is invoked.
	RESOLVED_TLS_PATH="$resolved"
	case "$resolved" in
		"${work_dir}"/*) RESOLVED_TLS_EXTERNAL=0 ;;
		/etc/acme/*|/etc/ssl/acme/*|/etc/ssl/certs/*) RESOLVED_TLS_EXTERNAL=1 ;;
		*) return 1 ;;
	esac
}

tls_file_hash() {
	local directory snapshot digest
	directory="$(mktemp -d /tmp/AdGuardHome-tls-hash.XXXXXX)" || return 1
	snapshot="${directory}/material"
	if ! snapshot_tls_file "$1" "$snapshot" service; then
		rm -rf "$directory"
		return 1
	fi
	digest="$(yaml_file_hash "$snapshot")" || {
		rm -rf "$directory"
		return 1
	}
	rm -rf "$directory" || return 1
	printf '%s\n' "$digest"
}

load_tls_access() {
	local tls_config_file="${1:-$config_file}"
	local enabled certificate_path private_key_path certificate_hash key_hash key_external
	TLS_DESIRED_MOUNTS=""
	TLS_CERT_REAL=""
	TLS_KEY_REAL=""
	TLS_CERT_EXTERNAL=0
	TLS_KEY_EXTERNAL=0
	TLS_USES_ACME=0
	TLS_FINGERPRINT=""

	enabled="$(yaml_get_section_value tls enabled "$tls_config_file")"
	case "$enabled" in
		1|on|true|TRUE|True|yes|YES|Yes) ;;
		0|off|false|FALSE|False|no|NO|No|"") return 0 ;;
		*) return 1 ;;
	esac
	certificate_path="$(yaml_get_section_value tls certificate_path "$tls_config_file")"
	private_key_path="$(yaml_get_section_value tls private_key_path "$tls_config_file")"
	# Inline certificate_chain/private_key needs no host filesystem access.
	[ -n "$certificate_path" ] || [ -n "$private_key_path" ] || return 0
	[ -n "$certificate_path" ] && [ -n "$private_key_path" ] || return 1

	resolve_tls_path "$certificate_path" || return 1
	TLS_CERT_REAL="$RESOLVED_TLS_PATH"
	TLS_CERT_EXTERNAL="$RESOLVED_TLS_EXTERNAL"
	resolve_tls_path "$private_key_path" || return 1
	TLS_KEY_REAL="$RESOLVED_TLS_PATH"
	TLS_KEY_EXTERNAL="$RESOLVED_TLS_EXTERNAL"
	key_external="$RESOLVED_TLS_EXTERNAL"
	# Candidate validation is read-only.  Permission repair occurs only when
	# synchronizing the active YAML, never while parsing an RPC submission.
	[ "${TLS_PREFLIGHT_ONLY:-0}" = 1 ] && return 0
	# External certificate and key material are readable only by root and the
	# official service group.  This is idempotent after ACME renewals (which may
	# recreate either inode as root:root), and neither file is group-writable.
	# Workdir material is never chowned from this root wrapper.
	if [ "$TLS_CERT_EXTERNAL" = 1 ]; then
		chown "0:${ADGUARD_GID}" "$TLS_CERT_REAL" || return 1
		chmod 0640 "$TLS_CERT_REAL" || return 1
	fi
	if [ "$key_external" = 1 ]; then
		chown "0:${ADGUARD_GID}" "$TLS_KEY_REAL" || return 1
		chmod 0640 "$TLS_KEY_REAL" || return 1
	fi

	# Prove that the official uid can read a bounded regular snapshot of both
	# configured files.  This also prevents FIFO/FUSE stalls from holding the
	# integration lock indefinitely.  It does not inspect certificate dates.
	certificate_hash="$(tls_file_hash "$TLS_CERT_REAL")" || return 1
	key_hash="$(tls_file_hash "$TLS_KEY_REAL")" || return 1
	if [ "$TLS_USES_ACME" = 1 ]; then
		TLS_FINGERPRINT="$(printf '%s\n%s\n' "$certificate_hash" "$key_hash" |
			sha256sum 2>/dev/null)" || return 1
		TLS_FINGERPRINT="${TLS_FINGERPRINT%% *}"
		[ "${#TLS_FINGERPRINT}" -eq 64 ] || return 1
		case "$TLS_FINGERPRINT" in *[!0-9a-f]*) return 1 ;; esac
	fi
}

yaml_replace_tls_scalar() {
	local section="$1" key="$2" replacement="$3" file="$4" tmp rc
	tmp="$(mktemp "${file}.tls.XXXXXX")" || return 1
	awk -v section="$section" -v key="$key" -v replacement="$replacement" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(n, s, i) { s=""; for (i=0; i<n; i++) s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for (i=1; i<=n; i++)
				if (line[i] ~ ("^" section ":[[:space:]]*($|#)")) { sections++; first=i }
			if (sections != 1) exit 1
			last=n
			for (i=first+1; i<=n; i++) if (top(line[i])) { last=i-1; break }
			depth=0
			for (i=first+1; i<=last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d=indent(line[i]); if (!depth || d<depth) depth=d
			}
			if (!depth) depth=2
			for (i=first+1; i<=last; i++) {
				if (indent(line[i]) != depth) continue
				value=substr(line[i], depth+1)
				if (value ~ ("^" key ":[[:space:]]*")) { matches++; found=i }
			}
			if (matches != 1) exit 1
			# TLS paths have already passed the restricted path grammar, which
			# excludes quotes and backslashes.  Quote the scalar so a permitted
			# trailing colon cannot change YAML syntax during normalization.
			line[found]=pad(depth) key ": \"" replacement "\""
			for (i=1; i<=n; i++) print line[i]
		}' "$file" >"$tmp"
	rc=$?
	if [ "$rc" != 0 ] || ! mv "$tmp" "$file"; then
		rm -f "$tmp"
		return 1
	fi
}

prepare_tls_validation_files() {
	local yaml="$1" directory="$2" cert_copy key_copy cert_access key_access rc=0
	TLS_PREFLIGHT_ONLY=1
	load_tls_access "$yaml" || rc=$?
	unset TLS_PREFLIGHT_ONLY
	[ "$rc" = 0 ] || return 1
	[ -n "$TLS_CERT_REAL" ] || return 0
	cert_copy="${directory}/tls-certificate"
	key_copy="${directory}/tls-private-key"
	[ "$TLS_CERT_EXTERNAL" = 1 ] && cert_access=root || cert_access=service
	[ "$TLS_KEY_EXTERNAL" = 1 ] && key_access=root || key_access=service
	snapshot_tls_file "$TLS_CERT_REAL" "$cert_copy" "$cert_access" || return 1
	snapshot_tls_file "$TLS_KEY_REAL" "$key_copy" "$key_access" || return 1
	chown "0:${ADGUARD_GID}" "$cert_copy" "$key_copy" || return 1
	chmod 0640 "$cert_copy" "$key_copy" || return 1
	yaml_replace_tls_scalar tls certificate_path "$cert_copy" "$yaml" || return 1
	yaml_replace_tls_scalar tls private_key_path "$key_copy" "$yaml"
}

load_active_tls_access() {
	local directory snapshot rc=0
	directory="$(mktemp -d /tmp/AdGuardHome-tls.XXXXXX)" || return 1
	snapshot="${directory}/AdGuardHome.yaml"
	if ! snapshot_config_file "$config_file" "$snapshot" "" "" ||
	   ! load_tls_access "$snapshot"; then
		rc=1
	fi
	rm -rf "$directory" || return 1
	return "$rc"
}

write_mount_list() {
	local target="$1" item list="$2"
	[ -n "$list" ] || return 0
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		uci -q add_list "${target}=${item}" || return 1
	done <<-EOF
	$list
	EOF
}

uci_guard_config_file_valid() {
	local target="$1" metadata mode links owner group size remainder
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	case "$mode" in -rw-------|-rw-r-----|-rw-r--r--) ;; *) return 1 ;; esac
	[ "$links:$owner:$group" = "1:0:0" ] || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_UCI_CONFIG_SIZE" ]
}

uci_guard_snapshot_dir_valid() {
	local target="$1" metadata mode links owner group remainder
	[ -d "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$mode:$owner:$group" = "drwx------:0:0" ] && [ "$links" -ge 2 ] 2>/dev/null
}

uci_guard_file_signature() {
	local metadata mode links owner group size remainder
	uci_guard_config_file_valid "$1" || return 1
	metadata="$(LC_ALL=C ls -ldn "$1" 2>/dev/null)" || return 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	printf '%s:%s:%s:%s\n' "$owner" "$group" "$mode" "$size"
}

uci_guard_snapshot_file() {
	local source="$1" target="$2" source_signature target_signature
	source_signature="$(uci_guard_file_signature "$source")" || return 1
	[ ! -e "$target" ] && [ ! -L "$target" ] || return 1
	cp -p "$source" "$target" || return 1
	target_signature="$(uci_guard_file_signature "$target")" || return 1
	[ "$source_signature" = "$target_signature" ] && cmp -s "$source" "$target"
}

uci_guard_restore_file() {
	local snapshot="$1" target="$2" temporary snapshot_signature target_signature
	snapshot_signature="$(uci_guard_file_signature "$snapshot")" || return 1
	temporary="$(mktemp "${UCI_GUARD_CONFIG_FD_PATH}/.luci-adguardhome-rollback.XXXXXX")" || return 1
	case "$temporary" in
		"${UCI_GUARD_CONFIG_FD_PATH}/.luci-adguardhome-rollback."??????) ;;
		*) rm -f "$temporary"; return 1 ;;
	esac
	if ! cp -p "$snapshot" "$temporary" ||
	   ! uci_guard_config_file_valid "$temporary" ||
	   ! cmp -s "$snapshot" "$temporary"; then
		rm -f "$temporary"
		return 1
	fi
	target_signature="$(uci_guard_file_signature "$temporary")" || {
		rm -f "$temporary"
		return 1
	}
	if [ "$snapshot_signature" != "$target_signature" ] ||
	   ! mv -f "$temporary" "$target"; then
		rm -f "$temporary"
		return 1
	fi
	target_signature="$(uci_guard_file_signature "$target")" || return 1
	[ "$snapshot_signature" = "$target_signature" ] && cmp -s "$snapshot" "$target"
}

uci_guard_no_delta() {
	local changes
	changes="$(uci -q changes "$1" 2>/dev/null)" || return 1
	[ -z "$changes" ]
}

# Used before a repair commit when no active v3 state may exist (for example,
# after /tmp disappeared at reboot).  Permit only the exact r2 work-dir delta
# and the exact r1 config-path delta; any user or foreign option blocks commit.
uci_guard_only_memory_path_delta() {
	local changes line seen_config=0 seen_work=0 count=0
	changes="$(uci -q changes "$OFFICIAL_CONFIG" 2>/dev/null)" || return 1
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		count=$((count + 1))
		case "$line" in
			"${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file='${LEGACY_MEMORY_CONFIG_FILE}'")
				[ "$seen_config" = 0 ] || return 1
				seen_config=1
				;;
			"${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir='${MEMORY_WORK_DIR}'")
				[ "$seen_work" = 0 ] || return 1
				seen_work=1
				;;
			*) return 1 ;;
		esac
	done <<-EOF
	$changes
	EOF
	[ "$count" -le 2 ] 2>/dev/null
}

uci_guard_expected_memory_delta() {
	local changes line seen_work=0 count=0 backing
	local effective_config effective_work legacy_config legacy_work
	# UCI suppresses a set whose value already matches the committed file.  Thus
	# a previous accidental global commit can yield zero or one delta here; every
	# delta that does exist must still be the exact volatile work-dir set.  The
	# effective config path must remain the state-bound persistent YAML.
	backing="${MEMORY_BACKING_WORK_DIR%/}"
	[ -n "$backing" ] && memory_state_binds_persistent "$backing" || return 1
	changes="$(uci -q changes "$OFFICIAL_CONFIG" 2>/dev/null)" || return 1
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		count=$((count + 1))
		if [ "$line" = "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir='${MEMORY_WORK_DIR}'" ]; then
			[ "$seen_work" = 0 ] || return 1
			seen_work=1
		else
			return 1
		fi
	done <<-EOF
	$changes
	EOF
	[ "$count" -le 1 ] 2>/dev/null || return 1
	effective_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	effective_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	legacy_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	legacy_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	[ "$effective_config" = "${backing}/AdGuardHome.yaml" ] &&
		[ "${effective_work%/}" = "$MEMORY_WORK_DIR" ] &&
		[ -z "$legacy_config" ] && [ -z "$legacy_work" ]
}

uci_guard_delta_dir_valid() {
	local metadata mode links owner group remainder
	[ -d "$UCI_DELTA_DIRECTORY" ] && [ ! -L "$UCI_DELTA_DIRECTORY" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$UCI_DELTA_DIRECTORY" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$mode:$owner:$group" = "drwx------:0:0" ] && [ "$links" -ge 2 ] 2>/dev/null
}

uci_guard_delta_file_valid() {
	local target="$1" metadata mode links owner group size remainder
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$mode:$links:$owner:$group" = "-rw-------:1:0:0" ] || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -le "$MAX_UCI_CONFIG_SIZE" ]
}

uci_guard_clear_delta() {
	local package="$1" delta
	case "$package" in "$OFFICIAL_CONFIG"|"$LEGACY_CONFIG") ;; *) return 1 ;; esac
	uci -q revert "$package" >/dev/null 2>&1 || true
	uci_guard_no_delta "$package" && return 0
	if [ ! -e "$UCI_DELTA_DIRECTORY" ] && [ ! -L "$UCI_DELTA_DIRECTORY" ]; then
		return 0
	fi
	uci_guard_delta_dir_valid || return 1
	exec 190<"$UCI_DELTA_DIRECTORY" || return 1
	[ -d /proc/self/fd/190 ] && [ /proc/self/fd/190 -ef "$UCI_DELTA_DIRECTORY" ] || return 1
	delta="/proc/self/fd/190/${package}"
	if [ ! -e "$delta" ] && [ ! -L "$delta" ]; then
		return 0
	fi
	uci_guard_delta_file_valid "$delta" || return 1
	rm -f "$delta"
}

uci_guard_snapshot_configs() {
	local directory
	directory="$(mktemp -d /tmp/AdGuardHome-uci-guard.XXXXXX)" || return 1
	if ! chown 0:0 "$directory" || ! chmod 0700 "$directory" ||
	   ! uci_guard_snapshot_dir_valid "$directory" ||
	   ! uci_guard_snapshot_file "${UCI_GUARD_CONFIG_FD_PATH}/${OFFICIAL_CONFIG}" \
		"${directory}/${OFFICIAL_CONFIG}" ||
	   ! uci_guard_snapshot_file "${UCI_GUARD_CONFIG_FD_PATH}/${LEGACY_CONFIG}" \
		"${directory}/${LEGACY_CONFIG}"; then
		rm -f "${directory}/${OFFICIAL_CONFIG}" "${directory}/${LEGACY_CONFIG}" 2>/dev/null || true
		rmdir "$directory" 2>/dev/null || true
		return 1
	fi
	printf '%s\n' "$directory"
}

uci_guard_discard_snapshot() {
	local directory="$1"
	uci_guard_snapshot_dir_valid "$directory" || return 1
	uci_guard_config_file_valid "${directory}/${OFFICIAL_CONFIG}" || return 1
	uci_guard_config_file_valid "${directory}/${LEGACY_CONFIG}" || return 1
	rm -f "${directory}/${OFFICIAL_CONFIG}" "${directory}/${LEGACY_CONFIG}" || return 1
	rmdir "$directory"
}

uci_guard_rollback_configs_once() {
	local directory="$1"
	uci_guard_snapshot_dir_valid "$directory" || return 1
	uci_guard_clear_delta "$OFFICIAL_CONFIG" || return 1
	uci_guard_clear_delta "$LEGACY_CONFIG" || return 1
	uci_guard_restore_file "${directory}/${OFFICIAL_CONFIG}" \
		"${UCI_GUARD_CONFIG_FD_PATH}/${OFFICIAL_CONFIG}" || return 1
	uci_guard_restore_file "${directory}/${LEGACY_CONFIG}" \
		"${UCI_GUARD_CONFIG_FD_PATH}/${LEGACY_CONFIG}" || return 1
	memory_durability_barrier || return 1
	cmp -s "${directory}/${OFFICIAL_CONFIG}" \
		"${UCI_GUARD_CONFIG_FD_PATH}/${OFFICIAL_CONFIG}" || return 1
	cmp -s "${directory}/${LEGACY_CONFIG}" \
		"${UCI_GUARD_CONFIG_FD_PATH}/${LEGACY_CONFIG}" || return 1
	uci_guard_no_delta "$OFFICIAL_CONFIG" &&
		uci_guard_no_delta "$LEGACY_CONFIG" &&
		uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}" >/dev/null 2>&1 &&
		uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}" >/dev/null 2>&1
}

uci_guard_rollback_configs() {
	local directory="$1" attempt=0
	while [ "$attempt" -lt 2 ]; do
		attempt=$((attempt + 1))
		uci_guard_rollback_configs_once "$directory" && return 0
	done
	return 1
}

memory_commit_official_persistent_paths() {
	local backing="${1%/}"
	validate_managed_work_dir_namespace "$backing" || return 1
	uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}" >/dev/null 2>&1 || return 1
	if ! uci_guard_no_delta "$OFFICIAL_CONFIG"; then
		uci_guard_only_memory_path_delta || return 1
	fi
	if ! uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file=${backing}/AdGuardHome.yaml" ||
	   ! uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir=${backing}"; then
		uci -q revert "$OFFICIAL_CONFIG" >/dev/null 2>&1 || true
		return 1
	fi
	if uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config" >/dev/null 2>&1; then
		uci -q delete "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config" || {
			uci -q revert "$OFFICIAL_CONFIG" >/dev/null 2>&1 || true
			return 1
		}
	fi
	if uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir" >/dev/null 2>&1; then
		uci -q delete "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir" || {
			uci -q revert "$OFFICIAL_CONFIG" >/dev/null 2>&1 || true
			return 1
		}
	fi
	if ! uci -q commit "$OFFICIAL_CONFIG"; then
		uci -q revert "$OFFICIAL_CONFIG" >/dev/null 2>&1 || true
		return 1
	fi
	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")" = "${backing}/AdGuardHome.yaml" ] &&
		[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")" = "$backing" ] &&
		[ -z "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")" ] &&
		[ -z "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")" ]
}

memory_clear_official_path_delta() {
	local effective_config effective_work legacy_config legacy_work backing
	effective_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	effective_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	legacy_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	legacy_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	if [ "$effective_config" != "$LEGACY_MEMORY_CONFIG_FILE" ] &&
	   [ "${effective_work%/}" != "$MEMORY_WORK_DIR" ] &&
	   [ "$legacy_config" != "$LEGACY_MEMORY_CONFIG_FILE" ] &&
		[ "${legacy_work%/}" != "$MEMORY_WORK_DIR" ]; then
		return 0
	fi
	if [ "$MEMORY_ACTIVE" = 1 ]; then
		backing="${MEMORY_BACKING_WORK_DIR%/}"
		[ -n "$backing" ] && memory_state_binds_persistent "$backing" || return 1
	else
		backing="${persistent_work_dir%/}"
	fi
	# Prefer dropping the known volatile work-dir override (and any r1 legacy
	# config override).  A real commit is needed only when a global `uci commit`
	# previously persisted a RAM path itself.
	uci -q revert "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file" >/dev/null 2>&1 || true
	uci -q revert "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir" >/dev/null 2>&1 || true
	effective_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	effective_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	legacy_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	legacy_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	if [ "$effective_config" = "${backing}/AdGuardHome.yaml" ] &&
	   [ "${effective_work%/}" = "$backing" ] &&
	   [ -z "$legacy_config" ] && [ -z "$legacy_work" ]; then
		return 0
	fi
	memory_commit_official_persistent_paths "$backing"
}

memory_apply_official_path_delta() {
	local backing effective_config effective_work legacy_config legacy_work
	[ "$MEMORY_ACTIVE" = 1 ] || return 0
	backing="${MEMORY_BACKING_WORK_DIR%/}"
	[ -n "$backing" ] && memory_state_binds_persistent "$backing" || return 1
	if ! uci_guard_no_delta "$OFFICIAL_CONFIG" &&
	   ! uci_guard_expected_memory_delta; then
		return 1
	fi
	effective_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	effective_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	legacy_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")"
	legacy_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	[ "$effective_config" = "${backing}/AdGuardHome.yaml" ] &&
		{ [ "${effective_work%/}" = "$backing" ] ||
		  [ "${effective_work%/}" = "$MEMORY_WORK_DIR" ]; } &&
		[ -z "$legacy_config" ] && [ -z "$legacy_work" ] || return 1
	if ! uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir=${MEMORY_WORK_DIR}"; then
		# Avoid leaving a half-applied volatile override.  The committed backing paths
		# are always the safe fallback and load_legacy_settings() will adopt the
		# still-valid RAM generation from its state record on the next invocation.
		memory_commit_official_persistent_paths "$backing" >/dev/null 2>&1 || true
		return 1
	fi
	if uci_guard_expected_memory_delta; then
		return 0
	fi
	memory_commit_official_persistent_paths "$backing" >/dev/null 2>&1 || true
	return 1
}

memory_restore_official_persistent_paths() {
	local backing
	[ "$MEMORY_ACTIVE" = 1 ] || return 0
	backing="${MEMORY_BACKING_WORK_DIR%/}"
	[ -n "$backing" ] && memory_state_binds_persistent "$backing" || return 1
	memory_commit_official_persistent_paths "$backing"
}

memory_run_with_official_path_guard() (
	local restore_delta=0 snapshot_ready=0 transaction_complete=0
	local primary_rc=1 final_rc snapshot_directory=""
	[ "$MEMORY_ACTIVE" != 1 ] || restore_delta=1
	cleanup_memory_path_guard() {
		final_rc=$?
		# Disable recursive EXIT handling, then make the compensating restore
		# uninterruptible by catchable termination signals.  A second signal must
		# never split the two raw config restores or their durability barrier.
		trap - 0
		trap '' HUP INT QUIT TERM
		if [ "$snapshot_ready" = 1 ] && [ "$transaction_complete" != 1 ]; then
			if uci_guard_rollback_configs "$snapshot_directory"; then
				snapshot_ready=0
				if ! uci_guard_discard_snapshot "$snapshot_directory"; then
					log_error "UCI rollback completed but its temporary snapshot could not be removed"
					final_rc=1
				fi
			else
				log_error "UCI transaction outcome is indeterminate; retained rollback snapshot at ${snapshot_directory}"
				final_rc=1
			fi
		fi
		if [ "$restore_delta" = 1 ] && [ "$snapshot_ready" != 1 ] &&
		   ! memory_apply_official_path_delta; then
			final_rc=1
		fi
		exit "$final_rc"
	}
	trap cleanup_memory_path_guard 0
	trap 'exit 1' HUP INT QUIT TERM
	[ -d "$UCI_CONFIG_DIRECTORY" ] && [ ! -L "$UCI_CONFIG_DIRECTORY" ] || exit 1
	exec 191<"$UCI_CONFIG_DIRECTORY" || exit 1
	UCI_GUARD_CONFIG_FD_PATH=/proc/self/fd/191
	[ -d "$UCI_GUARD_CONFIG_FD_PATH" ] &&
		[ "$UCI_GUARD_CONFIG_FD_PATH" -ef "$UCI_CONFIG_DIRECTORY" ] || exit 1
	# A package commit must never absorb user changes or make the volatile RAM
	# workdir persistent.  Validate the complete delta, not only its effective
	# values, before exposing a persistent two-package transaction.
	if [ "$restore_delta" = 1 ]; then
		if ! uci_guard_expected_memory_delta; then
			# A newly prepared RAM generation has a durable state record before
			# its volatile lower-UCI pair exists.  Bootstrap only that exact
			# zero-delta state; a partial or unrelated pending change must remain
			# an error and must not be hidden by applying our two values over it.
			uci_guard_no_delta "$OFFICIAL_CONFIG" || exit 1
			memory_apply_official_path_delta || exit 1
			uci_guard_expected_memory_delta || exit 1
		fi
	else
		uci_guard_no_delta "$OFFICIAL_CONFIG" || exit 1
	fi
	uci_guard_no_delta "$LEGACY_CONFIG" || exit 1
	memory_clear_official_path_delta || exit 1
	uci_guard_no_delta "$OFFICIAL_CONFIG" || exit 1
	uci_guard_no_delta "$LEGACY_CONFIG" || exit 1
	snapshot_directory="$(uci_guard_snapshot_configs)" || exit 1
	snapshot_ready=1
	"$@"
	primary_rc=$?
	[ "$primary_rc" = 0 ] || exit "$primary_rc"
	uci_guard_no_delta "$OFFICIAL_CONFIG" || exit 1
	uci_guard_no_delta "$LEGACY_CONFIG" || exit 1
	memory_durability_barrier || exit 1
	snapshot_ready=0
	transaction_complete=1
	if ! uci_guard_discard_snapshot "$snapshot_directory"; then
		log_error "Committed the UCI transaction but could not remove its temporary snapshot"
		exit 1
	fi
	exit 0
)

sync_tls_access_persistent() {
	local expected expected_managed expected_fingerprint current_fingerprint
	local verify_fingerprint official_changed=0 legacy_changed=0
	load_active_tls_access || {
		log_error "TLS certificate or private-key path is unsafe or unavailable"
		return 1
	}

	TLS_OLD_MOUNTS=""
	TLS_ORIGINAL_MOUNTS=""
	TLS_PRESERVED_MOUNTS=""
	config_load "$LEGACY_CONFIG" || return 1
	config_list_foreach "$LEGACY_SECTION" "$MANAGED_JAIL_OPTION" collect_tls_old_mount
	config_load "$OFFICIAL_CONFIG" || return 1
	config_list_foreach "$OFFICIAL_SECTION" jail_mount collect_tls_official_mount
	derive_tls_new_managed_mounts

	expected="$TLS_PRESERVED_MOUNTS"
	if [ -n "$TLS_NEW_MANAGED_MOUNTS" ]; then
		if [ -n "$expected" ]; then
			expected="${expected}
${TLS_NEW_MANAGED_MOUNTS}"
		else
			expected="$TLS_NEW_MANAGED_MOUNTS"
		fi
	fi
	if [ "$TLS_ORIGINAL_MOUNTS" != "$expected" ]; then
		uci -q delete "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.jail_mount" 2>/dev/null || true
		write_mount_list "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.jail_mount" "$expected" || return 1
		official_changed=1
	fi
	if [ "$TLS_OLD_MOUNTS" != "$TLS_NEW_MANAGED_MOUNTS" ]; then
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_JAIL_OPTION}" 2>/dev/null || true
		write_mount_list "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_JAIL_OPTION}" \
			"$TLS_NEW_MANAGED_MOUNTS" || return 1
		legacy_changed=1
	fi

	current_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}")"
	if [ -n "$TLS_FINGERPRINT" ]; then
		if [ "$current_fingerprint" != "$TLS_FINGERPRINT" ]; then
			uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}=${TLS_FINGERPRINT}" || return 1
			legacy_changed=1
		fi
	elif [ -n "$current_fingerprint" ]; then
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}" || return 1
		legacy_changed=1
	fi
	[ "$official_changed" = 0 ] || uci -q commit "$OFFICIAL_CONFIG" || return 1
	[ "$legacy_changed" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1

	# A successful commit status is insufficient for this cross-package update.
	# Reload both packages and prove that the complete list/marker state matches
	# the transaction we just calculated before its guard discards the snapshot.
	expected_managed="$TLS_NEW_MANAGED_MOUNTS"
	expected_fingerprint="$TLS_FINGERPRINT"
	TLS_ORIGINAL_MOUNTS=""
	TLS_PRESERVED_MOUNTS=""
	TLS_OLD_MOUNTS=""
	config_load "$OFFICIAL_CONFIG" || return 1
	config_list_foreach "$OFFICIAL_SECTION" jail_mount collect_tls_official_mount
	config_load "$LEGACY_CONFIG" || return 1
	config_list_foreach "$LEGACY_SECTION" "$MANAGED_JAIL_OPTION" collect_tls_old_mount
	verify_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}")"
	[ "$TLS_ORIGINAL_MOUNTS" = "$expected" ] &&
		[ "$TLS_OLD_MOUNTS" = "$expected_managed" ] &&
		[ "$verify_fingerprint" = "$expected_fingerprint" ]
}

sync_tls_access() {
	memory_run_with_official_path_guard sync_tls_access_persistent
}

sync_official_uci_persistent() {
	local official_work="$work_dir" official_config="$config_file"
	if [ "$MEMORY_ACTIVE" = 1 ]; then
		official_work="$MEMORY_BACKING_WORK_DIR"
		official_config="${official_work}/AdGuardHome.yaml"
	fi
	UCI_CHANGED=0
	if ! uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}" >/dev/null 2>&1; then
		uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}=adguardhome" || return 1
		UCI_CHANGED=1
	fi
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" enabled "$legacy_enabled" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" config_file "$official_config" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" work_dir "$official_work" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" verbose "$verbose" || return 1
	uci_delete_if_present "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" config || return 1
	uci_delete_if_present "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" workdir || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$OFFICIAL_CONFIG" || return 1
	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled")" = "$legacy_enabled" ] &&
		[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")" = "$official_config" ] &&
		[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")" = "$official_work" ] &&
		[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.verbose")" = "$verbose" ] &&
		[ -z "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config")" ] &&
		[ -z "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")" ] || return 1
	sync_tls_access_persistent
}

sync_official_uci() {
	memory_run_with_official_path_guard sync_official_uci_persistent
}

disable_official_autostart_persistent() {
	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled")" = 0 ] && return 0
	uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled=0" || return 1
	uci -q commit "$OFFICIAL_CONFIG" || return 1
	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled")" = 0 ]
}

disable_official_autostart() {
	memory_run_with_official_path_guard disable_official_autostart_persistent
}

reload_service_if_present() {
	local service="$1" action="$2"
	[ "${RELOAD_SERVICES:-1}" = 0 ] && return 0
	[ -x "$service" ] || return 0
	"$service" "$action" >/dev/null 2>&1
}

remember_first_dnsmasq() {
	DNSMASQ_COUNT=$((DNSMASQ_COUNT + 1))
	[ -n "$DNSMASQ_SECTION" ] || DNSMASQ_SECTION="$1"
}

load_dnsmasq_section() {
	DNSMASQ_SECTION=""
	DNSMASQ_UCI=""
	DNSMASQ_COUNT=0
	config_load dhcp || return 1
	config_foreach remember_first_dnsmasq dnsmasq
	[ -n "$DNSMASQ_SECTION" ] || return 1
	if [ "$DNSMASQ_COUNT" -ne 1 ]; then
		log_error "dnsmasq-upstream mode requires exactly one dnsmasq instance; found ${DNSMASQ_COUNT}"
		return 1
	fi
	DNSMASQ_UCI="dhcp.${DNSMASQ_SECTION}"
}

load_snapshot_dnsmasq_section() {
	local recorded
	recorded="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_DNSMASQ_SECTION}")"
	if [ -n "$recorded" ] && uci -q get "dhcp.${recorded}" >/dev/null 2>&1; then
		DNSMASQ_SECTION="$recorded"
		DNSMASQ_UCI="dhcp.${recorded}"
		return 0
	fi
	load_dnsmasq_section
}

dnsmasq_managed_fingerprint() {
	local section_dump managed digest
	section_dump="$(uci -q show "$DNSMASQ_UCI" 2>/dev/null)" || return 1
	managed="$(printf '%s\n' "$section_dump" |
		awk '/\.(server|noresolv|resolvfile)=/')" || return 1
	digest="$(printf '%s\n' "$managed" | sha256sum 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		""|*[!0-9A-Fa-f]*) return 1 ;;
	esac
	[ "${#digest}" -eq 64 ] || return 1
	printf '%s\n' "$digest"
}

# Entries beginning with /domain/ are conditional.  /#/ is dnsmasq's catch-all
# syntax, so it is a generic upstream and must not bypass AdGuard Home.
is_conditional_dnsmasq_server() {
	case "$1" in
		/#/*) return 1 ;;
		/*/*) return 0 ;;
		*) return 1 ;;
	esac
}

snapshot_server_value() {
	uci -q add_list "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_SERVER}=$1" || SNAPSHOT_ERROR=1
}

snapshot_dnsmasq_state() {
	local value option
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] && return 0
	load_dnsmasq_section || return 1

	for option in "$SNAPSHOT_MARKER" "$SNAPSHOT_DNSMASQ_SECTION" "$SNAPSHOT_ACTIVE_FINGERPRINT" "$SNAPSHOT_SERVER" \
		"$SNAPSHOT_NORESOLV_PRESENT" "$SNAPSHOT_NORESOLV_VALUE" \
		"$SNAPSHOT_RESOLVFILE_PRESENT" "$SNAPSHOT_RESOLVFILE_VALUE"; do
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${option}" >/dev/null 2>&1 || true
	done
	if value="$(uci -q get "${DNSMASQ_UCI}.noresolv")"; then
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}=1" || return 1
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_VALUE}=${value}" || return 1
	else
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}=0" || return 1
	fi
	if value="$(uci -q get "${DNSMASQ_UCI}.resolvfile")"; then
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}=1" || return 1
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_VALUE}=${value}" || return 1
	else
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}=0" || return 1
	fi

	SNAPSHOT_ERROR=0
	config_list_foreach "$DNSMASQ_SECTION" server snapshot_server_value
	[ "$SNAPSHOT_ERROR" = 0 ] || return 1
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_DNSMASQ_SECTION}=${DNSMASQ_SECTION}" || return 1
	# Publish the marker last so an interrupted, incomplete snapshot is never
	# treated as authoritative during recovery.
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}=1" || return 1
	uci -q commit "$LEGACY_CONFIG"
}

add_conditional_snapshot_server() {
	is_conditional_dnsmasq_server "$1" || return 0
	uci -q add_list "${DNSMASQ_UCI}.server=$1" || DNSMASQ_LIST_ERROR=1
}

restore_snapshot_server() {
	uci -q add_list "${DNSMASQ_UCI}.server=$1" || DNSMASQ_LIST_ERROR=1
}

clear_dnsmasq_snapshot_metadata() {
	local option
	for option in "$SNAPSHOT_DNSMASQ_SECTION" "$SNAPSHOT_ACTIVE_FINGERPRINT" "$SNAPSHOT_SERVER" \
		"$SNAPSHOT_NORESOLV_PRESENT" "$SNAPSHOT_NORESOLV_VALUE" \
		"$SNAPSHOT_RESOLVFILE_PRESENT" "$SNAPSHOT_RESOLVFILE_VALUE"; do
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${option}" >/dev/null 2>&1 || true
	done
	uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}" || return 1
	uci -q commit "$LEGACY_CONFIG"
}

restore_dnsmasq_snapshot() {
	local present value expected_fingerprint current_fingerprint
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] || return 0
	load_snapshot_dnsmasq_section || return 1
	expected_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}")"
	if [ -n "$expected_fingerprint" ]; then
		current_fingerprint="$(dnsmasq_managed_fingerprint)" || return 1
		if [ "$current_fingerprint" != "$expected_fingerprint" ]; then
			log_error "dnsmasq settings changed while AdGuard Home integration was active; refusing to overwrite them"
			return 1
		fi
	fi
	uci -q delete "${DNSMASQ_UCI}.server" >/dev/null 2>&1 || true
	config_load "$LEGACY_CONFIG" || return 1
	DNSMASQ_LIST_ERROR=0
	config_list_foreach "$LEGACY_SECTION" "$SNAPSHOT_SERVER" restore_snapshot_server
	[ "$DNSMASQ_LIST_ERROR" = 0 ] || return 1

	present="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}")"
	if [ "$present" = 1 ]; then
		value="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_VALUE}")"
		uci -q set "${DNSMASQ_UCI}.noresolv=${value}" || return 1
	else
		uci -q delete "${DNSMASQ_UCI}.noresolv" >/dev/null 2>&1 || true
	fi
	present="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}")"
	if [ "$present" = 1 ]; then
		value="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_VALUE}")"
		uci -q set "${DNSMASQ_UCI}.resolvfile=${value}" || return 1
	else
		uci -q delete "${DNSMASQ_UCI}.resolvfile" >/dev/null 2>&1 || true
	fi
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart || return 1
	clear_dnsmasq_snapshot_metadata
}

mark_generic_server() {
	is_conditional_dnsmasq_server "$1" && return 0
	GENERIC_SERVER_FOUND=1
}

# Best-effort cleanup for state created by releases predating snapshots.
clear_legacy_dnsmasq_upstream() {
	local upstream="127.0.0.1#${1}" resolvfile
	load_dnsmasq_section || return 1
	uci -q del_list "${DNSMASQ_UCI}.server=${upstream}" >/dev/null 2>&1 || true
	# Refresh the shell-side UCI cache before deciding whether any generic
	# upstream remains; otherwise the just-deleted legacy entry is still seen.
	config_load dhcp || return 1
	GENERIC_SERVER_FOUND=0
	config_list_foreach "$DNSMASQ_SECTION" server mark_generic_server
	if [ "$GENERIC_SERVER_FOUND" = 0 ]; then
		resolvfile="/tmp/resolv.conf.d/resolv.conf.auto"
		[ -f "$resolvfile" ] || resolvfile="/tmp/resolv.conf.auto"
		uci -q set "${DNSMASQ_UCI}.resolvfile=${resolvfile}" || return 1
		uci -q delete "${DNSMASQ_UCI}.noresolv" >/dev/null 2>&1 || true
	fi
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

set_dnsmasq_upstream() {
	local upstream="127.0.0.1#${dns_port}" fingerprint
	snapshot_dnsmasq_state || return 1
	uci -q delete "${DNSMASQ_UCI}.server" >/dev/null 2>&1 || true
	config_load "$LEGACY_CONFIG" || return 1
	DNSMASQ_LIST_ERROR=0
	config_list_foreach "$LEGACY_SECTION" "$SNAPSHOT_SERVER" add_conditional_snapshot_server
	[ "$DNSMASQ_LIST_ERROR" = 0 ] || return 1
	uci -q add_list "${DNSMASQ_UCI}.server=${upstream}" || return 1
	uci -q set "${DNSMASQ_UCI}.noresolv=1" || return 1
	uci -q commit dhcp || return 1
	fingerprint="$(dnsmasq_managed_fingerprint)" || return 1
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}=${fingerprint}" || return 1
	uci -q commit "$LEGACY_CONFIG" || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

inspect_active_server() {
	if is_conditional_dnsmasq_server "$1"; then return 0; fi
	if [ "$1" = "$EXPECTED_UPSTREAM" ]; then
		EXPECTED_UPSTREAM_COUNT=$((EXPECTED_UPSTREAM_COUNT + 1))
	else
		UNEXPECTED_GENERIC_SERVER=1
	fi
}

dnsmasq_integration_matches() {
	EXPECTED_UPSTREAM="127.0.0.1#${dns_port}"
	EXPECTED_UPSTREAM_COUNT=0
	UNEXPECTED_GENERIC_SERVER=0
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] || return 1
	load_snapshot_dnsmasq_section || return 1
	[ "$(uci -q get "${DNSMASQ_UCI}.noresolv")" = 1 ] || return 1
	[ "$(dnsmasq_managed_fingerprint)" = "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}")" ] || return 1
	config_load dhcp || return 1
	config_list_foreach "$DNSMASQ_SECTION" server inspect_active_server
	[ "$EXPECTED_UPSTREAM_COUNT" = 1 ] && [ "$UNEXPECTED_GENERIC_SERVER" = 0 ]
}

set_firewall_redirect() {
	local section="firewall.${FIREWALL_SECTION}" owner family=ipv4
	if uci -q get "$section" >/dev/null 2>&1; then
		owner="$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")"
		if [ "$owner" != "$FIREWALL_OWNER_VALUE" ]; then
			log_error "Refusing to overwrite the existing firewall.${FIREWALL_SECTION} section"
			return 1
		fi
	fi
	uci -q set "${section}=redirect" || return 1
	uci -q set "${section}.${FIREWALL_OWNER_OPTION}=${FIREWALL_OWNER_VALUE}" || return 1
	uci -q set "${section}.src=lan" || return 1
	uci -q set "${section}.proto=tcp udp" || return 1
	uci -q set "${section}.src_dport=53" || return 1
	uci -q set "${section}.dest_port=${dns_port}" || return 1
	uci -q set "${section}.target=DNAT" || return 1
	# Redirect IPv6 only when the supervised core actually owns an IPv6 DNS
	# socket; otherwise leave IPv6 port 53 with dnsmasq instead of black-holing it.
	dns_ipv6_listening && family=any
	uci -q set "${section}.family=${family}" || return 1
	uci -q set "${section}.reflection=0" || return 1
	uci -q commit firewall || return 1
	reload_service_if_present /etc/init.d/firewall reload
}

clear_firewall_redirect() {
	local force_reload="$1" existed=0 section="firewall.${FIREWALL_SECTION}" owner
	if uci -q get "$section" >/dev/null 2>&1; then
		owner="$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")"
		if [ "$owner" != "$FIREWALL_OWNER_VALUE" ]; then
			if [ "$force_reload" = 1 ]; then
				log_error "The recorded redirect is not owned by this package; refusing to delete it"
				return 1
			fi
			return 0
		fi
		existed=1
		uci -q delete "$section" || return 1
		uci -q commit firewall || return 1
	fi
	[ "$existed" = 1 ] || [ "$force_reload" = 1 ] || return 0
	reload_service_if_present /etc/init.d/firewall reload
}

firewall_integration_matches() {
	local section="firewall.${FIREWALL_SECTION}" expected_family=ipv4
	dns_ipv6_listening && expected_family=any
	[ "$(uci -q get "$section")" = redirect ] &&
		[ "$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")" = "$FIREWALL_OWNER_VALUE" ] &&
		[ "$(uci -q get "${section}.src")" = lan ] &&
		[ "$(uci -q get "${section}.proto")" = "tcp udp" ] &&
		[ "$(uci -q get "${section}.src_dport")" = 53 ] &&
		[ "$(uci -q get "${section}.dest_port")" = "$dns_port" ] &&
		[ "$(uci -q get "${section}.target")" = DNAT ] &&
		[ "$(uci -q get "${section}.family")" = "$expected_family" ] &&
		[ "$(uci -q get "${section}.reflection")" = 0 ]
}

clear_exchange_mode() {
	local current_port
	load_dnsmasq_section || return 1
	current_port="$(uci -q get "${DNSMASQ_UCI}.port")"
	[ "$current_port" = 53 ] && return 0
	uci -q set "${DNSMASQ_UCI}.port=53" || return 1
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

record_redirect_state() {
	local active="$1"
	UCI_CHANGED=0
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_redirect "$redirect_mode" || return 1
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_port "$dns_port" || return 1
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_enabled "$active" || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1
	printf '%s' "$active" >/var/run/AdGredir 2>/dev/null || true
}

record_redirect_inactive() {
	UCI_CHANGED=0
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_enabled 0 || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1
	printf '0' >/var/run/AdGredir 2>/dev/null || true
}

clear_recorded_integration_locked() {
	local old_redirect old_port old_enabled force_firewall_reload=0
	old_redirect="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_redirect")"
	old_port="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_port")"
	old_enabled="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_enabled")"

	# Snapshot presence takes precedence over possibly stale old_* fields.  The
	# marker is deleted only after dnsmasq has accepted the restored state.
	if [ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ]; then
		restore_dnsmasq_snapshot || return 1
	elif [ "$old_enabled" = 1 ] && [ "$old_redirect" = dnsmasq-upstream ]; then
		is_valid_port "$old_port" || return 1
		clear_legacy_dnsmasq_upstream "$old_port" || return 1
	fi

	[ "$old_enabled" = 1 ] && [ "$old_redirect" = redirect ] && force_firewall_reload=1
	if [ "$(uci -q get "firewall.${FIREWALL_SECTION}.${FIREWALL_OWNER_OPTION}")" = "$FIREWALL_OWNER_VALUE" ] ||
	   [ "$force_firewall_reload" = 1 ]; then
		clear_firewall_redirect "$force_firewall_reload" || return 1
	fi

	if [ "$old_enabled" = 1 ] && [ "$old_redirect" = exchange ]; then
		clear_exchange_mode || return 1
	fi
	record_redirect_inactive
}

runtime_settings_match() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3"
	load_legacy_settings || return 1
	[ "$legacy_enabled" = 1 ] || return 1
	load_runtime_dns_port || return 1
	[ "$dns_port" = "$expected_port" ] &&
		[ "$redirect_mode" = "$expected_mode" ] &&
		[ "$work_dir" = "$expected_work_dir" ]
}

apply_integration_locked() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3" result=0
	if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	dns_port="$expected_port"
	redirect_mode="$expected_mode"
	work_dir="$expected_work_dir"
	if ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	# A cleanup failure is terminal.  Never layer a new mode over live old state.
	clear_recorded_integration_locked || return 1
	case "$redirect_mode" in
		redirect) set_firewall_redirect || result=1 ;;
		dnsmasq-upstream) set_dnsmasq_upstream || result=1 ;;
		none) ;;
	esac
	if [ "$result" != 0 ]; then
		log_error "Unable to apply ${redirect_mode}; restoring the resolver state"
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! record_redirect_state 1; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	# YAML may be rewritten by the official Web UI while the resolver reloads.
	# Roll back immediately unless this exact port/mode/workdir is still current.
	if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir" ||
	   ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
}

integration_matches_desired() {
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_enabled")" = 1 ] || return 1
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_redirect")" = "$redirect_mode" ] || return 1
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_port")" = "$dns_port" ] || return 1
	case "$redirect_mode" in
		dnsmasq-upstream) dnsmasq_integration_matches ;;
		redirect) firewall_integration_matches ;;
		none) return 0 ;;
	esac
}

official_running() {
	[ -x "$OFFICIAL_SERVICE" ] && "$OFFICIAL_SERVICE" running >/dev/null 2>&1
}

official_pid() {
	ubus -S call service list '{"name":"adguardhome"}' 2>/dev/null |
		jsonfilter -e '@.adguardhome.instances.*.pid' 2>/dev/null |
		awk 'NR == 1 && $1 ~ /^[0-9]+$/ { print $1; exit }'
}

pid_is_supervised_descendant() {
	local candidate="$1" supervisor="$2" parent depth=0
	case "$candidate:$supervisor" in
		*[!0-9:]*) return 1 ;;
	esac
	while [ "$depth" -lt 64 ]; do
		[ "$candidate" = "$supervisor" ] && return 0
		[ -r "/proc/${candidate}/status" ] || return 1
		parent="$(awk '$1 == "PPid:" { print $2; exit }' "/proc/${candidate}/status")"
		case "$parent" in
			""|*[!0-9]*) return 1 ;;
		esac
		[ "$parent" -gt 1 ] 2>/dev/null || return 1
		[ "$parent" != "$candidate" ] || return 1
		candidate="$parent"
		depth=$((depth + 1))
	done
	return 1
}

# Verify that a socket in the requested kernel table belongs to the PID
# supervised by the official service.  An unrelated listener on the same port
# must never trigger DNS takeover.  Address modes additionally restrict a
# socket to a loopback-reachable or wildcard bind appropriate for the selected
# integration mode.
official_owns_socket() {
	local table="$1" address_mode="$2" expected_state supervisor pid executable port_hex inode fd link
	[ -r "$table" ] || return 1
	case "$table" in
		/proc/net/tcp|/proc/net/tcp6) expected_state=0A ;;
		/proc/net/udp|/proc/net/udp6) expected_state=07 ;;
		*) return 1 ;;
	esac
	supervisor="$(official_pid)"
	case "$supervisor" in ""|*[!0-9]*) return 1 ;; esac
	port_hex="$(printf '%04X' "$dns_port")" || return 1
	# With procd_add_jail(), ubus reports the outer ujail PID.  Accept only an
	# AdGuardHome process whose ancestor chain reaches that exact supervisor.
	for pid in $(pidof AdGuardHome 2>/dev/null); do
		pid_is_supervised_descendant "$pid" "$supervisor" || continue
		executable="$(readlink "/proc/${pid}/exe" 2>/dev/null)" || continue
		case "$executable" in
			"$CORE_BINARY"|"$CORE_BINARY (deleted)") ;;
			*) continue ;;
		esac
		[ -d "/proc/${pid}/fd" ] || continue
		for inode in $(awk -v wanted="$port_hex" -v mode="$address_mode" \
			-v wanted_state="$expected_state" '
			NR > 1 {
				split($2,a,":")
				address=toupper(a[1])
				if (toupper(a[2]) != wanted) next
				if (toupper($4) != wanted_state) next
				if (mode == "ipv4-loopback" &&
				    address != "00000000" && address != "0100007F") next
				if (mode == "ipv4-wildcard" && address != "00000000") next
				if (mode == "ipv6-wildcard" &&
				    address != "00000000000000000000000000000000") next
				print $10
			}' "$table"); do
			for fd in "/proc/${pid}/fd/"*; do
				link="$(readlink "$fd" 2>/dev/null)" || continue
				[ "$link" = "socket:[${inode}]" ] && return 0
			done
		done
	done
	return 1
}

# AdGuard Home 0.107.76 uses Go's dual-stack wildcard listeners, so an IPv4
# unspecified bind may appear only in the IPv6 kernel table.  Accept that exact
# supervised wildcard fallback, but never an IPv6 loopback or interface-only
# address.  This is intentionally tied to the package's >=0.107.76 baseline.
official_owns_ipv4_reachable_socket() {
	local ipv4_table="$1" ipv6_table="$2" ipv4_mode="$3"
	official_owns_socket "$ipv4_table" "$ipv4_mode" && return 0
	official_owns_socket "$ipv6_table" ipv6-wildcard
}

dns_port_listening() {
	if [ "$redirect_mode" = dnsmasq-upstream ]; then
		# dnsmasq is configured with 127.0.0.1#port.  Require both UDP and
		# TCP on an IPv4-reachable loopback/wildcard listener before
		# disabling its normal resolvers; a LAN-only listener is unreachable.
		official_owns_ipv4_reachable_socket \
			/proc/net/udp /proc/net/udp6 ipv4-loopback &&
			official_owns_ipv4_reachable_socket \
			/proc/net/tcp /proc/net/tcp6 ipv4-loopback
		return
	fi
	if [ "$redirect_mode" = redirect ]; then
		# A firewall DNAT can arrive on any LAN address and captures both
		# transports.  Only IPv4-reachable wildcard UDP+TCP sockets are safe.
		official_owns_ipv4_reachable_socket \
			/proc/net/udp /proc/net/udp6 ipv4-wildcard &&
			official_owns_ipv4_reachable_socket \
			/proc/net/tcp /proc/net/tcp6 ipv4-wildcard
		return
	fi
	(official_owns_socket /proc/net/udp any ||
		official_owns_socket /proc/net/udp6 any) &&
		(official_owns_socket /proc/net/tcp any ||
		official_owns_socket /proc/net/tcp6 any)
}

dns_ipv6_listening() {
	# family=any redirects both UDP and TCP to every local IPv6 address.
	official_owns_socket /proc/net/udp6 ipv6-wildcard &&
		official_owns_socket /proc/net/tcp6 ipv6-wildcard
}

web_listening() {
	local port="$1"
	is_valid_port "$port" || return 1
	official_running || return 1
	dns_port="$port"
	if official_owns_socket /proc/net/tcp any ||
	   official_owns_socket /proc/net/tcp6 any; then
		return 0
	fi
	return 1
}

wait_for_core_ready() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3"
	local elapsed=0 stable=0
	dns_port="$expected_port"
	redirect_mode="$expected_mode"
	work_dir="$expected_work_dir"
	while [ "$elapsed" -lt "$READY_TIMEOUT" ]; do
		if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir"; then
			log_error "AdGuard Home runtime settings changed while waiting for DNS readiness"
			return 1
		fi
		dns_port="$expected_port"
		redirect_mode="$expected_mode"
		work_dir="$expected_work_dir"
		if official_running && dns_port_listening; then
			stable=$((stable + 1))
			if [ "$stable" -ge "$READY_STABLE_COUNT" ]; then
				runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir" &&
					dns_port_listening
				return
			fi
		else
			stable=0
		fi
		sleep 1
		elapsed=$((elapsed + 1))
	done
	log_error "Core did not remain ready on DNS port ${dns_port} within ${READY_TIMEOUT}s"
	return 1
}

wait_for_core_stopped() {
	local elapsed=0
	while [ "$elapsed" -lt 10 ]; do
		if ! official_running && ! adguard_uid_process_exists; then
			return 0
		fi
		sleep 1
		elapsed=$((elapsed + 1))
	done
	return 1
}

yaml_file_hash() {
	local digest
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	digest="$(sha256sum "$1" 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		????????????????????????????????????????????????????????????????)
			case "$digest" in *[!0-9a-f]*) return 1 ;; esac
			printf '%s\n' "$digest"
			;;
		*) return 1 ;;
	esac
}

validate_yaml_stage() {
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local name token fd_path config_dir
	case "$expected_hash" in
		????????????????????????????????????????????????????????????????)
			case "$expected_hash" in *[!0-9a-f]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
	case "$candidate_hash" in
		????????????????????????????????????????????????????????????????)
			case "$candidate_hash" in *[!0-9a-f]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
	config_dir="${config_file%/*}"
	[ -n "$config_dir" ] || return 1
	name="${stage##*/}"
	case "$name" in AdGuardHome.yaml.luci-*) ;; *) return 1 ;; esac
	token="${name#AdGuardHome.yaml.luci-}"
	[ "${#token}" -eq 32 ] || return 1
	case "$token" in *[!0-9a-f]*) return 1 ;; esac
	[ "$stage" = "${config_file}.luci-${token}" ] || return 1
	[ -f "$stage" ] && [ ! -L "$stage" ] || return 1
	[ -f "$config_file" ] && [ ! -L "$config_file" ] || return 1
	path_contains_symlink "$config_dir" && return 1
	case "$inherited_fd" in ""|*[!0-9]*) return 1 ;; esac
	[ "$inherited_fd" -ge 3 ] 2>/dev/null || return 1
	fd_path="/proc/self/fd/${inherited_fd}"
	[ -f "$fd_path" ] && [ "$fd_path" -ef "$stage" ]
}

active_config_hash() (
	local directory snapshot
	directory="$(mktemp -d /tmp/AdGuardHome-hash.XXXXXX)" || exit 1
	trap 'rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"
	snapshot_config_file "$config_file" "$snapshot" "" "" || exit 1
	printf '%s\n' "$SNAPSHOT_CONFIG_HASH"
)

held_config_hash() (
	local expected_hash="$1" inherited_fd="$2" allow_detached="$3"
	local directory snapshot
	directory="$(mktemp -d /tmp/AdGuardHome-held-hash.XXXXXX)" || exit 1
	trap 'rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"
	snapshot_config_file "$config_file" "$snapshot" \
		"$expected_hash" "$inherited_fd" "$allow_detached" || exit 1
	printf '%s\n' "$SNAPSHOT_CONFIG_HASH"
)

resume_yaml_runtime() {
	local was_running="$1"
	[ "$was_running" = 1 ] || return 0
	load_legacy_settings || return 1
	[ "$legacy_enabled" = 1 ] || return 0
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	if ! official_running; then
		"$OFFICIAL_SERVICE" start >/dev/null 2>&1 || return 1
	fi
	wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || return 1
	apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
}

rollback_yaml_update() {
	local backup="$1" was_running="$2"
	clear_recorded_integration_locked >/dev/null 2>&1 || true
	if official_running; then
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	[ -f "$backup" ] && [ ! -L "$backup" ] || return 1
	[ ! -L "$config_file" ] || return 1
	restore_yaml_backup "$backup" || return 1
	secure_active_config || return 1
	load_legacy_settings || return 1
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	resume_yaml_runtime "$was_running" || return 1
	remove_yaml_backup "$backup"
}

remove_yaml_backup() {
	local backup="$1" directory
	directory="${backup%/*}"
	case "$backup" in
		/tmp/AdGuardHome-yaml-backup.??????/AdGuardHome.yaml) ;;
		*) return 1 ;;
	esac
	rm -f "$backup" || return 1
	rmdir "$directory" 2>/dev/null || return 1
}

cleanup_yaml_update() {
	[ -z "$YAML_STAGE_CLEANUP" ] || rm -f "$YAML_STAGE_CLEANUP"
	[ -z "$YAML_BACKUP_CLEANUP" ] ||
		remove_yaml_backup "$YAML_BACKUP_CLEANUP" >/dev/null 2>&1 || true
}

finalize_yaml_update_process() {
	# Normal function returns do not run an EXIT trap.  Finish cleanup while the
	# integration lock is still held, then disarm transaction-local traps before
	# the current rc.common action releases its descriptor.
	cleanup_yaml_update
	trap - EXIT
	trap - HUP INT QUIT TERM
}

attempt_yaml_rollback() {
	local backup="$1" was_running="$2"
	if rollback_yaml_update "$backup" "$was_running" >/dev/null 2>&1; then
		YAML_BACKUP_CLEANUP=""
		YAML_INSTALLED=0
		YAML_RUNTIME_PAUSED=0
		return 0
	fi
	# Never let the EXIT cleanup destroy the sole known-good copy if restoring
	# it failed before the atomic move.  Its fixed prefix and 0600 mode make it
	# available for explicit administrator recovery without exposing contents.
	if [ -f "$backup" ] && [ ! -L "$backup" ]; then
		chmod 0600 "$backup" >/dev/null 2>&1 || true
		YAML_BACKUP_CLEANUP=""
		log_error "Preserved the previous YAML after rollback failure: ${backup}"
	fi
	return 1
}

abort_yaml_update() {
	# Ignore a second termination signal while restoring the sole known-good
	# runtime; interruption here could otherwise defeat the recovery trap itself.
	trap '' HUP INT QUIT TERM
	if [ "${YAML_INSTALLED:-0}" = 1 ] && [ -n "$YAML_BACKUP_CLEANUP" ]; then
		attempt_yaml_rollback "$YAML_BACKUP_CLEANUP" "$YAML_WAS_RUNNING" || true
	elif [ "${YAML_RUNTIME_PAUSED:-0}" = 1 ]; then
		resume_yaml_runtime "$YAML_WAS_RUNNING" >/dev/null 2>&1 ||
			log_error "Unable to restore the interrupted YAML runtime"
	fi
	exit 1
}

resume_paused_yaml_runtime() {
	if resume_yaml_runtime "$YAML_WAS_RUNNING"; then
		YAML_RUNTIME_PAUSED=0
		return 0
	fi
	return 1
}

# The RPC layer creates a same-directory O_EXCL staging file and invokes this
# transaction without a shell.  Revalidate everything under the integration
# lock, validate a disposable candidate, stop the sole YAML writer, then make
# the final optimistic-lock comparison before the atomic rename.
yaml_update_locked() {
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local before_hash final_hash verify_hash held_hash fd_path
	local committed_port committed_mode committed_work_dir committed_tls_mounts
	local was_running=0 backup="" backup_directory=""
	load_legacy_settings || return 1
	validate_yaml_stage "$expected_hash" "$candidate_hash" "$stage" \
		"$inherited_fd" || return 1
	YAML_STAGE_CLEANUP="$stage"
	YAML_BACKUP_CLEANUP=""
	YAML_INSTALLED=0
	YAML_WAS_RUNNING=0
	YAML_RUNTIME_PAUSED=0
	trap cleanup_yaml_update EXIT
	trap abort_yaml_update HUP INT QUIT TERM

	before_hash="$(active_config_hash)" || return 1
	[ "$before_hash" = "$expected_hash" ] || return 1
	check_core_config_file "$stage" "$candidate_hash" "$inherited_fd" || {
		log_error "AdGuard Home rejected the staged LuCI YAML"
		return 1
	}
	official_running && was_running=1
	YAML_WAS_RUNNING="$was_running"
	YAML_RUNTIME_PAUSED=1

	# Resolver takeover must be removed before the listener is stopped.  A
	# cleanup failure leaves the working core and active YAML untouched.
	if ! clear_recorded_integration_locked; then
		resume_paused_yaml_runtime >/dev/null 2>&1 ||
			log_error "Unable to restore the YAML runtime after integration cleanup failed"
		return 1
	fi
	if [ "$was_running" = 1 ]; then
		if ! "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || ! wait_for_core_stopped; then
			resume_paused_yaml_runtime >/dev/null 2>&1 ||
				log_error "Unable to restore the YAML runtime after stop failed"
			return 1
		fi
	fi
	final_hash="$(active_config_hash)" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	if [ "$final_hash" != "$expected_hash" ] ||
	   ! validate_yaml_stage "$expected_hash" "$candidate_hash" "$stage" \
		"$inherited_fd"; then
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	fi
	check_core_config_file "$stage" "$candidate_hash" "$inherited_fd" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}

	backup_directory="$(mktemp -d /tmp/AdGuardHome-yaml-backup.XXXXXX)" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	backup="${backup_directory}/AdGuardHome.yaml"
	YAML_BACKUP_CLEANUP="$backup"
	# Create the rollback image through the same bounded, lowered snapshot path
	# and recheck its optimistic hash.  Never let root cp a replaceable active
	# pathname after the core validation window.
	snapshot_config_file "$config_file" "$backup" "$expected_hash" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	YAML_INSTALLED=1
	if ! mv "$stage" "$config_file"; then
		YAML_INSTALLED=0
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	fi
	YAML_STAGE_CLEANUP=""
	fd_path="/proc/self/fd/${inherited_fd}"
	if [ ! -f "$fd_path" ] || [ ! "$fd_path" -ef "$config_file" ] ||
	   ! secure_config_inode "$fd_path"; then
		log_error "The installed LuCI YAML no longer matches its held descriptor"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi

	if ! secure_active_paths ||
	   ! check_core_config_file "$config_file" "$candidate_hash" "$inherited_fd" 1 ||
	   ! load_runtime_dns_port ||
	   ! sync_official_uci; then
		log_error "Unable to activate the LuCI YAML; restoring the previous file"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi
	committed_port="$dns_port"
	committed_mode="$redirect_mode"
	committed_work_dir="$work_dir"
	committed_tls_mounts="$TLS_DESIRED_MOUNTS"
	if [ "$legacy_enabled" = 1 ]; then
		if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1 ||
		   ! wait_for_core_ready "$committed_port" "$committed_mode" "$committed_work_dir" ||
		   ! apply_integration_locked "$committed_port" "$committed_mode" "$committed_work_dir"; then
			log_error "The edited YAML failed at runtime; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
	fi
	YAML_RUNTIME_PAUSED=0

	held_hash="$(held_config_hash "$candidate_hash" "$inherited_fd" 1)" || {
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	}
	if [ "$held_hash" != "$candidate_hash" ]; then
		log_error "The submitted YAML changed while its transaction was running"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi
	final_hash="$(active_config_hash)" || {
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	}
	if [ "$legacy_enabled" = 1 ]; then
		# The official core owns the work directory as uid 853 and serializes a
		# canonical YAML through an atomic rename when it starts.  That legitimate
		# rewrite can change comments, formatting, the inode, and therefore the
		# byte hash.  Accept only a bounded, policy-checked, stable snapshot while
		# its external TLS mount requirements and the expected supervised listener
		# and resolver integration remain unchanged and live.
		if ! secure_active_paths ||
		   ! check_core_config_file "$config_file" "$final_hash" "" 1 ||
		   [ "$TLS_DESIRED_MOUNTS" != "$committed_tls_mounts" ] ||
		   ! runtime_settings_match "$committed_port" "$committed_mode" \
			"$committed_work_dir" ||
		   ! official_running || ! dns_port_listening; then
			log_error "The running core produced an unsafe YAML result; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
		verify_hash="$(active_config_hash)" || {
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		}
		if [ "$verify_hash" != "$final_hash" ] ||
		   ! runtime_settings_match "$committed_port" "$committed_mode" \
			"$committed_work_dir" ||
		   ! official_running || ! dns_port_listening; then
			log_error "The running core YAML did not reach a stable valid state; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
	elif [ "$final_hash" != "$candidate_hash" ] ||
	     [ ! "$fd_path" -ef "$config_file" ]; then
		log_error "The stopped-service YAML changed after installation; restoring the previous file"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	else
		secure_config_inode "$fd_path" || {
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		}
	fi
	if remove_yaml_backup "$backup"; then
		YAML_BACKUP_CLEANUP=""
	else
		log_error "Unable to remove the completed LuCI YAML backup"
	fi
	YAML_INSTALLED=0
	trap - HUP INT QUIT TERM
	return 0
}

yaml_update() {
	run_yaml_locked yaml_update_locked "$1" "$2" "$3" "$4"
}

yaml_job_token_valid() {
	[ "${#1}" = 32 ] || return 1
	case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

yaml_job_hash_valid() {
	[ "${#1}" = 64 ] || return 1
	case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

yaml_job_runtime_is_private() {
	local metadata mode links owner group remainder
	[ -d "$YAML_JOB_RUNTIME_DIR" ] && [ ! -L "$YAML_JOB_RUNTIME_DIR" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$YAML_JOB_RUNTIME_DIR" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ]
}

yaml_job_file_is_private() {
	local target="$1" metadata mode links owner group remainder size
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || return 1
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le 256 ]
}

yaml_job_lock_file_is_private() {
	local target="${YAML_JOB_RUNTIME_DIR}/update.lock"
	local metadata mode links owner group remainder size
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$target" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || return 1
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	[ "$size" = 0 ]
}

yaml_maintenance_marker_is_private() {
	local metadata mode links owner group remainder size
	[ -f "$YAML_MAINTENANCE_MARKER" ] &&
		[ ! -L "$YAML_MAINTENANCE_MARKER" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$YAML_MAINTENANCE_MARKER" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || return 1
	size="$(wc -c <"$YAML_MAINTENANCE_MARKER" 2>/dev/null)" || return 1
	[ "$size" = 0 ]
}

prepare_yaml_job_runtime() {
	local lock_path="${YAML_JOB_RUNTIME_DIR}/update.lock"
	if [ -e "$YAML_JOB_RUNTIME_DIR" ] || [ -L "$YAML_JOB_RUNTIME_DIR" ]; then
		yaml_job_runtime_is_private || return 1
	else
		if (umask 077; mkdir "$YAML_JOB_RUNTIME_DIR"); then
			chown 0:0 "$YAML_JOB_RUNTIME_DIR" &&
				chmod 0700 "$YAML_JOB_RUNTIME_DIR" || return 1
		fi
		yaml_job_runtime_is_private || return 1
	fi

	if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
		yaml_job_lock_file_is_private || return 1
	else
		if (umask 077; set -C; : >"$lock_path") 2>/dev/null; then
			chown 0:0 "$lock_path" && chmod 0600 "$lock_path" || return 1
		fi
		yaml_job_lock_file_is_private || return 1
	fi
}

yaml_job_lock_fd_valid() {
	local stage_fd="$1" lock_fd="$2" lock_path fd_path
	case "$lock_fd" in ""|*[!0-9]*) return 1 ;; esac
	[ "$lock_fd" -ge 3 ] 2>/dev/null || return 1
	[ "$lock_fd" != 1000 ] && [ "$lock_fd" != "$stage_fd" ] || return 1
	lock_path="${YAML_JOB_RUNTIME_DIR}/update.lock"
	fd_path="/proc/self/fd/${lock_fd}"
	yaml_job_lock_file_is_private || return 1
	[ -f "$fd_path" ] && [ "$fd_path" -ef "$lock_path" ]
}

write_yaml_job_state() {
	local token="$1" state="$2" target temporary
	yaml_job_token_valid "$token" || return 1
	yaml_job_runtime_is_private || return 1
	target="${YAML_JOB_RUNTIME_DIR}/${token}"
	[ -f "$target" ] && [ ! -L "$target" ] || return 1
	temporary="$(mktemp "${YAML_JOB_RUNTIME_DIR}/.${token}.XXXXXX")" || return 1
	if ! printf '%s\n' "$state" >"$temporary" ||
	   ! chown 0:0 "$temporary" || ! chmod 0600 "$temporary" ||
	   ! yaml_job_file_is_private "$temporary" ||
	   ! mv -f "$temporary" "$target" ||
	   ! yaml_job_file_is_private "$target"; then
		rm -f "$temporary"
		return 1
	fi
}

yaml_job_pending_matches() {
	local token="$1" expected_hash="$2" candidate_hash="$3"
	local target="${YAML_JOB_RUNTIME_DIR}/${token}"
	yaml_job_file_is_private "$target" || return 1
	grep -Fqx "pending:${expected_hash}:${candidate_hash}" "$target"
}

close_yaml_job_inherited_fds() {
	local inherited_fd="$1" job_lock_fd="$2" fd_path fd
	case "$inherited_fd:$job_lock_fd" in *[!0-9:]*) return 1 ;; esac
	[ "$inherited_fd" -ge 3 ] 2>/dev/null || return 1
	[ "$job_lock_fd" -ge 3 ] 2>/dev/null || return 1
	[ "$inherited_fd" != "$job_lock_fd" ] || return 1
	for fd_path in /proc/self/fd/[0-9]*; do
		[ -e "$fd_path" ] || continue
		fd="${fd_path##*/}"
		case "$fd" in
			0|1|2|1000|"$inherited_fd"|"$job_lock_fd") continue ;;
			*[!0-9]*) return 1 ;;
		esac
		# fd is numeric and came from procfs; eval is needed because BusyBox ash
		# does not support a variable file-descriptor operand for exec.
		eval "exec ${fd}>&-" || return 1
	done
}

cleanup_yaml_job_stage() {
	local stage="$1" inherited_fd="$2" fd_path="/proc/self/fd/${inherited_fd}"
	[ -f "$fd_path" ] || return 0
	if [ -f "$stage" ] && [ ! -L "$stage" ] && [ "$fd_path" -ef "$stage" ]; then
		rm -f "$stage"
	fi
}

yaml_update_job_locked() {
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local token="$5" final_hash restarted=0
	yaml_job_pending_matches "$token" "$expected_hash" "$candidate_hash" || return 1
	write_yaml_job_state "$token" \
		"running:$$:${expected_hash}:${candidate_hash}" || return 1

	if ! yaml_update_locked "$expected_hash" "$candidate_hash" \
		"$stage" "$inherited_fd"; then
		cleanup_yaml_job_stage "$stage" "$inherited_fd"
		# yaml_update_locked() can fail after an attempted rollback.  Its single
		# return code cannot prove that the old runtime was restored completely,
		# so never publish a definitive rejection that might invite an unsafe retry.
		write_yaml_job_state "$token" \
			"indeterminate:${expected_hash}:${candidate_hash}" >/dev/null 2>&1 || true
		return 1
	fi

	cleanup_yaml_job_stage "$stage" "$inherited_fd"
	if load_legacy_settings && final_hash="$(active_config_hash)" &&
	   yaml_job_hash_valid "$final_hash"; then
		official_running && restarted=1
		if write_yaml_job_state "$token" \
			"success:${final_hash}:${restarted}:${expected_hash}:${candidate_hash}"; then
			return 0
		fi
	fi

	# The transaction may already be committed.  Never turn a reporting failure
	# into a false rejection that could encourage an unsafe automatic retry.
	write_yaml_job_state "$token" \
		"indeterminate:${expected_hash}:${candidate_hash}" >/dev/null 2>&1 || true
	return 1
}

yaml_update_job() {
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local job_lock_fd="$5" token="$6"
	yaml_job_hash_valid "$expected_hash" || exit 1
	yaml_job_hash_valid "$candidate_hash" || exit 1
	yaml_job_token_valid "$token" || exit 1
	case "$stage" in
		*/AdGuardHome.yaml.luci-"$token") ;;
		*) exit 1 ;;
	esac
	yaml_job_runtime_is_private || exit 1
	yaml_job_pending_matches "$token" "$expected_hash" "$candidate_hash" || exit 1
	yaml_job_lock_fd_valid "$inherited_fd" "$job_lock_fd" || exit 1
	/usr/bin/flock -n -x "$job_lock_fd" || exit 1
	close_yaml_job_inherited_fds "$inherited_fd" "$job_lock_fd" || exit 1
	yaml_job_lock_fd_valid "$inherited_fd" "$job_lock_fd" || exit 1
	/usr/bin/flock -n -x "$job_lock_fd" || exit 1

	if run_yaml_locked yaml_update_job_locked "$expected_hash" "$candidate_hash" \
		"$stage" "$inherited_fd" "$token"; then
		exit 0
	fi
	exit 1
}

restore_tls_fingerprint() {
	local value="$1" option="${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}"
	if [ -n "$value" ]; then
		uci -q set "${option}=${value}" || return 1
	else
		uci -q delete "$option" 2>/dev/null || true
	fi
	uci -q commit "$LEGACY_CONFIG"
}

tls_refresh_locked() {
	local old_fingerprint was_running=0
	load_legacy_settings || return 1
	[ -f "$config_file" ] && [ ! -L "$config_file" ] || return 0
	old_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}")"
	load_active_tls_access || return 1
	# A system-wide ACME event must have no effect on installations whose YAML
	# does not consume file-by-file /etc/ssl/acme material.
	[ "$TLS_USES_ACME" = 1 ] || return 0
	check_core_config || return 1
	sync_tls_access || return 1
	[ "$old_fingerprint" != "$TLS_FINGERPRINT" ] || return 0
	[ "$legacy_enabled" = 1 ] || return 0
	official_running && was_running=1

	if ! clear_recorded_integration_locked; then
		restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 || true
		resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
		return 1
	fi
	if official_running; then
		if ! "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || ! wait_for_core_stopped; then
			restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 || true
			resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
			return 1
		fi
	fi
	if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1 ||
	   ! load_runtime_dns_port ||
	   ! wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" ||
	   ! apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 ||
			log_error "Unable to restore the previous ACME retry fingerprint"
		resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
		log_error "Unable to restart AdGuard Home after ACME renewal"
		return 1
	fi
}

tls_refresh() {
	case "${ACTION:-renewed}" in issued|renewed) ;; *) return 0 ;; esac
	run_locked tls_refresh_locked
}

tls_prepare_locked() {
	official_running && return 1
	load_legacy_settings || return 1
	sync_official_uci
}

tls_prepare() {
	run_locked tls_prepare_locked
}

fail_safe_locked() {
	local rc=0
	clear_recorded_integration_locked || rc=1
	if [ -x "$OFFICIAL_SERVICE" ]; then
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || rc=1
		wait_for_core_stopped >/dev/null 2>&1 || rc=1
	fi
	disable_official_autostart || rc=1
	return "$rc"
}

memory_deactivate_locked() {
	local checkpoint="${1:-1}" old_backing
	[ "$MEMORY_ACTIVE" = 1 ] || return 0
	official_running && {
		log_error "Refusing to remove a live AdGuard Home memory workdir"
		return 1
	}
	old_backing="$MEMORY_BACKING_WORK_DIR"
	if [ "$checkpoint" = 1 ]; then
		memory_checkpoint_full_locked || return 1
	else
		memory_recover_journal_locked || return 1
	fi
	memory_restore_official_persistent_paths || return 1
	# The persistent YAML may contain a safe_fs_patterns item rewritten for the
	# RAM workdir.  Restore that managed item before removing the RAM generation.
	previous_work_dir="$MEMORY_WORK_DIR"
	work_dir="$old_backing"
	config_file="${old_backing}/AdGuardHome.yaml"
	sync_yaml_managed_fields_checked || return 1
	memory_remove_active_tree || return 1
	memory_private_state_file "$MEMORY_STATE_FILE" || return 1
	rm -f "$MEMORY_STATE_FILE" || return 1
	memory_runtime_dir_valid || return 1
	rmdir "$MEMORY_RUNTIME_DIR" || return 1
	MEMORY_ACTIVE=0
	MEMORY_BACKING_WORK_DIR=""
	previous_work_dir="$old_backing"
	work_dir="$persistent_work_dir"
	config_file="$persistent_config_file"
	if [ "$checkpoint" = 1 ]; then
		log_error "Removed the AdGuard Home memory workdir after a successful checkpoint"
	else
		log_error "Removed an unused AdGuard Home memory workdir"
	fi
}

# Reconcile an already-active RAM generation with the newly requested backing
# path or checkbox value.  Changing either is a stop/checkpoint boundary; a
# failed checkpoint leaves the RAM tree intact and never starts stale disk data.
memory_reconcile_requested_storage_locked() {
	if [ "$MEMORY_ACTIVE" = 1 ] &&
	   { [ "$memory_requested" != 1 ] ||
	     [ "$MEMORY_BACKING_WORK_DIR" != "$persistent_work_dir" ]; }; then
		clear_recorded_integration_locked || return 1
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
			wait_for_core_stopped || return 1
		fi
		memory_deactivate_locked 1 || return 1
	fi
	memory_recover_journal_locked
}

memory_prepare_or_fallback_locked() {
	local prepare_rc=0
	[ "$legacy_enabled" = 1 ] || return 0
	[ "$memory_requested" = 1 ] || return 0
	[ "$MEMORY_ACTIVE" != 1 ] || return 0
	memory_prepare_runtime_locked || prepare_rc=$?
	case "$prepare_rc" in
		0) return 0 ;;
		2)
			# The RAM generation is already committed and bound to the backing
			# inode.  Keep it for a safe retry rather than pretending disk fallback.
			return 1
			;;
	esac
	# Preparation has not changed lower UCI and has cleaned only objects created
	# by this attempt.  Preserve availability by using the validated persistent
	# tree for this start, while leaving the requested checkbox set for retry.
	MEMORY_ACTIVE=0
	MEMORY_BACKING_WORK_DIR=""
	work_dir="$persistent_work_dir"
	config_file="$persistent_config_file"
	log_error "Memory mode was requested but could not be prepared; using the persistent workdir"
	return 0
}

memory_checkpoint_locked_command() {
	load_legacy_settings || return 1
	[ "$MEMORY_ACTIVE" = 1 ] || return 0
	official_running && return 1
	memory_checkpoint_full_locked
}

memory_cleanup_locked_command() {
	load_legacy_settings || return 1
	[ "$MEMORY_ACTIVE" = 1 ] || {
		memory_recover_journal_locked || return 1
		memory_clear_official_path_delta
		return
	}
	official_running && return 1
	memory_deactivate_locked 1
}

memory_prepare_locked_command() {
	load_legacy_settings || return 1
	[ "$memory_requested" = 1 ] || return 1
	official_running && return 1
	memory_reconcile_requested_storage_locked || return 1
	[ "$MEMORY_ACTIVE" = 1 ] || {
		work_dir="$persistent_work_dir"
		config_file="$persistent_config_file"
		secure_active_config || return 1
		memory_prepare_runtime_locked || return 1
	}
	sync_official_uci
}

# Complete an interrupted live write-back before normal reconciliation.  A
# valid marker remains published until the desired service/DNS state is fully
# restored, so SIGKILL at any point is retried by the respawned monitor.
# Return 2 when there is no pending operation.
memory_restore_live_checkpoint_locked() {
	local marker_rc=0 expected_port expected_mode expected_work_dir
	memory_live_marker_load || marker_rc=$?
	case "$marker_rc" in
		0) ;;
		1) return 2 ;;
		*)
			log_error "Unsafe AdGuard Home memory write-back marker"
			return 1
			;;
	esac
	if ! load_legacy_settings; then
		log_error "Unable to recover settings for an interrupted memory write-back"
		return 1
	fi
	# Reloading settings recovers any durable checkpoint WAL.  Revalidate the
	# volatile marker afterwards so its persistent inode binding cannot change.
	memory_live_marker_load || {
		log_error "Memory write-back marker changed during recovery"
		return 1
	}
	if [ "$MEMORY_ACTIVE" = 1 ] &&
	   [ "$MEMORY_LIVE_BACKING" != "$MEMORY_BACKING_WORK_DIR" ]; then
		log_error "Memory write-back marker does not bind the active RAM generation"
		return 1
	fi

	if [ "$MEMORY_ACTIVE" = 1 ] && [ "$legacy_enabled" = 1 ] &&
	   [ "$memory_requested" = 1 ] &&
	   [ "$MEMORY_BACKING_WORK_DIR" = "$persistent_work_dir" ]; then
		clear_recorded_integration_locked || return 1
		sync_official_uci || return 1
		load_runtime_dns_port || return 1
		expected_port="$dns_port"
		expected_mode="$redirect_mode"
		expected_work_dir="$work_dir"
		if ! official_running; then
			[ -x "$OFFICIAL_SERVICE" ] || return 1
			"$OFFICIAL_SERVICE" start >/dev/null 2>&1 || return 1
		fi
		wait_for_core_ready "$expected_port" "$expected_mode" \
			"$expected_work_dir" || return 1
		apply_integration_locked "$expected_port" "$expected_mode" \
			"$expected_work_dir" || return 1
	else
		# The user may have changed the enabled flag, backing path or RAM toggle
		# after a killed writer released the lock.  Converge that new request in
		# one transaction before declaring the interrupted operation recovered.
		orchestrate_core_locked || return 1
	fi
	memory_clear_live_checkpoint || return 1
	log_error "Recovered the AdGuard Home service after an interrupted memory write-back"
}

memory_writeback_locked_command() {
	load_legacy_settings || return 1
	[ "$legacy_enabled" = 1 ] && [ "$memory_requested" = 1 ] &&
		[ "$MEMORY_ACTIVE" = 1 ] &&
		[ "$MEMORY_BACKING_WORK_DIR" = "$persistent_work_dir" ] || return 2
	official_running || return 2
	memory_copy_live_data_locked || return $?
	log_error "Completed the live AdGuard Home memory write-back without restarting the core"
}

memory_checkpoint() {
	run_locked memory_checkpoint_locked_command
}

memory_writeback() {
	run_locked memory_writeback_locked_command
}

memory_cleanup() {
	run_locked memory_cleanup_locked_command
}

memory_prepare() {
	run_locked memory_prepare_locked_command
}

memory_status() {
	local load_rc=0
	load_legacy_settings || load_rc=$?
	if [ "$load_rc" != 0 ]; then
		printf 'requested=unknown\nactive=invalid\n'
		return 1
	fi
	printf 'requested=%s\nactive=%s\npersistent_work_dir=%s\n' \
		"$memory_requested" "$MEMORY_ACTIVE" "$persistent_work_dir"
	if [ "$MEMORY_ACTIVE" = 1 ]; then
		printf 'active_work_dir=%s\nactive_config_file=%s\nbacking_work_dir=%s\n' \
			"$MEMORY_WORK_DIR" "$config_file" "$MEMORY_BACKING_WORK_DIR"
	else
		printf 'active_work_dir=%s\nactive_config_file=%s\n' \
			"$persistent_work_dir" "$persistent_config_file"
	fi
}

prepare_wrapper_locked() {
	local live_restore_rc=0
	[ "${WRAPPER_BOOT:-0}" = 1 ] && RELOAD_SERVICES=0
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	memory_restore_live_checkpoint_locked || live_restore_rc=$?
	case "$live_restore_rc" in
		0) load_legacy_settings || return 1 ;;
		2) ;;
		*) return 1 ;;
	esac
	if [ "$legacy_enabled" != 1 ]; then
		clear_recorded_integration_locked || return 1
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
			wait_for_core_stopped || return 1
		fi
		if [ "$MEMORY_ACTIVE" = 1 ]; then
			memory_deactivate_locked 1 || return 1
		else
			memory_recover_journal_locked || return 1
		fi
		work_dir="$persistent_work_dir"
		config_file="$persistent_config_file"
		ensure_config_file || return 1
		sync_yaml_managed_fields_checked || return 1
		sync_official_uci || return 1
		# A distinct success status tells start_service not to create a polling
		# monitor for a deliberately disabled installation.
		return 2
	fi
	memory_reconcile_requested_storage_locked || return 1
	if [ "$MEMORY_ACTIVE" = 1 ]; then
		# A coordinator restart in the same boot adopts its validated RAM
		# generation.  Recopying the persistent backing here would discard
		# changes made by the official Web UI since the last checkpoint.
		if official_running; then
			check_core_config || return 1
		else
			sync_yaml_managed_fields_checked || return 1
		fi
		load_runtime_dns_port || return 1
		[ "${WRAPPER_BOOT:-0}" != 1 ] || clear_recorded_integration_locked || return 1
		sync_official_uci
		return
	fi
	work_dir="$persistent_work_dir"
	config_file="$persistent_config_file"
	# A work-directory change selects an independent YAML/data tree.  Stop the
	# old writer before switching the official lower service paths, but never
	# copy files from the previous directory into the new one.
	if { [ ! -f "$config_file" ] || [ "${previous_work_dir%/}" != "$work_dir" ]; } &&
	   official_running; then
		clear_recorded_integration_locked || return 1
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	ensure_config_file || {
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	}
	# Preserve the existing no-live-writer boundary in persistent mode.  Boot,
	# fresh workdir initialization, and the later orchestrator reach this block
	# with the core stopped.  An already-running disk core is validated here and
	# transitioned by service_started(), which first stops it under the same lock.
	if ! official_running; then
		sync_yaml_managed_fields_checked || return 1
		memory_prepare_or_fallback_locked || return 1
	fi
	load_runtime_dns_port || {
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	}

	# At boot restore the pre-integration resolver state first.  The monitor will
	# apply takeover only after the official delayed start has become stable.
	if [ "${WRAPPER_BOOT:-0}" = 1 ]; then
		clear_recorded_integration_locked || return 1
	fi

	# Any fresh workdir initialization and RAM copy-in completed while the core was
	# stopped.  A pre-existing disk core reaches only this non-writing check.
	check_core_config || return 1
	sync_official_uci || return 1
}

orchestrate_core_locked() {
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi

	# Clean up before stopping the listener.  If cleanup fails, leave the working
	# core alone rather than creating a DNS black hole.
	clear_recorded_integration_locked || return 1
	if official_running; then
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	# rc.common maps this wrapper's reload/restart path to start_service() and
	# service_started(), so an unchanged active RAM generation reaches this
	# orchestrator.  Treat that stopped-core boundary as a full durable
	# checkpoint while retaining the same RAM generation for the restart.
	if [ "$MEMORY_ACTIVE" = 1 ] && [ "$legacy_enabled" = 1 ] &&
	   [ "$memory_requested" = 1 ] &&
	   [ "$MEMORY_BACKING_WORK_DIR" = "$persistent_work_dir" ]; then
		memory_checkpoint_full_locked || return 1
	fi
	if [ "$legacy_enabled" != 1 ] && [ "$MEMORY_ACTIVE" = 1 ]; then
		memory_deactivate_locked 1 || return 1
	else
		memory_reconcile_requested_storage_locked || return 1
	fi
	if [ "$MEMORY_ACTIVE" != 1 ]; then
		work_dir="$persistent_work_dir"
		config_file="$persistent_config_file"
		ensure_config_file || {
			fail_safe_locked >/dev/null 2>&1 || true
			return 1
		}
	fi

	# The core is stopped here, so the managed workdir rewrite cannot race its
	# own configuration writer.  DNS and Web endpoints remain YAML-owned.
	sync_yaml_managed_fields_checked || return 1
	memory_prepare_or_fallback_locked || return 1
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	[ "$legacy_enabled" = 1 ] || return 0
	[ -x "$OFFICIAL_SERVICE" ] || return 1
	if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
}

reconcile_core_locked() {
	local live_restore_rc=0
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	memory_restore_live_checkpoint_locked || live_restore_rc=$?
	case "$live_restore_rc" in
		0) return 0 ;;
		2) ;;
		*) return 1 ;;
	esac
	if [ "$MEMORY_ACTIVE" = 1 ] &&
	   { [ "$memory_requested" != 1 ] ||
	     [ "$MEMORY_BACKING_WORK_DIR" != "$persistent_work_dir" ]; }; then
		# A UCI apply normally restarts the wrapper.  Also converge here so an
		# out-of-band commit cannot leave a live RAM generation attached to an
		# obsolete backing directory indefinitely.
		orchestrate_core_locked
		return
	fi
	if [ "$legacy_enabled" != 1 ]; then
		clear_recorded_integration_locked || return 1
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
			wait_for_core_stopped || return 1
		fi
		if [ "$MEMORY_ACTIVE" = 1 ]; then
			memory_deactivate_locked 1 || return 1
		fi
		return 0
	fi
	if ! load_runtime_dns_port; then
		clear_recorded_integration_locked || return 1
		return 0
	fi
	if ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked || return 1
		return 0
	fi
	if integration_matches_desired; then
		# The active YAML is always the persistent file, including RAM-data mode.
		return 0
	fi
	wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || {
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	}
	apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
}

do_redirect_locked() {
	case "$1" in
		0) clear_recorded_integration_locked ;;
		1)
			load_legacy_settings || return 1
			load_runtime_dns_port || return 1
			wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || {
				clear_recorded_integration_locked >/dev/null 2>&1 || true
				return 1
			}
			apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
			;;
		*) return 1 ;;
	esac
}

do_redirect() {
	run_locked do_redirect_locked "$1"
}

reconcile() {
	run_locked reconcile_core_locked
}

# This is the only process supervised by the compatibility wrapper.  It never
# launches or adopts the core; it merely reconciles DNS takeover with the state
# reported by the official lowercase procd service.
monitor() {
	local configured_interval interval last_interval="" interval_seconds=0
	local now=0 next_writeback=0 writeback_rc=0
	# rc.common serializes init commands with fd 1000.  This long-running
	# procd command enters through rc.common as well, so release the inherited
	# control lock before looping; otherwise every later start/stop/reload waits
	# forever behind the monitor instance.
	exec 1000>&-
	trap 'exit 0' TERM INT
	while :; do
		# Package postinst may need to replace a v2.2 monitor while preserving
		# the running official core.  A freshly registered v2.3 monitor stays
		# completely passive until the authenticated maintenance bundle is
		# removed.  If postinst fails and leaves an unsafe partial bundle, exit
		# for procd retry instead of reconciling or writing back with partial UCI.
		if [ -e "$MAINTENANCE_UPGRADE_MARKER" ] ||
		   [ -L "$MAINTENANCE_UPGRADE_MARKER" ]; then
			if ! maintenance_upgrade_marker_is_valid ||
			   { [ ! -e "$YAML_MAINTENANCE_MARKER" ] &&
			     [ ! -L "$YAML_MAINTENANCE_MARKER" ]; } ||
			   ! yaml_maintenance_marker_is_private; then
				log_error "Unsafe maintenance-upgrade state; monitor remains passive"
				return 1
			fi
			sleep "$MONITOR_INTERVAL" &
			wait $!
			continue
		fi
		run_locked reconcile_core_locked >/dev/null 2>&1 || true
		configured_interval="$(uci -q get \
			"${LEGACY_CONFIG}.${LEGACY_SECTION}.memory_writeback_interval")"
		interval="$(normalize_memory_writeback_interval \
			"$configured_interval")" || interval=0
		now="$(monotonic_seconds)" || now=0
		if [ "$interval" != "$last_interval" ] ||
		   { [ "$interval" -ne 0 ] 2>/dev/null &&
		     [ "$now" -ne 0 ] 2>/dev/null &&
		     [ "$next_writeback" -eq 0 ] 2>/dev/null; }; then
			last_interval="$interval"
			if [ "$interval" -eq 0 ] 2>/dev/null || [ "$now" -eq 0 ] 2>/dev/null; then
				next_writeback=0
			else
				interval_seconds=$((interval * 60))
				next_writeback=$((now + interval_seconds))
			fi
		fi
		if [ "$interval" -ne 0 ] 2>/dev/null && [ "$now" -ne 0 ] 2>/dev/null &&
		   [ "$next_writeback" -ne 0 ] 2>/dev/null &&
		   [ "$now" -ge "$next_writeback" ] 2>/dev/null; then
			writeback_rc=0
			run_locked memory_writeback_locked_command >/dev/null 2>&1 || writeback_rc=$?
			now="$(monotonic_seconds)" || now=0
			if [ "$now" -ne 0 ] 2>/dev/null; then
				case "$writeback_rc" in
					0|2) next_writeback=$((now + interval_seconds)) ;;
					*)
						next_writeback=$((now + 60))
						log_error "Scheduled AdGuard Home memory write-back failed; retrying in 60 seconds"
						;;
				esac
			else
				next_writeback=0
			fi
		fi
		sleep "$MONITOR_INTERVAL" &
		wait $!
	done
}

isrunning() {
	if official_running; then echo "running"; return 0; fi
	if [ ! -x /usr/bin/AdGuardHome ]; then echo "no bin"; return 2; fi
	echo "not run"
	return 1
}

start_service() {
	local prepare_rc=0 marker_rc=1
	if [ -e /etc/uci-defaults/40_luci-AdGuardHome ] ||
	   [ -L /etc/uci-defaults/40_luci-AdGuardHome ]; then
		log_error "Configuration migration is incomplete; refusing to start the coordinator"
		return 1
	fi
	if ! prepare_yaml_job_runtime; then
		log_error "Unsafe YAML job runtime; refusing to start the coordinator"
		return 1
	fi
	START_PREPARED=0
	START_DISABLED=0
	START_MAINTENANCE_UPGRADE=0
	if [ -e "$MAINTENANCE_UPGRADE_MARKER" ] ||
	   [ -L "$MAINTENANCE_UPGRADE_MARKER" ]; then
		if [ "${PKG_UPGRADE:-0}" != 1 ] ||
		   ! maintenance_upgrade_marker_is_valid; then
			log_error "Unsafe maintenance-upgrade marker; refusing to start the coordinator"
			return 1
		fi
		[ -e "$YAML_MAINTENANCE_MARKER" ] ||
			[ -L "$YAML_MAINTENANCE_MARKER" ] || {
			log_error "Missing YAML maintenance marker; refusing to start the coordinator"
			return 1
		}
		yaml_maintenance_marker_is_private || {
			log_error "Unsafe YAML maintenance marker; refusing to start the coordinator"
			return 1
		}
		log_error "Preserving the maintenance bundle for package post-install verification"
		START_PREPARED=1
		START_MAINTENANCE_UPGRADE=1
		case "$MAINTENANCE_WRAPPER_RUNNING" in
			0)
				START_DISABLED=1
				log_error "Preserved the stopped AdGuard Home state across the maintenance upgrade"
				return 0
				;;
			1) ;;
			*)
				log_error "Invalid maintenance-upgrade service state"
				return 1
				;;
		esac
	elif [ -e "$UPGRADE_STOPPED_MARKER" ] || [ -L "$UPGRADE_STOPPED_MARKER" ]; then
		marker_rc=0
		consume_upgrade_stopped_marker || marker_rc=$?
		case "$marker_rc" in
			0)
				if [ "${PKG_UPGRADE:-0}" = 1 ]; then
					START_PREPARED=1
					START_DISABLED=1
					log_error "Preserved the stopped AdGuard Home state across the package upgrade"
					return 0
				fi
				log_error "Discarded a stale stopped-upgrade marker before a normal start"
				;;
			*)
				log_error "Unsafe stopped-upgrade marker; refusing to start the coordinator"
				return 1
				;;
		esac
	else
		run_locked prepare_wrapper_locked || prepare_rc=$?
		case "$prepare_rc" in
			0) START_PREPARED=1 ;;
			2)
				START_PREPARED=1
				START_DISABLED=1
				return 0
				;;
		esac
	fi
	[ "$START_PREPARED" = 1 ] || return 0
	procd_open_instance monitor
	procd_set_param command "$initscript" monitor
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 5
	procd_close_instance
	return 0
}

service_started() {
	if [ "$START_PREPARED" != 1 ]; then
		run_locked fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	[ "$START_DISABLED" != 1 ] || return 0
	[ "$START_MAINTENANCE_UPGRADE" != 1 ] || return 0
	if [ "${WRAPPER_BOOT:-0}" = 1 ]; then
		RELOAD_SERVICES=0 run_locked reconcile_core_locked
	else
		run_locked orchestrate_core_locked
	fi
}

stop_wrapper_locked() {
	local shutdown_mode="$1" settings_rc=0 live_marker_rc=1
	[ "$shutdown_mode" = 1 ] && RELOAD_SERVICES=0
	load_legacy_settings || settings_rc=$?
	if [ "$settings_rc" = 0 ]; then
		memory_live_marker_load || live_marker_rc=$?
		case "$live_marker_rc" in
			0|1) ;;
			*) log_error "Unsafe memory write-back marker remains while stopping" ;;
		esac
	fi
	clear_recorded_integration_locked || return 1
	if [ "$settings_rc" != 0 ]; then
		[ ! -x "$OFFICIAL_SERVICE" ] || "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || true
		return 1
	fi
	if [ "$MEMORY_ACTIVE" = 1 ]; then
		# K89 stops the official service before this K90 shutdown hook.  A
		# manual stop reaches the same checkpoint boundary explicitly.
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		fi
		wait_for_core_stopped || return 1
		memory_deactivate_locked 1 || return 1
	fi
	if [ "$shutdown_mode" != 1 ]; then
		disable_official_autostart || return 1
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
			wait_for_core_stopped || return 1
		fi
	fi
	if [ "$live_marker_rc" = 0 ]; then
		memory_clear_live_checkpoint || return 1
		log_error "Cleared an interrupted memory write-back after reaching the stopped state"
	fi
}

stop_service() {
	run_locked stop_wrapper_locked "${WRAPPER_SHUTDOWN:-0}"
}

service_triggers() {
	procd_add_reload_trigger "$LEGACY_CONFIG"
}

restart() {
	reload
}

boot() {
	WRAPPER_BOOT=1
	start
}

shutdown() {
	WRAPPER_SHUTDOWN=1
	stop
}
