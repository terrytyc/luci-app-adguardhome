EXTRA_COMMANDS="do_redirect isrunning monitor reconcile web_listening check_config normalize_config yaml_update yaml_update_job tls_prepare tls_refresh memory_checkpoint memory_writeback memory_cleanup memory_prepare memory_status"
EXTRA_HELP="\tdo_redirect [0|1]\tApply or remove DNS integration
\tisrunning\t\tReport the official service status
\treconcile\t\tReconcile DNS integration with the core state
\tweb_listening <port>\tVerify an official-core TCP listener
\tcheck_config <yaml> <workdir>\tValidate one YAML as uid 853
\tnormalize_config <yaml> <workdir>\tValidate and normalize one installer YAML
\tyaml_update <old-hash> <new-hash> <stage> <fd>\tCommit a validated LuCI YAML edit
\tyaml_update_job <old-hash> <new-hash> <stage> <stage-fd> <lock-fd> <token>\tRun an asynchronous LuCI YAML edit
\ttls_prepare\t\tPrepare current YAML TLS access before core start
\ttls_refresh\t\tRecheck ACME material after renewal
\tmemory_checkpoint\tPersist a stopped RAM workdir without removing it
\tmemory_writeback\tCopy live RAM data directly to persistent storage
