#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

# Compatibility and DNS-integration coordinator for the historical mixed-case
# UCI name.  The packaged lowercase service remains the only process supervisor.

USE_PROCD=1
START=18
STOP=90

LEGACY_CONFIG="AdGuardHome"
LEGACY_SECTION="AdGuardHome"
OFFICIAL_CONFIG="adguardhome"
OFFICIAL_SECTION="config"
OFFICIAL_SERVICE="/etc/init.d/adguardhome"
DEFAULT_WORK_DIR="/etc/AdGuardHome"
DEFAULT_CONFIG_FILE="${DEFAULT_WORK_DIR}/AdGuardHome.yaml"
CORE_BINARY="/usr/bin/AdGuardHome"
ADGUARD_UID=853
ADGUARD_GID=853
ADGUARD_USER="adguardhome"
ADGUARD_GROUP="adguardhome"
NORMALIZER_GROUP="root"
MAX_YAML_SIZE=524288
MAX_TLS_FILE_SIZE=1048576
MANAGED_JAIL_OPTION="managed_jail_mount"
MANAGED_TLS_FINGERPRINT="managed_tls_fingerprint"

INTEGRATION_LOCK="/var/lock/AdGuardHome-integration.lock"
NORMALIZER_RUNTIME_DIR="/var/run/luci-app-adguardhome"
NORMALIZER_LOCK="${NORMALIZER_RUNTIME_DIR}/normalizer.lock"
MONITOR_INTERVAL=2
# First boot can download and compile the packaged default filters before the
# DNS sockets appear, especially on slower routers.  Keep takeover disabled
# while allowing the official core enough time to become genuinely ready.
READY_TIMEOUT=120
READY_STABLE_COUNT=3

SNAPSHOT_MARKER="dnsmasq_snapshot"
SNAPSHOT_DNSMASQ_SECTION="dnsmasq_snapshot_section"
SNAPSHOT_ACTIVE_FINGERPRINT="dnsmasq_active_fingerprint"
SNAPSHOT_SERVER="dnsmasq_snapshot_server"
SNAPSHOT_NORESOLV_PRESENT="dnsmasq_snapshot_noresolv_present"
SNAPSHOT_NORESOLV_VALUE="dnsmasq_snapshot_noresolv_value"
SNAPSHOT_RESOLVFILE_PRESENT="dnsmasq_snapshot_resolvfile_present"
SNAPSHOT_RESOLVFILE_VALUE="dnsmasq_snapshot_resolvfile_value"

FIREWALL_SECTION="adguardhome_redirect"
FIREWALL_OWNER_OPTION="name"
FIREWALL_OWNER_VALUE="AdGuard Home (luci-app-adguardhome)"

EXTRA_COMMANDS="do_redirect isrunning monitor reconcile web_listening check_config normalize_config yaml_update tls_refresh"
EXTRA_HELP="\tdo_redirect [0|1]\tApply or remove DNS integration
\tisrunning\t\tReport the official service status
\treconcile\t\tReconcile DNS integration with the core state
\tweb_listening <port>\tVerify an official-core TCP listener
\tcheck_config <yaml> <workdir>\tValidate one YAML as uid 853
\tnormalize_config <yaml> <workdir>\tValidate and normalize one installer YAML
\tyaml_update <old-hash> <new-hash> <stage> <fd>\tCommit a validated LuCI YAML edit
\ttls_refresh\t\tRecheck ACME material after renewal"

log_error() {
	logger -t AdGuardHome "$*"
}

run_locked() (
	mkdir -p "${INTEGRATION_LOCK%/*}" || exit 1
	lock "$INTEGRATION_LOCK" || exit 1
	trap 'lock -u "$INTEGRATION_LOCK"' EXIT
	"$@"
)

is_valid_port() {
	case "$1" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

validate_work_dir() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/)
			log_error "Invalid work directory: '${value}'"
			return 1
			;;
		/*) ;;
		*)
			log_error "Work directory must be absolute: '${value}'"
			return 1
			;;
	esac
	value="${value%/}"
	case "$value" in
		/*/*) ;;
		*)
			log_error "Work directory must not be a top-level directory: '${value}'"
			return 1
			;;
	esac
	case "$value" in
		*[!A-Za-z0-9_./+@%:,=-]*)
			log_error "Work directory contains unsafe characters: '${value}'"
			return 1
			;;
	esac
	case "${value}/" in
		*/./*|*/../*)
			log_error "Work directory contains a '.' or '..' component: '${value}'"
			return 1
			;;
	esac
	[ -n "$value" ] && [ "$value" != / ] && ! path_contains_symlink "$value"
}

validate_mnt_ancestors() {
	local value="${1%/}" parent remaining component current="" metadata mode owner
	local links group remainder
	case "$value" in /mnt/*) ;; *) return 0 ;; esac
	parent="${value%/*}"
	remaining="${parent#/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -e "$current" ] || [ -L "$current" ]; then
			if [ ! -d "$current" ] || [ -L "$current" ]; then
				log_error "Untrusted work-directory ancestor: '$current'"
				return 1
			fi
			metadata="$(LC_ALL=C ls -ldn "$current" 2>/dev/null)" || return 1
			read -r mode links owner group remainder <<-EOF
			$metadata
			EOF
			if [ "$owner" != 0 ]; then
				log_error "Work-directory ancestor is not root-owned: '$current'"
				return 1
			fi
			case "$mode" in
				?????w*|????????w*)
					log_error "Work-directory ancestor is group/world-writable: '$current'"
					return 1
					;;
			esac
		fi
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
}

validate_managed_work_dir_namespace() {
	local value="${1%/}"
	validate_work_dir "$1" || return 1
	case "$value" in
		/etc/AdGuardHome|/etc/AdGuardHome-?*|/mnt/*/AdGuardHome|/mnt/*/AdGuardHome-?*)
			;;
		*)
			log_error "Work directory is outside the dedicated AdGuard Home namespace: '$value'"
			return 1
			;;
	esac
	validate_mnt_ancestors "$value"
}

validate_managed_work_dir() {
	local value="${1%/}" official_work official_config
	validate_managed_work_dir_namespace "$1" || return 1
	[ "$value" = "$DEFAULT_WORK_DIR" ] && return 0
	[ -e "$value" ] || [ -L "$value" ] || return 0
	official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	[ -n "$official_work" ] ||
		official_work="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"
	official_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	if [ "${official_work%/}" = "$value" ] &&
	   [ "$official_config" = "${value}/AdGuardHome.yaml" ]; then
		return 0
	fi
	log_error "Refusing an existing custom work directory not anchored by official adguardhome UCI: '$value'"
	return 1
}

path_contains_symlink() {
	local remaining="${1#/}" component current=""
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -L "$current" ]; then
			# ImmortalWrt's standard rootfs intentionally provides /var -> /tmp;
			# the official adguardhome package uses /var/lib/adguardhome by
			# default.  Permit only that verified system link, never an arbitrary
			# user-controlled symlink.
			if [ "$current" = /var ]; then
				case "$(readlink "$current" 2>/dev/null)" in
					tmp|/tmp)
						[ "$remaining" = "$component" ] && break
						remaining="${remaining#*/}"
						continue
						;;
				esac
			fi
			log_error "Symlink path components are not allowed: '${current}'"
			return 0
		fi
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
	return 1
}

load_legacy_settings() {
	local configured_work_dir
	config_load "$LEGACY_CONFIG"
	config_get_bool legacy_enabled "$LEGACY_SECTION" enabled 0
	config_get configured_work_dir "$LEGACY_SECTION" workdir "$DEFAULT_WORK_DIR"
	config_get redirect_mode "$LEGACY_SECTION" redirect "dnsmasq-upstream"
	config_get_bool verbose "$LEGACY_SECTION" verbose 0
	previous_work_dir="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.work_dir")"
	[ -n "$previous_work_dir" ] ||
		previous_work_dir="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.workdir")"

	validate_managed_work_dir "$configured_work_dir" || return 1
	work_dir="${configured_work_dir%/}"
	config_file="${work_dir}/AdGuardHome.yaml"

	case "$redirect_mode" in
		none|redirect|dnsmasq-upstream) ;;
		exchange) redirect_mode="redirect" ;;
		*)
			log_error "Invalid redirect mode '${redirect_mode}', using none"
			redirect_mode="none"
			;;
	esac
}

# The official YAML is the sole runtime authority for the DNS listener.  The
# packaged value 53335 is only present in the clean-install template; an
# existing missing or invalid value must fail closed instead of being replaced.
load_runtime_dns_port() {
	local value address web_port directory snapshot
	if [ ! -f "$config_file" ] || [ -L "$config_file" ]; then
		log_error "Config file is unavailable while reading the DNS port: ${config_file}"
		return 1
	fi
	directory="$(mktemp -d /tmp/AdGuardHome-runtime.XXXXXX)" || return 1
	snapshot="${directory}/AdGuardHome.yaml"
	if ! snapshot_config_file "$config_file" "$snapshot" "" ""; then
		rm -rf "$directory"
		log_error "Unable to take a safe YAML snapshot: ${config_file}"
		return 1
	fi
	value="$(yaml_get_section_value dns port "$snapshot")"
	address="$(yaml_get_section_value http address "$snapshot")"
	rm -rf "$directory" || return 1
	is_valid_port "$value" || {
		log_error "Invalid or ambiguous dns.port in ${config_file}"
		return 1
	}
	dns_port="$(awk -v value="$value" 'BEGIN { printf "%d\n", value + 0 }')" || return 1
	if [ "$dns_port" -eq 53 ] 2>/dev/null && [ "$redirect_mode" != none ]; then
		log_error "DNS port 53 is only supported when DNS integration mode is none"
		return 1
	fi

	if [ -n "$address" ]; then
		case "$address" in
			*:*) web_port="${address##*:}" ;;
		esac
	fi
	if is_valid_port "$web_port" && [ "$dns_port" -eq "$web_port" ] 2>/dev/null; then
		log_error "The YAML DNS and HTTP ports must be different: ${dns_port}"
		return 1
	fi
}

# Locate a key at the section's actual shallowest indentation.  This accepts
# both two- and four-space YAML and does not mistake nested keys for children.
yaml_get_section_value() {
	local section="$1" key="$2" file="$3"
	awk -v section="$section" -v key="$key" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		{ line[++n] = $0 }
		END {
			for (i = 1; i <= n; i++)
				if (line[i] ~ ("^" section ":[[:space:]]*($|#)")) { sections++; if (!first) first = i }
			if (sections != 1) exit
			last = n
			for (i = first + 1; i <= n; i++)
				if (top(line[i])) { last = i - 1; break }
			depth = 0
			for (i = first + 1; i <= last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d = indent(line[i]); if (!depth || d < depth) depth = d
			}
			if (!depth) depth = 2
			for (i = first + 1; i <= last; i++) {
				if (indent(line[i]) != depth) continue
				value = substr(line[i], depth + 1)
				if (value !~ ("^" key ":[[:space:]]*")) continue
				matches++
				sub("^" key ":[[:space:]]*", "", value)
				sub(/[[:space:]]+#.*$/, "", value)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if ((substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") ||
				    (substr(value,1,1)=="\047" && substr(value,length(value),1)=="\047"))
					value = substr(value, 2, length(value) - 2)
				result = value
			}
			if (matches == 1) print result
		}' "$file"
}

install_yaml_temp() {
	local generated="$1" file="$2" replacement
	replacement="$(mktemp "${file}.install.XXXXXX")" || return 1
	# The generated file is already root-private.  Do not root-copy the
	# replaceable source pathname merely to preserve metadata; apply the narrow
	# managed permissions directly to the new inode before the atomic rename.
	if ! cat "$generated" >"$replacement"; then
		rm -f "$replacement"
		return 1
	fi
	chmod 0600 "$replacement" || {
		rm -f "$replacement"
		return 1
	}
	rm -f "$generated" || {
		rm -f "$replacement"
		return 1
	}
	mv "$replacement" "$file" || {
		rm -f "$replacement"
		return 1
	}
}

# Replace an existing list item without disturbing user-added entries.  This is
# used to keep AdGuard Home's default local-filter allowlist aligned when the
# managed work directory moves.
yaml_replace_section_list_item() {
	local section="$1" key="$2" old_value="$3" new_value="$4" file="$5" tmp rc
	[ -n "$old_value" ] || return 3
	tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
	awk -v section="$section" -v key="$key" -v old="$old_value" -v replacement="$new_value" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(count, s, i) { s=""; for(i=0;i<count;i++)s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for(i=1;i<=n;i++)
				if(line[i] ~ ("^" section ":[[:space:]]*($|#)")){first=i;break}
			if(!first){for(i=1;i<=n;i++)print line[i]; exit 3}
			last=n
			for(i=first+1;i<=n;i++)if(top(line[i])){last=i-1;break}
			depth=0
			for(i=first+1;i<=last;i++){
				if(line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/)continue
				d=indent(line[i]); if(!depth || d<depth)depth=d
			}
			if(!depth)depth=2
			for(i=first+1;i<=last;i++){
				if(indent(line[i])!=depth)continue
				candidate=substr(line[i],depth+1)
				if(candidate ~ ("^" key ":[[:space:]]*")){key_line=i;break}
			}
			if(!key_line){for(i=1;i<=n;i++)print line[i]; exit 3}
			block_last=last
			for(i=key_line+1;i<=last;i++){
				if(line[i] ~ /^[[:space:]]*($|#)/)continue
				if(indent(line[i])<=depth){block_last=i-1;break}
			}
			for(i=key_line+1;i<=block_last;i++){
				if(indent(line[i])<=depth)continue
				value=substr(line[i],indent(line[i])+1)
				if(value !~ /^-[[:space:]]*/)continue
				sub(/^-[[:space:]]*/, "", value)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
				if((substr(value,1,1)=="\"" && substr(value,length(value),1)=="\"") ||
				   (substr(value,1,1)=="\047" && substr(value,length(value),1)=="\047"))
					value=substr(value,2,length(value)-2)
				if(value==old){
					line[i]=pad(indent(line[i])) "- " replacement
					changed=1
				}
			}
			for(i=1;i<=n;i++)print line[i]
			if(!changed)exit 3
		}' "$file" >"$tmp"
	rc=$?
	case "$rc" in
		0)
			if ! install_yaml_temp "$tmp" "$file"; then
				rm -f "$tmp"
				return 1
			fi
			;;
		3)
			rm -f "$tmp"
			return 3
			;;
		*)
			rm -f "$tmp"
			return 1
			;;
	esac
}

secure_active_paths() {
	local data_dir="${work_dir}/data" metadata mode links owner group remainder
	[ -d "$work_dir" ] || return 1
	[ ! -L "$work_dir" ] || return 1
	[ -f "$config_file" ] || return 1
	[ ! -L "$config_file" ] || return 1
	path_contains_symlink "$work_dir" && return 1
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) return 1 ;;
	esac
	if [ -e "$data_dir" ] || [ -L "$data_dir" ]; then
		if [ ! -d "$data_dir" ] || [ -L "$data_dir" ]; then
			log_error "Unsafe AdGuard Home data path: ${data_dir}"
			return 1
		fi
	fi
}

secure_active_config() (
	local directory snapshot metadata mode links owner group size remainder
	local workdir_fd old_fd stage_fd stage="" capture verify old_hash snapshot_fd=""
	secure_active_paths || exit 1
	umask 077
	directory="$(mktemp -d /tmp/AdGuardHome-secure.XXXXXX)" || exit 1
	trap '[ -z "$stage" ] || rm -f "$stage"; rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"

	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || exit 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------)
			metadata="$(LC_ALL=C ls -ldn "$config_file" 2>/dev/null)" || exit 1
			read -r mode links owner group size remainder <<-EOF
			$metadata
			EOF
			case "$owner" in
				0) ;;
				"$ADGUARD_UID")
					# The package installer can leave a service-owned YAML inside a
					# root-private directory before the official service first starts.
					# Do not relax the directory or chown that inode: an old writer FD
					# would retain access.  With the namespace frozen at 0700, copy the
					# exact bounded inode into a new private inode and atomically replace
					# it.  The official service will chown it back on its next start.
					[ "$group:$mode:$links" = "$ADGUARD_GID:-rw-------:1" ] ||
						[ "$group:$mode:$links" = "$ADGUARD_GID:-rw-r-----:1" ] || exit 1
					case "$size" in ""|*[!0-9]*) exit 1 ;; esac
					[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
					official_running && exit 1
					exec 7<"$work_dir" || exit 1
					workdir_fd=/proc/self/fd/7
					[ -d "$workdir_fd" ] && [ "$workdir_fd" -ef "$work_dir" ] || exit 1
					exec 8<"$config_file" || exit 1
					old_fd=/proc/self/fd/8
					[ -f "$old_fd" ] && [ "$old_fd" -ef "$config_file" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$old_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group size remainder <<-EOF
					$metadata
					EOF
					case "$owner:$group:$mode:$links" in
						"$ADGUARD_UID":"$ADGUARD_GID":-rw-------:1|"$ADGUARD_UID":"$ADGUARD_GID":-rw-r-----:1) ;;
						*) exit 1 ;;
					esac
					case "$size" in ""|*[!0-9]*) exit 1 ;; esac
					[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
					# Two bounded captures must agree before the active pathname can be
					# replaced.  Hash only those private captures, never the mutable old
					# inode directly, so an old writer cannot create an unbounded read.
					capture="${directory}/service-owned.yaml"
					verify="${directory}/service-owned-verify.yaml"
					snapshot_config_file "$config_file" "$capture" "" 8 || exit 1
					old_hash="$SNAPSHOT_CONFIG_HASH"
					snapshot_config_file "$config_file" "$verify" "$old_hash" 8 || exit 1
					stage="$(mktemp "${work_dir}/.AdGuardHome-secure.XXXXXX")" || exit 1
					exec 9<>"$stage" || exit 1
					stage_fd=/proc/self/fd/9
					[ -f "$stage_fd" ] && [ "$stage_fd" -ef "$stage" ] || exit 1
					/usr/bin/timeout -k 1s 3s /bin/dd if="$capture" bs=4096 count=129 \
						of="$stage_fd" 2>/dev/null || exit 1
					secure_config_inode "$stage_fd" || exit 1
					# This is the final size/hash gate before rename.  A truncate or
					# growth beyond MAX_YAML_SIZE therefore leaves the old path intact.
					snapshot_config_file "$stage" "$snapshot" "$old_hash" 9 || exit 1
					[ -f "$old_fd" ] && [ ! -L "$config_file" ] &&
						[ "$old_fd" -ef "$config_file" ] || exit 1
					[ -d "$workdir_fd" ] && [ "$workdir_fd" -ef "$work_dir" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$workdir_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group remainder <<-EOF
					$metadata
					EOF
					case "$owner:$group:$mode" in
						0:0:drwx------|0:"$ADGUARD_GID":drwx------) ;;
						*) exit 1 ;;
					esac
					official_running && exit 1
					mv "$stage" "$config_file" || exit 1
					stage=""
					[ "$stage_fd" -ef "$config_file" ] || exit 1
					metadata="$(LC_ALL=C ls -ldnL "$stage_fd" 2>/dev/null)" || exit 1
					read -r mode links owner group size remainder <<-EOF
					$metadata
					EOF
					[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
					snapshot_fd=9
					;;
				*) exit 1 ;;
			esac
			;;
		"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*) exit 1 ;;
	esac

	snapshot_config_file "$config_file" "$snapshot" "$old_hash" "$snapshot_fd" || exit 1
)

secure_config_inode() {
	local inode_path="$1" metadata mode owner links group remainder
	case "$inode_path" in /proc/self/fd/[0-9]*|/proc/[0-9]*/fd/[0-9]*) ;; *) return 1 ;; esac
	[ -f "$inode_path" ] || return 1
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner" in
		0)
			chown 0:0 "$inode_path" && chmod 0600 "$inode_path"
			;;
		"$ADGUARD_UID")
			# A previously-running official service owns the workdir.  Keep an
			# edited, root-owned YAML group-readable so disabled -> edit -> enable
			# can still be opened by the official uid without making it writable.
			chown "0:${ADGUARD_GID}" "$inode_path" && chmod 0640 "$inode_path"
			;;
		*)
			log_error "Unexpected AdGuard Home work-directory owner: ${owner}"
			return 1
			;;
	esac
}

ensure_config_file() {
	local previous_config source directory candidate candidate_hash
	if [ -L "$config_file" ]; then
		log_error "The AdGuard Home configuration file must not be a symlink: ${config_file}"
		return 1
	fi
	if [ -f "$config_file" ]; then
		secure_active_config
		return
	fi
	mkdir -m 0700 -p "$work_dir" || return 1
	path_contains_symlink "$work_dir" && return 1
	previous_config="$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.config_file")"
	for source in "$previous_config" "$DEFAULT_CONFIG_FILE"; do
		[ -n "$source" ] || continue
		[ "$source" != "$config_file" ] || continue
		[ -f "$source" ] || continue
		[ ! -L "$source" ] || continue
		directory="$(mktemp -d /tmp/AdGuardHome-seed.XXXXXX)" || return 1
		candidate="${directory}/AdGuardHome.yaml"
		if ! snapshot_config_file "$source" "$candidate" "" ""; then
			rm -rf "$directory"
			return 1
		fi
		candidate_hash="$(yaml_file_hash "$candidate")" || {
			rm -rf "$directory"
			return 1
		}
		if [ -e "$config_file" ] || [ -L "$config_file" ]; then
			rm -rf "$directory"
			log_error "Configuration path appeared while migrating: ${config_file}"
			return 1
		fi
		install_config_candidate "$candidate" absent "$candidate_hash" "" || {
			rm -rf "$directory"
			return 1
		}
		rm -rf "$directory" || return 1
		secure_active_config
		return
	done
	log_error "Config file is missing: ${config_file}"
	return 1
}

# Preserve the official core's runtime history and filter data when the managed
# work directory changes.  Copy into an atomic sibling first, keep the source
# untouched for rollback, and refuse to merge with an unrelated target tree.
uid853_tree_is_plain() {
	local tree="$1"
	[ -d "$tree" ] && [ ! -L "$tree" ] || return 1
	# $1 and found intentionally expand only in the lowered child shell.
	# shellcheck disable=SC2016
	/usr/bin/timeout -k 2s 30s \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataScan -x /bin/sh -- -c '
			set -o pipefail
			found="$(/usr/bin/find "$1" ! -type f ! -type d -print 2>/dev/null |
				/usr/bin/head -n 1)" || exit 1
			[ -z "$found" ]
		' sh "$tree" >/dev/null 2>&1
}

uid853_read_small_file() {
	/usr/bin/timeout -k 1s 3s \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHDataRead -x /bin/dd -- if="$1" bs=4096 count=1 2>/dev/null
}

restore_migration_workdir_access() {
	chown "$2:$3" "$1" && chmod 0700 "$1"
}

read_migration_marker() {
	local marker="$1" metadata mode links owner group remainder value
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	case "$owner:$group:$mode" in
		"$ADGUARD_UID":"$ADGUARD_GID":drwx------)
			uid853_read_small_file "$marker"
			return
			;;
		0:0:drwx------|0:"$ADGUARD_GID":drwx------) ;;
		*) return 1 ;;
	esac
	value="$(
		trap 'restore_migration_workdir_access "$work_dir" "$owner" "$group" >/dev/null 2>&1 || true' EXIT
		chown "0:${ADGUARD_GID}" "$work_dir" && chmod 0710 "$work_dir" || exit 1
		uid853_read_small_file "$marker" || exit 1
		restore_migration_workdir_access "$work_dir" "$owner" "$group" || exit 1
		trap - EXIT
	)" || return 1
	printf '%s' "$value"
}

migrate_work_data() {
	local old_work source_data target_data marker temporary marker_value metadata
	local mode links original_owner original_group remainder
	old_work="${previous_work_dir%/}"
	[ -n "$old_work" ] || return 0
	[ "$old_work" != "$work_dir" ] || return 0
	validate_work_dir "$old_work" || return 1
	source_data="${old_work}/data"
	target_data="${work_dir}/data"
	marker="${target_data}/.luci-app-adguardhome-migrated-from"
	[ -d "$source_data" ] || return 0
	if [ -L "$source_data" ] || path_contains_symlink "$old_work" ||
	   ! uid853_tree_is_plain "$source_data"; then
		log_error "Refusing to migrate data through a symlinked source: ${source_data}"
		return 1
	fi
	if [ -e "$target_data" ] || [ -L "$target_data" ]; then
		marker_value=""
		if [ -f "$marker" ] && [ ! -L "$marker" ]; then
			marker_value="$(read_migration_marker "$marker")" || marker_value=""
		fi
		if [ "$marker_value" = "$old_work" ]; then
			return 0
		fi
		log_error "Target data directory already exists; refusing to overwrite it: ${target_data}"
		return 1
	fi
	temporary="$(mktemp -d "${work_dir}/.data-migration.XXXXXX")" || return 1
	metadata="$(LC_ALL=C ls -ldn "$work_dir" 2>/dev/null)" || {
		rm -rf "$temporary"
		return 1
	}
	read -r mode links original_owner original_group remainder <<-EOF
	$metadata
	EOF
	case "$original_owner:$original_group:$mode" in
		0:0:drwx------|0:"$ADGUARD_GID":drwx------|"$ADGUARD_UID":"$ADGUARD_GID":drwx------) ;;
		*)
			rm -rf "$temporary"
			return 1
			;;
	esac
	# Give uid 853 only traverse access to the parent during the copy; it can
	# write solely inside the dedicated temporary directory.  The EXIT trap
	# restores the exact owner/group and mode even on timeout or signal.
	if ! (
		target_installed=0
		trap '[ "$target_installed" != 1 ] || rm -rf "$target_data"; restore_migration_workdir_access "$work_dir" "$original_owner" "$original_group" >/dev/null 2>&1 || true' EXIT
		chown "0:${ADGUARD_GID}" "$work_dir" && chmod 0710 "$work_dir" || exit 1
		chown "${ADGUARD_UID}:${ADGUARD_GID}" "$temporary" &&
			chmod 0700 "$temporary" || exit 1
		# The source tree is controlled by the official uid.  Copy as that uid so
		# a path substitution cannot make root read host secrets; scan again to
		# reject any symlink introduced during the copy.
		/usr/bin/timeout -k 2s 120s \
			/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
			-n AGHDataCopy -x /bin/cp -- -pR "${source_data}/." "$temporary/" || exit 1
		uid853_tree_is_plain "$temporary" || exit 1
		printf '%s\n' "$old_work" | /usr/bin/timeout -k 1s 3s \
			/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
			-n AGHDataMark -x /bin/dd -- \
			of="${temporary}/.luci-app-adguardhome-migrated-from" \
			bs=4096 count=1 2>/dev/null || exit 1
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
			-n AGHDataMode -x /bin/chmod -- 0600 \
			"${temporary}/.luci-app-adguardhome-migrated-from" || exit 1
		uid853_tree_is_plain "$temporary" || exit 1
		[ ! -e "$target_data" ] && [ ! -L "$target_data" ] || exit 1
		target_installed=1
		mv "$temporary" "$target_data" || exit 1
		[ -d "$target_data" ] && [ ! -L "$target_data" ] || exit 1
		restore_migration_workdir_access "$work_dir" \
			"$original_owner" "$original_group" || exit 1
		target_installed=0
		trap - EXIT
	); then
		rm -rf "$temporary"
		return 1
	fi
	log_error "Copied AdGuard Home runtime data from ${source_data} to ${target_data}"
}

sync_yaml_workdir_pattern() {
	local target_file="${1:-$config_file}" old_pattern desired_pattern replace_rc=0
	[ -n "$previous_work_dir" ] || return 0
	old_pattern="${previous_work_dir%/}/data/userfilters/*"
	desired_pattern="${work_dir}/data/userfilters/*"
	[ "$old_pattern" != "$desired_pattern" ] || return 0
	yaml_replace_section_list_item filtering safe_fs_patterns \
		"$old_pattern" "$desired_pattern" "$target_file" || replace_rc=$?
	case "$replace_rc" in
		0|3) ;;
		*) return 1 ;;
	esac
}

sync_yaml_managed_fields() {
	sync_yaml_workdir_pattern "$1"
}

root_private_config_source() {
	local candidate="$1" parent mode
	parent="${candidate%/*}"
	[ -n "$parent" ] || parent=/
	[ -O "$candidate" ] && [ -O "$parent" ] || return 1
	path_contains_symlink "$parent" && return 1
	mode="$(LC_ALL=C ls -ldn "$parent" 2>/dev/null)" || return 1
	mode="${mode%% *}"
	# Reject group- or world-writable parents.  A root-owned file under such a
	# directory could still be renamed between the identity check and open.
	case "$mode" in ?????w*|????????w*) return 1 ;; esac
}

snapshot_config_file() {
	local candidate="$1" target="$2" expected_hash="$3" inherited_fd="$4"
	local allow_detached="$5" fd_path size hash capture_rc=0
	if [ -n "$inherited_fd" ]; then
		case "$inherited_fd" in ""|*[!0-9]*) return 1 ;; esac
		[ "$inherited_fd" -ge 3 ] 2>/dev/null || return 1
		fd_path="/proc/self/fd/${inherited_fd}"
		[ -f "$fd_path" ] || return 1
		if [ "$allow_detached" != 1 ]; then
			[ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
			[ "$fd_path" -ef "$candidate" ] || return 1
		fi
		/usr/bin/timeout -k 1s 3s /bin/dd if="$fd_path" bs=4096 count=129 \
			of="$target" 2>/dev/null || capture_rc=$?
		[ "$capture_rc" = 0 ] || return 1
		# The pathname is needed later for a same-filesystem rename.  Reject an
		# unlink or replacement that occurred while the held inode was copied.
		if [ "$allow_detached" != 1 ]; then
			[ -f "$candidate" ] && [ ! -L "$candidate" ] &&
				[ "$fd_path" -ef "$candidate" ] || return 1
		fi
	else
		[ -f "$candidate" ] && [ ! -L "$candidate" ] || return 1
		# A root-owned private workdir cannot be renamed by uid 853 (clean,
		# disabled installation).  Otherwise capture as uid 853 so a concurrent
		# symlink swap can never grant the snapshotter root read access.
		if root_private_config_source "$candidate"; then
			capture_root_file_bytes "$candidate" "$target" 129 || capture_rc=$?
		else
			/usr/bin/timeout -k 1s 3s \
				/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
				-n AGHSnapshot -x /bin/dd -- if="$candidate" bs=4096 count=129 \
				>"$target" 2>/dev/null || capture_rc=$?
		fi
		[ "$capture_rc" = 0 ] || return 1
	fi
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || return 1
	hash="$(yaml_file_hash "$target")" || return 1
	if [ -n "$expected_hash" ]; then
		[ "$hash" = "$expected_hash" ] || return 1
	fi
	SNAPSHOT_CONFIG_HASH="$hash"
}

check_core_config_file() {
	local candidate="$1" expected_hash="$2" inherited_fd="$3" repair_tls="$4"
	local validation_dir validation_work validation rc
	[ -x "$CORE_BINARY" ] || {
		log_error "AdGuard Home binary is missing: ${CORE_BINARY}"
		return 1
	}
	[ -x /usr/bin/timeout ] || {
		log_error "The required coreutils timeout helper is missing"
		return 1
	}
	[ -x /sbin/start-stop-daemon ] || {
		log_error "The required start-stop-daemon helper is missing"
		return 1
	}
	validation_dir="$(mktemp -d /tmp/AdGuardHome-check.XXXXXX)" || return 1
	validation="${validation_dir}/AdGuardHome.yaml"
	validation_work="${validation_dir}/work"
	mkdir "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	if ! snapshot_config_file "$candidate" "$validation" \
		"$expected_hash" "$inherited_fd"; then
		rm -rf "$validation_dir"
		return 1
	fi
	# When activating an installed YAML, repair only an allowlisted external
	# private key and then prove uid-853 readability.  A staged candidate remains
	# strictly read-only; prepare_tls_validation_files() gives the lowered core
	# bounded private copies so a first root:root 0600 ACME key can be validated
	# without changing the live key before commit.
	if [ "$repair_tls" = 1 ] && ! load_tls_access "$validation"; then
		rm -rf "$validation_dir"
		return 1
	fi
	if ! prepare_tls_validation_files "$validation" "$validation_dir"; then
		rm -rf "$validation_dir"
		return 1
	fi
	# Root retains ownership of both path components.  Group 853 may only
	# traverse the directory and read the disposable YAML, so it cannot replace
	# the validation pathname before the lowered checker opens it.
	chown "0:${ADGUARD_GID}" "$validation_dir" "$validation" || {
		rm -rf "$validation_dir"
		return 1
	}
	chown "${ADGUARD_UID}:${ADGUARD_GID}" "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0710 "$validation_dir" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0640 "$validation" || {
		rm -rf "$validation_dir"
		return 1
	}
	chmod 0700 "$validation_work" || {
		rm -rf "$validation_dir"
		return 1
	}
	# AdGuard Home may migrate an old schema during --check-config.  Validate a
	# disposable copy so this helper is genuinely read-only for the active YAML,
	# including while the official service is running.  A hard timeout bounds
	# FIFOs or slow filesystem references in fields not interpreted above, and
	# uid/gid 853 prevents the checker from reading root-only host files.
	/usr/bin/timeout -k 2s 15s \
		/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
		-n AGHConfigCheck -x "$CORE_BINARY" -- \
		--check-config --config "$validation" --work-dir "$validation_work" \
		>/dev/null 2>&1
	rc=$?
	rm -rf "$validation_dir" || return 1
	return "$rc"
}

check_core_config() {
	# Only the root-owned snapshot is parsed while repairing access for an
	# external ACME/certs key.  Staged RPC candidates never take that mutating
	# path.
	check_core_config_file "$config_file" "" "" 1
}

valid_config_candidate_path() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "${value}/" in */./*|*/../*) return 1 ;; esac
	[ -f "$value" ] && [ ! -L "$value" ] || return 1
	! path_contains_symlink "$value"
}

normalizer_lock_directory_is_private() {
	local directory="${NORMALIZER_LOCK%/*}" metadata mode links owner group remainder
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	path_contains_symlink "$directory" && return 1
	metadata="$(LC_ALL=C ls -ldn "$directory" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ]
}

normalizer_lock_is_private() {
	local metadata mode links owner group remainder
	[ -d "$NORMALIZER_LOCK" ] && [ ! -L "$NORMALIZER_LOCK" ] || return 1
	path_contains_symlink "$NORMALIZER_LOCK" && return 1
	metadata="$(LC_ALL=C ls -ldn "$NORMALIZER_LOCK" 2>/dev/null)" || return 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ]
}

# The writable normalizer child may start only while uid 853 is otherwise
# completely quiescent.  Read each thread status once and fail closed if a
# non-vanished record is malformed.
adguard_uid_process_exists() {
	local status uids
	for status in /proc/[0-9]*/task/[0-9]*/status; do
		if [ ! -r "$status" ]; then
			[ ! -e "$status" ] && continue
			return 0
		fi
		uids="$(awk '$1 == "Uid:" {
			if (NF != 5) exit 2
			for (i=2; i<=5; i++) if ($i !~ /^[0-9]+$/) exit 2
			print $2, $3, $4, $5; found=1; exit }
			END { if (!found) exit 1 }' \
			"$status" 2>/dev/null)" || {
			[ ! -e "$status" ] && continue
			return 0
		}
		case " $uids " in *" ${ADGUARD_UID} "*) return 0 ;; esac
	done
	return 1
}

# Installer migrations are the only place where an old schema must be written
# by the official core before it becomes active.  Keep the disposable tree
# behind a root-only parent and expose only its root-group-writable config/work
# children inside a dedicated ujail mount namespace.  The lowered child has
# uid 853 and primary gid 0 solely so it can write the root-group staging
# children.  No other uid-853 process may coexist, so none can reach the
# root-only outer directory through the child's procfs views.  Runtime and RPC
# validation continue to use the read-only sandbox above.
normalize_installer_config() (
	local candidate="$1" source_fd original_hash
	local validation_dir validation_config_dir validation_work validation
	local normalized normalized_verify source_verify config_dir_fd output_fd
	local original_certificate_path original_private_key_path tls_paths_rewritten=0
	local normalized_hash replacement="" replacement_fd metadata mode links
	local owner group size remainder rc=0 pattern_rc=0 lock_held=0
	local account_groups

	cleanup_installer_normalizer() {
		case "$replacement" in
			"${candidate}.normalized."??????) rm -f "$replacement" ;;
		esac
		case "$validation_dir" in
			/tmp/AdGuardHome-normalize.??????) rm -rf "$validation_dir" ;;
		esac
		if [ "$lock_held" = 1 ]; then
			rmdir "$NORMALIZER_LOCK" >/dev/null 2>&1 || true
		fi
	}

	root_private_config_source "$candidate" || exit 1
	[ -x /sbin/ujail ] || exit 1
	[ "$(id -u "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_UID" ] || exit 1
	[ "$(id -g "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_GID" ] || exit 1
	[ "$(id -gn "$ADGUARD_USER" 2>/dev/null)" = "$ADGUARD_GROUP" ] || exit 1
	[ "$(id -g "$NORMALIZER_GROUP" 2>/dev/null)" = 0 ] || exit 1
	[ "$(id -gn "$NORMALIZER_GROUP" 2>/dev/null)" = "$NORMALIZER_GROUP" ] || exit 1
	account_groups="$(id -G "$ADGUARD_USER" 2>/dev/null)" || exit 1
	case " $account_groups " in *" 0 "*) exit 1 ;; esac
	normalizer_lock_directory_is_private || exit 1
	trap cleanup_installer_normalizer EXIT
	# mkdir is the lock acquisition: it is atomic, nonblocking, and only the
	# successful creator removes this exact directory on exit.  Unlike unlinking
	# a flock file, this cannot split contenders across two locked inodes.
	mkdir -m 0700 "$NORMALIZER_LOCK" || exit 1
	lock_held=1
	chown 0:0 "$NORMALIZER_LOCK" && chmod 0700 "$NORMALIZER_LOCK" || exit 1
	normalizer_lock_is_private || exit 1
	if adguard_uid_process_exists; then
		log_error "Refusing installer normalization while uid ${ADGUARD_UID} is not quiescent"
		exit 1
	fi
	exec 8<"$candidate" || exit 1
	source_fd=/proc/self/fd/8
	[ -f "$source_fd" ] && [ "$source_fd" -ef "$candidate" ] || exit 1

	validation_dir="$(mktemp -d /tmp/AdGuardHome-normalize.XXXXXX)" || exit 1
	validation_config_dir="${validation_dir}/config"
	validation_work="${validation_dir}/work"
	validation="${validation_config_dir}/AdGuardHome.yaml"
	normalized="${validation_dir}/normalized.yaml"
	normalized_verify="${validation_dir}/normalized-verify.yaml"
	source_verify="${validation_dir}/source-verify.yaml"
	mkdir "$validation_config_dir" "$validation_work" || exit 1
	snapshot_config_file "$candidate" "$validation" "" 8 || exit 1
	original_hash="$SNAPSHOT_CONFIG_HASH"
	original_certificate_path="$(yaml_get_section_value tls certificate_path "$validation")"
	original_private_key_path="$(yaml_get_section_value tls private_key_path "$validation")"
	prepare_tls_validation_files "$validation" "$validation_dir" || exit 1
	[ -z "$TLS_CERT_REAL" ] || tls_paths_rewritten=1
	if [ "$tls_paths_rewritten" = 1 ]; then
		chown 0:0 "${validation_dir}/tls-certificate" \
			"${validation_dir}/tls-private-key" || exit 1
		chmod 0640 "${validation_dir}/tls-certificate" \
			"${validation_dir}/tls-private-key" || exit 1
	fi

	# Hold the exact config directory before it becomes writable.  Its root-only
	# parent remains mode 0700 on the host; ujail bind-mounts the child at the
	# same pathname inside a private mount namespace for the lowered core.
	exec 7<"$validation_config_dir" || exit 1
	config_dir_fd=/proc/self/fd/7
	[ -d "$config_dir_fd" ] && [ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1
	chown 0:0 "$config_dir_fd" "$validation_work" || exit 1
	chown "${ADGUARD_UID}:0" "$validation" || exit 1
	chmod 0770 "$config_dir_fd" "$validation_work" || exit 1
	chmod 0600 "$validation" || exit 1
	[ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1

	# Let ujail reap a TERM-resistant child before the outer timeout may kill its
	# supervisor.  The four-second outer grace exceeds ujail's one-second grace.
	set -- /sbin/ujail -n AGHNormalize -t 1 -E -c -o \
		-U "$ADGUARD_USER" -G "$NORMALIZER_GROUP" \
		-w "$validation_config_dir" -w "$validation_work"
	if [ "$tls_paths_rewritten" = 1 ]; then
		set -- "$@" -r "${validation_dir}/tls-certificate" \
			-r "${validation_dir}/tls-private-key"
	fi
	set -- "$@" -- "$CORE_BINARY" --check-config \
		--config "$validation" --work-dir "$validation_work"
	/usr/bin/timeout -k 4s 20s "$@" >/dev/null 2>&1 || rc=$?
	[ "$rc" = 0 ] || exit 1

	# Revoke the bind source through its held descriptor before opening output.
	# Then prove that the core produced one bounded regular inode and capture it
	# twice through a held FD.  Hash only the root-owned bounded snapshots.
	[ -d "$config_dir_fd" ] && [ "$config_dir_fd" -ef "$validation_config_dir" ] || exit 1
	chown 0:0 "$config_dir_fd" && chmod 0700 "$config_dir_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$config_dir_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode" = "0:0:drwx------" ] || exit 1
	[ -f "$validation" ] && [ ! -L "$validation" ] || exit 1
	exec 9<"$validation" || exit 1
	output_fd=/proc/self/fd/9
	[ -f "$output_fd" ] && [ "$output_fd" -ef "$validation" ] || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$output_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = \
		"${ADGUARD_UID}:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	chown 0:0 "$output_fd" && chmod 0600 "$output_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$output_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	snapshot_config_file "$validation" "$normalized" "" 9 || exit 1
	normalized_hash="$SNAPSHOT_CONFIG_HASH"
	snapshot_config_file "$validation" "$normalized_verify" \
		"$normalized_hash" 9 || exit 1
	chown 0:0 "$normalized" && chmod 0600 "$normalized" || exit 1
	if [ "$tls_paths_rewritten" = 1 ]; then
		yaml_replace_tls_scalar tls certificate_path \
			"$original_certificate_path" "$normalized" || exit 1
		yaml_replace_tls_scalar tls private_key_path \
			"$original_private_key_path" "$normalized" || exit 1
	fi
	yaml_replace_section_list_item filtering safe_fs_patterns \
		"${validation_work}/data/userfilters/*" \
		"${work_dir}/data/userfilters/*" "$normalized" || pattern_rc=$?
	case "$pattern_rc" in 0|3) ;; *) exit 1 ;; esac
	# No jail-private path may escape into the installed YAML.  This also catches
	# any future official migrator field that embeds its disposable workdir.
	rc=0
	grep -F "$validation_dir" "$normalized" >/dev/null 2>&1 || rc=$?
	case "$rc" in 0) exit 1 ;; 1) ;; *) exit 1 ;; esac
	normalized_hash="$(yaml_file_hash "$normalized")" || exit 1
	check_core_config_file "$normalized" "$normalized_hash" "" "" || exit 1

	snapshot_config_file "$candidate" "$source_verify" "$original_hash" 8 || exit 1
	[ -f "$candidate" ] && [ ! -L "$candidate" ] && \
		[ "$source_fd" -ef "$candidate" ] || exit 1
	root_private_config_source "$candidate" || exit 1
	replacement="$(mktemp "${candidate}.normalized.XXXXXX")" || exit 1
	exec 6<>"$replacement" || exit 1
	replacement_fd=/proc/self/fd/6
	[ -f "$replacement_fd" ] && [ "$replacement_fd" -ef "$replacement" ] || exit 1
	/usr/bin/timeout -k 1s 3s /bin/dd if="$normalized" \
		bs=4096 count=129 of="$replacement_fd" 2>/dev/null || exit 1
	chown 0:0 "$replacement_fd" && chmod 0600 "$replacement_fd" || exit 1
	metadata="$(LC_ALL=C ls -ldnL "$replacement_fd" 2>/dev/null)" || exit 1
	read -r mode links owner group size remainder <<-EOF
	$metadata
	EOF
	[ "$owner:$group:$mode:$links" = "0:0:-rw-------:1" ] || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	[ "$(open_fd_hash "$replacement_fd")" = "$normalized_hash" ] || exit 1
	snapshot_config_file "$candidate" "$source_verify" "$original_hash" 8 || exit 1
	[ -f "$candidate" ] && [ ! -L "$candidate" ] && \
		[ "$source_fd" -ef "$candidate" ] || exit 1
	mv "$replacement" "$candidate" || exit 1
	replacement=""
	[ "$replacement_fd" -ef "$candidate" ] || exit 1
	[ "$(open_fd_hash "$replacement_fd")" = "$normalized_hash" ] || exit 1
	exec 6>&-
	exec 9>&-
	exec 7>&-
	exec 8>&-
)

# Restricted validator for the clean-install/migration script.  It accepts no
# UCI state and performs no writes outside a root-owned disposable directory.
# snapshot_config_file() either uses a root-private source or reads as uid 853,
# so a pathname race cannot turn this command into a privileged file reader.
check_config() {
	local candidate="$1" requested_work_dir="$2"
	valid_config_candidate_path "$candidate" || return 1
	# This root-only migration validator may run immediately before the official
	# lower UCI is anchored to a newly-created custom directory.  Enforce the
	# namespace and trusted ancestors here; runtime entry points additionally
	# require the exact existing-directory UCI anchor.
	validate_managed_work_dir_namespace "$requested_work_dir" || return 1
	work_dir="${requested_work_dir%/}"
	check_core_config_file "$candidate"
}

normalize_config() {
	local candidate="$1" requested_work_dir="$2"
	valid_config_candidate_path "$candidate" || return 1
	case "$candidate" in
		"${NORMALIZER_RUNTIME_DIR}/yaml-migration."??????|\
		"${NORMALIZER_RUNTIME_DIR}/yaml-workdir-result."??????|\
		"${NORMALIZER_RUNTIME_DIR}/yaml-dns-result."??????) ;;
		*) return 1 ;;
	esac
	# Package migrations may normalize only root-private candidates after the
	# requested destination has passed the same namespace checks as runtime.
	validate_managed_work_dir_namespace "$requested_work_dir" || return 1
	work_dir="${requested_work_dir%/}"
	normalize_installer_config "$candidate"
}

restore_yaml_backup() {
	local backup="$1"
	install_config_candidate "$backup" "" ""
}

open_fd_hash() {
	local fd_path="$1" digest
	[ -f "$fd_path" ] || return 1
	digest="$(/usr/bin/sha256sum "$fd_path" 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		????????????????????????????????????????????????????????????????)
			case "$digest" in *[!0-9a-f]*) return 1 ;; esac
			printf '%s\n' "$digest"
			;;
		*) return 1 ;;
	esac
}

install_config_candidate_attempt() (
	local source="$1" source_hash="$2" expected_active="$3" stage="$4"
	local replacement_marker="$5" fd_path size installed_hash current_hash cleanup_stage=""
	trap '[ -z "$cleanup_stage" ] || rm -f "$cleanup_stage"' EXIT
	# noclobber makes the redirection an exclusive create.  Keep descriptor 9
	# open through the pathname identity checks and atomic rename, so root never
	# writes a stage pathname that uid 853 replaced with a symlink.
	set -C
	exec 9>"$stage" || exit 1
	set +C
	cleanup_stage="$stage"
	fd_path=/proc/self/fd/9
	/bin/cat "$source" >&9 || exit 1
	[ -f "$fd_path" ] || exit 1
	size="$(wc -c <"$fd_path" 2>/dev/null)" || exit 1
	case "$size" in ""|*[!0-9]*) exit 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_YAML_SIZE" ] || exit 1
	installed_hash="$(open_fd_hash "$fd_path")" || exit 1
	[ "$installed_hash" = "$source_hash" ] || exit 1
	[ -f "$stage" ] && [ ! -L "$stage" ] && [ "$fd_path" -ef "$stage" ] || exit 1
	if [ "$expected_active" = absent ]; then
		[ ! -e "$config_file" ] && [ ! -L "$config_file" ] || exit 1
	elif [ -n "$expected_active" ]; then
		current_hash="$(active_config_hash)" || exit 1
		[ "$current_hash" = "$expected_active" ] || exit 1
	fi
	secure_config_inode "$fd_path" || exit 1
	[ -f "$stage" ] && [ ! -L "$stage" ] && [ "$fd_path" -ef "$stage" ] || exit 1
	[ -z "$replacement_marker" ] || : >"$replacement_marker" || exit 1
	mv "$stage" "$config_file" || exit 1
	cleanup_stage=""
	[ "$fd_path" -ef "$config_file" ] || exit 1
	current_hash="$(active_config_hash)" || exit 1
	[ "$current_hash" = "$source_hash" ] || exit 1
	exec 9>&-
)

install_config_candidate() {
	local source="$1" expected_active="$2" desired_hash="$3"
	local replacement_marker="$4" source_hash attempt=0 stage
	[ -f "$source" ] && [ ! -L "$source" ] || return 1
	root_private_config_source "$source" || return 1
	source_hash="$(yaml_file_hash "$source")" || return 1
	[ -z "$desired_hash" ] || [ "$source_hash" = "$desired_hash" ] || return 1
	if [ -n "$replacement_marker" ]; then
		case "$replacement_marker" in
			/tmp/AdGuardHome-managed.??????/install-replaced) ;;
			*) return 1 ;;
		esac
		rm -f "$replacement_marker" || return 1
	fi
	while [ "$attempt" -lt 10 ]; do
		stage="${config_file}.install.$$.$attempt"
		if install_config_candidate_attempt "$source" "$source_hash" \
			"$expected_active" "$stage" "$replacement_marker"; then
			return 0
		fi
		attempt=$((attempt + 1))
	done
	return 1
}

# Rewrite only a root-private bounded snapshot.  The official core validates
# that candidate as uid 853, then the active revision is compared again at the
# final atomic-install boundary.
sync_yaml_managed_fields_checked() {
	local directory backup candidate replacement_marker
	local expected_hash candidate_hash current_hash
	directory="$(mktemp -d /tmp/AdGuardHome-managed.XXXXXX)" || return 1
	backup="${directory}/original.yaml"
	candidate="${directory}/AdGuardHome.yaml"
	replacement_marker="${directory}/install-replaced"
	expected_hash="$(active_config_hash)" || {
		rm -rf "$directory"
		return 1
	}
	if ! snapshot_config_file "$config_file" "$backup" "$expected_hash" "" ||
	   ! /bin/cp "$backup" "$candidate" ||
	   ! chmod 0600 "$candidate" ||
	   ! sync_yaml_managed_fields "$candidate"; then
		rm -rf "$directory"
		log_error "Unable to update the managed YAML fields"
		return 1
	fi
	candidate_hash="$(yaml_file_hash "$candidate")" || {
		rm -rf "$directory"
		return 1
	}
	if [ "$candidate_hash" = "$expected_hash" ]; then
		rm -rf "$directory"
		return 0
	fi
	if ! check_core_config_file "$candidate" "$candidate_hash" "" 1; then
		rm -rf "$directory"
		log_error "AdGuard Home rejected the managed YAML candidate"
		return 1
	fi
	current_hash="$(active_config_hash)" || {
		rm -rf "$directory"
		return 1
	}
	if [ "$current_hash" != "$expected_hash" ]; then
		rm -rf "$directory"
		log_error "The active YAML changed during its managed-field update"
		return 1
	fi
	if ! install_config_candidate "$candidate" "$expected_hash" \
		"$candidate_hash" "$replacement_marker"; then
		if [ -f "$replacement_marker" ] && [ ! -L "$replacement_marker" ]; then
			if install_config_candidate "$backup" "" "$expected_hash" ""; then
				rm -rf "$directory"
				log_error "Restored the active YAML after a failed managed-field install"
				return 1
			fi
			chmod 0700 "$directory" >/dev/null 2>&1 || true
			chmod 0600 "$backup" >/dev/null 2>&1 || true
			log_error "Preserved the original YAML after restore failure: ${backup}"
			return 1
		fi
		rm -rf "$directory"
		log_error "The managed YAML candidate was not installed"
		return 1
	fi
	rm -rf "$directory"
}

uci_set_if_changed() {
	local config="$1" section="$2" option="$3" value="$4" current
	current="$(uci -q get "${config}.${section}.${option}")"
	[ "$current" = "$value" ] && return 0
	uci -q set "${config}.${section}.${option}=${value}" || return 1
	UCI_CHANGED=1
}

uci_delete_if_present() {
	local config="$1" section="$2" option="$3"
	uci -q get "${config}.${section}.${option}" >/dev/null 2>&1 || return 0
	uci -q delete "${config}.${section}.${option}" || return 1
	UCI_CHANGED=1
}

line_list_contains() {
	local needle="$1" list="$2" item
	[ -n "$list" ] || return 1
	while IFS= read -r item; do
		[ "$item" = "$needle" ] && return 0
	done <<-EOF
	$list
	EOF
	return 1
}

append_tls_desired_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_DESIRED_MOUNTS" && return 0
	if [ -n "$TLS_DESIRED_MOUNTS" ]; then
		TLS_DESIRED_MOUNTS="${TLS_DESIRED_MOUNTS}
${value}"
	else
		TLS_DESIRED_MOUNTS="$value"
	fi
}

append_tls_old_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_OLD_MOUNTS" && return 0
	if [ -n "$TLS_OLD_MOUNTS" ]; then
		TLS_OLD_MOUNTS="${TLS_OLD_MOUNTS}
${value}"
	else
		TLS_OLD_MOUNTS="$value"
	fi
}

append_tls_new_managed_mount() {
	local value="$1"
	line_list_contains "$value" "$TLS_NEW_MANAGED_MOUNTS" && return 0
	if [ -n "$TLS_NEW_MANAGED_MOUNTS" ]; then
		TLS_NEW_MANAGED_MOUNTS="${TLS_NEW_MANAGED_MOUNTS}
${value}"
	else
		TLS_NEW_MANAGED_MOUNTS="$value"
	fi
}

append_tls_original_mount() {
	local value="$1"
	if [ -n "$TLS_ORIGINAL_MOUNTS" ]; then
		TLS_ORIGINAL_MOUNTS="${TLS_ORIGINAL_MOUNTS}
${value}"
	else
		TLS_ORIGINAL_MOUNTS="$value"
	fi
	if line_list_contains "$value" "$TLS_OLD_MOUNTS" ||
	   line_list_contains "$value" "$TLS_PRESERVED_MOUNTS"; then
		return 0
	fi
	if [ -n "$TLS_PRESERVED_MOUNTS" ]; then
		TLS_PRESERVED_MOUNTS="${TLS_PRESERVED_MOUNTS}
${value}"
	else
		TLS_PRESERVED_MOUNTS="$value"
	fi
}

collect_tls_old_mount() {
	append_tls_old_mount "$1"
}

collect_tls_official_mount() {
	append_tls_original_mount "$1"
}

derive_tls_new_managed_mounts() {
	local value
	TLS_NEW_MANAGED_MOUNTS=""
	[ -n "$TLS_DESIRED_MOUNTS" ] || return 0
	while IFS= read -r value; do
		[ -n "$value" ] || continue
		# Continue owning mounts recorded by this package.  A desired mount
		# already present without such a record is user-owned and is preserved,
		# not silently adopted.  Only a missing desired path becomes new
		# package-managed state.
		if line_list_contains "$value" "$TLS_OLD_MOUNTS" ||
		   ! line_list_contains "$value" "$TLS_ORIGINAL_MOUNTS"; then
			append_tls_new_managed_mount "$value"
		fi
	done <<-EOF
	$TLS_DESIRED_MOUNTS
	EOF
}

valid_tls_path_syntax() {
	local value="$1"
	case "$value" in
		""|/|//*|*//*|*/|*[!A-Za-z0-9_./+@%:,=-]*) return 1 ;;
		/*) ;;
		*) return 1 ;;
	esac
	case "${value}/" in
		*/./*|*/../*) return 1 ;;
	esac
}

# Require every ancestor of a root-read file to be root-owned.  Writable
# ancestors are rejected except for the target's top-level /etc (exposed as
# mode 0777 by this rootfs) and the root-owned sticky /tmp used by mktemp.
# ImmortalWrt's fixed /var -> /tmp link is treated exactly like /tmp only when
# its target and dereferenced permissions match that system layout.  Every
# deeper ancestor must be non-writable, and the held-FD identity checks below
# reject replacement before bytes are accepted.
trusted_root_file_source() {
	local value="$1" parent remaining component current="" metadata mode owner
	local links group remainder protected_ancestor=0
	[ -f "$value" ] && [ ! -L "$value" ] && [ -O "$value" ] || return 1
	parent="${value%/*}"
	remaining="${parent#/}"
	while [ -n "$remaining" ]; do
		component="${remaining%%/*}"
		current="${current}/${component}"
		if [ -L "$current" ]; then
			[ "$current" = /var ] || return 1
			case "$(readlink "$current" 2>/dev/null)" in
				tmp|/tmp) ;;
				*) return 1 ;;
			esac
			metadata="$(LC_ALL=C ls -ldnL "$current" 2>/dev/null)" || return 1
		else
			[ -d "$current" ] || return 1
			metadata="$(LC_ALL=C ls -ldn "$current" 2>/dev/null)" || return 1
		fi
		read -r mode links owner group remainder <<-EOF
		$metadata
		EOF
		[ "$owner" = 0 ] || return 1
		case "$mode" in
			?????w*|????????w*)
				case "$current:$mode" in
					/etc:*) ;;
					/tmp:drwxrwxrwt) ;;
					/var:drwxrwxrwt) ;;
					*) return 1 ;;
				esac
				;;
		esac
		case "$current" in /etc|/tmp|/var) ;; *) protected_ancestor=1 ;; esac
		[ "$remaining" = "$component" ] && break
		remaining="${remaining#*/}"
	done
	[ "$protected_ancestor" = 1 ]
}

capture_root_file_bytes() {
	local source="$1" target="$2" blocks="$3"
	trusted_root_file_source "$source" || return 1
	(
		exec 8<"$source" || exit 1
		[ -f /proc/self/fd/8 ] || exit 1
		fd_metadata="$(LC_ALL=C ls -ldnL /proc/self/fd/8 2>/dev/null)" || exit 1
		read -r fd_mode fd_links fd_owner fd_group fd_remainder <<-EOF
		$fd_metadata
		EOF
		case "$fd_mode" in -*) ;; *) exit 1 ;; esac
		[ "$fd_owner" = 0 ] || exit 1
		[ ! -L "$source" ] && [ /proc/self/fd/8 -ef "$source" ] || exit 1
		/usr/bin/timeout -k 1s 5s /bin/dd if=/proc/self/fd/8 \
			bs=4096 count="$blocks" of="$target" 2>/dev/null || exit 1
		[ ! -L "$source" ] && [ /proc/self/fd/8 -ef "$source" ] || exit 1
		trusted_root_file_source "$source"
	)
}

# Copy one TLS file into a root-private regular file with a strict byte and time
# bound.  Workdir material is opened only as uid 853; external root-controlled
# material may be captured as root after the ancestor ownership proof above.
snapshot_tls_file() {
	local source="$1" target="$2" access="$3" size capture_rc=0
	[ ! -e "$target" ] && [ ! -L "$target" ] || return 1
	(umask 077; : >"$target") || return 1
	case "$access" in
		root)
			capture_root_file_bytes "$source" "$target" 257 || capture_rc=$?
			;;
		service)
			/usr/bin/timeout -k 1s 5s \
				/sbin/start-stop-daemon -S -c "${ADGUARD_UID}:${ADGUARD_GID}" \
				-n AGHTLSRead -x /bin/dd -- if="$source" bs=4096 count=257 \
				>"$target" 2>/dev/null || capture_rc=$?
			;;
		*) capture_rc=1 ;;
	esac
	[ "$capture_rc" = 0 ] || {
		rm -f "$target"
		return 1
	}
	size="$(wc -c <"$target" 2>/dev/null)" || return 1
	case "$size" in ""|*[!0-9]*) return 1 ;; esac
	[ "$size" -gt 0 ] && [ "$size" -le "$MAX_TLS_FILE_SIZE" ] || return 1
}

# Resolve one YAML TLS pathname without widening the official service jail.
# /etc/ssl/acme is intentionally file-by-file: a symlink is accepted only when
# its canonical target remains under the acme package's /etc/acme tree.
resolve_tls_path() {
	local value="$1" remainder resolved
	valid_tls_path_syntax "$value" || return 1
	[ -f "$value" ] || return 1
	resolved="$(readlink -f "$value" 2>/dev/null)" || return 1
	[ -f "$resolved" ] || return 1
	case "$value" in
		"${work_dir}"/*)
			case "$resolved" in "${work_dir}"/*) ;; *) return 1 ;; esac
			;;
		/etc/ssl/certs/*)
			case "$resolved" in /etc/ssl/certs/*) ;; *) return 1 ;; esac
			;;
		/etc/ssl/acme/*)
			remainder="${value#/etc/ssl/acme/}"
			case "$remainder" in ""|*/*) return 1 ;; esac
			path_contains_symlink /etc/ssl/acme && return 1
			if [ -L "$value" ]; then
				case "$resolved" in /etc/acme/*) ;; *) return 1 ;; esac
			else
				[ "$resolved" = "$value" ] || return 1
			fi
			append_tls_desired_mount "$value"
			[ "$resolved" = "$value" ] || append_tls_desired_mount "$resolved"
			TLS_USES_ACME=1
			;;
		*) return 1 ;;
	esac
	# Certificate expiry is owned by ACME/the official core and is deliberately
	# not interpreted here.  snapshot_tls_file() separately enforces ordinary
	# file, readability, byte and hard-time bounds before the core is invoked.
	RESOLVED_TLS_PATH="$resolved"
	case "$resolved" in
		"${work_dir}"/*) RESOLVED_TLS_EXTERNAL=0 ;;
		/etc/acme/*|/etc/ssl/acme/*|/etc/ssl/certs/*) RESOLVED_TLS_EXTERNAL=1 ;;
		*) return 1 ;;
	esac
}

tls_file_hash() {
	local directory snapshot digest
	directory="$(mktemp -d /tmp/AdGuardHome-tls-hash.XXXXXX)" || return 1
	snapshot="${directory}/material"
	if ! snapshot_tls_file "$1" "$snapshot" service; then
		rm -rf "$directory"
		return 1
	fi
	digest="$(yaml_file_hash "$snapshot")" || {
		rm -rf "$directory"
		return 1
	}
	rm -rf "$directory" || return 1
	printf '%s\n' "$digest"
}

load_tls_access() {
	local tls_config_file="${1:-$config_file}"
	local enabled certificate_path private_key_path certificate_hash key_hash key_external
	TLS_DESIRED_MOUNTS=""
	TLS_CERT_REAL=""
	TLS_KEY_REAL=""
	TLS_CERT_EXTERNAL=0
	TLS_KEY_EXTERNAL=0
	TLS_USES_ACME=0
	TLS_FINGERPRINT=""

	enabled="$(yaml_get_section_value tls enabled "$tls_config_file")"
	case "$enabled" in
		1|on|true|TRUE|True|yes|YES|Yes) ;;
		0|off|false|FALSE|False|no|NO|No|"") return 0 ;;
		*) return 1 ;;
	esac
	certificate_path="$(yaml_get_section_value tls certificate_path "$tls_config_file")"
	private_key_path="$(yaml_get_section_value tls private_key_path "$tls_config_file")"
	# Inline certificate_chain/private_key needs no host filesystem access.
	[ -n "$certificate_path" ] || [ -n "$private_key_path" ] || return 0
	[ -n "$certificate_path" ] && [ -n "$private_key_path" ] || return 1

	resolve_tls_path "$certificate_path" || return 1
	TLS_CERT_REAL="$RESOLVED_TLS_PATH"
	TLS_CERT_EXTERNAL="$RESOLVED_TLS_EXTERNAL"
	resolve_tls_path "$private_key_path" || return 1
	TLS_KEY_REAL="$RESOLVED_TLS_PATH"
	TLS_KEY_EXTERNAL="$RESOLVED_TLS_EXTERNAL"
	key_external="$RESOLVED_TLS_EXTERNAL"
	# Candidate validation is read-only.  Permission repair occurs only when
	# synchronizing the active YAML, never while parsing an RPC submission.
	[ "${TLS_PREFLIGHT_ONLY:-0}" = 1 ] && return 0
	# External certificate and key material are readable only by root and the
	# official service group.  This is idempotent after ACME renewals (which may
	# recreate either inode as root:root), and neither file is group-writable.
	# Workdir material is never chowned from this root wrapper.
	if [ "$TLS_CERT_EXTERNAL" = 1 ]; then
		chown "0:${ADGUARD_GID}" "$TLS_CERT_REAL" || return 1
		chmod 0640 "$TLS_CERT_REAL" || return 1
	fi
	if [ "$key_external" = 1 ]; then
		chown "0:${ADGUARD_GID}" "$TLS_KEY_REAL" || return 1
		chmod 0640 "$TLS_KEY_REAL" || return 1
	fi

	# Prove that the official uid can read a bounded regular snapshot of both
	# configured files.  This also prevents FIFO/FUSE stalls from holding the
	# integration lock indefinitely.  It does not inspect certificate dates.
	certificate_hash="$(tls_file_hash "$TLS_CERT_REAL")" || return 1
	key_hash="$(tls_file_hash "$TLS_KEY_REAL")" || return 1
	if [ "$TLS_USES_ACME" = 1 ]; then
		TLS_FINGERPRINT="$(printf '%s\n%s\n' "$certificate_hash" "$key_hash" |
			sha256sum 2>/dev/null)" || return 1
		TLS_FINGERPRINT="${TLS_FINGERPRINT%% *}"
		[ "${#TLS_FINGERPRINT}" -eq 64 ] || return 1
		case "$TLS_FINGERPRINT" in *[!0-9a-f]*) return 1 ;; esac
	fi
}

yaml_replace_tls_scalar() {
	local section="$1" key="$2" replacement="$3" file="$4" tmp rc
	tmp="$(mktemp "${file}.tls.XXXXXX")" || return 1
	awk -v section="$section" -v key="$key" -v replacement="$replacement" '
		function top(s) { return s ~ /^[^[:space:]#][^:]*:/ }
		function indent(s) { match(s, /^ */); return RLENGTH }
		function pad(n, s, i) { s=""; for (i=0; i<n; i++) s=s " "; return s }
		{ line[++n]=$0 }
		END {
			for (i=1; i<=n; i++)
				if (line[i] ~ ("^" section ":[[:space:]]*($|#)")) { sections++; first=i }
			if (sections != 1) exit 1
			last=n
			for (i=first+1; i<=n; i++) if (top(line[i])) { last=i-1; break }
			depth=0
			for (i=first+1; i<=last; i++) {
				if (line[i] ~ /^[[:space:]]*($|#)/ || line[i] !~ /^ +/) continue
				d=indent(line[i]); if (!depth || d<depth) depth=d
			}
			if (!depth) depth=2
			for (i=first+1; i<=last; i++) {
				if (indent(line[i]) != depth) continue
				value=substr(line[i], depth+1)
				if (value ~ ("^" key ":[[:space:]]*")) { matches++; found=i }
			}
			if (matches != 1) exit 1
			# TLS paths have already passed the restricted path grammar, which
			# excludes quotes and backslashes.  Quote the scalar so a permitted
			# trailing colon cannot change YAML syntax during normalization.
			line[found]=pad(depth) key ": \"" replacement "\""
			for (i=1; i<=n; i++) print line[i]
		}' "$file" >"$tmp"
	rc=$?
	if [ "$rc" != 0 ] || ! mv "$tmp" "$file"; then
		rm -f "$tmp"
		return 1
	fi
}

prepare_tls_validation_files() {
	local yaml="$1" directory="$2" cert_copy key_copy cert_access key_access rc=0
	TLS_PREFLIGHT_ONLY=1
	load_tls_access "$yaml" || rc=$?
	unset TLS_PREFLIGHT_ONLY
	[ "$rc" = 0 ] || return 1
	[ -n "$TLS_CERT_REAL" ] || return 0
	cert_copy="${directory}/tls-certificate"
	key_copy="${directory}/tls-private-key"
	[ "$TLS_CERT_EXTERNAL" = 1 ] && cert_access=root || cert_access=service
	[ "$TLS_KEY_EXTERNAL" = 1 ] && key_access=root || key_access=service
	snapshot_tls_file "$TLS_CERT_REAL" "$cert_copy" "$cert_access" || return 1
	snapshot_tls_file "$TLS_KEY_REAL" "$key_copy" "$key_access" || return 1
	chown "0:${ADGUARD_GID}" "$cert_copy" "$key_copy" || return 1
	chmod 0640 "$cert_copy" "$key_copy" || return 1
	yaml_replace_tls_scalar tls certificate_path "$cert_copy" "$yaml" || return 1
	yaml_replace_tls_scalar tls private_key_path "$key_copy" "$yaml"
}

load_active_tls_access() {
	local directory snapshot rc=0
	directory="$(mktemp -d /tmp/AdGuardHome-tls.XXXXXX)" || return 1
	snapshot="${directory}/AdGuardHome.yaml"
	if ! snapshot_config_file "$config_file" "$snapshot" "" "" ||
	   ! load_tls_access "$snapshot"; then
		rc=1
	fi
	rm -rf "$directory" || return 1
	return "$rc"
}

write_mount_list() {
	local target="$1" item list="$2"
	[ -n "$list" ] || return 0
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		uci -q add_list "${target}=${item}" || return 1
	done <<-EOF
	$list
	EOF
}

sync_tls_access() {
	local expected current_fingerprint official_changed=0 legacy_changed=0
	load_active_tls_access || {
		log_error "TLS certificate or private-key path is unsafe or unavailable"
		return 1
	}

	TLS_OLD_MOUNTS=""
	TLS_ORIGINAL_MOUNTS=""
	TLS_PRESERVED_MOUNTS=""
	config_load "$LEGACY_CONFIG" || return 1
	config_list_foreach "$LEGACY_SECTION" "$MANAGED_JAIL_OPTION" collect_tls_old_mount
	config_load "$OFFICIAL_CONFIG" || return 1
	config_list_foreach "$OFFICIAL_SECTION" jail_mount collect_tls_official_mount
	derive_tls_new_managed_mounts

	expected="$TLS_PRESERVED_MOUNTS"
	if [ -n "$TLS_NEW_MANAGED_MOUNTS" ]; then
		if [ -n "$expected" ]; then
			expected="${expected}
${TLS_NEW_MANAGED_MOUNTS}"
		else
			expected="$TLS_NEW_MANAGED_MOUNTS"
		fi
	fi
	if [ "$TLS_ORIGINAL_MOUNTS" != "$expected" ]; then
		uci -q delete "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.jail_mount" 2>/dev/null || true
		write_mount_list "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.jail_mount" "$expected" || return 1
		official_changed=1
	fi
	if [ "$TLS_OLD_MOUNTS" != "$TLS_NEW_MANAGED_MOUNTS" ]; then
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_JAIL_OPTION}" 2>/dev/null || true
		write_mount_list "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_JAIL_OPTION}" \
			"$TLS_NEW_MANAGED_MOUNTS" || return 1
		legacy_changed=1
	fi

	current_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}")"
	if [ -n "$TLS_FINGERPRINT" ]; then
		if [ "$current_fingerprint" != "$TLS_FINGERPRINT" ]; then
			uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}=${TLS_FINGERPRINT}" || return 1
			legacy_changed=1
		fi
	elif [ -n "$current_fingerprint" ]; then
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}" || return 1
		legacy_changed=1
	fi
	[ "$official_changed" = 0 ] || uci -q commit "$OFFICIAL_CONFIG" || return 1
	[ "$legacy_changed" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1
}

sync_official_uci() {
	UCI_CHANGED=0
	if ! uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}" >/dev/null 2>&1; then
		uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}=adguardhome" || return 1
		UCI_CHANGED=1
	fi
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" enabled "$legacy_enabled" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" config_file "$config_file" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" work_dir "$work_dir" || return 1
	uci_set_if_changed "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" verbose "$verbose" || return 1
	uci_delete_if_present "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" config || return 1
	uci_delete_if_present "$OFFICIAL_CONFIG" "$OFFICIAL_SECTION" workdir || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$OFFICIAL_CONFIG" || return 1
	sync_tls_access
}

disable_official_autostart() {
	[ "$(uci -q get "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled")" = 0 ] && return 0
	uci -q set "${OFFICIAL_CONFIG}.${OFFICIAL_SECTION}.enabled=0" || return 1
	uci -q commit "$OFFICIAL_CONFIG"
}

reload_service_if_present() {
	local service="$1" action="$2"
	[ "${RELOAD_SERVICES:-1}" = 0 ] && return 0
	[ -x "$service" ] || return 0
	"$service" "$action" >/dev/null 2>&1
}

remember_first_dnsmasq() {
	DNSMASQ_COUNT=$((DNSMASQ_COUNT + 1))
	[ -n "$DNSMASQ_SECTION" ] || DNSMASQ_SECTION="$1"
}

load_dnsmasq_section() {
	DNSMASQ_SECTION=""
	DNSMASQ_UCI=""
	DNSMASQ_COUNT=0
	config_load dhcp || return 1
	config_foreach remember_first_dnsmasq dnsmasq
	[ -n "$DNSMASQ_SECTION" ] || return 1
	if [ "$DNSMASQ_COUNT" -ne 1 ]; then
		log_error "dnsmasq-upstream mode requires exactly one dnsmasq instance; found ${DNSMASQ_COUNT}"
		return 1
	fi
	DNSMASQ_UCI="dhcp.${DNSMASQ_SECTION}"
}

load_snapshot_dnsmasq_section() {
	local recorded
	recorded="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_DNSMASQ_SECTION}")"
	if [ -n "$recorded" ] && uci -q get "dhcp.${recorded}" >/dev/null 2>&1; then
		DNSMASQ_SECTION="$recorded"
		DNSMASQ_UCI="dhcp.${recorded}"
		return 0
	fi
	load_dnsmasq_section
}

dnsmasq_managed_fingerprint() {
	local section_dump managed digest
	section_dump="$(uci -q show "$DNSMASQ_UCI" 2>/dev/null)" || return 1
	managed="$(printf '%s\n' "$section_dump" |
		awk '/\.(server|noresolv|resolvfile)=/')" || return 1
	digest="$(printf '%s\n' "$managed" | sha256sum 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		""|*[!0-9A-Fa-f]*) return 1 ;;
	esac
	[ "${#digest}" -eq 64 ] || return 1
	printf '%s\n' "$digest"
}

# Entries beginning with /domain/ are conditional.  /#/ is dnsmasq's catch-all
# syntax, so it is a generic upstream and must not bypass AdGuard Home.
is_conditional_dnsmasq_server() {
	case "$1" in
		/#/*) return 1 ;;
		/*/*) return 0 ;;
		*) return 1 ;;
	esac
}

snapshot_server_value() {
	uci -q add_list "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_SERVER}=$1" || SNAPSHOT_ERROR=1
}

snapshot_dnsmasq_state() {
	local value option
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] && return 0
	load_dnsmasq_section || return 1

	for option in "$SNAPSHOT_MARKER" "$SNAPSHOT_DNSMASQ_SECTION" "$SNAPSHOT_ACTIVE_FINGERPRINT" "$SNAPSHOT_SERVER" \
		"$SNAPSHOT_NORESOLV_PRESENT" "$SNAPSHOT_NORESOLV_VALUE" \
		"$SNAPSHOT_RESOLVFILE_PRESENT" "$SNAPSHOT_RESOLVFILE_VALUE"; do
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${option}" >/dev/null 2>&1 || true
	done
	if value="$(uci -q get "${DNSMASQ_UCI}.noresolv")"; then
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}=1" || return 1
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_VALUE}=${value}" || return 1
	else
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}=0" || return 1
	fi
	if value="$(uci -q get "${DNSMASQ_UCI}.resolvfile")"; then
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}=1" || return 1
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_VALUE}=${value}" || return 1
	else
		uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}=0" || return 1
	fi

	SNAPSHOT_ERROR=0
	config_list_foreach "$DNSMASQ_SECTION" server snapshot_server_value
	[ "$SNAPSHOT_ERROR" = 0 ] || return 1
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_DNSMASQ_SECTION}=${DNSMASQ_SECTION}" || return 1
	# Publish the marker last so an interrupted, incomplete snapshot is never
	# treated as authoritative during recovery.
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}=1" || return 1
	uci -q commit "$LEGACY_CONFIG"
}

add_conditional_snapshot_server() {
	is_conditional_dnsmasq_server "$1" || return 0
	uci -q add_list "${DNSMASQ_UCI}.server=$1" || DNSMASQ_LIST_ERROR=1
}

restore_snapshot_server() {
	uci -q add_list "${DNSMASQ_UCI}.server=$1" || DNSMASQ_LIST_ERROR=1
}

clear_dnsmasq_snapshot_metadata() {
	local option
	for option in "$SNAPSHOT_DNSMASQ_SECTION" "$SNAPSHOT_ACTIVE_FINGERPRINT" "$SNAPSHOT_SERVER" \
		"$SNAPSHOT_NORESOLV_PRESENT" "$SNAPSHOT_NORESOLV_VALUE" \
		"$SNAPSHOT_RESOLVFILE_PRESENT" "$SNAPSHOT_RESOLVFILE_VALUE"; do
		uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${option}" >/dev/null 2>&1 || true
	done
	uci -q delete "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}" || return 1
	uci -q commit "$LEGACY_CONFIG"
}

restore_dnsmasq_snapshot() {
	local present value expected_fingerprint current_fingerprint
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] || return 0
	load_snapshot_dnsmasq_section || return 1
	expected_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}")"
	if [ -n "$expected_fingerprint" ]; then
		current_fingerprint="$(dnsmasq_managed_fingerprint)" || return 1
		if [ "$current_fingerprint" != "$expected_fingerprint" ]; then
			log_error "dnsmasq settings changed while AdGuard Home integration was active; refusing to overwrite them"
			return 1
		fi
	fi
	uci -q delete "${DNSMASQ_UCI}.server" >/dev/null 2>&1 || true
	config_load "$LEGACY_CONFIG" || return 1
	DNSMASQ_LIST_ERROR=0
	config_list_foreach "$LEGACY_SECTION" "$SNAPSHOT_SERVER" restore_snapshot_server
	[ "$DNSMASQ_LIST_ERROR" = 0 ] || return 1

	present="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_PRESENT}")"
	if [ "$present" = 1 ]; then
		value="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_NORESOLV_VALUE}")"
		uci -q set "${DNSMASQ_UCI}.noresolv=${value}" || return 1
	else
		uci -q delete "${DNSMASQ_UCI}.noresolv" >/dev/null 2>&1 || true
	fi
	present="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_PRESENT}")"
	if [ "$present" = 1 ]; then
		value="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_RESOLVFILE_VALUE}")"
		uci -q set "${DNSMASQ_UCI}.resolvfile=${value}" || return 1
	else
		uci -q delete "${DNSMASQ_UCI}.resolvfile" >/dev/null 2>&1 || true
	fi
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart || return 1
	clear_dnsmasq_snapshot_metadata
}

mark_generic_server() {
	is_conditional_dnsmasq_server "$1" && return 0
	GENERIC_SERVER_FOUND=1
}

# Best-effort cleanup for state created by releases predating snapshots.
clear_legacy_dnsmasq_upstream() {
	local upstream="127.0.0.1#${1}" resolvfile
	load_dnsmasq_section || return 1
	uci -q del_list "${DNSMASQ_UCI}.server=${upstream}" >/dev/null 2>&1 || true
	# Refresh the shell-side UCI cache before deciding whether any generic
	# upstream remains; otherwise the just-deleted legacy entry is still seen.
	config_load dhcp || return 1
	GENERIC_SERVER_FOUND=0
	config_list_foreach "$DNSMASQ_SECTION" server mark_generic_server
	if [ "$GENERIC_SERVER_FOUND" = 0 ]; then
		resolvfile="/tmp/resolv.conf.d/resolv.conf.auto"
		[ -f "$resolvfile" ] || resolvfile="/tmp/resolv.conf.auto"
		uci -q set "${DNSMASQ_UCI}.resolvfile=${resolvfile}" || return 1
		uci -q delete "${DNSMASQ_UCI}.noresolv" >/dev/null 2>&1 || true
	fi
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

set_dnsmasq_upstream() {
	local upstream="127.0.0.1#${dns_port}" fingerprint
	snapshot_dnsmasq_state || return 1
	uci -q delete "${DNSMASQ_UCI}.server" >/dev/null 2>&1 || true
	config_load "$LEGACY_CONFIG" || return 1
	DNSMASQ_LIST_ERROR=0
	config_list_foreach "$LEGACY_SECTION" "$SNAPSHOT_SERVER" add_conditional_snapshot_server
	[ "$DNSMASQ_LIST_ERROR" = 0 ] || return 1
	uci -q add_list "${DNSMASQ_UCI}.server=${upstream}" || return 1
	uci -q set "${DNSMASQ_UCI}.noresolv=1" || return 1
	uci -q commit dhcp || return 1
	fingerprint="$(dnsmasq_managed_fingerprint)" || return 1
	uci -q set "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}=${fingerprint}" || return 1
	uci -q commit "$LEGACY_CONFIG" || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

inspect_active_server() {
	if is_conditional_dnsmasq_server "$1"; then return 0; fi
	if [ "$1" = "$EXPECTED_UPSTREAM" ]; then
		EXPECTED_UPSTREAM_COUNT=$((EXPECTED_UPSTREAM_COUNT + 1))
	else
		UNEXPECTED_GENERIC_SERVER=1
	fi
}

dnsmasq_integration_matches() {
	EXPECTED_UPSTREAM="127.0.0.1#${dns_port}"
	EXPECTED_UPSTREAM_COUNT=0
	UNEXPECTED_GENERIC_SERVER=0
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ] || return 1
	load_snapshot_dnsmasq_section || return 1
	[ "$(uci -q get "${DNSMASQ_UCI}.noresolv")" = 1 ] || return 1
	[ "$(dnsmasq_managed_fingerprint)" = "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_ACTIVE_FINGERPRINT}")" ] || return 1
	config_load dhcp || return 1
	config_list_foreach "$DNSMASQ_SECTION" server inspect_active_server
	[ "$EXPECTED_UPSTREAM_COUNT" = 1 ] && [ "$UNEXPECTED_GENERIC_SERVER" = 0 ]
}

set_firewall_redirect() {
	local section="firewall.${FIREWALL_SECTION}" owner family=ipv4
	if uci -q get "$section" >/dev/null 2>&1; then
		owner="$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")"
		if [ "$owner" != "$FIREWALL_OWNER_VALUE" ]; then
			log_error "Refusing to overwrite the existing firewall.${FIREWALL_SECTION} section"
			return 1
		fi
	fi
	uci -q set "${section}=redirect" || return 1
	uci -q set "${section}.${FIREWALL_OWNER_OPTION}=${FIREWALL_OWNER_VALUE}" || return 1
	uci -q set "${section}.src=lan" || return 1
	uci -q set "${section}.proto=tcp udp" || return 1
	uci -q set "${section}.src_dport=53" || return 1
	uci -q set "${section}.dest_port=${dns_port}" || return 1
	uci -q set "${section}.target=DNAT" || return 1
	# Redirect IPv6 only when the supervised core actually owns an IPv6 DNS
	# socket; otherwise leave IPv6 port 53 with dnsmasq instead of black-holing it.
	dns_ipv6_listening && family=any
	uci -q set "${section}.family=${family}" || return 1
	uci -q set "${section}.reflection=0" || return 1
	uci -q commit firewall || return 1
	reload_service_if_present /etc/init.d/firewall reload
}

clear_firewall_redirect() {
	local force_reload="$1" existed=0 section="firewall.${FIREWALL_SECTION}" owner
	if uci -q get "$section" >/dev/null 2>&1; then
		owner="$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")"
		if [ "$owner" != "$FIREWALL_OWNER_VALUE" ]; then
			if [ "$force_reload" = 1 ]; then
				log_error "The recorded redirect is not owned by this package; refusing to delete it"
				return 1
			fi
			return 0
		fi
		existed=1
		uci -q delete "$section" || return 1
		uci -q commit firewall || return 1
	fi
	[ "$existed" = 1 ] || [ "$force_reload" = 1 ] || return 0
	reload_service_if_present /etc/init.d/firewall reload
}

firewall_integration_matches() {
	local section="firewall.${FIREWALL_SECTION}" expected_family=ipv4
	dns_ipv6_listening && expected_family=any
	[ "$(uci -q get "$section")" = redirect ] &&
		[ "$(uci -q get "${section}.${FIREWALL_OWNER_OPTION}")" = "$FIREWALL_OWNER_VALUE" ] &&
		[ "$(uci -q get "${section}.src")" = lan ] &&
		[ "$(uci -q get "${section}.proto")" = "tcp udp" ] &&
		[ "$(uci -q get "${section}.src_dport")" = 53 ] &&
		[ "$(uci -q get "${section}.dest_port")" = "$dns_port" ] &&
		[ "$(uci -q get "${section}.target")" = DNAT ] &&
		[ "$(uci -q get "${section}.family")" = "$expected_family" ] &&
		[ "$(uci -q get "${section}.reflection")" = 0 ]
}

clear_exchange_mode() {
	local current_port
	load_dnsmasq_section || return 1
	current_port="$(uci -q get "${DNSMASQ_UCI}.port")"
	[ "$current_port" = 53 ] && return 0
	uci -q set "${DNSMASQ_UCI}.port=53" || return 1
	uci -q commit dhcp || return 1
	reload_service_if_present /etc/init.d/dnsmasq restart
}

record_redirect_state() {
	local active="$1"
	UCI_CHANGED=0
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_redirect "$redirect_mode" || return 1
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_port "$dns_port" || return 1
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_enabled "$active" || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1
	printf '%s' "$active" >/var/run/AdGredir 2>/dev/null || true
}

record_redirect_inactive() {
	UCI_CHANGED=0
	uci_set_if_changed "$LEGACY_CONFIG" "$LEGACY_SECTION" old_enabled 0 || return 1
	[ "$UCI_CHANGED" = 0 ] || uci -q commit "$LEGACY_CONFIG" || return 1
	printf '0' >/var/run/AdGredir 2>/dev/null || true
}

clear_recorded_integration_locked() {
	local old_redirect old_port old_enabled force_firewall_reload=0
	old_redirect="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_redirect")"
	old_port="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_port")"
	old_enabled="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_enabled")"

	# Snapshot presence takes precedence over possibly stale old_* fields.  The
	# marker is deleted only after dnsmasq has accepted the restored state.
	if [ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${SNAPSHOT_MARKER}")" = 1 ]; then
		restore_dnsmasq_snapshot || return 1
	elif [ "$old_enabled" = 1 ] && [ "$old_redirect" = dnsmasq-upstream ]; then
		is_valid_port "$old_port" || return 1
		clear_legacy_dnsmasq_upstream "$old_port" || return 1
	fi

	[ "$old_enabled" = 1 ] && [ "$old_redirect" = redirect ] && force_firewall_reload=1
	if [ "$(uci -q get "firewall.${FIREWALL_SECTION}.${FIREWALL_OWNER_OPTION}")" = "$FIREWALL_OWNER_VALUE" ] ||
	   [ "$force_firewall_reload" = 1 ]; then
		clear_firewall_redirect "$force_firewall_reload" || return 1
	fi

	if [ "$old_enabled" = 1 ] && [ "$old_redirect" = exchange ]; then
		clear_exchange_mode || return 1
	fi
	record_redirect_inactive
}

runtime_settings_match() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3"
	load_legacy_settings || return 1
	[ "$legacy_enabled" = 1 ] || return 1
	load_runtime_dns_port || return 1
	[ "$dns_port" = "$expected_port" ] &&
		[ "$redirect_mode" = "$expected_mode" ] &&
		[ "$work_dir" = "$expected_work_dir" ]
}

apply_integration_locked() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3" result=0
	if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	dns_port="$expected_port"
	redirect_mode="$expected_mode"
	work_dir="$expected_work_dir"
	if ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	# A cleanup failure is terminal.  Never layer a new mode over live old state.
	clear_recorded_integration_locked || return 1
	case "$redirect_mode" in
		redirect) set_firewall_redirect || result=1 ;;
		dnsmasq-upstream) set_dnsmasq_upstream || result=1 ;;
		none) ;;
	esac
	if [ "$result" != 0 ]; then
		log_error "Unable to apply ${redirect_mode}; restoring the resolver state"
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! record_redirect_state 1; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	# YAML may be rewritten by the official Web UI while the resolver reloads.
	# Roll back immediately unless this exact port/mode/workdir is still current.
	if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir" ||
	   ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
}

integration_matches_desired() {
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_enabled")" = 1 ] || return 1
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_redirect")" = "$redirect_mode" ] || return 1
	[ "$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.old_port")" = "$dns_port" ] || return 1
	case "$redirect_mode" in
		dnsmasq-upstream) dnsmasq_integration_matches ;;
		redirect) firewall_integration_matches ;;
		none) return 0 ;;
	esac
}

official_running() {
	[ -x "$OFFICIAL_SERVICE" ] && "$OFFICIAL_SERVICE" running >/dev/null 2>&1
}

official_pid() {
	ubus -S call service list '{"name":"adguardhome"}' 2>/dev/null |
		jsonfilter -e '@.adguardhome.instances.*.pid' 2>/dev/null |
		awk 'NR == 1 && $1 ~ /^[0-9]+$/ { print $1; exit }'
}

pid_is_supervised_descendant() {
	local candidate="$1" supervisor="$2" parent depth=0
	case "$candidate:$supervisor" in
		*[!0-9:]*) return 1 ;;
	esac
	while [ "$depth" -lt 64 ]; do
		[ "$candidate" = "$supervisor" ] && return 0
		[ -r "/proc/${candidate}/status" ] || return 1
		parent="$(awk '$1 == "PPid:" { print $2; exit }' "/proc/${candidate}/status")"
		case "$parent" in
			""|*[!0-9]*) return 1 ;;
		esac
		[ "$parent" -gt 1 ] 2>/dev/null || return 1
		[ "$parent" != "$candidate" ] || return 1
		candidate="$parent"
		depth=$((depth + 1))
	done
	return 1
}

# Verify that a socket in the requested kernel table belongs to the PID
# supervised by the official service.  An unrelated listener on the same port
# must never trigger DNS takeover.  Address modes additionally restrict a
# socket to a loopback-reachable or wildcard bind appropriate for the selected
# integration mode.
official_owns_socket() {
	local table="$1" address_mode="$2" expected_state supervisor pid executable port_hex inode fd link
	[ -r "$table" ] || return 1
	case "$table" in
		/proc/net/tcp|/proc/net/tcp6) expected_state=0A ;;
		/proc/net/udp|/proc/net/udp6) expected_state=07 ;;
		*) return 1 ;;
	esac
	supervisor="$(official_pid)"
	case "$supervisor" in ""|*[!0-9]*) return 1 ;; esac
	port_hex="$(printf '%04X' "$dns_port")" || return 1
	# With procd_add_jail(), ubus reports the outer ujail PID.  Accept only an
	# AdGuardHome process whose ancestor chain reaches that exact supervisor.
	for pid in $(pidof AdGuardHome 2>/dev/null); do
		pid_is_supervised_descendant "$pid" "$supervisor" || continue
		executable="$(readlink "/proc/${pid}/exe" 2>/dev/null)" || continue
		case "$executable" in
			"$CORE_BINARY"|"$CORE_BINARY (deleted)") ;;
			*) continue ;;
		esac
		[ -d "/proc/${pid}/fd" ] || continue
		for inode in $(awk -v wanted="$port_hex" -v mode="$address_mode" \
			-v wanted_state="$expected_state" '
			NR > 1 {
				split($2,a,":")
				address=toupper(a[1])
				if (toupper(a[2]) != wanted) next
				if (toupper($4) != wanted_state) next
				if (mode == "ipv4-loopback" &&
				    address != "00000000" && address != "0100007F") next
				if (mode == "ipv4-wildcard" && address != "00000000") next
				if (mode == "ipv6-wildcard" &&
				    address != "00000000000000000000000000000000") next
				print $10
			}' "$table"); do
			for fd in "/proc/${pid}/fd/"*; do
				link="$(readlink "$fd" 2>/dev/null)" || continue
				[ "$link" = "socket:[${inode}]" ] && return 0
			done
		done
	done
	return 1
}

# AdGuard Home 0.107.76 uses Go's dual-stack wildcard listeners, so an IPv4
# unspecified bind may appear only in the IPv6 kernel table.  Accept that exact
# supervised wildcard fallback, but never an IPv6 loopback or interface-only
# address.  This is intentionally tied to the package's >=0.107.76 baseline.
official_owns_ipv4_reachable_socket() {
	local ipv4_table="$1" ipv6_table="$2" ipv4_mode="$3"
	official_owns_socket "$ipv4_table" "$ipv4_mode" && return 0
	official_owns_socket "$ipv6_table" ipv6-wildcard
}

dns_port_listening() {
	if [ "$redirect_mode" = dnsmasq-upstream ]; then
		# dnsmasq is configured with 127.0.0.1#port.  Require both UDP and
		# TCP on an IPv4-reachable loopback/wildcard listener before
		# disabling its normal resolvers; a LAN-only listener is unreachable.
		official_owns_ipv4_reachable_socket \
			/proc/net/udp /proc/net/udp6 ipv4-loopback &&
			official_owns_ipv4_reachable_socket \
			/proc/net/tcp /proc/net/tcp6 ipv4-loopback
		return
	fi
	if [ "$redirect_mode" = redirect ]; then
		# A firewall DNAT can arrive on any LAN address and captures both
		# transports.  Only IPv4-reachable wildcard UDP+TCP sockets are safe.
		official_owns_ipv4_reachable_socket \
			/proc/net/udp /proc/net/udp6 ipv4-wildcard &&
			official_owns_ipv4_reachable_socket \
			/proc/net/tcp /proc/net/tcp6 ipv4-wildcard
		return
	fi
	(official_owns_socket /proc/net/udp any ||
		official_owns_socket /proc/net/udp6 any) &&
		(official_owns_socket /proc/net/tcp any ||
		official_owns_socket /proc/net/tcp6 any)
}

dns_ipv6_listening() {
	# family=any redirects both UDP and TCP to every local IPv6 address.
	official_owns_socket /proc/net/udp6 ipv6-wildcard &&
		official_owns_socket /proc/net/tcp6 ipv6-wildcard
}

web_listening() {
	local port="$1"
	is_valid_port "$port" || return 1
	official_running || return 1
	dns_port="$port"
	if official_owns_socket /proc/net/tcp any ||
	   official_owns_socket /proc/net/tcp6 any; then
		return 0
	fi
	return 1
}

wait_for_core_ready() {
	local expected_port="$1" expected_mode="$2" expected_work_dir="$3"
	local elapsed=0 stable=0
	dns_port="$expected_port"
	redirect_mode="$expected_mode"
	work_dir="$expected_work_dir"
	while [ "$elapsed" -lt "$READY_TIMEOUT" ]; do
		if ! runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir"; then
			log_error "AdGuard Home runtime settings changed while waiting for DNS readiness"
			return 1
		fi
		dns_port="$expected_port"
		redirect_mode="$expected_mode"
		work_dir="$expected_work_dir"
		if official_running && dns_port_listening; then
			stable=$((stable + 1))
			if [ "$stable" -ge "$READY_STABLE_COUNT" ]; then
				runtime_settings_match "$expected_port" "$expected_mode" "$expected_work_dir" &&
					dns_port_listening
				return
			fi
		else
			stable=0
		fi
		sleep 1
		elapsed=$((elapsed + 1))
	done
	log_error "Core did not remain ready on DNS port ${dns_port} within ${READY_TIMEOUT}s"
	return 1
}

wait_for_core_stopped() {
	local elapsed=0
	while [ "$elapsed" -lt 10 ]; do
		official_running || return 0
		sleep 1
		elapsed=$((elapsed + 1))
	done
	return 1
}

yaml_file_hash() {
	local digest
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	digest="$(sha256sum "$1" 2>/dev/null)" || return 1
	digest="${digest%% *}"
	case "$digest" in
		????????????????????????????????????????????????????????????????)
			case "$digest" in *[!0-9a-f]*) return 1 ;; esac
			printf '%s\n' "$digest"
			;;
		*) return 1 ;;
	esac
}

validate_yaml_stage() {
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local name token fd_path
	case "$expected_hash" in
		????????????????????????????????????????????????????????????????)
			case "$expected_hash" in *[!0-9a-f]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
	case "$candidate_hash" in
		????????????????????????????????????????????????????????????????)
			case "$candidate_hash" in *[!0-9a-f]*) return 1 ;; esac
			;;
		*) return 1 ;;
	esac
	[ "${stage%/*}" = "$work_dir" ] || return 1
	name="${stage##*/}"
	case "$name" in AdGuardHome.yaml.luci-*) ;; *) return 1 ;; esac
	token="${name#AdGuardHome.yaml.luci-}"
	[ "${#token}" -eq 32 ] || return 1
	case "$token" in *[!0-9a-f]*) return 1 ;; esac
	[ -f "$stage" ] && [ ! -L "$stage" ] || return 1
	[ -f "$config_file" ] && [ ! -L "$config_file" ] || return 1
	path_contains_symlink "$work_dir" && return 1
	case "$inherited_fd" in ""|*[!0-9]*) return 1 ;; esac
	[ "$inherited_fd" -ge 3 ] 2>/dev/null || return 1
	fd_path="/proc/self/fd/${inherited_fd}"
	[ -f "$fd_path" ] && [ "$fd_path" -ef "$stage" ]
}

active_config_hash() (
	local directory snapshot
	directory="$(mktemp -d /tmp/AdGuardHome-hash.XXXXXX)" || exit 1
	trap 'rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"
	snapshot_config_file "$config_file" "$snapshot" "" "" || exit 1
	printf '%s\n' "$SNAPSHOT_CONFIG_HASH"
)

held_config_hash() (
	local expected_hash="$1" inherited_fd="$2" allow_detached="$3"
	local directory snapshot
	directory="$(mktemp -d /tmp/AdGuardHome-held-hash.XXXXXX)" || exit 1
	trap 'rm -rf "$directory"' EXIT
	snapshot="${directory}/AdGuardHome.yaml"
	snapshot_config_file "$config_file" "$snapshot" \
		"$expected_hash" "$inherited_fd" "$allow_detached" || exit 1
	printf '%s\n' "$SNAPSHOT_CONFIG_HASH"
)

resume_yaml_runtime() {
	local was_running="$1"
	[ "$was_running" = 1 ] || return 0
	load_legacy_settings || return 1
	[ "$legacy_enabled" = 1 ] || return 0
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	if ! official_running; then
		"$OFFICIAL_SERVICE" start >/dev/null 2>&1 || return 1
	fi
	wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || return 1
	apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
}

rollback_yaml_update() {
	local backup="$1" was_running="$2"
	clear_recorded_integration_locked >/dev/null 2>&1 || true
	if official_running; then
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	[ -f "$backup" ] && [ ! -L "$backup" ] || return 1
	[ ! -L "$config_file" ] || return 1
	restore_yaml_backup "$backup" || return 1
	secure_active_config || return 1
	load_legacy_settings || return 1
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	resume_yaml_runtime "$was_running" || return 1
	remove_yaml_backup "$backup"
}

remove_yaml_backup() {
	local backup="$1" directory
	directory="${backup%/*}"
	case "$backup" in
		/tmp/AdGuardHome-yaml-backup.??????/AdGuardHome.yaml) ;;
		*) return 1 ;;
	esac
	rm -f "$backup" || return 1
	rmdir "$directory" 2>/dev/null || return 1
}

cleanup_yaml_update() {
	[ -z "$YAML_STAGE_CLEANUP" ] || rm -f "$YAML_STAGE_CLEANUP"
	[ -z "$YAML_BACKUP_CLEANUP" ] ||
		remove_yaml_backup "$YAML_BACKUP_CLEANUP" >/dev/null 2>&1 || true
}

attempt_yaml_rollback() {
	local backup="$1" was_running="$2"
	if rollback_yaml_update "$backup" "$was_running" >/dev/null 2>&1; then
		YAML_BACKUP_CLEANUP=""
		YAML_INSTALLED=0
		YAML_RUNTIME_PAUSED=0
		return 0
	fi
	# Never let the EXIT cleanup destroy the sole known-good copy if restoring
	# it failed before the atomic move.  Its fixed prefix and 0600 mode make it
	# available for explicit administrator recovery without exposing contents.
	if [ -f "$backup" ] && [ ! -L "$backup" ]; then
		chmod 0600 "$backup" >/dev/null 2>&1 || true
		YAML_BACKUP_CLEANUP=""
		log_error "Preserved the previous YAML after rollback failure: ${backup}"
	fi
	return 1
}

abort_yaml_update() {
	# Ignore a second termination signal while restoring the sole known-good
	# runtime; interruption here could otherwise defeat the recovery trap itself.
	trap '' HUP INT QUIT TERM
	if [ "${YAML_INSTALLED:-0}" = 1 ] && [ -n "$YAML_BACKUP_CLEANUP" ]; then
		attempt_yaml_rollback "$YAML_BACKUP_CLEANUP" "$YAML_WAS_RUNNING" || true
	elif [ "${YAML_RUNTIME_PAUSED:-0}" = 1 ]; then
		resume_yaml_runtime "$YAML_WAS_RUNNING" >/dev/null 2>&1 ||
			log_error "Unable to restore the interrupted YAML runtime"
	fi
	exit 1
}

resume_paused_yaml_runtime() {
	if resume_yaml_runtime "$YAML_WAS_RUNNING"; then
		YAML_RUNTIME_PAUSED=0
		return 0
	fi
	return 1
}

# The RPC layer creates a same-directory O_EXCL staging file and invokes this
# transaction without a shell.  Revalidate everything under the integration
# lock, validate a disposable candidate, stop the sole YAML writer, then make
# the final optimistic-lock comparison before the atomic rename.
yaml_update_locked() (
	local expected_hash="$1" candidate_hash="$2" stage="$3" inherited_fd="$4"
	local before_hash final_hash verify_hash held_hash fd_path
	local committed_port committed_mode committed_work_dir committed_tls_mounts
	local was_running=0 backup="" backup_directory=""
	load_legacy_settings || return 1
	validate_yaml_stage "$expected_hash" "$candidate_hash" "$stage" \
		"$inherited_fd" || return 1
	YAML_STAGE_CLEANUP="$stage"
	YAML_BACKUP_CLEANUP=""
	YAML_INSTALLED=0
	YAML_WAS_RUNNING=0
	YAML_RUNTIME_PAUSED=0
	trap cleanup_yaml_update EXIT
	trap abort_yaml_update HUP INT QUIT TERM

	before_hash="$(active_config_hash)" || return 1
	[ "$before_hash" = "$expected_hash" ] || return 1
	check_core_config_file "$stage" "$candidate_hash" "$inherited_fd" || {
		log_error "AdGuard Home rejected the staged LuCI YAML"
		return 1
	}
	official_running && was_running=1
	YAML_WAS_RUNNING="$was_running"
	YAML_RUNTIME_PAUSED=1

	# Resolver takeover must be removed before the listener is stopped.  A
	# cleanup failure leaves the working core and active YAML untouched.
	if ! clear_recorded_integration_locked; then
		resume_paused_yaml_runtime >/dev/null 2>&1 ||
			log_error "Unable to restore the YAML runtime after integration cleanup failed"
		return 1
	fi
	if [ "$was_running" = 1 ]; then
		if ! "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || ! wait_for_core_stopped; then
			resume_paused_yaml_runtime >/dev/null 2>&1 ||
				log_error "Unable to restore the YAML runtime after stop failed"
			return 1
		fi
	fi
	final_hash="$(active_config_hash)" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	if [ "$final_hash" != "$expected_hash" ] ||
	   ! validate_yaml_stage "$expected_hash" "$candidate_hash" "$stage" \
		"$inherited_fd"; then
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	fi
	check_core_config_file "$stage" "$candidate_hash" "$inherited_fd" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}

	backup_directory="$(mktemp -d /tmp/AdGuardHome-yaml-backup.XXXXXX)" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	backup="${backup_directory}/AdGuardHome.yaml"
	YAML_BACKUP_CLEANUP="$backup"
	# Create the rollback image through the same bounded, lowered snapshot path
	# and recheck its optimistic hash.  Never let root cp a replaceable active
	# pathname after the core validation window.
	snapshot_config_file "$config_file" "$backup" "$expected_hash" || {
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	}
	YAML_INSTALLED=1
	if ! mv "$stage" "$config_file"; then
		YAML_INSTALLED=0
		resume_paused_yaml_runtime >/dev/null 2>&1 || true
		return 1
	fi
	YAML_STAGE_CLEANUP=""
	fd_path="/proc/self/fd/${inherited_fd}"
	if [ ! -f "$fd_path" ] || [ ! "$fd_path" -ef "$config_file" ] ||
	   ! secure_config_inode "$fd_path"; then
		log_error "The installed LuCI YAML no longer matches its held descriptor"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi

	if ! secure_active_paths ||
	   ! check_core_config_file "$config_file" "$candidate_hash" "$inherited_fd" 1 ||
	   ! load_runtime_dns_port ||
	   ! sync_official_uci; then
		log_error "Unable to activate the LuCI YAML; restoring the previous file"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi
	committed_port="$dns_port"
	committed_mode="$redirect_mode"
	committed_work_dir="$work_dir"
	committed_tls_mounts="$TLS_DESIRED_MOUNTS"
	if [ "$legacy_enabled" = 1 ]; then
		if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1 ||
		   ! wait_for_core_ready "$committed_port" "$committed_mode" "$committed_work_dir" ||
		   ! apply_integration_locked "$committed_port" "$committed_mode" "$committed_work_dir"; then
			log_error "The edited YAML failed at runtime; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
	fi
	YAML_RUNTIME_PAUSED=0

	held_hash="$(held_config_hash "$candidate_hash" "$inherited_fd" 1)" || {
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	}
	if [ "$held_hash" != "$candidate_hash" ]; then
		log_error "The submitted YAML changed while its transaction was running"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	fi
	final_hash="$(active_config_hash)" || {
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	}
	if [ "$legacy_enabled" = 1 ]; then
		# The official core owns the work directory as uid 853 and serializes a
		# canonical YAML through an atomic rename when it starts.  That legitimate
		# rewrite can change comments, formatting, the inode, and therefore the
		# byte hash.  Accept only a bounded, policy-checked, stable snapshot while
		# its external TLS mount requirements and the expected supervised listener
		# and resolver integration remain unchanged and live.
		if ! secure_active_paths ||
		   ! check_core_config_file "$config_file" "$final_hash" "" 1 ||
		   [ "$TLS_DESIRED_MOUNTS" != "$committed_tls_mounts" ] ||
		   ! runtime_settings_match "$committed_port" "$committed_mode" \
			"$committed_work_dir" ||
		   ! official_running || ! dns_port_listening; then
			log_error "The running core produced an unsafe YAML result; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
		verify_hash="$(active_config_hash)" || {
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		}
		if [ "$verify_hash" != "$final_hash" ] ||
		   ! runtime_settings_match "$committed_port" "$committed_mode" \
			"$committed_work_dir" ||
		   ! official_running || ! dns_port_listening; then
			log_error "The running core YAML did not reach a stable valid state; restoring the previous file"
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		fi
	elif [ "$final_hash" != "$candidate_hash" ] ||
	     [ ! "$fd_path" -ef "$config_file" ]; then
		log_error "The stopped-service YAML changed after installation; restoring the previous file"
		attempt_yaml_rollback "$backup" "$was_running" ||
			log_error "Failed to restore the previous YAML runtime"
		return 1
	else
		secure_config_inode "$fd_path" || {
			attempt_yaml_rollback "$backup" "$was_running" ||
				log_error "Failed to restore the previous YAML runtime"
			return 1
		}
	fi
	if remove_yaml_backup "$backup"; then
		YAML_BACKUP_CLEANUP=""
	else
		log_error "Unable to remove the completed LuCI YAML backup"
	fi
	YAML_INSTALLED=0
	trap - HUP INT QUIT TERM
	return 0
)

yaml_update() {
	run_locked yaml_update_locked "$1" "$2" "$3" "$4"
}

restore_tls_fingerprint() {
	local value="$1" option="${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}"
	if [ -n "$value" ]; then
		uci -q set "${option}=${value}" || return 1
	else
		uci -q delete "$option" 2>/dev/null || true
	fi
	uci -q commit "$LEGACY_CONFIG"
}

tls_refresh_locked() {
	local old_fingerprint was_running=0
	load_legacy_settings || return 1
	[ -f "$config_file" ] && [ ! -L "$config_file" ] || return 0
	old_fingerprint="$(uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${MANAGED_TLS_FINGERPRINT}")"
	load_active_tls_access || return 1
	# A system-wide ACME event must have no effect on installations whose YAML
	# does not consume file-by-file /etc/ssl/acme material.
	[ "$TLS_USES_ACME" = 1 ] || return 0
	check_core_config || return 1
	sync_tls_access || return 1
	[ "$old_fingerprint" != "$TLS_FINGERPRINT" ] || return 0
	[ "$legacy_enabled" = 1 ] || return 0
	official_running && was_running=1

	if ! clear_recorded_integration_locked; then
		restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 || true
		resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
		return 1
	fi
	if official_running; then
		if ! "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || ! wait_for_core_stopped; then
			restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 || true
			resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
			return 1
		fi
	fi
	if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1 ||
	   ! load_runtime_dns_port ||
	   ! wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" ||
	   ! apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		restore_tls_fingerprint "$old_fingerprint" >/dev/null 2>&1 ||
			log_error "Unable to restore the previous ACME retry fingerprint"
		resume_yaml_runtime "$was_running" >/dev/null 2>&1 || true
		log_error "Unable to restart AdGuard Home after ACME renewal"
		return 1
	fi
}

tls_refresh() {
	case "${ACTION:-renewed}" in issued|renewed) ;; *) return 0 ;; esac
	run_locked tls_refresh_locked
}

fail_safe_locked() {
	clear_recorded_integration_locked || return 1
	disable_official_autostart || return 1
	[ ! -x "$OFFICIAL_SERVICE" ] || "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
}

prepare_wrapper_locked() {
	[ "${WRAPPER_BOOT:-0}" = 1 ] && RELOAD_SERVICES=0
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	if [ "$legacy_enabled" != 1 ]; then
		clear_recorded_integration_locked || return 1
		if official_running; then
			"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
			wait_for_core_stopped || return 1
		fi
		ensure_config_file || return 1
		migrate_work_data || return 1
		sync_yaml_managed_fields_checked || return 1
		sync_official_uci || return 1
		# A distinct success status tells start_service not to create a polling
		# monitor for a deliberately disabled installation.
		return 2
	fi
	# A work-directory migration copies the lower service's current YAML.  Stop
	# that writer before taking the copy so the new file cannot be torn.
	if { [ ! -f "$config_file" ] || [ "${previous_work_dir%/}" != "$work_dir" ]; } &&
	   official_running; then
		clear_recorded_integration_locked || return 1
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	ensure_config_file || {
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	}
	migrate_work_data || return 1
	load_runtime_dns_port || {
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	}

	# At boot restore the pre-integration resolver state first.  The monitor will
	# apply takeover only after the official delayed start has become stable.
	if [ "${WRAPPER_BOOT:-0}" = 1 ]; then
		clear_recorded_integration_locked || return 1
	fi

	# Never enter a YAML writer while the core is live.  A running service can
	# only reach this branch when no workdir rewrite is required.
	if official_running; then
		check_core_config || return 1
	else
		sync_yaml_managed_fields_checked || return 1
	fi
	sync_official_uci || return 1
}

orchestrate_core_locked() {
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi

	# Clean up before stopping the listener.  If cleanup fails, leave the working
	# core alone rather than creating a DNS black hole.
	clear_recorded_integration_locked || return 1
	if official_running; then
		"$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
	ensure_config_file || {
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	}
	migrate_work_data || return 1
	load_runtime_dns_port || return 1

	# The core is stopped here, so the managed workdir rewrite cannot race its
	# own configuration writer.  DNS and Web endpoints remain YAML-owned.
	sync_yaml_managed_fields_checked || return 1
	load_runtime_dns_port || return 1
	sync_official_uci || return 1
	[ "$legacy_enabled" = 1 ] || return 0
	[ -x "$OFFICIAL_SERVICE" ] || return 1
	if ! "$OFFICIAL_SERVICE" start >/dev/null 2>&1; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
	if ! apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"; then
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	fi
}

reconcile_core_locked() {
	if ! load_legacy_settings; then
		fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	if [ "$legacy_enabled" != 1 ]; then
		clear_recorded_integration_locked || return 1
		[ ! -x "$OFFICIAL_SERVICE" ] || "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || true
		return 0
	fi
	if ! load_runtime_dns_port; then
		clear_recorded_integration_locked || return 1
		return 0
	fi
	if ! official_running || ! dns_port_listening; then
		clear_recorded_integration_locked || return 1
		return 0
	fi
	integration_matches_desired && return 0
	wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || {
		clear_recorded_integration_locked >/dev/null 2>&1 || true
		return 1
	}
	apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
}

do_redirect_locked() {
	case "$1" in
		0) clear_recorded_integration_locked ;;
		1)
			load_legacy_settings || return 1
			load_runtime_dns_port || return 1
			wait_for_core_ready "$dns_port" "$redirect_mode" "$work_dir" || {
				clear_recorded_integration_locked >/dev/null 2>&1 || true
				return 1
			}
			apply_integration_locked "$dns_port" "$redirect_mode" "$work_dir"
			;;
		*) return 1 ;;
	esac
}

do_redirect() {
	run_locked do_redirect_locked "$1"
}

reconcile() {
	run_locked reconcile_core_locked
}

# This is the only process supervised by the compatibility wrapper.  It never
# launches or adopts the core; it merely reconciles DNS takeover with the state
# reported by the official lowercase procd service.
monitor() {
	# rc.common serializes init commands with fd 1000.  This long-running
	# procd command enters through rc.common as well, so release the inherited
	# control lock before looping; otherwise every later start/stop/reload waits
	# forever behind the monitor instance.
	exec 1000>&-
	trap 'exit 0' TERM INT
	while :; do
		run_locked reconcile_core_locked >/dev/null 2>&1 || true
		sleep "$MONITOR_INTERVAL" &
		wait $!
	done
}

isrunning() {
	if official_running; then echo "running"; return 0; fi
	if [ ! -x /usr/bin/AdGuardHome ]; then echo "no bin"; return 2; fi
	echo "not run"
	return 1
}

start_service() {
	local prepare_rc=0
	if [ -e /etc/uci-defaults/40_luci-AdGuardHome ] ||
	   [ -L /etc/uci-defaults/40_luci-AdGuardHome ]; then
		log_error "Configuration migration is incomplete; refusing to start the coordinator"
		return 1
	fi
	START_PREPARED=0
	START_DISABLED=0
	run_locked prepare_wrapper_locked || prepare_rc=$?
	case "$prepare_rc" in
		0) START_PREPARED=1 ;;
		2)
			START_PREPARED=1
			START_DISABLED=1
			return 0
			;;
	esac
	[ "$START_PREPARED" = 1 ] || return 0
	procd_open_instance monitor
	procd_set_param command "$initscript" monitor
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 5
	procd_close_instance
	return 0
}

service_started() {
	if [ "$START_PREPARED" != 1 ]; then
		run_locked fail_safe_locked >/dev/null 2>&1 || true
		return 1
	fi
	[ "$START_DISABLED" != 1 ] || return 0
	if [ "${WRAPPER_BOOT:-0}" = 1 ]; then
		RELOAD_SERVICES=0 run_locked reconcile_core_locked
	else
		run_locked orchestrate_core_locked
	fi
}

stop_wrapper_locked() {
	local shutdown_mode="$1"
	[ "$shutdown_mode" = 1 ] && RELOAD_SERVICES=0
	clear_recorded_integration_locked || return 1
	if [ "$shutdown_mode" != 1 ]; then
		disable_official_autostart || return 1
		[ ! -x "$OFFICIAL_SERVICE" ] || "$OFFICIAL_SERVICE" stop >/dev/null 2>&1 || return 1
		wait_for_core_stopped || return 1
	fi
}

stop_service() {
	run_locked stop_wrapper_locked "${WRAPPER_SHUTDOWN:-0}"
}

service_triggers() {
	procd_add_reload_trigger "$LEGACY_CONFIG"
}

restart() {
	reload
}

boot() {
	WRAPPER_BOOT=1
	start
}

shutdown() {
	WRAPPER_SHUTDOWN=1
	stop
}
