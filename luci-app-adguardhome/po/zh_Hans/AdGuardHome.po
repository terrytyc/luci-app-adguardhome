msgid "AdGuard Home"
msgstr "AdGuard Home"

msgid "Preparing account change…"
msgstr "正在准备修改账号…"

msgid "Syntax highlighting is disabled for large files; editing and validation are unchanged."
msgstr "大文件已关闭语法高亮，编辑和校验功能不变。"

msgid "Persistent data and AdGuardHome.yaml are stored in this directory."
msgstr "持久化 data 和 AdGuardHome.yaml 保存在此目录。"

msgid "Choose how LAN DNS reaches AdGuard Home. The listening port is read from YAML."
msgstr "选择 LAN DNS 接入 AdGuard Home 的方式，监听端口从 YAML 读取。"

msgid "Only data is copied to RAM; the core executable and YAML stay in place. Live write-back does not restart services and cannot guarantee consistency during concurrent changes or power loss."
msgstr "仅将 data 放入内存，主程序和 YAML 保留在持久目录。直接回写不重启服务，不保证并发修改或断电时的数据一致性。"

msgid "0 disables scheduled write-back. A normal stop or restart still writes data back. Use 60 minutes or longer to reduce flash wear."
msgstr "0 关闭定时回写，正常停止或重启仍会回写。建议设为 60 分钟或更长，以减少闪存磨损。"

msgid "Change AdGuard Home Account"
msgstr "修改 AdGuard Home 登录账号"

msgid "Close"
msgstr "关闭"

msgid "Unsaved changes"
msgstr "未保存"

msgid "Load Template"
msgstr "载入模板"

msgid "Load Template changes only the editor. The active configuration stays unchanged until Validate, Save & Apply."
msgstr "载入模板仅替换编辑内容，点击“校验、保存并应用”前不会修改运行配置。"

msgid "Discard unsaved changes?"
msgstr "放弃未保存的修改？"

msgid "Reloading from disk will replace your unsaved editor text."
msgstr "从磁盘重新载入将覆盖编辑器中未保存的内容。"

msgid "Use Reload from disk before editing again."
msgstr "请先点击“从磁盘重新载入”，再继续编辑。"

msgid "Unable to load the YAML template: %s"
msgstr "无法载入 YAML 模板：%s"

msgid "Wrap lines"
msgstr "自动换行"

msgid "Grant permissions for the AdGuard Home LuCI app"
msgstr "授予 AdGuard Home LuCI 应用权限"

msgid "The core is provided and updated by the official adguardhome package. Default web login: admin / admin."
msgstr "核心由官方 adguardhome 软件包提供和更新。默认网页登录用户名和密码为 admin / admin。"

msgid "Overview"
msgstr "概览"

msgid "Service status"
msgstr "服务状态"

msgid "Active storage"
msgstr "当前存储模式"

msgid "Memory"
msgstr "内存"

msgid "Persistent storage"
msgstr "持久化存储"

msgid "Persistent storage (memory fallback)"
msgstr "持久化存储（内存模式回退）"

msgid "Persistent storage (memory on next start)"
msgstr "持久化存储（下次启动使用内存）"

msgid "Running"
msgstr "运行中"

msgid "Not running"
msgstr "未运行"

msgid "Core version"
msgstr "核心版本"

msgid "Unknown"
msgstr "未知"

msgid "Unavailable"
msgstr "不可用"

msgid "Open Web Interface"
msgstr "打开 Web 管理界面"

msgid "Settings"
msgstr "设置"

msgid "Enable"
msgstr "启用"

msgid "Listening port"
msgstr "监听端口"

msgid "DNS redirect mode"
msgstr "DNS 重定向模式"

msgid "None"
msgstr "无"

msgid "Use AdGuard Home as dnsmasq upstream"
msgstr "作为 dnsmasq 上游"

msgid "Redirect port 53"
msgstr "重定向 53 端口"

msgid "Working directory"
msgstr "工作目录"

msgid "Verbose logging"
msgstr "详细日志"

msgid "Run from memory"
msgstr "从内存运行"

msgid "Memory write-back interval (minutes)"
msgstr "内存数据回写周期（分钟）"

msgid "The memory write-back interval is invalid."
msgstr "内存数据回写周期无效。"

msgid "Enter 0 to disable periodic write-back, or a whole number from 1 to 10080."
msgstr "请输入 0 以停用周期回写，或输入 1 到 10080 之间的整数。"

msgid "The settings returned by the service are invalid."
msgstr "服务返回的设置无效。"

msgid "The server did not accept the settings update job."
msgstr "服务器未接受设置更新任务。"

msgid "The server rejected the settings update."
msgstr "服务器拒绝了设置更新。"

msgid "The settings update returned an unknown job state."
msgstr "设置更新任务返回了未知状态。"

msgid "The settings update is still running, but its status is temporarily unavailable: %s. Do not submit it again; reload this page later."
msgstr "设置更新仍在运行，但暂时无法获取其状态：%s。请勿重复提交，稍后重新加载此页面。"

msgid "The settings update is still running. Do not submit it again; reload this page later."
msgstr "设置更新仍在运行。请勿重复提交，稍后重新加载此页面。"

msgid "Unable to apply settings: %s"
msgstr "无法应用设置：%s"

msgid "Change Username and Password"
msgstr "修改用户名及密码"

msgid "Configuration changes applied."
msgstr "配置已应用。"

msgid "Current username"
msgstr "当前用户名"

msgid "New username"
msgstr "新用户名"

msgid "Leave empty to keep the current username"
msgstr "留空则不修改当前用户名"

msgid "Leave either field empty to keep it unchanged. A new password must contain at least 8 characters and no more than 72 UTF-8 bytes."
msgstr "用户名或密码留空时将保持不变。新密码必须至少包含 8 个字符，且不超过 72 个 UTF-8 字节。"

msgid "Enter a new username, a new password, or both."
msgstr "请输入新用户名、新密码，或同时输入两者。"

msgid "The username must be 1 to 64 characters and may contain only letters, numbers, dot, underscore, at sign, plus sign, or hyphen. It must start with a letter or number."
msgstr "用户名必须为 1 到 64 个字符，只能包含字母、数字、点、下划线、@、加号或连字符，并且必须以字母或数字开头。"

msgid "The username is unchanged and no new password was entered."
msgstr "用户名没有变化，且未输入新密码。"

msgid "The YAML user account is unavailable or ambiguous. Use the YAML editor to review the users section."
msgstr "YAML 中的用户账号不可用或存在歧义，请在 YAML 编辑器中检查 users 段。"

msgid "Unable to prepare the username or password change: %s"
msgstr "无法准备用户名或密码修改：%s"

msgid "The server did not accept the credential update job."
msgstr "服务器未接受用户凭据更新任务。"

msgid "The server rejected the credential update."
msgstr "服务器拒绝了用户凭据更新。"

msgid "Unable to change the username or password: %s"
msgstr "无法修改用户名或密码：%s"

msgid "The credential update returned an unknown job state."
msgstr "用户凭据更新任务返回了未知状态。"

msgid "The credential update is still running, but its status is temporarily unavailable: %s. Do not submit it again; reload this page later."
msgstr "用户凭据更新仍在运行，但暂时无法获取其状态：%s。请勿重复提交，稍后重新加载此页面。"

msgid "The credential update is still running. Do not submit it again; reload this page later."
msgstr "用户凭据更新仍在运行。请勿重复提交，稍后重新加载此页面。"

msgid "New password"
msgstr "新密码"

msgid "Confirm password"
msgstr "确认密码"

msgid "The two passwords do not match."
msgstr "两次输入的密码不一致。"

msgid "The password must contain at least 8 characters."
msgstr "密码必须至少包含 8 个字符。"

msgid "The password exceeds the 72-byte BCrypt limit."
msgstr "密码超过 BCrypt 的 72 字节限制。"

msgid "This field is required."
msgstr "此字段为必填项。"

msgid "Path must be absolute."
msgstr "必须使用绝对路径。"

msgid "The working directory must not be the filesystem root."
msgstr "工作目录不能是文件系统根目录。"

msgid "Path must not contain repeated slashes."
msgstr "路径不能包含连续的斜杠。"

msgid "Path must not end with a slash."
msgstr "路径不能以斜杠结尾。"

msgid "Path contains characters that are unsafe for the current service script."
msgstr "路径包含当前服务脚本不接受的字符。"

msgid "Path must not contain \".\" or \"..\" components."
msgstr "路径不能包含“.”或“..”路径段。"

msgid "Runtime Log"
msgstr "运行日志"

msgid "View recent core and plugin messages from the system log. The newest entries are shown first, and this page is read-only."
msgstr "查看系统日志中的近期核心和插件消息；最新记录显示在最上方，此页面为只读。"

msgid "Lines:"
msgstr "行数："

msgid "%d lines"
msgstr "%d 行"

msgid "Refresh"
msgstr "刷新"

msgid "No log output."
msgstr "暂无日志输出。"

msgid "Showing up to %d lines (%d returned)."
msgstr "最多显示 %d 行（实际返回 %d 行）。"

msgid "AdGuard Home Core Log"
msgstr "AdGuard Home 核心日志"

msgid "Plugin Runtime Log"
msgstr "插件运行日志"

msgid "Unable to read the AdGuard Home core log: %s"
msgstr "无法读取 AdGuard Home 核心日志：%s"

msgid "Unable to read the plugin runtime log: %s"
msgstr "无法读取插件运行日志：%s"

msgid "The log source response was invalid."
msgstr "日志来源响应无效。"

msgid "Unknown error"
msgstr "未知错误"

msgid "YAML Configuration"
msgstr "YAML 配置"

msgid "Edit the active AdGuard Home configuration file directly."
msgstr "直接编辑当前生效的 AdGuard Home 配置文件。"

msgid "Saving validates and atomically applies the YAML. A running service is restarted; a disabled service remains stopped."
msgstr "保存时会校验并原子应用 YAML；服务原本运行时会重启，原本停用时会保持停用。"

msgid "Validate, Save & Apply"
msgstr "校验、保存并应用"

msgid "Reload from disk"
msgstr "从磁盘重新载入"

msgid "The packaged YAML template is unavailable."
msgstr "软件包自带的 YAML 模板不可用。"

msgid "Unable to read the YAML configuration: %s"
msgstr "无法读取 YAML 配置：%s"

msgid "The YAML configuration is unavailable."
msgstr "YAML 配置不可用。"

msgid "Save YAML Configuration"
msgstr "保存 YAML 配置"

msgid "The configuration will be validated and applied atomically. A running service will restart; a disabled service will remain stopped. Continue?"
msgstr "配置将接受校验并原子应用；服务原本运行时会重启，原本停用时会保持停用。是否继续？"

msgid "Cancel"
msgstr "取消"

msgid "The server rejected the YAML configuration. Check its syntax and protected settings."
msgstr "服务器拒绝了 YAML 配置。请检查语法及受保护的设置。"

msgid "Unable to save the YAML configuration: %s"
msgstr "无法保存 YAML 配置：%s"

msgid "The YAML configuration was saved and applied, but the editor could not reload it: %s. Refresh this page before editing again."
msgstr "YAML 配置已保存并应用，但编辑器无法重新载入：%s。请刷新此页面后再继续编辑。"

msgid "The server did not accept the YAML update job."
msgstr "服务器未接受 YAML 更新任务。"

msgid "The YAML update returned an unknown job state."
msgstr "YAML 更新任务返回了未知状态。"

msgid "The YAML update is still running, but its status is temporarily unavailable: %s. Do not submit it again; reload this page later."
msgstr "YAML 更新仍在运行，但暂时无法获取其状态：%s。请勿重复提交，稍后重新加载此页面。"

msgid "The YAML update is still running. Do not submit it again; reload this page later."
msgstr "YAML 更新仍在运行。请勿重复提交，稍后重新加载此页面。"

msgid "The YAML update outcome is unknown. Reload the page before editing it again."
msgstr "YAML 更新结果未知。再次编辑前请重新加载页面。"

msgid "The YAML update succeeded, but its result could not be verified. Reload the page before editing it again."
msgstr "YAML 更新已成功，但无法验证其结果。再次编辑前请重新加载页面。"

msgid "The current settings state is unknown. Reload this page before applying settings again."
msgstr "当前设置状态未知。再次应用设置前请重新加载此页面。"

msgid "The settings update outcome is unknown. Reload this page before applying settings again."
msgstr "设置更新结果未知。再次应用设置前请重新加载此页面。"

msgid "The settings update request may have reached the router, but its result could not be read: %s. Reload this page before applying settings again."
msgstr "设置更新请求可能已到达路由器，但无法读取结果：%s。再次应用设置前请重新加载此页面。"

msgid "The server accepted the settings update job but did not return a valid status token. Reload this page before applying settings again."
msgstr "服务器已接受设置更新任务，但未返回有效的状态令牌。再次应用设置前请重新加载此页面。"

msgid "The settings update succeeded, but its result could not be verified. Reload this page before applying settings again."
msgstr "设置更新已成功，但无法验证结果。再次应用设置前请重新加载此页面。"

msgid "The settings update finished, but the page could not reload its result: %s. Reload this page before applying settings again."
msgstr "设置更新已结束，但页面无法重新载入结果：%s。再次应用设置前请重新加载此页面。"

msgid "Applying configuration changes…"
msgstr "正在应用配置…"

msgid "Loading the template will replace your unsaved editor text."
msgstr "载入模板将替换尚未保存的编辑内容。"

msgid "The memory write-back outcome is unknown."
msgstr "内存回写结果未知。"

msgid "Ready"
msgstr "就绪"

msgid "Not ready"
msgstr "未就绪"

msgid "Not required"
msgstr "无需接管"

msgid "DNS integration"
msgstr "DNS 集成状态"

msgid "Writes back only the currently running data; unsaved settings are not applied."
msgstr "仅回写当前运行的 data，不应用尚未保存的设置。"

msgid "Write back now"
msgstr "立即回写"

msgid "Plugin version"
msgstr "插件版本"

msgid "The current settings state is unknown. Reload this page before writing back memory data."
msgstr "当前设置状态未知。回写内存数据前请重新加载此页面。"

msgid "Writing memory data back…"
msgstr "正在回写内存数据…"

msgid "The server did not accept the memory write-back job."
msgstr "服务器未接受内存回写任务。"

msgid "The memory write-back returned an unknown job state."
msgstr "内存回写任务返回了未知状态。"

msgid "The memory write-back status is temporarily unavailable: %s"
msgstr "暂时无法获取内存回写状态：%s"

msgid "The memory write-back is still running."
msgstr "内存回写仍在进行。"

msgid "The server rejected the memory write-back."
msgstr "服务器拒绝了内存回写。"

msgid "Memory data written back."
msgstr "内存数据已回写。"

msgid "Unable to write back memory data: %s"
msgstr "无法回写内存数据：%s"

msgid "Reload this page before trying again."
msgstr "请重新加载此页面后再试。"

msgid "The memory write-back outcome is unknown. Reload this page before trying again."
msgstr "内存回写结果未知。请重新加载此页面后再试。"

msgid "Choose a dedicated working directory, not a system directory."
msgstr "请选择独立的工作目录，不要使用系统目录本身。"

msgid "The username or password update outcome is unknown. The request may have reached the router, but its response could not be read: %s. Reopen this dialog to review the current account before making another change."
msgstr "用户名或密码的修改结果未知。请求可能已到达路由器，但无法读取响应：%s。请重新打开账号窗口，确认当前状态后再修改。"

msgid "The username or password update outcome is unknown. The server accepted the update job but did not return a valid status token. Reopen this dialog to review the current account before making another change."
msgstr "用户名或密码的修改结果未知。服务器已接受任务，但未返回有效的状态令牌。请重新打开账号窗口，确认当前状态后再修改。"
